{
    return strpos($ip, ':') === false ? self::IPV4 : self::IPV6;
}
";s:6:"params";a:1:{s:3:"$ip";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:3:"$ip";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:31:"The valid IPv4 or IPv6 address.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseIpHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:20:"[[IPV4]] or [[IPV6]]";s:10:"returnType";s:3:"int";s:11:"returnTypes";a:1:{i:0;s:3:"int";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:63730;s:4:"name";s:12:"getIpVersion";s:8:"fullName";s:38:"yii\helpers\BaseIpHelper::getIpVersion";s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseIpHelper.php";s:9:"startLine";i:40;s:7:"endLine";i:43;s:16:"shortDescription";s:60:"Gets the IP version. Does not perform IP address validation.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:7:"inRange";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:24:"yii\helpers\BaseIpHelper";s:10:"sourceCode";s:704:"public static function inRange($subnet, $range)
{
    list($ip, $mask) = array_pad(explode('/', $subnet), 2, null);
    list($net, $netMask) = array_pad(explode('/', $range), 2, null);
    $ipVersion = static::getIpVersion($ip);
    $netVersion = static::getIpVersion($net);
    if ($ipVersion !== $netVersion) {
        return false;
    }
    $maxMask = $ipVersion === self::IPV4 ? self::IPV4_ADDRESS_LENGTH : self::IPV6_ADDRESS_LENGTH;
    $mask = isset($mask) ? $mask : $maxMask;
    $netMask = isset($netMask) ? $netMask : $maxMask;
    $binIp = static::ip2bin($ip);
    $binNet = static::ip2bin($net);
    return substr($binIp, 0, $netMask) === substr($binNet, 0, $netMask) && $mask >= $netMask;
}
";s:6:"params";a:2:{s:7:"$subnet";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$subnet";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:82:"The valid IPv4 or IPv6 address or CIDR range, e.g.: `10.0.0.0/8` or `2001:af::/64`";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseIpHelper.php";}s:6:"$range";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$range";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:70:"The valid IPv4 or IPv6 CIDR range, e.g. `10.0.0.0/8` or `2001:af::/64`";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseIpHelper.php";}}s:10:"exceptions";a:1:{s:31:"\yii\base\NotSupportedException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:38:"Whether $subnet is contained by $range";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:63730;s:4:"name";s:7:"inRange";s:8:"fullName";s:33:"yii\helpers\BaseIpHelper::inRange";s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseIpHelper.php";s:9:"startLine";i:69;s:7:"endLine";i:87;s:16:"shortDescription";s:68:"Checks whether IP address or subnet $subnet is contained by $subnet.";s:11:"description";s:448:"For example, the following code checks whether subnet `192.168.1.0/24` is in subnet `192.168.0.0/22`:

```
IpHelper::inRange('192.168.1.0/24', '192.168.0.0/22'); // true
```

In case you need to check whether a single IP address `192.168.1.21` is in the subnet `192.168.1.0/24`,
you can use any of theses examples:

```
IpHelper::inRange('192.168.1.21', '192.168.1.0/24'); // true
IpHelper::inRange('192.168.1.21/32', '192.168.1.0/24'); // true
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:4;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:60:"https://en.wikipedia.org/wiki/Classless_Inter-Domain_Routing";}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:10:"expandIPv6";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:24:"yii\helpers\BaseIpHelper";s:10:"sourceCode";s:167:"public static function expandIPv6($ip)
{
    $hex = unpack('H*hex', inet_pton($ip));
    return substr(preg_replace('/([a-f0-9]{4})/i', '$1:', $hex['hex']), 0, -1);
}
";s:6:"params";a:1:{s:3:"$ip";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:3:"$ip";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:31:"The original valid IPv6 address";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseIpHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:25:"The expanded IPv6 address";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:63730;s:4:"name";s:10:"expandIPv6";s:8:"fullName";s:36:"yii\helpers\BaseIpHelper::expandIPv6";s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseIpHelper.php";s:9:"startLine";i:97;s:7:"endLine";i:101;s:16:"shortDescription";s:46:"Expands an IPv6 address to it's full notation.";s:11:"description";s:87:"For example `2001:db8::1` will be expanded to `2001:0db8:0000:0000:0000:0000:0000:0001`";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"ip2bin";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:24:"yii\helpers\BaseIpHelper";s:10:"sourceCode";s:552:"public static function ip2bin($ip)
{
    $ipBinary = null;
    if (static::getIpVersion($ip) === self::IPV4) {
        $ipBinary = pack('N', ip2long($ip));
    } elseif (@inet_pton('::1') === false) {
        throw new NotSupportedException('IPv6 is not supported by inet_pton()!');
    } else {
        $ipBinary = inet_pton($ip);
    }
    $result = '';
    for ($i = 0, $iMax = strlen($ipBinary); $i < $iMax; $i += 4) {
        $result .= str_pad(decbin(unpack('N', substr($ipBinary, $i, 4))[1]), 32, '0', STR_PAD_LEFT);
    }
    return $result;
}
