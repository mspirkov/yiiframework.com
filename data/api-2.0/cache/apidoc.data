mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Action.php";s:9:"startLine";i:40;s:7:"endLine";i:132;s:16:"shortDescription";s:59:"Action is the base class for all controller action classes.";s:11:"description";s:770:"Action provides a way to reuse action method code. An action method in an Action
class can be used in multiple controllers or in different projects.

Derived classes must implement a method named `run()`. This method
will be invoked by the controller when the action is requested.
The `run()` method can have parameters which will be filled up
with user input values automatically according to their names.
For example, if the `run()` method is declared as follows:

```
public function run($id, $type = 'book') { ... }
```

And the parameters provided for the action are: `['id' => 1]`.
Then the `run()` method will be invoked as `run(1)` automatically.

For more details and usage information on Action, see the [guide article on actions](guide:structure-controllers).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:0;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:8:"uniqueId";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:80501;}i:3;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Template":5:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀templateName";s:1:"T";s:54:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀bound";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:20:"\yii\base\Controller";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:10:"Controller";}}s:56:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀default";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:7:"␀*␀name";s:8:"template";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:29:"yii\base\InvalidCallException";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:22:"BadMethodCallException";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:1:{s:7:"getName";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:29:"yii\base\InvalidCallException";s:10:"sourceCode";s:57:"public function getName()
