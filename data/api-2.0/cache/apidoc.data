php";s:9:"startLine";i:147;s:7:"endLine";i:198;s:16:"shortDescription";s:136:"Parses an input string according to an [ICU message format](https://unicode-org.github.io/icu/userguide/format_parse/messages/) pattern.";s:11:"description";s:229:"It uses the PHP intl extension's [MessageFormatter::parse()](https://www.php.net/manual/en/messageformatter.parsemessage.php)
and adds support for named arguments.
Usage of this method requires PHP intl extension to be installed.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"fallbackFormat";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:25:"yii\i18n\MessageFormatter";s:10:"sourceCode";s:613:"protected function fallbackFormat($pattern, $args, $locale)
{
    if (($tokens = self::tokenizePattern($pattern)) === false) {
        $this->_errorCode = -1;
        $this->_errorMessage = 'Message pattern is invalid.';
        return false;
    }
    foreach ($tokens as $i => $token) {
        if (is_array($token)) {
            if (($tokens[$i] = $this->parseToken($token, $args, $locale)) === false) {
                $this->_errorCode = -1;
                $this->_errorMessage = 'Message pattern is invalid.';
                return false;
            }
        }
    }
    return implode('', $tokens);
}
";s:6:"params";a:3:{s:8:"$pattern";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$pattern";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:41:"The pattern string to insert things into.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/MessageFormatter.php";}s:5:"$args";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$args";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:52:"The array of values to insert into the format string";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/MessageFormatter.php";}s:7:"$locale";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$locale";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:55:"The locale to use for formatting locale-dependent parts";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/MessageFormatter.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:60:"The formatted pattern string or `false` if an error occurred";s:10:"returnType";s:12:"false|string";s:11:"returnTypes";a:2:{i:0;s:5:"false";i:1;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:1974;s:4:"name";s:14:"fallbackFormat";s:8:"fullName";s:41:"yii\i18n\MessageFormatter::fallbackFormat";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/MessageFormatter.php";s:9:"startLine";i:264;s:7:"endLine";i:284;s:16:"shortDescription";s:60:"Fallback implementation for MessageFormatter::formatMessage.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags"