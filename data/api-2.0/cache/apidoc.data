";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:46579;s:4:"name";s:4:"init";s:8:"fullName";s:27:"yii\filters\PageCache::init";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/PageCache.php";s:9:"startLine";i:160;s:7:"endLine";i:166;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:12:"beforeAction";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\filters\PageCache";s:10:"sourceCode";s:930:"public function beforeAction($action)
{
    if (!$this->enabled) {
        return true;
    }
    $this->cache = Instance::ensure($this->cache, 'yii\caching\CacheInterface');
    if (is_array($this->dependency)) {
        $this->dependency = Yii::createObject($this->dependency);
    }
    $response = Yii::$app->getResponse();
    $data = $this->cache->get($this->calculateCacheKey());
    if (!is_array($data) || !isset($data['cacheVersion']) || $data['cacheVersion'] !== static::PAGE_CACHE_VERSION) {
        $this->view->pushDynamicContent($this);
        ob_start();
        ob_implicit_flush(false);
        $response->on(Response::EVENT_AFTER_SEND, [$this, 'cacheResponse']);
        Yii::debug('Valid page content is not found in the cache.', __METHOD__);
        return true;
    }
    $this->restoreResponse($response, $data);
    Yii::debug('Valid page content is found in the cache.', __METHOD__);
    return false;
}
