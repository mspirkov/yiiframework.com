"startLine";i:37;s:7:"endLine";i:37;s:16:"shortDescription";s:68:"The language ID (e.g. en-US) that the message is to be translated to";s:11:"description";s:68:"The language ID (e.g. en-US) that the message is to be translated to";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:68:"the language ID (e.g. en-US) that the message is to be translated to";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:8:"yii\i18n";s:13:"phpDocContext";r:6566;s:4:"name";s:32:"yii\i18n\MissingTranslationEvent";s:8:"fullName";s:32:"yii\i18n\MissingTranslationEvent";s:10:"sourceFile";s:107:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/MissingTranslationEvent.php";s:9:"startLine";i:18;s:7:"endLine";i:38;s:16:"shortDescription";s:108:"MissingTranslationEvent represents the parameter for the [[MessageSource::EVENT_MISSING_TRANSLATION]] event.";s:11:"description";s:0:"";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:22:"yii\i18n\GettextPoFile";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:20:"yii\i18n\GettextFile";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:4:{s:4:"load";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:22:"yii\i18n\GettextPoFile";s:10:"sourceCode";s:676:"public function load($filePath, $context)
{
    $pattern = '/(msgctxt\s+"(.*?(?<!\\\\))")?\s+' // context
        . 'msgid\s+((?:".*(?<!\\\\)"\s*)+)\s+' // message ID, i.e. original string
        . 'msgstr\s+((?:".*(?<!\\\\)"\s*)+)/'; // translated string
    $content = file_get_contents($filePath);
    $matches = [];
    $matchCount = preg_match_all($pattern, $content, $matches);
    $messages = [];
    for ($i = 0; $i < $matchCount; ++$i) {
        if ($matches[2][$i] === $context) {
            $id = $this->decode($matches[3][$i]);
            $message = $this->decode($matches[4][$i]);
            $messages[$id] = $message;
        }
    }
    return $messages;
}
";s:6:"params";a:2:{s:9:"$filePath";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$filePath";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:9:"File path";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/GettextPoFile.php";}s:8:"$context";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$context";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:15:"Message context";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/GettextPoFile.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:132:"Message translations. Array keys are source messages and array values are translated messages:
source message => translated message.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:8:"yii\i18n";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:1:{s:3:"Yii";s:3:"Yii";}}s:4:"name";s:4:"load";s:8:"fullName";s:28:"yii\i18n\GettextPoFile::load";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/GettextPoFile.php";s:9:"startLine";i:27;s:7:"endLine";i:46;s:16:"shortDescription";s:30:"Loads messages from a PO file.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:4:"save";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:22:"yii\i18n\GettextPoFile";s:10:"sourceCode";s:1065:"public function save($filePath, $messages)
{
    $language = str_replace('-', '_', basename(dirname($filePath)));
    $headers = [
        'msgid ""',
        'msgstr ""',
        '"Project-Id-Version: \n"',
        '"POT-Creation-Date: \n"',
        '"PO-Revision-Date: \n"',
        '"Last-Translator: \n"',
        '"Language-Team: \n"',
        '"Language: ' . $language . '\n"',
        '"MIME-Version: 1.0\n"',
        '"Content-Type: text/plain; charset=' . Yii::$app->charset . '\n"',
        '"Content-Transfer-Encoding: 8bit\n"',
    ];
    $content = implode("\n", $headers) . "\n\n";
    foreach ($messages as $id => $message) {
        $separatorPosition = strpos($id, chr(4));
        if ($separatorPosition !== false) {
            $content .= 'msgctxt "' . substr($id, 0, $separatorPosition) . "\"\n";
            $id = substr($id, $separatorPosition + 1);
        }
        $content .= 'msgid "' . $this->encode($id) . "\"\n";
        $content .= 'msgstr "' . $this->encode($message) . "\"\n\n";
    }
    file_put_contents($filePath, $content);
}
