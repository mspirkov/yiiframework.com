like '5M', '15K' etc.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"getByteSize";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"YiiRequirementChecker";s:10:"sourceCode";s:655:"public function getByteSize($verboseSize)
{
    if (empty($verboseSize)) {
        return 0;
    }
    if (is_numeric($verboseSize)) {
        return (int) $verboseSize;
    }
    $sizeUnit = trim($verboseSize, '0123456789');
    $size = trim(str_replace($sizeUnit, '', $verboseSize));
    if (!is_numeric($size)) {
        return 0;
    }
    switch (strtolower($sizeUnit)) {
        case 'kb':
        case 'k':
            return $size * 1024;
        case 'mb':
        case 'm':
            return $size * 1024 * 1024;
        case 'gb':
        case 'g':
            return $size * 1024 * 1024 * 1024;
        default:
            return 0;
    }
}
";s:6:"params";a:1:{s:12:"$verboseSize";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:12:"$verboseSize";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:28:"Verbose size representation.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/requirements/YiiRequirementChecker.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:21:"Actual size in bytes.";s:10:"returnType";s:3:"int";s:11:"returnTypes";a:1:{i:0;s:3:"int";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:0:"";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:0:{}}s:4:"name";s:11:"getByteSize";s:8:"fullName";s:34:"YiiRequirementChecker::getByteSize";s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/requirements/YiiRequirementChecker.php";s:9:"startLine";i:244;s:7:"endLine";i:270;s:16:"shortDescription";s:56:"Gets the size in bytes from verbose size representation.";s:11:"description";s:27:"For example: '5K' => 5*1024";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:22:"checkUploadMaxFileSize";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"YiiRequirementChecker";s:10:"sourceCode";s:640:"public function checkUploadMaxFileSize($min = null, $max = null)
{
    $postMaxSize = ini_get('post_max_size');
    $uploadMaxFileSize = ini_get('upload_max_filesize');
    if ($min !== null) {
        $minCheckResult = $this->compareByteSize($postMaxSize, $min, '>=') && $this->compareByteSize($uploadMaxFileSize, $min, '>=');
    } else {
        $minCheckResult = true;
    }
    if ($max !== null) {
        $maxCheckResult = $this->compareByteSize($postMaxSize, $max, '<=') && $this->compareByteSize($uploadMaxFileSize, $max, '<=');
    } else {
        $maxCheckResult = true;
    }
    return ($minCheckResult && $maxCheckResult);
}
";s:6:"params";a:2:{s:4:"$min";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:4:"$min";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:74:"Verbose file size minimum required value, pass null to skip minimum check.";s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/requirements/YiiRequirementChecker.php";}s:4:"$max";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:4:"$max";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:74:"Verbose file size maximum required value, pass null to skip maximum check.";s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/requirements/YiiRequirementChecker.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:8:"Success.";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:0:"";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:0:{}}s:4:"name";s:22:"checkUploadMaxFileSize";s:8:"fullName";s:45:"YiiRequirementChecker::checkUploadMaxFileSize";s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/requirements/YiiRequirementChecker.php";s:9:"startLine";i:278;s:7:"endLine";i:294;s:16:"shortDescription";s:55:"Checks if upload max file size matches the given range.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"renderViewFile";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"YiiRequirementChecker";s:10:"sourceCode";s:489:"public function renderViewFile($_viewFile_, $_data_ = null, $_return_ = false)
{
    // we use special variable names here to avoid conflict when extracting data
    if (is_array($_data_)) {
        extract($_data_, EXTR_PREFIX_SAME, 'data');
    } else {
        $data = $_data_;
    }
    if ($_return_) {
        ob_start();
        ob_implicit_flush(false);
        require $_viewFile_;
        return ob_get_clean();
    } else {
        require $_viewFile_;
    }
    return null;
}
";s:6:"params";a:3:{s:11:"$_viewFile_";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:11:"$_viewFile_";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:9:"View file";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/requirements/YiiRequirementChecker.php";}s:7:"$_data_";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$_data_";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:56:"Data to be extracted and made available to the view file";s:4:"type";s:10:"array|null";s:5:"types";a:2:{i:0;s:5:"array";i:1;s:4:"null";}s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/requirements/YiiRequirementChecker.php";}s:9:"$_return_";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$_return_";s:10:"isOptional";b:1;s:12:"defaultValue";s:5:"false";s:19:"isPassedByReference";b:0;s:11:"description";s:59:"Whether the rendering result should be returned as a string";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/requirements/YiiRequirementChecker.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:67:"The rendering result. Null if the rendering result is not required.";s:10:"returnType";s:11:"string|null";s:11:"returnTypes";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:0:"";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:0:{}}s:4:"name";s:14:"renderViewFile";s:8:"fullName";s:37:"YiiRequirementChecker::renderViewFile";s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/requirements/YiiRequirementChecker.php";s:9:"startLine";i:305;s:7:"endLine";i:324;s:16:"shortDescription";s:20:"Renders a view file.";s:11:"description";s:95:"This method includes the view file as a PHP script
and captures the display result if required.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:20:"normalizeRequirement";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"YiiRequirementChecker";s:10:"sourceCode";s:1286:"public function normalizeRequirement($requirement, $requirementKey = 0)
{
    if (!is_array($requirement)) {
        $this->usageError('Requirement must be an array!');
    }
    if (!array_key_exists('condition', $requirement)) {
        $this->usageError("Requirement '{$requirementKey}' has no condition!");
    } else {
        $evalPrefix = 'eval:';
        if (is_string($requirement['condition']) && strpos($requirement['condition'], $evalPrefix) === 0) {
            $expression = substr($requirement['condition'], strlen($evalPrefix));
            $requirement['condition'] = $this->evaluateExpression($expression);
        }
    }
    if (!array_key_exists('name', $requirement)) {
        $requirement['name'] = is_numeric($requirementKey) ? 'Requirement #' . $requirementKey : $requirementKey;
    }
    if (!array_key_exists('mandatory', $requirement)) {
        if (array_key_exists('required', $requirement)) {
            $requirement['mandatory'] = $requirement['required'];
        } else {
            $requirement['mandatory'] = false;
        }
    }
    if (!array_key_exists('by', $requirement)) {
        $requirement['by'] = 'Unknown';
    }
    if (!array_key_exists('memo', $requirement)) {
        $requirement['memo'] = '';
    }
    return $requirement;
}
