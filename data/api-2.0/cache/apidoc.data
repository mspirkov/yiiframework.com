The keys are original messages, and the values are the translated messages.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/PhpMessageSource.php";}s:20:"$originalMessageFile";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:20:"$originalMessageFile";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:105:"The path to the file with messages. Used to log an error message
in case when no translations were found.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/PhpMessageSource.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:96:"The loaded messages. The keys are original messages, and the values are the translated messages.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:7920;s:4:"name";s:20:"loadFallbackMessages";s:8:"fullName";s:47:"yii\i18n\PhpMessageSource::loadFallbackMessages";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/PhpMessageSource.php";s:9:"startLine";i:102;s:7:"endLine";i:125;s:16:"shortDescription";s:97:"The method is normally called by [[loadMessages]] to load the fallback messages for the language.";s:11:"description";s:107:"Method tries to load the $category messages for the $fallbackLanguage and adds them to the $messages array.";s:5:"since";s:5:"2.0.7";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:18:"getMessageFilePath";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:25:"yii\i18n\PhpMessageSource";s:10:"sourceCode";s:550:"protected function getMessageFilePath($category, $language)
{
    $language = (string) $language;
    if ($language !== '' && !preg_match('/^[a-z0-9_-]+$/i', $language)) {
        throw new InvalidArgumentException(sprintf('Invalid language code: "%s".', $language));
    }
    $messageFile = Yii::getAlias($this->basePath) . "/$language/";
    if (isset($this->fileMap[$category])) {
        $messageFile .= $this->fileMap[$category];
    } else {
        $messageFile .= str_replace('\\', '/', $category) . '.php';
    }
    return $messageFile;
}
