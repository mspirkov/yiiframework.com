{
    $caches = $this->findCaches();
    if (!empty($caches)) {
        $this->notifyCachesCanBeFlushed($caches);
    } else {
        $this->notifyNoCachesFound();
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:23:"yii\console\controllers";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:8:{s:3:"Yii";s:3:"Yii";s:8:"ApcCache";s:20:"yii\caching\ApcCache";s:14:"CacheInterface";s:26:"yii\caching\CacheInterface";s:11:"Application";s:23:"yii\console\Application";s:10:"Controller";s:22:"yii\console\Controller";s:9:"Exception";s:21:"yii\console\Exception";s:8:"ExitCode";s:20:"yii\console\ExitCode";s:7:"Console";s:19:"yii\helpers\Console";}}s:4:"name";s:11:"actionIndex";s:8:"fullName";s:52:"yii\console\controllers\CacheController::actionIndex";s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/CacheController.php";s:9:"startLine";i:56;s:7:"endLine";i:65;s:16:"shortDescription";s:37:"Lists the caches that can be flushed.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"actionFlush";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:39:"yii\console\controllers\CacheController";s:10:"sourceCode";s:921:"public function actionFlush()
{
    $cachesInput = func_get_args();
    if (empty($cachesInput)) {
        throw new Exception('You should specify cache components names');
    }
    $caches = $this->findCaches($cachesInput);
    $cachesInfo = [];
    $foundCaches = array_keys($caches);
    $notFoundCaches = array_diff($cachesInput, array_keys($caches));
    if ($notFoundCaches !== []) {
        $this->notifyNotFoundCaches($notFoundCaches);
    }
    if ($foundCaches === []) {
        $this->notifyNoCachesFound();
        return ExitCode::OK;
    }
    if (!$this->confirmFlush($foundCaches)) {
        return ExitCode::OK;
    }
    foreach ($caches as $name => $class) {
        $cachesInfo[] = [
            'name' => $name,
            'class' => $class,
            'is_flushed' => $this->canBeFlushed($class) ? Yii::$app->get($name)->flush() : false,
        ];
    }
    $this->notifyFlushed($cachesInfo);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:38809;s:4:"name";s:11:"actionFlush";s:8:"fullName";s:52:"yii\console\controllers\CacheController::actionFlush";s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/CacheController.php";s:9:"startLine";i:77;s:7:"endLine";i:113;s:16:"shortDescription";s:31:"Flushes given cache components.";s:11:"description";s:123:"For example,

```
# flushes caches specified by their id: "first", "second", "third"
yii cache/flush first second third
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"actionFlushAll";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:39:"yii\console\controllers\CacheController";s:10:"sourceCode";s:476:"public function actionFlushAll()
{
    $caches = $this->findCaches();
    $cachesInfo = [];
    if (empty($caches)) {
        $this->notifyNoCachesFound();
        return ExitCode::OK;
    }
    foreach ($caches as $name => $class) {
        $cachesInfo[] = [
            'name' => $name,
            'class' => $class,
            'is_flushed' => $this->canBeFlushed($class) ? Yii::$app->get($name)->flush() : false,
        ];
    }
    $this->notifyFlushed($cachesInfo);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:38809;s:4:"name";s:14:"actionFlushAll";s:8:"fullName";s:55:"yii\console\controllers\CacheController::actionFlushAll";s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/CacheController.php";s:9:"startLine";i:118;s:7:"endLine";i:137;s:16:"shortDescription";s:44:"Flushes all caches registered in the system.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"actionFlushSchema";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:39:"yii\console\controllers\CacheController";s:10:"sourceCode";s:872:"public function actionFlushSchema($db = 'db')
{
    $connection = Yii::$app->get($db, false);
    if ($connection === null) {
        $this->stdout("Unknown component \"$db\".\n", Console::FG_RED);
        return ExitCode::UNSPECIFIED_ERROR;
    }
    if (!$connection instanceof \yii\db\Connection) {
        $this->stdout("\"$db\" component doesn't inherit \\yii\\db\\Connection.\n", Console::FG_RED);
        return ExitCode::UNSPECIFIED_ERROR;
    } elseif (!$this->confirm("Flush cache schema for \"$db\" connection?")) {
        return ExitCode::OK;
    }
    try {
        $schema = $connection->getSchema();
        $schema->refresh();
        $this->stdout("Schema cache for component \"$db\", was flushed.\n\n", Console::FG_GREEN);
    } catch (\Exception $e) {
        $this->stdout($e->getMessage() . "\n\n", Console::FG_RED);
    }
    return ExitCode::OK;
}
