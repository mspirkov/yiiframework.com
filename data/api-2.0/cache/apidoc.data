- The first operand is the column name.
- The second operand is a single value or an array of values that column value
  should be compared with. If it is an empty array the generated expression will
  be a `false` value if operator is `LIKE` or `OR LIKE`, and empty if operator
  is `NOT LIKE` or `OR NOT LIKE`.
- An optional third operand can also be provided to specify how to escape special characters
  in the value(s). The operand should be an array of mappings from the special characters to their
  escaped counterparts. If this operand is not provided, a default escape mapping will be used.
  You may use `false` or an empty array to indicate the values are already escaped and no escape
  should be applied. Note that when using an escape mapping (or the third operand is not provided),
  the values will be automatically enclosed within a pair of percentage characters.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/QueryBuilder.php";}s:7:"$params";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$params";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:1;s:11:"description";s:38:"The binding parameters to be populated";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/QueryBuilder.php";}}s:10:"exceptions";a:1:{s:34:"\yii\base\InvalidArgumentException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:44:"if wrong number of operands have been given.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:28:"The generated SQL expression";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:174411;s:4:"name";s:18:"buildLikeCondition";s:8:"fullName";s:39:"yii\db\QueryBuilder::buildLikeCondition";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/QueryBuilder.php";s:9:"startLine";i:1717;s:7:"endLine";i:1721;s:16:"shortDescription";s:52:"Creates an SQL expressions with the `LIKE` operator.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";s:45:"since 2.0.14. Use `buildCondition()` instead.";s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:20:"buildExistsCondition";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\db\QueryBuilder";s:10:"sourceCode";s:168:"public function buildExistsCondition($operator, $operands, &$params)
