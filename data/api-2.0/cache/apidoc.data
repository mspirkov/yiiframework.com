```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:19:"notifyNothingToLoad";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:41:"yii\console\controllers\FixtureController";s:10:"sourceCode";s:637:"public function notifyNothingToLoad($foundFixtures, $except)
{
    $this->stdout("Fixtures to load could not be found according given conditions:\n\n", Console::FG_RED);
    $this->stdout("Fixtures namespace is: \n", Console::FG_YELLOW);
    $this->stdout("\t" . $this->namespace . "\n", Console::FG_GREEN);
    if (count($foundFixtures)) {
        $this->stdout("\nFixtures founded under the namespace:\n\n", Console::FG_YELLOW);
        $this->outputList($foundFixtures);
    }
    if (count($except)) {
        $this->stdout("\nFixtures that will NOT be loaded: \n\n", Console::FG_YELLOW);
        $this->outputList($except);
    }
}
