If empty or if it contains '*', all fields as specified by [[fields()]] will be returned.
Fields can be nested, separated with dots (.). e.g.: item.field.sub-field
`$recursive` must be true for nested fields to be extracted. If `$recursive` is false, only the root fields will be extracted.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/ArrayableTrait.php";}s:7:"$expand";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$expand";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:322:"The additional fields being requested for exporting. Only fields declared in [[extraFields()]]
will be considered.
Expand can also be nested, separated with dots (.). e.g.: item.expand1.expand2
`$recursive` must be true for nested expands to be extracted. If `$recursive` is false, only the root expands will be extracted.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/ArrayableTrait.php";}s:10:"$recursive";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$recursive";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"true";s:19:"isPassedByReference";b:0;s:11:"description";s:71:"Whether to recursively return array representation of embedded objects.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/ArrayableTrait.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:38:"The array representation of the object";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:213838;s:4:"name";s:7:"toArray";s:8:"fullName";s:32:"yii\base\ArrayableTrait::toArray";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/ArrayableTrait.php";s:9:"startLine";i:122;s:7:"endLine";i:157;s:16:"shortDescription";s:33:"Converts the model into an array.";s:11:"description";s:545:"This method will first identify which fields to be included in the resulting array by calling [[resolveFields()]].
It will then turn the model into an array with these fields. If `$recursive` is true,
any embedded objects will also be converted into arrays.
When embedded objects are [[Arrayable]], their respective nested fields will be extracted and passed to [[toArray()]].

If the model implements the [[Linkable]] interface, the resulting array will also have a `_link` element
which refers to a list of links as specified by the interface.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"extractRootFields";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:23:"yii\base\ArrayableTrait";s:10:"sourceCode";s:270:"protected function extractRootFields(array $fields)
{
    $result = [];
    foreach ($fields as $field) {
        $result[] = current(explode('.', $field, 2));
    }
    if (in_array('*', $result, true)) {
        $result = [];
    }
    return array_unique($result);
}
";s:6:"params";a:1:{s:7:"$fields";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$fields";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:35:"The fields requested for extraction";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/ArrayableTrait.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:50:"Root fields extracted from the given nested fields";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:213838;s:4:"name";s:17:"extractRootFields";s:8:"fullName";s:42:"yii\base\ArrayableTrait::extractRootFields";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/ArrayableTrait.php";s:9:"startLine";i:168;s:7:"endLine";i:181;s:16:"shortDescription";s:49:"Extracts the root field names from nested fields.";s:11:"description";s:100:"Nested fields are separated with dots (.). e.g: "item.id"
The previous example would extract "item".";s:5:"since";s:6:"2.0.14";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"extractFieldsFor";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:23:"yii\base\ArrayableTrait";s:10:"sourceCode";s:317:"protected function extractFieldsFor(array $fields, $rootField)
{
    $result = [];
    foreach ($fields as $field) {
        if (0 === strpos($field, "{$rootField}.")) {
            $result[] = preg_replace('/^' . preg_quote($rootField, '/') . '\./i', '', $field);
        }
    }
    return array_unique($result);
}
