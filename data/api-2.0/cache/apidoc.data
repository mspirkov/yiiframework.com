";s:6:"params";a:1:{s:10:"$tableName";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$tableName";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/sqlite/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:201941;s:4:"name";s:19:"loadTablePrimaryKey";s:8:"fullName";s:41:"yii\db\sqlite\Schema::loadTablePrimaryKey";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/sqlite/Schema.php";s:9:"startLine";i:115;s:7:"endLine";i:118;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:20:"loadTableForeignKeys";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:20:"yii\db\sqlite\Schema";s:10:"sourceCode";s:941:"protected function loadTableForeignKeys($tableName)
{
    $foreignKeys = $this->db->createCommand('PRAGMA FOREIGN_KEY_LIST (' . $this->quoteValue($tableName) . ')')->queryAll();
    $foreignKeys = $this->normalizePdoRowKeyCase($foreignKeys, true);
    $foreignKeys = ArrayHelper::index($foreignKeys, null, 'table');
    ArrayHelper::multisort($foreignKeys, 'seq', SORT_ASC, SORT_NUMERIC);
    $result = [];
    foreach ($foreignKeys as $table => $foreignKey) {
        $result[] = new ForeignKeyConstraint([
            'columnNames' => ArrayHelper::getColumn($foreignKey, 'from'),
            'foreignTableName' => $table,
            'foreignColumnNames' => ArrayHelper::getColumn($foreignKey, 'to'),
            'onDelete' => isset($foreignKey[0]['on_delete']) ? $foreignKey[0]['on_delete'] : null,
            'onUpdate' => isset($foreignKey[0]['on_update']) ? $foreignKey[0]['on_update'] : null,
        ]);
    }
    return $result;
}
