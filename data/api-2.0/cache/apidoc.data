{
    $path = Yii::getAlias($this->fileTransportPath);
    if (!is_dir($path)) {
        mkdir($path, 0777, true);
    }
    if ($this->fileTransportCallback !== null) {
        $file = $path . '/' . call_user_func($this->fileTransportCallback, $this, $message);
    } else {
        $file = $path . '/' . $this->generateMessageFileName();
    }
    file_put_contents($file, $message->toString());
    return true;
}
";s:6:"params";a:1:{s:8:"$message";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$message";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:26:"\yii\mail\MessageInterface";s:5:"types";a:1:{i:0;s:26:"\yii\mail\MessageInterface";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mail/BaseMailer.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:41:"Whether the message is saved successfully";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:15039;s:4:"name";s:11:"saveMessage";s:8:"fullName";s:32:"yii\mail\BaseMailer::saveMessage";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mail/BaseMailer.php";s:9:"startLine";i:323;s:7:"endLine";i:337;s:16:"shortDescription";s:56:"Saves the message as a file under [[fileTransportPath]].";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:23:"generateMessageFileName";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\mail\BaseMailer";s:10:"sourceCode";s:251:"public function generateMessageFileName()
{
    $time = microtime(true);
    $timeInt = (int) $time;
    return date('Ymd-His-', $timeInt) . sprintf('%04d', (int) (($time - $timeInt) * 10000)) . '-' . sprintf('%04d', random_int(0, 10000)) . '.eml';
}
