rmatter";s:5:"value";s:8:"'length'";s:13:"phpDocContext";r:2299;s:4:"name";s:11:"UNIT_LENGTH";s:8:"fullName";s:31:"yii\i18n\Formatter::UNIT_LENGTH";s:10:"sourceFile";N;s:9:"startLine";i:75;s:7:"endLine";i:75;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.13";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"UNIT_WEIGHT";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:18:"yii\i18n\Formatter";s:5:"value";s:6:"'mass'";s:13:"phpDocContext";r:2299;s:4:"name";s:11:"UNIT_WEIGHT";s:8:"fullName";s:31:"yii\i18n\Formatter::UNIT_WEIGHT";s:10:"sourceFile";N;s:9:"startLine";i:79;s:7:"endLine";i:79;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.13";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:7:"authors";a:3:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";s:13:"Enrica Ruedin";s:20:"e.ruedin@guggach.com";s:14:"Carsten Brandt";s:12:"mail@cebe.cc";}s:7:"methods";a:40:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\i18n\Formatter";s:10:"sourceCode";s:916:"public function init()
{
    if ($this->timeZone === null) {
        $this->timeZone = Yii::$app->timeZone;
    }
    if ($this->locale === null) {
        $this->locale = Yii::$app->language;
    }
    if ($this->language === null) {
        $this->language = strtok($this->locale, '@');
    }
    if ($this->booleanFormat === null) {
        $this->booleanFormat = [Yii::t('yii', 'No', [], $this->language), Yii::t('yii', 'Yes', [], $this->language)];
    }
    if ($this->nullDisplay === null) {
        $this->nullDisplay = '<span class="not-set">' . Yii::t('yii', '(not set)', [], $this->language) . '</span>';
    }
    $this->_intlLoaded = extension_loaded('intl');
    if (!$this->_intlLoaded) {
        if ($this->decimalSeparator === null) {
            $this->decimalSeparator = '.';
        }
        if ($this->thousandSeparator === null) {
            $this->thousandSeparator = ',';
        }
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:2299;s:4:"name";s:4:"init";s:8:"fullName";s:24:"yii\i18n\Formatter::init";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";s:9:"startLine";i:396;s:7:"endLine";i:422;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:6:"format";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\i18n\Formatter";s:10:"sourceCode";s:677:"public function format($value, $format)
{
    if ($format instanceof Closure) {
        return $format($value, $this);
    }
    if (is_array($format)) {
        if (!isset($format[0])) {
            throw new InvalidArgumentException('The $format array must contain at least one element.');
        }
        $f = $format[0];
        $format[0] = $value;
        $params = $format;
        $format = $f;
    } else {
        $params = [$value];
    }
    $method = 'as' . $format;
    if ($this->hasMethod($method)) {
        return call_user_func_array([$this, $method], array_values($params));
    }
    throw new InvalidArgumentException("Unknown format type: $format");
}
";s:6:"params";a:2:{s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:26:"The value to be formatted.";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";}s:7:"$format";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$format";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:750:"The format of the value, e.g., "html", "text" or an anonymous function
returning the formatted value.

To specify additional parameters of the formatting method, you may use an array.
The first element of the array specifies the format name, while the rest of the elements will be used as the
parameters to the formatting method. For example, a format of `['date', 'Y-m-d']` will cause the invocation
of `asDate($value, 'Y-m-d')`.

The anonymous function signature should be: `function($value, $formatter)`,
where `$value` is the value that should be formatted and `$formatter` is an instance of the Formatter class,
which can be used to call other formatting functions.
The possibility to use an anonymous function is available since version 2.0.13.";s:4:"type";s:21:"string|array|\Closure";s:5:"types";a:3:{i:0;s:6:"string";i:1;s:5:"array";i:2;s:8:"\Closure";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";}}s:10:"exceptions";a:1:{s:34:"\yii\base\InvalidArgumentException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:50:"if the format type is not supported by this class.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:22:"The formatting result.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:2299;s:4:"name";s:6:"format";s:8:"fullName";s:26:"yii\i18n\Formatter::format";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";s:9:"startLine";i:445;s:7:"endLine";i:467;s:16:"shortDescription";s:49:"Formats the value based on the given format type.";s:11:"description";s:245:"This method will call one of the "as" methods available in this class to do the formatting.
For type "xyz", the method "asXyz" will be used. For example, if the format is "html",
then [[asHtml()]] will be used. Format names are case insensitive.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:5:"asRaw";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\i18n\Formatter";s:10:"sourceCode";s:121:"public function asRaw($value)
{
    if ($value === null) {
        return $this->nullDisplay;
    }
    return $value;
}
