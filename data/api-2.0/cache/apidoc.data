askToken($token)
{
    // The number of bytes in a mask is always equal to the number of bytes in a token.
    $mask = $this->generateRandomKey(StringHelper::byteLength($token));
    return StringHelper::base64UrlEncode($mask . ($mask ^ $token));
}
";s:6:"params";a:1:{s:6:"$token";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$token";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:18:"An unmasked token.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Security.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:15:"A masked token.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:81732;s:4:"name";s:9:"maskToken";s:8:"fullName";s:28:"yii\base\Security::maskToken";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Security.php";s:9:"startLine";i:669;s:7:"endLine";i:674;s:16:"shortDescription";s:40:"Masks a token to make it uncompressible.";s:11:"description";s:194:"Applies a random mask to the token and prepends the mask used to the result making the string always unique.
Used to mitigate BREACH attack by randomizing how token is outputted on each request.";s:5:"since";s:6:"2.0.12";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"unmaskToken";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\base\Security";s:10:"sourceCode";s:380:"public function unmaskToken($maskedToken)
{
    $decoded = StringHelper::base64UrlDecode($maskedToken);
    $length = StringHelper::byteLength($decoded) / 2;
    // Check if the masked token has an even length.
    if (!is_int($length)) {
        return '';
    }
    return StringHelper::byteSubstr($decoded, $length, $length) ^ StringHelper::byteSubstr($decoded, 0, $length);
}
