complex data structure that will be handled by a [[Target|log target]].";s:4:"type";s:23:"string|array|\Throwable";s:5:"types";a:3:{i:0;s:6:"string";i:1;s:5:"array";i:2;s:10:"\Throwable";}s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/Logger.php";}s:6:"$level";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$level";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:238:"The level of the message. This must be one of the following:
`Logger::LEVEL_ERROR`, `Logger::LEVEL_WARNING`, `Logger::LEVEL_INFO`, `Logger::LEVEL_TRACE`, `Logger::LEVEL_PROFILE`,
`Logger::LEVEL_PROFILE_BEGIN`, `Logger::LEVEL_PROFILE_END`.";s:4:"type";s:3:"int";s:5:"types";a:1:{i:0;s:3:"int";}s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/Logger.php";}s:9:"$category";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$category";s:10:"isOptional";b:1;s:12:"defaultValue";s:13:"'application'";s:19:"isPassedByReference";b:0;s:11:"description";s:28:"The category of the message.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/Logger.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:65202;s:4:"name";s:3:"log";s:8:"fullName";s:19:"yii\log\Logger::log";s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/Logger.php";s:9:"startLine";i:154;s:7:"endLine";i:182;s:16:"shortDescription";s:48:"Logs a message with the given type and category.";s:11:"description";s:121:"If [[traceLevel]] is greater than 0, additional call stack information about
the application code will be logged as well.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:5:"flush";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:14:"yii\log\Logger";s:10:"sourceCode";s:1474:"public function flush($final = false)
{
    if ($this->profilingAware) {
        $keep = [];
        $messages = [];
        foreach ($this->messages as $index => $message) {
            if (is_int($index)) {
                $messages[] = $message;
            } else {
                if (strncmp($index, 'begin-', 6) === 0) {
                    $oppositeProfile = 'end-' . substr($index, 6);
                } else {
                    $oppositeProfile = 'begin-' . substr($index, 4);
                }
                if (array_key_exists($oppositeProfile, $this->messages)) {
                    $messages[] = $message;
                } else {
                    $keep[$index] = $message;
                }
            }
        }
        if ($this->flushInterval > 0 && count($keep) >= $this->flushInterval) {
            $this->messages = [];
            $this->log(
                'Number of dangling profiling block messages reached flushInterval value and therefore these were flushed. Please consider setting higher flushInterval value or making profiling blocks shorter.',
                self::LEVEL_WARNING
            );
            $messages = array_merge($messages, array_values($keep));
        } else {
            $this->messages = $keep;
        }
    } else {
        $messages = $this->messages;
        $this->messages = [];
    }
    if ($this->dispatcher instanceof Dispatcher) {
        $this->dispatcher->dispatch($messages, $final);
    }
}
