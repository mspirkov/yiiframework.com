After using this command, developers should modify the created migration
skeleton by filling up the actual migration logic.

```
yii migrate/create create_user_table
```

In order to generate a namespaced migration, you should specify a namespace before the migration's name.
Note that backslash (`\`) is usually considered a special character in the shell, so you need to escape it
properly to avoid shell errors or incorrect behavior.
For example:

```
yii migrate/create app\\migrations\\createUserTable
```

In case [[migrationPath]] is not set and no namespace is provided, the first entry of [[migrationNamespaces]] will be used.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"migrateUp";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:45:"yii\console\controllers\BaseMigrateController";s:10:"sourceCode";s:679:"protected function migrateUp($class)
{
    if ($class === self::BASE_MIGRATION) {
        return true;
    }
    $this->stdout("*** applying $class\n", Console::FG_YELLOW);
    $start = microtime(true);
    $migration = $this->createMigration($class);
    if ($migration->up() !== false) {
        $this->addMigrationHistory($class);
        $time = microtime(true) - $start;
        $this->stdout("*** applied $class (time: " . sprintf('%.3f', $time) . "s)\n\n", Console::FG_GREEN);
        return true;
    }
    $time = microtime(true) - $start;
    $this->stdout("*** failed to apply $class (time: " . sprintf('%.3f', $time) . "s)\n\n", Console::FG_RED);
    return false;
}
";s:6:"params";a:1:{s:6:"$class";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$class";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:24:"The migration class name";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:120:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/BaseMigrateController.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:35:"Whether the migration is successful";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:37103;s:4:"name";s:9:"migrateUp";s:8:"fullName";s:56:"yii\console\controllers\BaseMigrateController::migrateUp";s:10:"sourceFile";s:120:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/BaseMigrateController.php";s:9:"startLine";i:757;s:7:"endLine";i:778;s:16:"shortDescription";s:44:"Upgrades with the specified migration class.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"migrateDown";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:45:"yii\console\controllers\BaseMigrateController";s:10:"sourceCode";s:689:"protected function migrateDown($class)
{
    if ($class === self::BASE_MIGRATION) {
        return true;
    }
    $this->stdout("*** reverting $class\n", Console::FG_YELLOW);
    $start = microtime(true);
    $migration = $this->createMigration($class);
    if ($migration->down() !== false) {
        $this->removeMigrationHistory($class);
        $time = microtime(true) - $start;
        $this->stdout("*** reverted $class (time: " . sprintf('%.3f', $time) . "s)\n\n", Console::FG_GREEN);
        return true;
    }
    $time = microtime(true) - $start;
    $this->stdout("*** failed to revert $class (time: " . sprintf('%.3f', $time) . "s)\n\n", Console::FG_RED);
    return false;
}
";s:6:"params";a:1:{s:6:"$class";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$class";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:24:"The migration class name";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:120:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/BaseMigrateController.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:35:"Whether the migration is successful";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:37103;s:4:"name";s:11:"migrateDown";s:8:"fullName";s:58:"yii\console\controllers\BaseMigrateController::migrateDown";s:10:"sourceFile";s:120:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/BaseMigrateController.php";s:9:"startLine";i:785;s:7:"endLine";i:806;s:16:"shortDescription";s:46:"Downgrades with the specified migration class.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:15:"createMigration";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:45:"yii\console\controllers\BaseMigrateController";s:10:"sourceCode";s:338:"protected function createMigration($class)
{
    $this->includeMigrationFile($class);
    /** @var MigrationInterface $migration */
    $migration = Yii::createObject($class);
    if ($migration instanceof BaseObject && $migration->canSetProperty('compact')) {
        $migration->compact = $this->compact;
    }
    return $migration;
}
