";s:6:"params";a:1:{s:9:"$viewName";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$viewName";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:35:"The name of the view to be dropped.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Command.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:26:"The command object itself.";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:184737;s:4:"name";s:8:"dropView";s:8:"fullName";s:24:"yii\db\Command::dropView";s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Command.php";s:9:"startLine";i:1092;s:7:"endLine";i:1097;s:16:"shortDescription";s:17:"Drops a SQL View.";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.14";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:7:"execute";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:14:"yii\db\Command";s:10:"sourceCode";s:575:"public function execute()
{
    $sql = $this->getSql();
    list($profile, $rawSql) = $this->logQuery(__METHOD__);
    if ($sql == '') {
        return 0;
    }
    $this->prepare(false);
    try {
        $profile and Yii::beginProfile($rawSql, __METHOD__);
        $this->internalExecute($rawSql);
        $n = $this->pdoStatement->rowCount();
        $profile and Yii::endProfile($rawSql, __METHOD__);
        $this->refreshTableSchema();
        return $n;
    } catch (Exception $e) {
        $profile and Yii::endProfile($rawSql, __METHOD__);
        throw $e;
    }
}
