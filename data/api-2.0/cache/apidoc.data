{
    return str_replace(
        ['"', "\n", "\t", "\r"],
        ['\\"', '\\n', '\\t', '\\r'],
        $string
    );
}
";s:6:"params";a:1:{s:7:"$string";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$string";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:21:"Message to be encoded";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/GettextPoFile.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:19:"The encoded message";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:6749;s:4:"name";s:6:"encode";s:8:"fullName";s:30:"yii\i18n\GettextPoFile::encode";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/GettextPoFile.php";s:9:"startLine";i:89;s:7:"endLine";i:96;s:16:"shortDescription";s:40:"Encodes special characters in a message.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"decode";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:22:"yii\i18n\GettextPoFile";s:10:"sourceCode";s:234:"protected function decode($string)
{
    $string = preg_replace(
        ['/"\s+"/', '/\\\\n/', '/\\\\r/', '/\\\\t/', '/\\\\"/'],
        ['', "\n", "\r", "\t", '"'],
        $string
    );
    return substr(rtrim($string), 1, -1);
}
