6:"␀phpDocumentor\Reflection\Fqsen␀name";s:18:"generateUniqueSlug";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:12:"validateSlug";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:31:"yii\behaviors\SluggableBehavior";s:10:"sourceCode";s:489:"protected function validateSlug($slug)
{
    /** @var UniqueValidator $validator */
    $validator = Yii::createObject(array_merge(
        [
            'class' => UniqueValidator::className(),
        ],
        $this->uniqueValidator
    ));
    /** @var BaseActiveRecord $model */
    $model = clone $this->owner;
    $model->clearErrors();
    $model->{$this->slugAttribute} = $slug;
    $validator->validateAttribute($model, $this->slugAttribute);
    return !$model->hasErrors();
}
