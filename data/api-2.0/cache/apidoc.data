The data will be exposed by ArrayAccessTrait to support accessing the class object like an array.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:3:{i:0;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:4:"data";s:7:"␀*␀type";O:37:"phpDocumentor\Reflection\Types\Array_":3:{s:12:"␀*␀valueType";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:10:"␀*␀keyType";N;s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:213772;}i:3;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:16:"phpstan-property";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:29:"array<array-key, mixed> $data";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:4;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:14:"psalm-property";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:29:"array<array-key, mixed> $data";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:23:"yii\base\ArrayableTrait";O:26:"yii\apidoc\models\TraitDoc":20:{s:6:"usedBy";a:0:{}s:6:"traits";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:6:{s:6:"fields";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\base\ArrayableTrait";s:10:"sourceCode";s:126:"public function fields()
