es\Context␀namespace";s:23:"yii\db\mssql\conditions";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:2:{s:21:"NotSupportedException";s:30:"yii\base\NotSupportedException";s:10:"Expression";s:17:"yii\db\Expression";}}s:4:"name";s:24:"buildSubqueryInCondition";s:8:"fullName";s:68:"yii\db\mssql\conditions\InConditionBuilder::buildSubqueryInCondition";s:10:"sourceFile";s:117:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/conditions/InConditionBuilder.php";s:9:"startLine";i:25;s:7:"endLine";i:32;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:1;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:25:"buildCompositeInCondition";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:42:"yii\db\mssql\conditions\InConditionBuilder";s:10:"sourceCode";s:1133:"protected function buildCompositeInCondition($operator, $columns, $values, &$params)
{
    $quotedColumns = [];
    foreach ($columns as $i => $column) {
        if ($column instanceof Expression) {
            $column = $column->expression;
        }
        $quotedColumns[$i] = strpos($column, '(') === false ? $this->queryBuilder->db->quoteColumnName($column) : $column;
    }
    $vss = [];
    foreach ($values as $value) {
        $vs = [];
        foreach ($columns as $i => $column) {
            if ($column instanceof Expression) {
                $column = $column->expression;
            }
            if (isset($value[$column])) {
                $phName = $this->queryBuilder->bindParam($value[$column], $params);
                $vs[] = $quotedColumns[$i] . ($operator === 'IN' ? ' = ' : ' != ') . $phName;
            } else {
                $vs[] = $quotedColumns[$i] . ($operator === 'IN' ? ' IS' : ' IS NOT') . ' NULL';
            }
        }
        $vss[] = '(' . implode($operator === 'IN' ? ' AND ' : ' OR ', $vs) . ')';
    }
    return '(' . implode($operator === 'IN' ? ' OR ' : ' AND ', $vss) . ')';
}
