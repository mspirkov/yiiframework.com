Nested fields are separated with dots (.). e.g: "item.id"
The previous example would extract "id".";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.14";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"resolveFields";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:23:"yii\base\ArrayableTrait";s:10:"sourceCode";s:756:"protected function resolveFields(array $fields, array $expand)
{
    $fields = $this->extractRootFields($fields);
    $expand = $this->extractRootFields($expand);
    $result = [];
    foreach ($this->fields() as $field => $definition) {
        if (is_int($field)) {
            $field = $definition;
        }
        if (empty($fields) || in_array($field, $fields, true)) {
            $result[$field] = $definition;
        }
    }
    if (empty($expand)) {
        return $result;
    }
    foreach ($this->extraFields() as $field => $definition) {
        if (is_int($field)) {
            $field = $definition;
        }
        if (in_array($field, $expand, true)) {
            $result[$field] = $definition;
        }
    }
    return $result;
}
