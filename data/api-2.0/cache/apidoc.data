separate them with commas or use an array to represent them. Each column name will be properly quoted
by the method, unless a parenthesis is found in the name.";s:4:"type";s:12:"string|array";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:5:"array";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/QueryBuilder.php";}s:7:"$unique";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$unique";s:10:"isOptional";b:1;s:12:"defaultValue";s:5:"false";s:19:"isPassedByReference";b:0;s:11:"description";s:313:"Whether to make this a UNIQUE index constraint. You can pass `true` or [[INDEX_UNIQUE]] to create
a unique index, `false` to make a non-unique index using the default index type, or one of the following constants to specify
the index method to use: [[INDEX_B_TREE]], [[INDEX_HASH]], [[INDEX_GIST]], [[INDEX_GIN]].";s:4:"type";s:11:"bool|string";s:5:"types";a:2:{i:0;s:4:"bool";i:1;s:6:"string";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/QueryBuilder.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:43:"The SQL statement for creating a new index.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:195066;s:4:"name";s:11:"createIndex";s:8:"fullName";s:38:"yii\db\pgsql\QueryBuilder::createIndex";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/QueryBuilder.php";s:9:"startLine";i:117;s:7:"endLine";i:132;s:16:"shortDescription";s:48:"Builds a SQL statement for creating a new index.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:5;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:56:"https://www.postgresql.org/docs/8.2/sql-createindex.html";}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:9:"dropIndex";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\db\pgsql\QueryBuilder";s:10:"sourceCode";s:674:"public function dropIndex($name, $table)
{
    if (strpos($table, '.') !== false && strpos($name, '.') === false) {
        if (strpos($table, '{{') !== false) {
            $table = preg_replace('/\\{\\{(.*?)\\}\\}/', '\1', $table);
            list($schema, $table) = explode('.', $table);
            if (strpos($schema, '%') === false) {
                $name = $schema . '.' . $name;
            } else {
                $name = '{{' . $schema . '.' . $name . '}}';
            }
        } else {
            list($schema) = explode('.', $table);
            $name = $schema . '.' . $name;
        }
    }
    return 'DROP INDEX ' . $this->db->quoteTableName($name);
}
