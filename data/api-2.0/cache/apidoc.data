in order for the array to be treated as indexed.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:28:"Whether the array is indexed";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:54807;s:4:"name";s:9:"isIndexed";s:8:"fullName";s:38:"yii\helpers\BaseArrayHelper::isIndexed";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";s:9:"startLine";i:832;s:7:"endLine";i:855;s:16:"shortDescription";s:71:"Returns a value indicating whether the given array is an indexed array.";s:11:"description";s:198:"An array is indexed if all its keys are integers. If `$consecutive` is true,
then the array keys must be a consecutive sequence starting from 0.

Note that an empty array will be considered indexed.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:4:"isIn";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\helpers\BaseArrayHelper";s:10:"sourceCode";s:478:"public static function isIn($needle, $haystack, $strict = false)
{
    if (!static::isTraversable($haystack)) {
        throw new InvalidArgumentException('Argument $haystack must be an array or implement Traversable');
    }
    if (is_array($haystack)) {
        return in_array($needle, $haystack, $strict);
    }
    foreach ($haystack as $value) {
        if ($strict ? $needle === $value : $needle == $value) {
            return true;
        }
    }
    return false;
}
