";s:17:"CONTENT_TYPE_JSON";s:8:"fullName";s:48:"yii\web\JsonResponseFormatter::CONTENT_TYPE_JSON";s:10:"sourceFile";N;s:9:"startLine";i:50;s:7:"endLine";i:50;s:16:"shortDescription";s:18:"JSONP Content Type";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.14";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:21:"CONTENT_TYPE_HAL_JSON";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:29:"yii\web\JsonResponseFormatter";s:5:"value";s:37:"'application/hal+json; charset=UTF-8'";s:13:"phpDocContext";r:95618;s:4:"name";s:21:"CONTENT_TYPE_HAL_JSON";s:8:"fullName";s:52:"yii\web\JsonResponseFormatter::CONTENT_TYPE_HAL_JSON";s:10:"sourceFile";N;s:9:"startLine";i:55;s:7:"endLine";i:55;s:16:"shortDescription";s:21:"HAL JSON Content Type";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.14";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:3:{s:6:"format";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:29:"yii\web\JsonResponseFormatter";s:10:"sourceCode";s:513:"public function format($response)
{
    if ($this->contentType === null) {
        $this->contentType = $this->useJsonp
            ? self::CONTENT_TYPE_JSONP
            : self::CONTENT_TYPE_JSON;
    } elseif (strpos($this->contentType, 'charset') === false) {
        $this->contentType .= '; charset=UTF-8';
    }
    $response->getHeaders()->set('Content-Type', $this->contentType);
    if ($this->useJsonp) {
        $this->formatJsonp($response);
    } else {
        $this->formatJson($response);
    }
}
";s:6:"params";a:1:{s:9:"$response";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$response";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:29:"The response to be formatted.";s:4:"type";s:17:"\yii\web\Response";s:5:"types";a:1:{i:0;s:17:"\yii\web\Response";}s:10:"sourceFile";s:104:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/JsonResponseFormatter.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:95618;s:4:"name";s:6:"format";s:8:"fullName";s:37:"yii\web\JsonResponseFormatter::format";s:10:"sourceFile";s:104:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/JsonResponseFormatter.php";s:9:"startLine";i:98;s:7:"endLine";i:114;s:16:"shortDescription";s:31:"Formats the specified response.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:10:"formatJson";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:29:"yii\web\JsonResponseFormatter";s:10:"sourceCode";s:633:"protected function formatJson($response)
{
    if ($response->data !== null) {
        $options = $this->encodeOptions;
        if ($this->prettyPrint) {
            $options |= JSON_PRETTY_PRINT;
        }
        $default = Json::$keepObjectType;
        if ($this->keepObjectType !== null) {
            Json::$keepObjectType = $this->keepObjectType;
        }
        $response->content = Json::encode($response->data, $options);
        // Restore default value to avoid any unexpected behaviour
        Json::$keepObjectType = $default;
    } elseif ($response->content === null) {
        $response->content = 'null';
    }
}
";s:6:"params";a:1:{s:9:"$response";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$response";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:17:"\yii\web\Response";s:5:"types";a:1:{i:0;s:17:"\yii\web\Response";}s:10:"sourceFile";s:104:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/JsonResponseFormatter.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:95618;s:4:"name";s:10:"formatJson";s:8:"fullName";s:41:"yii\web\JsonResponseFormatter::formatJson";s:10:"sourceFile";s:104:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/JsonResponseFormatter.php";s:9:"startLine";i:120;s:7:"endLine";i:140;s:16:"shortDescription";s:37:"Formats response data in JSON format.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"formatJsonp";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:29:"yii\web\JsonResponseFormatter";s:10:"sourceCode";s:594:"protected function formatJsonp($response)
{
    if (
        is_array($response->data)
        && isset($response->data['data'], $response->data['callback'])
    ) {
        $response->content = sprintf(
            '%s(%s);',
            $response->data['callback'],
            Json::htmlEncode($response->data['data'])
        );
    } elseif ($response->data !== null) {
        $response->content = '';
        Yii::warning(
            "The 'jsonp' response requires that the data be an array consisting of both 'data' and 'callback' elements.",
            __METHOD__
        );
    }
}
