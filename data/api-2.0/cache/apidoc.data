When this method is used to validate multiple models, this parameter will be interpreted
as a model.";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveForm.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:53:"The error message array indexed by the attribute IDs.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:21287;s:4:"name";s:8:"validate";s:8:"fullName";s:32:"yii\widgets\ActiveForm::validate";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveForm.php";s:9:"startLine";i:410;s:7:"endLine";i:429;s:16:"shortDescription";s:96:"Validates one or several models and returns an error message array indexed by the attribute IDs.";s:11:"description";s:591:"This is a helper method that simplifies the way of writing AJAX validation code.

For example, you may use the following code in a controller action to respond
to an AJAX validation request:

```
$model = new Post;
$model->load(Yii::$app->request->post());
if (Yii::$app->request->isAjax) {
    Yii::$app->response->format = Response::FORMAT_JSON;
    return ActiveForm::validate($model);
}
// ... respond to non-AJAX request ...
```

To validate multiple models, simply pass each model as a parameter to this method, like
the following:

```
ActiveForm::validate($model1, $model2, ...);
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:3;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:14:"phpstan-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:27:"array<string,array<string>>";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:4;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:12:"psalm-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:27:"array<string,array<string>>";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:16:"validateMultiple";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:22:"yii\widgets\ActiveForm";s:10:"sourceCode";s:378:"public static function validateMultiple($models, $attributes = null)
{
    $result = [];
    /** @var Model $model */
    foreach ($models as $i => $model) {
        $model->validate($attributes);
        foreach ($model->getErrors() as $attribute => $errors) {
            $result[Html::getInputId($model, "[$i]" . $attribute)] = $errors;
        }
    }
    return $result;
}
