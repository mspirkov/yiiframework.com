";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:54:"The IPv4 or IPv6 ranges that are allowed or forbidden.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:138712;s:4:"name";s:9:"getRanges";s:8:"fullName";s:37:"yii\validators\IpValidator::getRanges";s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/IpValidator.php";s:9:"startLine";i:278;s:7:"endLine";i:281;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"validateValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:26:"yii\validators\IpValidator";s:10:"sourceCode";s:261:"protected function validateValue($value)
{
    $result = $this->validateSubnet($value);
    if (is_array($result)) {
        $result[1] = array_merge(['ip' => is_array($value) ? 'array()' : $value], $result[1]);
        return $result;
    }
    return null;
}
";s:6:"params";a:1:{s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/IpValidator.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:138712;s:4:"name";s:13:"validateValue";s:8:"fullName";s:41:"yii\validators\IpValidator::validateValue";s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/IpValidator.php";s:9:"startLine";i:286;s:7:"endLine";i:295;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:17:"validateAttribute";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:26:"yii\validators\IpValidator";s:10:"sourceCode";s:386:"public function validateAttribute($model, $attribute)
{
    $value = $model->$attribute;
    $result = $this->validateSubnet($value);
    if (is_array($result)) {
        $result[1] = array_merge(['ip' => is_array($value) ? 'array()' : $value], $result[1]);
        $this->addError($model, $attribute, $result[0], $result[1]);
    } else {
        $model->$attribute = $result;
    }
}
