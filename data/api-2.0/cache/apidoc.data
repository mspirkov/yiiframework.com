en␀name";s:20:"generateRandomString";}}s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:21:"if you need a string.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:20:"generateRandomString";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\base\Security";s:10:"sourceCode";s:424:"public function generateRandomString($length = 32)
{
    if (!is_int($length)) {
        throw new InvalidArgumentException('First parameter ($length) must be an integer');
    }
    if ($length < 1) {
        throw new InvalidArgumentException('First parameter ($length) must be greater than 0');
    }
    $bytes = $this->generateRandomKey($length);
    return substr(StringHelper::base64UrlEncode($bytes), 0, $length);
}
";s:6:"params";a:1:{s:7:"$length";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$length";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"32";s:19:"isPassedByReference";b:0;s:11:"description";s:35:"The length of the key in characters";s:4:"type";s:3:"int";s:5:"types";a:1:{i:0;s:3:"int";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Security.php";}}s:10:"exceptions";a:1:{s:19:"\yii\base\Exception";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:11:"on failure.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:24:"The generated random key";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:81732;s:4:"name";s:20:"generateRandomString";s:8:"fullName";s:39:"yii\base\Security::generateRandomString";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Security.php";s:9:"startLine";i:496;s:7:"endLine";i:508;s:16:"shortDescription";s:46:"Generates a random string of specified length.";s:11:"description";s:79:"The string generated matches [A-Za-z0-9_-]+ and is transparent to URL-encoding.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:20:"generatePasswordHash";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\base\Security";s:10:"sourceCode";s:615:"public function generatePasswordHash($password, $cost = null)
{
    if ($cost === null) {
        $cost = $this->passwordHashCost;
    }
    if (function_exists('password_hash')) {
        /* @noinspection PhpUndefinedConstantInspection */
        return password_hash($password, PASSWORD_DEFAULT, ['cost' => $cost]);
    }
    $salt = $this->generateSalt($cost);
    $hash = crypt($password, $salt);
    // strlen() is safe since crypt() returns only ascii
    if (!is_string($hash) || strlen($hash) !== 60) {
        throw new Exception('Unknown error occurred while generating hash.');
    }
    return $hash;
}
";s:6:"params";a:2:{s:9:"$password";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$password";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:26:"The password to be hashed.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Security.php";}s:5:"$cost";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$cost";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:412:"Cost parameter used by the Blowfish hash algorithm.
The higher the value of cost,
the longer it takes to generate the hash and to verify a password against it. Higher cost
therefore slows down a brute-force attack. For best protection against brute-force attacks,
set it to the highest value that is tolerable on production servers. The time taken to
compute the hash doubles for every increment by one of $cost.";s:4:"type";s:8:"int|null";s:5:"types";a:2:{i:0;s:3:"int";i:1;s:4:"null";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Security.php";}}s:10:"exceptions";a:1:{s:19:"\yii\base\Exception";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:44:"on bad password parameter or cost parameter.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:262:"The password hash string. When [[passwordHashStrategy]] is set to 'crypt',
the output is always 60 ASCII characters, when set to 'password_hash' the output length
might increase in future versions of PHP (https://www.php.net/manual/en/function.password-hash.php)";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:81732;s:4:"name";s:20:"generatePasswordHash";s:8:"fullName";s:39:"yii\base\Security::generatePasswordHash";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Security.php";s:9:"startLine";i:543;s:7:"endLine";i:562;s:16:"shortDescription";s:58:"Generates a secure hash from a password and a random salt.";s:11:"description";s:589:"The generated hash can be stored in database.
Later when a password needs to be validated, the hash can be fetched and passed
to [[validatePassword()]]. For example,

```
// generates the hash (usually done during user registration or when the password is changed)
$hash = Yii::$app->getSecurity()->generatePasswordHash($password);
// ...save $hash in database...

// during login, validate if the password entered is correct using $hash fetched from database
if (Yii::$app->getSecurity()->validatePassword($password, $hash)) {
    // password is good
} else {
    // password is bad
}
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:4;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:28:"\yii\base\validatePassword()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:16:"validatePassword";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:16:"validatePassword";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\base\Security";s:10:"sourceCode";s:690:"public function validatePassword($password, $hash)
{
    if (!is_string($password) || $password === '') {
        throw new InvalidArgumentException('Password must be a string and cannot be empty.');
    }
    if (
        !preg_match('/^\$2[axy]\$(\d\d)\$[\.\/0-9A-Za-z]{22}/', $hash, $matches)
        || $matches[1] < 4
        || $matches[1] > 30
    ) {
        throw new InvalidArgumentException('Hash is invalid.');
    }
    if (function_exists('password_verify')) {
        return password_verify($password, $hash);
    }
    $test = crypt($password, $hash);
    $n = strlen($test);
    if ($n !== 60) {
        return false;
    }
    return $this->compareString($test, $hash);
}
