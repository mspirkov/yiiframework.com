applying all available new migrations.";s:4:"type";s:3:"int";s:5:"types";a:1:{i:0;s:3:"int";}s:10:"sourceFile";s:120:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/BaseMigrateController.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:79:"The status of the action execution. 0 means normal, other values mean abnormal.";s:10:"returnType";s:3:"int";s:11:"returnTypes";a:1:{i:0;s:3:"int";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:37103;s:4:"name";s:8:"actionUp";s:8:"fullName";s:55:"yii\console\controllers\BaseMigrateController::actionUp";s:10:"sourceFile";s:120:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/BaseMigrateController.php";s:9:"startLine";i:189;s:7:"endLine";i:238;s:16:"shortDescription";s:52:"Upgrades the application by applying new migrations.";s:11:"description";s:115:"For example,

```
yii migrate     # apply all new migrations
yii migrate 3   # apply the first 3 new migrations
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:10:"actionDown";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:45:"yii\console\controllers\BaseMigrateController";s:10:"sourceCode";s:1563:"public function actionDown($limit = 1)
{
    if ($limit === 'all') {
        $limit = null;
    } else {
        $limit = (int) $limit;
        if ($limit < 1) {
            throw new Exception('The step argument must be greater than 0.');
        }
    }
    $migrations = $this->getMigrationHistory($limit);
    if (empty($migrations)) {
        $this->stdout("No migration has been done before.\n", Console::FG_YELLOW);
        return ExitCode::OK;
    }
    $migrations = array_keys($migrations);
    $n = count($migrations);
    $this->stdout("Total $n " . ($n === 1 ? 'migration' : 'migrations') . " to be reverted:\n", Console::FG_YELLOW);
    foreach ($migrations as $migration) {
        $this->stdout("\t$migration\n");
    }
    $this->stdout("\n");
    $reverted = 0;
    if ($this->confirm('Revert the above ' . ($n === 1 ? 'migration' : 'migrations') . '?')) {
        foreach ($migrations as $migration) {
            if (!$this->migrateDown($migration)) {
                $this->stdout("\n$reverted from $n " . ($reverted === 1 ? 'migration was' : 'migrations were') . " reverted.\n", Console::FG_RED);
                $this->stdout("\nMigration failed. The rest of the migrations are canceled.\n", Console::FG_RED);
                return ExitCode::UNSPECIFIED_ERROR;
            }
            $reverted++;
        }
        $this->stdout("\n$n " . ($n === 1 ? 'migration was' : 'migrations were') . " reverted.\n", Console::FG_GREEN);
        $this->stdout("\nMigrated down successfully.\n", Console::FG_GREEN);
    }
    return ExitCode::OK;
}
";s:6:"params";a:1:{s:6:"$limit";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$limit";s:10:"isOptional";b:1;s:12:"defaultValue";s:1:"1";s:19:"isPassedByReference";b:0;s:11:"description";s:162:"The number of migrations to be reverted. Defaults to 1,
meaning the last applied migration will be reverted. When value is "all", all migrations will be reverted.";s:4:"type";s:10:"int|string";s:5:"types";a:2:{i:0;s:3:"int";i:1;s:6:"string";}s:10:"sourceFile";s:120:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/BaseMigrateController.php";}}s:10:"exceptions";a:1:{s:22:"\yii\console\Exception";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:52:"if the number of the steps specified is less than 1.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:79:"The status of the action execution. 0 means normal, other values mean abnormal.";s:10:"returnType";s:3:"int";s:11:"returnTypes";a:1:{i:0;s:3:"int";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:37103;s:4:"name";s:10:"actionDown";s:8:"fullName";s:57:"yii\console\controllers\BaseMigrateController::actionDown";s:10:"sourceFile";s:120:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/BaseMigrateController.php";s:9:"startLine";i:257;s:7:"endLine";i:301;s:16:"shortDescription";s:55:"Downgrades the application by reverting old migrations.";s:11:"description";s:167:"For example,

```
yii migrate/down     # revert the last migration
yii migrate/down 3   # revert the last 3 migrations
yii migrate/down all # revert all migrations
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:10:"actionRedo";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:45:"yii\console\controllers\BaseMigrateController";s:10:"sourceCode";s:1669:"public function actionRedo($limit = 1)
{
    if ($limit === 'all') {
        $limit = null;
    } else {
        $limit = (int) $limit;
        if ($limit < 1) {
            throw new Exception('The step argument must be greater than 0.');
        }
    }
    $migrations = $this->getMigrationHistory($limit);
    if (empty($migrations)) {
        $this->stdout("No migration has been done before.\n", Console::FG_YELLOW);
        return ExitCode::OK;
    }
    $migrations = array_keys($migrations);
    $n = count($migrations);
    $this->stdout("Total $n " . ($n === 1 ? 'migration' : 'migrations') . " to be redone:\n", Console::FG_YELLOW);
    foreach ($migrations as $migration) {
        $this->stdout("\t$migration\n");
    }
    $this->stdout("\n");
    if ($this->confirm('Redo the above ' . ($n === 1 ? 'migration' : 'migrations') . '?')) {
        foreach ($migrations as $migration) {
            if (!$this->migrateDown($migration)) {
                $this->stdout("\nMigration failed. The rest of the migrations are canceled.\n", Console::FG_RED);
                return ExitCode::UNSPECIFIED_ERROR;
            }
        }
        foreach (array_reverse($migrations) as $migration) {
            if (!$this->migrateUp($migration)) {
                $this->stdout("\nMigration failed. The rest of the migrations are canceled.\n", Console::FG_RED);
                return ExitCode::UNSPECIFIED_ERROR;
            }
        }
        $this->stdout("\n$n " . ($n === 1 ? 'migration was' : 'migrations were') . " redone.\n", Console::FG_GREEN);
        $this->stdout("\nMigration redone successfully.\n", Console::FG_GREEN);
    }
    return ExitCode::OK;
}
