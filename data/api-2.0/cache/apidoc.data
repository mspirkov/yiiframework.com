";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:22:"Query builder instance";s:10:"returnType";s:27:"\yii\db\cubrid\QueryBuilder";s:11:"returnTypes";a:1:{i:0;s:27:"\yii\db\cubrid\QueryBuilder";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:158204;s:4:"name";s:18:"createQueryBuilder";s:8:"fullName";s:40:"yii\db\cubrid\Schema::createQueryBuilder";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/cubrid/Schema.php";s:9:"startLine";i:255;s:7:"endLine";i:258;s:16:"shortDescription";s:48:"Creates a query builder for the CUBRID database.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"loadColumnSchema";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:20:"yii\db\cubrid\Schema";s:10:"sourceCode";s:2525:"protected function loadColumnSchema($info)
{
    $column = $this->createColumnSchema();
    $column->name = $info['Field'];
    $column->allowNull = $info['Null'] === 'YES';
    $column->isPrimaryKey = false; // primary key will be set by loadTableSchema() later
    $column->autoIncrement = stripos($info['Extra'], 'auto_increment') !== false;
    $column->dbType = $info['Type'];
    $column->unsigned = strpos($column->dbType, 'unsigned') !== false;
    $column->type = self::TYPE_STRING;
    if (preg_match('/^([\w ]+)(?:\(([^\)]+)\))?$/', $column->dbType, $matches)) {
        $type = strtolower($matches[1]);
        $column->dbType = $type . (isset($matches[2]) ? "({$matches[2]})" : '');
        if (isset($this->typeMap[$type])) {
            $column->type = $this->typeMap[$type];
        }
        if (!empty($matches[2])) {
            if ($type === 'enum') {
                $values = preg_split('/\s*,\s*/', $matches[2]);
                foreach ($values as $i => $value) {
                    $values[$i] = trim($value, "'");
                }
                $column->enumValues = $values;
            } else {
                $values = explode(',', $matches[2]);
                $column->size = $column->precision = (int) $values[0];
                if (isset($values[1])) {
                    $column->scale = (int) $values[1];
                }
                if ($column->size === 1 && $type === 'bit') {
                    $column->type = 'boolean';
                } elseif ($type === 'bit') {
                    if ($column->size > 32) {
                        $column->type = 'bigint';
                    } elseif ($column->size === 32) {
                        $column->type = 'integer';
                    }
                }
            }
        }
    }
    $column->phpType = $this->getColumnPhpType($column);
    if ($column->isPrimaryKey) {
        return $column;
    }
    if (
        $column->type === 'timestamp' && $info['Default'] === 'SYS_TIMESTAMP' ||
        $column->type === 'datetime' && $info['Default'] === 'SYS_DATETIME' ||
        $column->type === 'date' && $info['Default'] === 'SYS_DATE' ||
        $column->type === 'time' && $info['Default'] === 'SYS_TIME'
    ) {
        $column->defaultValue = new Expression($info['Default']);
    } elseif (isset($type) && $type === 'bit') {
        $column->defaultValue = hexdec(trim($info['Default'], 'X\''));
    } else {
        $column->defaultValue = $column->phpTypecast($info['Default']);
    }
    return $column;
}
