{
    parent::init();
    if ($this->db->driverName !== 'mysql') {
        throw new InvalidConfigException('In order to use MysqlMutex connection must be configured to use MySQL database.');
    }
    if ($this->keyPrefix === null) {
        $this->keyPrefix = new Expression('DATABASE()');
    }
}
