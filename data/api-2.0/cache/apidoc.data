escaped or quoted.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"escapeColumnName";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:48:"yii\db\conditions\BetweenColumnsConditionBuilder";s:10:"sourceCode";s:500:"protected function escapeColumnName($columnName, &$params = [])
{
    if ($columnName instanceof Query) {
        list($sql, $params) = $this->queryBuilder->build($columnName, $params);
        return "($sql)";
    } elseif ($columnName instanceof ExpressionInterface) {
        return $this->queryBuilder->buildExpression($columnName, $params);
    } elseif (strpos($columnName, '(') === false) {
        return $this->queryBuilder->db->quoteColumnName($columnName);
    }
    return $columnName;
}
