If this is not set, the file specified by [[mimeMagicFile]] will be used.";s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseFileHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:70:"The MIME type. Null is returned if the MIME type cannot be determined.";s:10:"returnType";s:11:"string|null";s:11:"returnTypes";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:62694;s:4:"name";s:22:"getMimeTypeByExtension";s:8:"fullName";s:50:"yii\helpers\BaseFileHelper::getMimeTypeByExtension";s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseFileHelper.php";s:9:"startLine";i:196;s:7:"endLine";i:208;s:16:"shortDescription";s:75:"Determines the MIME type based on the extension name of the specified file.";s:11:"description";s:72:"This method will use a local map between extension names and MIME types.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:23:"getExtensionsByMimeType";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:26:"yii\helpers\BaseFileHelper";s:10:"sourceCode";s:431:"public static function getExtensionsByMimeType($mimeType, $magicFile = null)
{
    $aliases = static::loadMimeAliases(static::$mimeAliasesFile);
    if (isset($aliases[$mimeType])) {
        $mimeType = $aliases[$mimeType];
    }
    // Note: For backwards compatibility the "MimeTypes" file is used.
    $mimeTypes = static::loadMimeTypes($magicFile);
    return array_keys($mimeTypes, mb_strtolower($mimeType, 'UTF-8'), true);
}
