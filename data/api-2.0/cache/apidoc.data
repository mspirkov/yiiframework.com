If the [[not]] property is set true, the validator will ensure the attribute value
is NOT among the specified range.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:27:"yii\validators\UrlValidator";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:24:"yii\validators\Validator";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:5:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\validators\UrlValidator";s:10:"sourceCode";s:355:"public function init()
{
    parent::init();
    if ($this->enableIDN && !function_exists('idn_to_ascii')) {
        throw new InvalidConfigException('In order to use IDN validation intl extension must be installed and enabled.');
    }
    if ($this->message === null) {
        $this->message = Yii::t('yii', '{attribute} is not a valid URL.');
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:14:"yii\validators";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:4:{s:3:"Yii";s:3:"Yii";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:4:"Json";s:16:"yii\helpers\Json";s:12:"JsExpression";s:20:"yii\web\JsExpression";}}s:4:"name";s:4:"init";s:8:"fullName";s:33:"yii\validators\UrlValidator::init";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/UrlValidator.php";s:9:"startLine";i:55;s:7:"endLine";i:64;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:17:"validateAttribute";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\validators\UrlValidator";s:10:"sourceCode";s:387:"public function validateAttribute($model, $attribute)
{
    $value = $model->$attribute;
    $result = $this->validateValue($value);
    if (!empty($result)) {
        $this->addError($model, $attribute, $result[0], $result[1]);
    } elseif ($this->defaultScheme !== null && strpos($value, '://') === false) {
        $model->$attribute = $this->defaultScheme . '://' . $value;
    }
}
";s:6:"params";a:2:{s:6:"$model";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$model";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/UrlValidator.php";}s:10:"$attribute";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$attribute";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/UrlValidator.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:134024;s:4:"name";s:17:"validateAttribute";s:8:"fullName";s:46:"yii\validators\UrlValidator::validateAttribute";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/UrlValidator.php";s:9:"startLine";i:69;s:7:"endLine";i:78;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:13:"validateValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:27:"yii\validators\UrlValidator";s:10:"sourceCode";s:879:"protected function validateValue($value)
{
    // make sure the length is limited to avoid DOS attacks
    if (is_string($value) && strlen($value) < 2000) {
        if ($this->defaultScheme !== null && strpos($value, '://') === false) {
            $value = $this->defaultScheme . '://' . $value;
        }
        if (strpos($this->pattern, '{schemes}') !== false) {
            $pattern = str_replace('{schemes}', '(' . implode('|', $this->validSchemes) . ')', $this->pattern);
        } else {
            $pattern = $this->pattern;
        }
        if ($this->enableIDN) {
            $value = preg_replace_callback('/:\/\/([^\/]+)/', function ($matches) {
                return '://' . $this->idnToAscii($matches[1]);
            }, $value);
        }
        if (preg_match($pattern, $value)) {
            return null;
        }
    }
    return [$this->message, []];
}
";s:6:"params";a:1:{s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/UrlValidator.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:134024;s:4:"name";s:13:"validateValue";s:8:"fullName";s:42:"yii\validators\UrlValidator::validateValue";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/UrlValidator.php";s:9:"startLine";i:83;s:7:"endLine";i:109;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:23:"clientValidateAttribute";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\validators\UrlValidator";s:10:"sourceCode";s:330:"public function clientValidateAttribute($model, $attribute, $view)
{
    ValidationAsset::register($view);
    if ($this->enableIDN) {
        PunycodeAsset::register($view);
    }
    $options = $this->getClientOptions($model, $attribute);
    return 'yii.validation.url(value, messages, ' . Json::htmlEncode($options) . ');';
}
