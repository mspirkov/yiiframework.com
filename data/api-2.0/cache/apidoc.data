If true, the JS scripts registered at [[POS_READY]] and [[POS_LOAD]] positions
will be rendered at the end of the view like normal scripts.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/View.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:119100;s:4:"name";s:7:"endPage";s:8:"fullName";s:21:"yii\web\View::endPage";s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/View.php";s:9:"startLine";i:216;s:7:"endLine";i:231;s:16:"shortDescription";s:33:"Marks the ending of an HTML page.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:10:"renderAjax";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:12:"yii\web\View";s:10:"sourceCode";s:369:"public function renderAjax($view, $params = [], $context = null)
{
    $viewFile = $this->findViewFile($view, $context);
    ob_start();
    ob_implicit_flush(false);
    $this->beginPage();
    $this->head();
    $this->beginBody();
    echo $this->renderFile($viewFile, $params, $context);
    $this->endBody();
    $this->endPage(true);
    return ob_get_clean();
}
