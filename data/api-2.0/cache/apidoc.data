will be replaced with the actual HTML link for each active item.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:11:"yii\widgets";s:13:"phpDocContext";r:19673;s:4:"name";s:23:"yii\widgets\Breadcrumbs";s:8:"fullName";s:23:"yii\widgets\Breadcrumbs";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Breadcrumbs.php";s:9:"startLine";i:55;s:7:"endLine";i:181;s:16:"shortDescription";s:109:"Breadcrumbs displays a list of links indicating the position of the current page in the whole site hierarchy.";s:11:"description";s:1325:"For example, breadcrumbs like "Home / Sample Post / Edit" means the user is viewing an edit page
for the "Sample Post". He can click on "Sample Post" to view that page, or he can click on "Home"
to return to the homepage.

To use Breadcrumbs, you need to configure its [[links]] property, which specifies the links to be displayed. For example,

```
// $this is the view object currently being used
echo Breadcrumbs::widget([
    'itemTemplate' => "<li><i>{link}</i></li>\n", // template for all links
    'links' => [
        [
            'label' => 'Post Category',
            'url' => ['post-category/view', 'id' => 10],
            'template' => "<li><b>{link}</b></li>\n", // template for this link only
        ],
        ['label' => 'Sample Post', 'url' => ['post/edit', 'id' => 1]],
        'Edit',
    ],
]);
```

Because breadcrumbs usually appears in nearly every page of a website, you may consider placing it in a layout view.
You can use a view parameter (e.g. `$this->params['breadcrumbs']`) to configure the links in different
views. In the layout view, you assign this view parameter to the [[links]] property like the following:

```
// $this is the view object currently being used
echo Breadcrumbs::widget([
    'links' => isset($this->params['breadcrumbs']) ? $this->params['breadcrumbs'] : [],
]);
```";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:22:"yii\widgets\LinkSorter";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:15:"yii\base\Widget";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:3:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:22:"yii\widgets\LinkSorter";s:10:"sourceCode";s:163:"public function init()
{
    parent::init();
    if ($this->sort === null) {
        throw new InvalidConfigException('The "sort" property must be set.');
    }
}
