";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:45:"The loaded fixtures for the current test case";s:10:"returnType";s:19:"\yii\test\Fixture[]";s:11:"returnTypes";a:1:{i:0;s:19:"\yii\test\Fixture[]";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:213161;s:4:"name";s:11:"getFixtures";s:8:"fullName";s:34:"yii\test\FixtureTrait::getFixtures";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/test/FixtureTrait.php";s:9:"startLine";i:140;s:7:"endLine";i:147;s:16:"shortDescription";s:84:"Returns the fixture objects as specified in [[globalFixtures()]] and [[fixtures()]].";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:10:"getFixture";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\test\FixtureTrait";s:10:"sourceCode";s:296:"public function getFixture($name)
{
    if ($this->_fixtures === null) {
        $this->_fixtures = $this->createFixtures(array_merge($this->globalFixtures(), $this->fixtures()));
    }
    $name = ltrim($name, '\\');
    return isset($this->_fixtures[$name]) ? $this->_fixtures[$name] : null;
}
";s:6:"params";a:1:{s:5:"$name";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$name";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:104:"The fixture name. This can be either the fixture alias name, or the class name if the alias is not used.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/test/FixtureTrait.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:64:"The fixture object, or null if the named fixture does not exist.";s:10:"returnType";s:22:"\yii\test\Fixture|null";s:11:"returnTypes";a:2:{i:0;s:17:"\yii\test\Fixture";i:1;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:213161;s:4:"name";s:10:"getFixture";s:8:"fullName";s:33:"yii\test\FixtureTrait::getFixture";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/test/FixtureTrait.php";s:9:"startLine";i:154;s:7:"endLine";i:162;s:16:"shortDescription";s:26:"Returns the named fixture.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"createFixtures";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:21:"yii\test\FixtureTrait";s:10:"sourceCode";s:1935:"protected function createFixtures(array $fixtures)
{
    // normalize fixture configurations
    $config = [];  // configuration provided in test case
    $aliases = [];  // class name => alias or class name
    foreach ($fixtures as $name => $fixture) {
        if (!is_array($fixture)) {
            $class = ltrim($fixture, '\\');
            $fixtures[$name] = ['class' => $class];
            $aliases[$class] = is_int($name) ? $class : $name;
        } elseif (isset($fixture['class'])) {
            $class = ltrim($fixture['class'], '\\');
            $config[$class] = $fixture;
            $aliases[$class] = $name;
        } else {
            throw new InvalidConfigException("You must specify 'class' for the fixture '$name'.");
        }
    }
    // create fixture instances
    $instances = [];
    $stack = array_reverse($fixtures);
    while (($fixture = array_pop($stack)) !== null) {
        if ($fixture instanceof Fixture) {
            $class = get_class($fixture);
            $name = isset($aliases[$class]) ? $aliases[$class] : $class;
            unset($instances[$name]);  // unset so that the fixture is added to the last in the next line
            $instances[$name] = $fixture;
        } else {
            $class = ltrim($fixture['class'], '\\');
            $name = isset($aliases[$class]) ? $aliases[$class] : $class;
            if (!isset($instances[$name])) {
                $instances[$name] = false;
                $stack[] = $fixture = Yii::createObject($fixture);
                foreach ($fixture->depends as $dep) {
                    // need to use the configuration provided in test case
                    $stack[] = isset($config[$dep]) ? $config[$dep] : ['class' => $dep];
                }
            }
            // if the fixture is already loaded (ie. a circular dependency or if two fixtures depend on the same fixture) just skip it.
        }
    }
    return $instances;
}
";s:6:"params";a:1:{s:9:"$fixtures";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$fixtures";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:202:"The fixtures to be created. You may provide fixture names or fixture configurations.
If this parameter is not provided, the fixtures specified in [[globalFixtures()]] and [[fixtures()]] will be created.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/test/FixtureTrait.php";}}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:39:"if fixtures are not properly configured";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:29:"The created fixture instances";s:10:"returnType";s:19:"\yii\test\Fixture[]";s:11:"returnTypes";a:1:{i:0;s:19:"\yii\test\Fixture[]";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:213161;s:4:"name";s:14:"createFixtures";s:8:"fullName";s:37:"yii\test\FixtureTrait::createFixtures";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/test/FixtureTrait.php";s:9:"startLine";i:172;s:7:"endLine";i:216;s:16:"shortDescription";s:40:"Creates the specified fixture instances.";s:11:"description";s:116:"All dependent fixtures will also be created. Duplicate fixtures and circular dependencies will only be created once.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:10:"properties";a:0:{}s:9:"namespace";s:8:"yii\test";s:13:"phpDocContext";r:213161;s:4:"name";s:21:"yii\test\FixtureTrait";s:8:"fullName";s:21:"yii\test\FixtureTrait";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/test/FixtureTrait.php";s:9:"startLine";i:27;s:7:"endLine";i:217;s:16:"shortDescription";s:100:"FixtureTrait provides functionalities for loading, unloading and accessing fixtures for a test case.";s:11:"description";s:592:"By using FixtureTrait, a test class will be able to specify which fixtures to load by overriding
the [[fixtures()]] method. It can then load and unload the fixtures using [[loadFixtures()]] and [[unloadFixtures()]].
Once a fixture is loaded, it can be accessed like an object property, thanks to the PHP `__get()` magic method.
Also, if the fixture is an instance of [[ActiveFixture]], you will be able to access AR models
through the syntax `$this->fixtureName('model name')`.

For more details and usage information on FixtureTrait, see the [guide article on fixtures](guide:test-fixtures).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:28:"yii\base\StaticInstanceTrait";O:26:"yii\apidoc\models\TraitDoc":20:{s:6:"usedBy";a:0:{}s:6:"traits";a:0:{}s:7:"authors";a:1:{s:11:"Paul Klimov";s:21:"klimov.paul@gmail.com";}s:7:"methods";a:1:{s:8:"instance";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:28:"yii\base\StaticInstanceTrait";s:10:"sourceCode";s:271:"public static function instance($refresh = false)
{
    $className = get_called_class();
    if ($refresh || !isset(self::$_instances[$className])) {
        self::$_instances[$className] = Yii::createObject($className);
    }
    return self::$_instances[$className];
}
