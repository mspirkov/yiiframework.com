This exception is only thrown when in debug mode.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:81:"The newly created controller instance, or `null` if the controller ID is invalid.";s:10:"returnType";s:25:"\yii\base\Controller|null";s:11:"returnTypes";a:2:{i:0;s:20:"\yii\base\Controller";i:1;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:77136;s:4:"name";s:20:"createControllerByID";s:8:"fullName";s:37:"yii\base\Module::createControllerByID";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Module.php";s:9:"startLine";i:651;s:7:"endLine";i:682;s:16:"shortDescription";s:54:"Creates a controller based on the given controller ID.";s:11:"description";s:190:"The controller ID is relative to this module. The controller class
should be namespaced under [[controllerNamespace]].

Note that this method does not check [[modules]] or [[controllerMap]].";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:3;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:14:"phpstan-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:22:"Controller<$this>|null";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:4;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:12:"psalm-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:22:"Controller<$this>|null";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:12:"beforeAction";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\base\Module";s:10:"sourceCode";s:164:"public function beforeAction($action)
{
    $event = new ActionEvent($action);
    $this->trigger(self::EVENT_BEFORE_ACTION, $event);
    return $event->isValid;
}
