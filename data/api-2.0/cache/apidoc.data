{
    if ($value instanceof ExpressionInterface) {
        return $value;
    }
    if (in_array($expression->getType(), [Schema::TYPE_JSON, Schema::TYPE_JSONB], true)) {
        return new JsonExpression($value);
    }
    return $value;
}
