";s:6:"params";a:1:{s:10:"$attribute";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$attribute";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:18:"The attribute name";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:88:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/Sort.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:190:"Sort direction of the attribute. Can be either `SORT_ASC`
for ascending order or `SORT_DESC` for descending order. Null is returned
if the attribute is invalid or does not need to be sorted.";s:10:"returnType";s:8:"int|null";s:11:"returnTypes";a:2:{i:0;s:3:"int";i:1;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:11254;s:4:"name";s:17:"getAttributeOrder";s:8:"fullName";s:32:"yii\data\Sort::getAttributeOrder";s:10:"sourceFile";s:88:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/Sort.php";s:9:"startLine";i:357;s:7:"endLine";i:362;s:16:"shortDescription";s:77:"Returns the sort direction of the specified attribute in the current request.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:4:"link";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:13:"yii\data\Sort";s:10:"sourceCode";s:1070:"public function link($attribute, $options = [])
{
    if (($direction = $this->getAttributeOrder($attribute)) !== null) {
        $class = $direction === SORT_DESC ? 'desc' : 'asc';
        if (isset($options['class'])) {
            $options['class'] .= ' ' . $class;
        } else {
            $options['class'] = $class;
        }
    }
    $url = $this->createUrl($attribute);
    $options['data-sort'] = $this->createSortParam($attribute);
    if (isset($options['label'])) {
        $label = $options['label'];
        unset($options['label']);
    } else {
        if (isset($this->attributes[$attribute]['label'])) {
            $label = $this->attributes[$attribute]['label'];
        } elseif ($this->modelClass !== null) {
            $modelClass = $this->modelClass;
            /** @var \yii\base\Model $model */
            $model = $modelClass::instance();
            $label = $model->getAttributeLabel($attribute);
        } else {
            $label = Inflector::camel2words($attribute);
        }
    }
    return Html::a($label, $url, $options);
}
