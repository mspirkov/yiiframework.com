{
    static $comments = [
        '--' => true,
        '/*' => true,
    ];
    $length = 2;
    if (!isset($comments[$this->substring($length)])) {
        return false;
    }
    if ($this->substring($length) === '--') {
        $length = $this->indexAfter("\n") - $this->offset;
    } else {
        $length = $this->indexAfter('*/') - $this->offset;
    }
    return true;
}
