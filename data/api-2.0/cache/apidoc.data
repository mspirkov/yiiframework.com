";s:6:"params";a:2:{s:6:"$class";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$class";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:36:"The class name of the related record";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";}s:5:"$link";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$link";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:221:"The primary-foreign key constraint. The keys of the array refer to
the attributes of the record associated with the `$class` model, while the values of the
array refer to the corresponding attributes in **this** AR class.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:28:"The relational query object.";s:10:"returnType";s:28:"\yii\db\ActiveQueryInterface";s:11:"returnTypes";a:1:{i:0;s:28:"\yii\db\ActiveQueryInterface";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:170608;s:4:"name";s:7:"hasMany";s:8:"fullName";s:32:"yii\db\BaseActiveRecord::hasMany";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";s:9:"startLine";i:440;s:7:"endLine";i:443;s:16:"shortDescription";s:31:"Declares a `has-many` relation.";s:11:"description";s:806:"The declaration is returned in terms of a relational [[ActiveQuery]] instance
through which the related record can be queried and retrieved back.

A `has-many` relation means that there are multiple related records matching
the criteria set by this relation, e.g., a customer has many orders.

For example, to declare the `orders` relation for `Customer` class, we can write
the following code in the `Customer` class:

```
public function getOrders()
{
    return $this->hasMany(Order::class, ['customer_id' => 'id']);
}
```

Note that in the above, the 'customer_id' key in the `$link` parameter refers to
an attribute name in the related class `Order`, while the 'id' value refers to
an attribute name in the current AR class.

