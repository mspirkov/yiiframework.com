```
$array1 = [
    'ids' => [
        1,
    ],
    'validDomains' => [
        'example.com',
        'www.example.com',
    ],
];

$array2 = [
    'ids' => [
        2,
    ],
    'validDomains' => new \yii\helpers\ReplaceArrayValue([
        'yiiframework.com',
        'www.yiiframework.com',
    ]),
];

$result = \yii\helpers\ArrayHelper::merge($array1, $array2);
```

The result will be

```
[
    'ids' => [
        1,
        2,
    ],
    'validDomains' => [
        'yiiframework.com',
        'www.yiiframework.com',
    ],
]
```";s:5:"since";s:6:"2.0.10";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:21:"yii\helpers\VarDumper";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:25:"yii\helpers\BaseVarDumper";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:0:{}s:10:"properties";a:0:{}s:9:"namespace";s:11:"yii\helpers";s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\helpers";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:0:{}}s:4:"name";s:21:"yii\helpers\VarDumper";s:8:"fullName";s:21:"yii\helpers\VarDumper";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/VarDumper.php";s:9:"startLine";i:25;s:7:"endLine";i:27;s:16:"shortDescription";s:77:"VarDumper is intended to replace the buggy PHP function var_dump and print_r.";s:11:"description";s:262:"It can correctly identify the recursively referenced objects in a complex
