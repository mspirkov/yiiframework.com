";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:22:"Query builder instance";s:10:"returnType";s:26:"\yii\db\mysql\QueryBuilder";s:11:"returnTypes";a:1:{i:0;s:26:"\yii\db\mysql\QueryBuilder";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:189213;s:4:"name";s:18:"createQueryBuilder";s:8:"fullName";s:39:"yii\db\mysql\Schema::createQueryBuilder";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mysql/Schema.php";s:9:"startLine";i:263;s:7:"endLine";i:266;s:16:"shortDescription";s:47:"Creates a query builder for the MySQL database.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"resolveTableNames";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\db\mysql\Schema";s:10:"sourceCode";s:354:"protected function resolveTableNames($table, $name)
{
    $parts = explode('.', str_replace('`', '', $name));
    if (isset($parts[1])) {
        $table->schemaName = $parts[0];
        $table->name = $parts[1];
        $table->fullName = $table->schemaName . '.' . $table->name;
    } else {
        $table->fullName = $table->name = $parts[0];
    }
}
";s:6:"params";a:2:{s:6:"$table";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$table";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:25:"The table metadata object";s:4:"type";s:19:"\yii\db\TableSchema";s:5:"types";a:1:{i:0;s:19:"\yii\db\TableSchema";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mysql/Schema.php";}s:5:"$name";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$name";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:14:"The table name";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mysql/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:189213;s:4:"name";s:17:"resolveTableNames";s:8:"fullName";s:38:"yii\db\mysql\Schema::resolveTableNames";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mysql/Schema.php";s:9:"startLine";i:273;s:7:"endLine";i:283;s:16:"shortDescription";s:49:"Resolves the table name and schema name (if any).";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"loadColumnSchema";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\db\mysql\Schema";s:10:"sourceCode";s:2808:"protected function loadColumnSchema($info)
{
    $column = $this->createColumnSchema();
    $column->name = $info['field'];
    $column->allowNull = $info['null'] === 'YES';
    $column->isPrimaryKey = strpos($info['key'], 'PRI') !== false;
    $column->autoIncrement = stripos($info['extra'], 'auto_increment') !== false;
    $column->comment = $info['comment'];
    $column->dbType = $info['type'];
    $column->unsigned = stripos($column->dbType, 'unsigned') !== false;
    $column->type = self::TYPE_STRING;
    if (preg_match('/^(\w+)(?:\(([^\)]+)\))?/', $column->dbType, $matches)) {
        $type = strtolower($matches[1]);
        if (isset($this->typeMap[$type])) {
            $column->type = $this->typeMap[$type];
        }
        if (!empty($matches[2])) {
            if ($type === 'enum') {
                preg_match_all("/'[^']*'/", $matches[2], $values);
                foreach ($values[0] as $i => $value) {
                    $values[$i] = trim($value, "'");
                }
                $column->enumValues = $values;
            } else {
                $values = explode(',', $matches[2]);
                $column->size = $column->precision = (int) $values[0];
                if (isset($values[1])) {
                    $column->scale = (int) $values[1];
                }
                if ($column->size === 1 && $type === 'bit') {
                    $column->type = 'boolean';
                } elseif ($type === 'bit') {
                    if ($column->size > 32) {
                        $column->type = 'bigint';
                    } elseif ($column->size === 32) {
                        $column->type = 'integer';
                    }
                }
            }
        }
    }
    $column->phpType = $this->getColumnPhpType($column);
    if (!$column->isPrimaryKey) {
        /**
         * When displayed in the INFORMATION_SCHEMA.COLUMNS table, a default CURRENT TIMESTAMP is displayed
         * as CURRENT_TIMESTAMP up until MariaDB 10.2.2, and as current_timestamp() from MariaDB 10.2.3.
         *
         * See details here: https://mariadb.com/kb/en/library/now/#description
         */
        if (
            in_array($column->type, ['timestamp', 'datetime', 'date', 'time'])
            && isset($info['default'])
            && preg_match('/^current_timestamp(?:\(([0-9]*)\))?$/i', $info['default'], $matches)
        ) {
            $column->defaultValue = new Expression('CURRENT_TIMESTAMP' . (!empty($matches[1]) ? '(' . $matches[1] . ')' : ''));
        } elseif (isset($type) && $type === 'bit') {
            $column->defaultValue = bindec(trim(isset($info['default']) ? $info['default'] : '', 'b\''));
        } else {
            $column->defaultValue = $column->phpTypecast($info['default']);
        }
    }
    return $column;
}
";s:6:"params";a:1:{s:5:"$info";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$info";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:18:"Column information";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mysql/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:24:"The column schema object";s:10:"returnType";s:26:"\yii\db\mysql\ColumnSchema";s:11:"returnTypes";a:1:{i:0;s:26:"\yii\db\mysql\ColumnSchema";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:189213;s:4:"name";s:16:"loadColumnSchema";s:8:"fullName";s:37:"yii\db\mysql\Schema::loadColumnSchema";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mysql/Schema.php";s:9:"startLine";i:293;s:7:"endLine";i:361;s:16:"shortDescription";s:60:"Loads the column information into a [[ColumnSchema]] object.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:2;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:14:"phpstan-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:1:"T";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:3;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:12:"psalm-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:1:"T";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:11:"findColumns";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\db\mysql\Schema";s:10:"sourceCode";s:1261:"protected function findColumns($table)
{
    $sql = 'SHOW FULL COLUMNS FROM ' . $this->quoteTableName($table->fullName);
    try {
        $columns = $this->db->createCommand($sql)->queryAll();
    } catch (\Exception $e) {
        $previous = $e->getPrevious();
        if ($previous instanceof \PDOException && strpos($previous->getMessage(), 'SQLSTATE[42S02') !== false) {
            // table does not exist
            // https://dev.mysql.com/doc/refman/5.5/en/error-messages-server.html#error_er_bad_table_error
            return false;
        }
        throw $e;
    }
    $jsonColumns = $this->getJsonColumns($table);
    foreach ($columns as $info) {
        if ($this->db->slavePdo->getAttribute(\PDO::ATTR_CASE) !== \PDO::CASE_LOWER) {
            $info = array_change_key_case($info, CASE_LOWER);
        }
        if (\in_array($info['field'], $jsonColumns, true)) {
            $info['type'] = static::TYPE_JSON;
        }
        $column = $this->loadColumnSchema($info);
        $table->columns[$column->name] = $column;
        if ($column->isPrimaryKey) {
            $table->primaryKey[] = $column->name;
            if ($column->autoIncrement) {
                $table->sequenceName = '';
            }
        }
    }
    return true;
}
