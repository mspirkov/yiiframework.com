;a:0:{}}}s:9:"namespace";s:13:"yii\behaviors";s:13:"phpDocContext";r:30911;s:4:"name";s:36:"yii\behaviors\OptimisticLockBehavior";s:8:"fullName";s:36:"yii\behaviors\OptimisticLockBehavior";s:10:"sourceFile";s:111:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/behaviors/OptimisticLockBehavior.php";s:9:"startLine";i:68;s:7:"endLine";i:174;s:16:"shortDescription";s:167:"OptimisticLockBehavior automatically upgrades a model's lock version using the column name
returned by [[\yii\db\BaseActiveRecord::optimisticLock()|optimisticLock()]].";s:11:"description";s:2069:"Optimistic locking allows multiple users to access the same record for edits and avoids
potential conflicts. In case when a user attempts to save the record upon some staled data
(because another user has modified the data), a [[StaleObjectException]] exception will be thrown,
and the update or deletion is skipped.

To use this behavior, first enable optimistic lock by following the steps listed in
[[\yii\db\BaseActiveRecord::optimisticLock()|optimisticLock()]], remove the column name
holding the lock version from the [[\yii\base\Model::rules()|rules()]] method of your
ActiveRecord class, then add the following code to it:

```
use yii\behaviors\OptimisticLockBehavior;

public function behaviors()
{
    return [
        OptimisticLockBehavior::class,
    ];
}
```

By default, OptimisticLockBehavior will use [[\yii\web\Request::getBodyParam()|getBodyParam()]] to parse
the submitted value or set it to 0 on any fail. That means a request not holding the version attribute
may achieve a first successful update to entity, but starting from there any further try should fail
unless the request is holding the expected version number.

Once attached, internal use of the model class should also fail to save the record if the version number
isn't held by [[\yii\web\Request::getBodyParam()|getBodyParam()]]. It may be useful to extend your model class,
enable optimistic lock in parent class by overriding [[\yii\db\BaseActiveRecord::optimisticLock()|optimisticLock()]],
then attach the behavior to the child class so you can tie the parent model to internal use while linking the child model
holding this behavior to the controllers responsible of receiving end user inputs.
Alternatively, you can also configure the [[value]] property with a PHP callable to implement a different logic.

OptimisticLockBehavior also provides a method named [[upgrade()]] that increases a model's
version by one, that may be useful when you need to mark an entity as stale among connected clients
and avoid any change to it until they load it again:

```
$model->upgrade();
```";s:5:"since";s:6:"2.0.16";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:3:{i:2;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:42:"\yii\db\BaseActiveRecord::optimisticLock()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:14:"optimisticLock";}}s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:45:"for details on how to enable optimistic lock.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:3;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Template":5:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀templateName";s:1:"T";s:54:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀bound";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:24:"\yii\db\BaseActiveRecord";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:16:"BaseActiveRecord";}}s:56:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀default";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:7:"␀*␀name";s:8:"template";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:4;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Extends_":3:{s:7:"␀*␀type";O:41:"phpDocumentor\Reflection\Types\Collection":4:{s:48:"␀phpDocumentor\Reflection\Types\Collection␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:32:"\yii\behaviors\AttributeBehavior";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:17:"AttributeBehavior";}s:12:"␀*␀valueType";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:16:"\yii\behaviors\T";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:1:"T";}}s:10:"␀*␀keyType";N;s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}s:7:"␀*␀name";s:7:"extends";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:31:"yii\behaviors\AttributeBehavior";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:17:"yii\base\Behavior";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:2:{s:16:"Luciano Baraglia";s:26:"luciano.baraglia@gmail.com";s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:3:{s:6:"events";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:31:"yii\behaviors\AttributeBehavior";s:10:"sourceCode";s:132:"public function events()
