there are no cache items for this definition exists.";s:10:"returnType";s:33:"\yii\web\UrlRuleInterface[]|false";s:11:"returnTypes";a:2:{i:0;s:27:"\yii\web\UrlRuleInterface[]";i:1;s:5:"false";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:96781;s:4:"name";s:22:"getBuiltRulesFromCache";s:8:"fullName";s:42:"yii\web\UrlManager::getBuiltRulesFromCache";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/UrlManager.php";s:9:"startLine";i:304;s:7:"endLine";i:312;s:16:"shortDescription";s:87:"Provides the built URL rules that are associated with the $ruleDeclarations from cache.";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.14";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:12:"parseRequest";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\web\UrlManager";s:10:"sourceCode";s:1981:"public function parseRequest($request)
{
    if ($this->enablePrettyUrl) {
        /** @var UrlRule $rule */
        foreach ($this->rules as $rule) {
            $result = $rule->parseRequest($this, $request);
            if (YII_DEBUG) {
                Yii::debug([
                    'rule' => method_exists($rule, '__toString') ? $rule->__toString() : get_class($rule),
                    'match' => $result !== false,
                    'parent' => null,
                ], __METHOD__);
            }
            if ($result !== false) {
                return $result;
            }
        }
        if ($this->enableStrictParsing) {
            return false;
        }
        Yii::debug('No matching URL rules. Using default URL parsing logic.', __METHOD__);
        $suffix = (string) $this->suffix;
        $pathInfo = $request->getPathInfo();
        $normalized = false;
        if ($this->normalizer !== false) {
            $pathInfo = $this->normalizer->normalizePathInfo($pathInfo, $suffix, $normalized);
        }
        if ($suffix !== '' && $pathInfo !== '') {
            $n = strlen($this->suffix);
            if (substr_compare($pathInfo, $this->suffix, -$n, $n) === 0) {
                $pathInfo = substr($pathInfo, 0, -$n);
                if ($pathInfo === '') {
                    // suffix alone is not allowed
                    return false;
                }
            } else {
                // suffix doesn't match
                return false;
            }
        }
        if ($normalized) {
            // pathInfo was changed by normalizer - we need also normalize route
            return $this->normalizer->normalizeRoute([$pathInfo, []]);
        }
        return [$pathInfo, []];
    }
    Yii::debug('Pretty URL not enabled. Using default URL parsing logic.', __METHOD__);
    $route = $request->getQueryParam($this->routeParam, '');
    if (is_array($route)) {
        $route = '';
    }
    return [(string) $route, []];
}
";s:6:"params";a:1:{s:8:"$request";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$request";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:21:"The request component";s:4:"type";s:16:"\yii\web\Request";s:5:"types";a:1:{i:0;s:16:"\yii\web\Request";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/UrlManager.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:176:"The route and the associated parameters. The latter is always empty
if [[enablePrettyUrl]] is `false`. `false` is returned if the current request cannot be successfully parsed.";s:10:"returnType";s:10:"array|bool";s:11:"returnTypes";a:2:{i:0;s:5:"array";i:1;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:96781;s:4:"name";s:12:"parseRequest";s:8:"fullName";s:32:"yii\web\UrlManager::parseRequest";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/UrlManager.php";s:9:"startLine";i:320;s:7:"endLine";i:379;s:16:"shortDescription";s:24:"Parses the user request.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"createUrl";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\web\UrlManager";s:10:"sourceCode";s:2605:"public function createUrl($params)
{
    $params = (array) $params;
    $anchor = isset($params['#']) ? '#' . $params['#'] : '';
    unset($params['#'], $params[$this->routeParam]);
    $route = trim(isset($params[0]) ? $params[0] : '', '/');
    unset($params[0]);
    $baseUrl = $this->showScriptName || !$this->enablePrettyUrl ? $this->getScriptUrl() : $this->getBaseUrl();
    if ($this->enablePrettyUrl) {
        $cacheKey = $route . '?';
        foreach ($params as $key => $value) {
            if ($value !== null) {
                $cacheKey .= $key . '&';
            }
        }
        $url = $this->getUrlFromCache($cacheKey, $route, $params);
        if ($url === false) {
            /** @var UrlRule $rule */
            foreach ($this->rules as $rule) {
                if (in_array($rule, $this->_ruleCache[$cacheKey], true)) {
                    // avoid redundant calls of `UrlRule::createUrl()` for rules checked in `getUrlFromCache()`
                    // @see https://github.com/yiisoft/yii2/issues/14094
                    continue;
                }
                $url = $rule->createUrl($this, $route, $params);
                if ($this->canBeCached($rule)) {
                    $this->setRuleToCache($cacheKey, $rule);
                }
                if ($url !== false) {
                    break;
                }
            }
        }
        if ($url !== false) {
            if (strpos($url, '://') !== false) {
                if ($baseUrl !== '' && ($pos = strpos($url, '/', 8)) !== false) {
                    return substr($url, 0, $pos) . $baseUrl . substr($url, $pos) . $anchor;
                }
                return $url . $baseUrl . $anchor;
            } elseif (strncmp($url, '//', 2) === 0) {
                if ($baseUrl !== '' && ($pos = strpos($url, '/', 2)) !== false) {
                    return substr($url, 0, $pos) . $baseUrl . substr($url, $pos) . $anchor;
                }
                return $url . $baseUrl . $anchor;
            }
            $url = ltrim($url, '/');
            return "$baseUrl/{$url}{$anchor}";
        }
        if ($this->suffix !== null) {
            $route .= $this->suffix;
        }
        if (!empty($params) && ($query = http_build_query($params)) !== '') {
            $route .= '?' . $query;
        }
        $route = ltrim($route, '/');
        return "$baseUrl/{$route}{$anchor}";
    }
    $url = "$baseUrl?{$this->routeParam}=" . urlencode($route);
    if (!empty($params) && ($query = http_build_query($params)) !== '') {
        $url .= '&' . $query;
    }
    return $url . $anchor;
}
