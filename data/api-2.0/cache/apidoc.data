rty";s:14:"␀*␀description";r:75687;}i:4;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:8:"viewPath";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:75713;}i:7;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Template":5:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀templateName";s:1:"T";s:54:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀bound";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:16:"\yii\base\Module";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:6:"Module";}}s:56:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀default";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:7:"␀*␀name";s:8:"template";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:14:"yii\base\Event";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:19:"yii\base\BaseObject";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:5:{s:2:"on";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:14:"yii\base\Event";s:10:"sourceCode";s:682:"public static function on($class, $name, $handler, $data = null, $append = true)
{
    $class = ltrim($class, '\\');
    if (strpos($class, '*') !== false || strpos($name, '*') !== false) {
        if ($append || empty(self::$_eventWildcards[$name][$class])) {
            self::$_eventWildcards[$name][$class][] = [$handler, $data];
        } else {
            array_unshift(self::$_eventWildcards[$name][$class], [$handler, $data]);
        }
        return;
    }
    if ($append || empty(self::$_events[$name][$class])) {
        self::$_events[$name][$class][] = [$handler, $data];
    } else {
        array_unshift(self::$_events[$name][$class], [$handler, $data]);
    }
}
