{
    if ($this->filterModel instanceof Model && $this->filterModel->hasErrors()) {
        return Html::errorSummary($this->filterModel, $this->filterErrorSummaryOptions);
    }
    return '';
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:21:"The rendering result.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:27606;s:4:"name";s:12:"renderErrors";s:8:"fullName";s:31:"yii\grid\GridView::renderErrors";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/grid/GridView.php";s:9:"startLine";i:308;s:7:"endLine";i:315;s:16:"shortDescription";s:41:"Renders validator errors of filter model.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"renderSection";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\grid\GridView";s:10:"sourceCode";s:201:"public function renderSection($name)
{
    switch ($name) {
        case '{errors}':
