rk/i18n/I18N.php";s:9:"startLine";i:87;s:7:"endLine";i:96;s:16:"shortDescription";s:47:"Translates a message to the specified language.";s:11:"description";s:137:"After translation the message will be formatted using [[MessageFormatter]] if it contains
ICU message format and `$params` are not empty.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"format";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:13:"yii\i18n\I18N";s:10:"sourceCode";s:774:"public function format($message, $params, $language)
{
    $params = (array) $params;
    if ($params === []) {
        return $message;
    }
    if (preg_match('~{\s*[\w.]+\s*,~u', $message)) {
        $formatter = $this->getMessageFormatter();
        $result = $formatter->format($message, $params, $language);
        if ($result === false) {
            $errorMessage = $formatter->getErrorMessage();
            Yii::warning("Formatting message for language '$language' failed with error: $errorMessage. The message being formatted was: $message.", __METHOD__);
            return $message;
        }
        return $result;
    }
    $p = [];
    foreach ($params as $name => $value) {
        $p['{' . $name . '}'] = $value;
    }
    return strtr($message, $p);
}
