";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:30:"Whether to use custom storage.";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:106378;s:4:"name";s:19:"getUseCustomStorage";s:8:"fullName";s:36:"yii\web\Session::getUseCustomStorage";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Session.php";s:9:"startLine";i:135;s:7:"endLine";i:138;s:16:"shortDescription";s:65:"Returns a value indicating whether to use custom session storage.";s:11:"description";s:284:"This method should be overridden to return true by child classes that implement custom session storage.
To implement custom session storage, override these methods: [[openSession()]], [[closeSession()]],
[[readSession()]], [[writeSession()]], [[destroySession()]] and [[gcSession()]].";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:4:"open";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\web\Session";s:10:"sourceCode";s:717:"public function open()
{
    if ($this->getIsActive()) {
        return;
    }
    $this->registerSessionHandler();
    if ($this->getUseCookies() !== false) {
        $this->setCookieParamsInternal();
    }
    YII_DEBUG ? session_start() : @session_start();
    if ($this->getUseStrictMode() && $this->_forceRegenerateId) {
        $this->regenerateID();
        $this->_forceRegenerateId = null;
    }
    if ($this->getIsActive()) {
        Yii::info('Session started', __METHOD__);
        $this->updateFlashCounters();
    } else {
        $error = error_get_last();
        $message = isset($error['message']) ? $error['message'] : 'Failed to start session.';
        Yii::error($message, __METHOD__);
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:106378;s:4:"name";s:4:"open";s:8:"fullName";s:21:"yii\web\Session::open";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Session.php";s:9:"startLine";i:143;s:7:"endLine";i:170;s:16:"shortDescription";s:19:"Starts the session.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:22:"registerSessionHandler";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:15:"yii\web\Session";s:10:"sourceCode";s:1203:"protected function registerSessionHandler()
{
    $sessionModuleName = session_module_name();
    if (static::$_originalSessionModule === null) {
        static::$_originalSessionModule = $sessionModuleName;
    }
    if ($this->handler === null && $this->getUseCustomStorage()) {
        $this->handler = Yii::createObject(
            [
                '__class' => SessionHandler::class,
                '__construct()' => [$this],
            ]
        );
    }
    if ($this->handler !== null) {
        if (is_array($this->handler)) {
            $this->handler = Yii::createObject($this->handler);
        }
        if (!$this->handler instanceof \SessionHandlerInterface) {
            throw new InvalidConfigException('"' . get_class($this) . '::handler" must implement the SessionHandlerInterface.');
        }
        YII_DEBUG ? session_set_save_handler($this->handler, false) : @session_set_save_handler($this->handler, false);
    } elseif (
        $sessionModuleName !== static::$_originalSessionModule
        && static::$_originalSessionModule !== null
        && static::$_originalSessionModule !== 'user'
    ) {
        session_module_name(static::$_originalSessionModule);
    }
}
