Note, the values and labels will be automatically HTML-encoded by this method, and the blank spaces in
the labels will also be HTML-encoded.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";}s:8:"$options";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$options";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:1668:"The tag options in terms of name-value pairs. The following options are specially handled:

- prompt: string, a prompt text to be displayed as the first option. Since version 2.0.11 you can use an array
  to override the value and to set other tag attributes:

  ```
  ['text' => 'Please select', 'options' => ['value' => 'none', 'class' => 'prompt', 'label' => 'Select']],
  ```

- options: array, the attributes for the select option tags. The array keys must be valid option values,
  and the array values are the extra attributes for the corresponding option tags. For example,

  ```
  [
      'value1' => ['disabled' => true],
      'value2' => ['label' => 'value 2'],
  ];
  ```

- groups: array, the attributes for the optgroup tags. The structure of this is similar to that of 'options',
  except that the array keys represent the optgroup labels specified in $items.
- unselect: string, the value that will be submitted when no option is selected.
  When this attribute is set, a hidden field will be generated so that if no option is selected in multiple
  mode, we can still obtain the posted unselect value.
- encodeSpaces: bool, whether to encode spaces in option prompt and option value with `&nbsp;` character.
  Defaults to false.
- encode: bool, whether to encode option prompt and option value characters.
  Defaults to `true`. This option is available since 2.0.3.

The rest of the options will be rendered as the attributes of the resulting tag. The values will
be HTML-encoded using [[encode()]]. If a value is null, the corresponding attribute will not be rendered.
See [[renderTagAttributes()]] for details on how attributes are being rendered.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:26:"The generated list box tag";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:56244;s:4:"name";s:13:"activeListBox";s:8:"fullName";s:35:"yii\helpers\BaseHtml::activeListBox";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";s:9:"startLine";i:1758;s:7:"endLine";i:1761;s:16:"shortDescription";s:21:"Generates a list box.";s:11:"description";s:77:"The selection of the list box is taken from the value of the model attribute.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:18:"activeCheckboxList";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\helpers\BaseHtml";s:10:"sourceCode";s:179:"public static function activeCheckboxList($model, $attribute, $items, $options = [])
