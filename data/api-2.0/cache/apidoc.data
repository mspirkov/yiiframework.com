";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:55:"Part of the request URL that is after the question mark";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:113036;s:4:"name";s:14:"getQueryString";s:8:"fullName";s:31:"yii\web\Request::getQueryString";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";s:9:"startLine";i:1122;s:7:"endLine";i:1125;s:16:"shortDescription";s:64:"Returns part of the request URL that is after the question mark.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:21:"getIsSecureConnection";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\web\Request";s:10:"sourceCode";s:665:"public function getIsSecureConnection()
{
    if (isset($_SERVER['HTTPS']) && (strcasecmp($_SERVER['HTTPS'], 'on') === 0 || $_SERVER['HTTPS'] == 1)) {
        return true;
    }
    if (($proto = $this->getSecureForwardedHeaderTrustedPart('proto')) !== null) {
        return strcasecmp($proto, 'https') === 0;
    }
    foreach ($this->secureProtocolHeaders as $header => $values) {
        if (($headerValue = $this->headers->get($header, null)) !== null) {
            foreach ($values as $value) {
                if (strcasecmp($headerValue, $value) === 0) {
                    return true;
                }
            }
        }
    }
    return false;
}
