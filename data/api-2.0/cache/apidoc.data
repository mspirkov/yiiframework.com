the maximum page size. If this is false, it means [[pageSize]] should always return the value of [[defaultPageSize]].";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:37:"phpDocumentor\Reflection\Types\Array_":3:{s:12:"␀*␀valueType";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:10:"␀*␀keyType";N;s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}i:1;O:43:"phpDocumentor\Reflection\PseudoTypes\False_":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:209:"the page size limits. The first array element defines the minimum page size, and the second
the maximum page size. If this is false, it means [[pageSize]] should always return the value of [[defaultPageSize]].";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:8:"yii\data";s:13:"phpDocContext";r:9077;s:4:"name";s:19:"yii\data\Pagination";s:8:"fullName";s:19:"yii\data\Pagination";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/Pagination.php";s:9:"startLine";i:76;s:7:"endLine";i:354;s:16:"shortDescription";s:71:"Pagination represents information relevant to pagination of data items.";s:11:"description";s:1073:"When data needs to be rendered in multiple pages, Pagination can be used to
represent information such as [[totalCount|total item count]], [[pageSize|page size]],
[[page|current page]], etc. These information can be passed to [[\yii\widgets\LinkPager|pagers]]
to render pagination buttons or links.

The following example shows how to create a pagination object and feed it
to a pager.

Controller action:

```
public function actionIndex()
{
    $query = Article::find()->where(['status' => 1]);
    $countQuery = clone $query;
    $pages = new Pagination(['totalCount' => $countQuery->count()]);
    $models = $query->offset($pages->offset)
        ->limit($pages->limit)
        ->all();

    return $this->render('index', [
         'models' => $models,
         'pages' => $pages,
    ]);
}
```

View:

```
foreach ($models as $model) {
    // display $model here
}

// display pagination
echo LinkPager::widget([
    'pagination' => $pages,
]);
```

For more details and usage information on Pagination, see the [guide article on pagination](guide:output-pagination).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:6:{i:0;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:5:"limit";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Integer":0:{}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:9502;}i:1;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:5:"links";s:7:"␀*␀type";O:37:"phpDocumentor\Reflection\Types\Array_":3:{s:12:"␀*␀valueType";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:10:"␀*␀keyType";N;s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:9528;}i:2;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:6:"offset";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Integer":0:{}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:9554;}i:3;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:4:"page";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Integer":0:{}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:9580;}i:4;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:9:"pageCount";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Integer":0:{}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:9606;}i:5;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:8:"pageSize";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Integer":0:{}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:9632