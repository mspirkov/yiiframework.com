";s:6:"params";a:1:{s:7:"$ranges";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$ranges";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:638:"The IPv4 or IPv6 ranges that are allowed or forbidden.

When the array is empty, or the option not set, all IP addresses are allowed.

Otherwise, the rules are checked sequentially until the first match is found.
An IP address is forbidden, when it has not matched any of the rules.

Example:

```
[
     'ranges' => [
         '192.168.10.128'
         '!192.168.10.0/24',
         'any' // allows any other IP addresses
     ]
]
```

In this example, access is allowed for all the IPv4 and IPv6 addresses excluding the `192.168.10.0/24` subnet.
IPv4 address `192.168.10.128` is also allowed, because it is listed before the restriction.";s:4:"type";s:17:"array|string|null";s:5:"types";a:3:{i:0;s:5:"array";i:1;s:6:"string";i:2;s:4:"null";}s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/IpValidator.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:138712;s:4:"name";s:9:"setRanges";s:8:"fullName";s:37:"yii\validators\IpValidator::setRanges";s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/IpValidator.php";s:9:"startLine";i:270;s:7:"endLine";i:273;s:16:"shortDescription";s:58:"Set the IPv4 or IPv6 ranges that are allowed or forbidden.";s:11:"description";s:149:"The following preparation tasks are performed:

- Recursively substitutes aliases (described in [[networks]]) with their values.
- Removes duplicates";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"getRanges";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:26:"yii\validators\IpValidator";s:10:"sourceCode";s:59:"public function getRanges()
