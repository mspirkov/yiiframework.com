";s:6:"params";a:2:{s:3:"$id";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:3:"$id";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:16:"The component ID";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/Instance.php";}s:9:"$optional";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$optional";s:10:"isOptional";b:1;s:12:"defaultValue";s:5:"false";s:19:"isPassedByReference";b:0;s:11:"description";s:59:"If null should be returned instead of throwing an exception";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/Instance.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:24:"The new Instance object.";s:10:"returnType";s:16:"\yii\di\Instance";s:11:"returnTypes";a:1:{i:0;s:16:"\yii\di\Instance";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:89466;s:4:"name";s:2:"of";s:8:"fullName";s:19:"yii\di\Instance::of";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/Instance.php";s:9:"startLine";i:85;s:7:"endLine";i:88;s:16:"shortDescription";s:30:"Creates a new Instance object.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"ensure";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\di\Instance";s:10:"sourceCode";s:1829:"public static function ensure($reference, $type = null, $container = null)
{
    if (is_array($reference)) {
        if (!$container instanceof Container) {
            $container = Yii::$container;
        }
        if (isset($reference['__class'])) {
            $class = $reference['__class'];
            unset($reference['__class'], $reference['class']);
        } elseif (isset($reference['class'])) {
            $class = $reference['class'];
            unset($reference['class']);
        } else {
            $class = $type;
        }
        $component = $container->get($class, [], $reference);
        if ($type === null || $component instanceof $type) {
            return $component;
        }
        throw new InvalidConfigException('Invalid data type: ' . $class . '. ' . $type . ' is expected.');
    } elseif (empty($reference)) {
        throw new InvalidConfigException('The required component is not specified.');
    }
    if (is_string($reference)) {
        $reference = new static($reference);
    } elseif ($type === null || $reference instanceof $type) {
        return $reference;
    }
    if ($reference instanceof self) {
        try {
            $component = $reference->get($container);
        } catch (\ReflectionException $e) {
            throw new InvalidConfigException('Failed to instantiate component or class "' . $reference->id . '".', 0, $e);
        }
        if ($type === null || $component instanceof $type) {
            return $component;
        }
        throw new InvalidConfigException('"' . $reference->id . '" refers to a ' . get_class($component) . " component. $type is expected.");
    }
    $valueType = is_object($reference) ? get_class($reference) : gettype($reference);
    throw new InvalidConfigException("Invalid data type: $valueType. $type is expected.");
}
";s:6:"params";a:3:{s:10:"$reference";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$reference";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:322:"An object or a reference to the desired object.
You may specify a reference in terms of a component ID or an Instance object.
Starting from version 2.0.2, you may also pass in a configuration array for creating the object.
If the "class" value is not specified in the configuration array, it will use the value of `$type`.";s:4:"type";s:26:"object|string|array|static";s:5:"types";a:4:{i:0;s:6:"object";i:1;s:6:"string";i:2;s:5:"array";i:3;s:6:"static";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/Instance.php";}s:5:"$type";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$type";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:82:"The class/interface name to be checked. If null, type check will not be performed.";s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/Instance.php";}s:10:"$container";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$container";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:48:"The container. This will be passed to [[get()]].";s:4:"type";s:45:"\yii\di\ServiceLocator|\yii\di\Container|null";s:5:"types";a:3:{i:0;s:22:"\yii\di\ServiceLocator";i:1;s:17:"\yii\di\Container";i:2;s:4:"null";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/Instance.php";}}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:27:"if the reference is invalid";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:81:"The object referenced by the Instance, or `$reference` itself if it is an object.";s:10:"returnType";s:6:"object";s:11:"returnTypes";a:1:{i:0;s:6:"object";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:89466;s:4:"name";s:6:"ensure";s:8:"fullName";s:23:"yii\di\Instance::ensure";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/Instance.php";s:9:"startLine";i:124;s:7:"endLine";i:170;s:16:"shortDescription";s:99:"Resolves the specified reference into the actual object and makes sure it is of the specified type.";s:11:"description";s:558:"The reference may be specified as a string or an Instance object. If the former,
it will be treated as a component ID, a class/interface name or an alias, depending on the container type.

If you do not specify a container, the method will first try `Yii::$app` followed by `Yii::$container`.

For example,

```
use yii\db\Connection;

// returns Yii::$app->db
$db = Instance::ensure('db', Connection::class);
// returns an instance of Connection using the given configuration
$db = Instance::ensure(['dsn' => 'sqlite:path/to/my.db'], Connection::class);
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:5:{i:5;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Template":5:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀templateName";s:1:"T";s:54:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀bound";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";N;}s:56:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀default";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:7:"␀*␀name";s:8:"template";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:6;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:11:"psalm-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:26:"class-string<T>|null $type";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:7;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:13:"phpstan-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:26:"class-string<T>|null $type";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:8;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:12:"psalm-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:28:"($type is null ? object : T)";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:9;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:14:"phpstan-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:28:"($type is null ? object : T)";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:3:"get";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\di\Instance";s:10:"sourceCode";s:528:"public function get($container = null)
{
    try {
        if ($container) {
            return $container->get($this->id);
        }
        if (Yii::$app && Yii::$app->has($this->id)) {
            return Yii::$app->get($this->id);
        }
        return Yii::$container->get($this->id);
    } catch (\Exception $e) {
        if ($this->optional) {
            return null;
        }
        throw $e;
    } catch (\Throwable $e) {
        if ($this->optional) {
            return null;
        }
        throw $e;
    }
}
