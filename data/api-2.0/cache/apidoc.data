{
    /**
     * @var ActiveRecordInterface $class
     * @var ActiveQuery $query
     *
     * @phpstan-var ActiveQuery<ActiveRecord> $query
     */
    $query = $class::find();
    $query->primaryModel = $this;
    $query->link = $link;
    $query->multiple = $multiple;
    return $query;
}
