[[\yii\base\View]] component contains two methods [[\yii\base\View::beginBlock()]] and [[\yii\base\View::endBlock()]].
The general idea is that you're defining block default in a view or layout:

```
<?php $this->beginBlock('messages', true) ?>
Nothing.
<?php $this->endBlock() ?>
```

And then overriding default in sub-views:

```
<?php $this->beginBlock('username') ?>
Umm... hello?
<?php $this->endBlock() ?>
```

Second parameter defines if block content should be outputted which is desired when rendering its content but isn't
desired when redefining it in subviews.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:21:"yii\widgets\PjaxAsset";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:19:"yii\web\AssetBundle";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:0:{}s:10:"properties";a:3:{s:11:"$sourcePath";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:0:"";s:5:"types";a:1:{i:0;s:0:"";}s:12:"defaultValue";s:18:"'@bower/yii2-pjax'";s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:21:"yii\widgets\PjaxAsset";s:13:"phpDocContext";N;s:4:"name";s:11:"$sourcePath";s:8:"fullName";s:34:"yii\widgets\PjaxAsset::$sourcePath";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/PjaxAsset.php";s:9:"startLine";i:20;s:7:"endLine";i:20;s:16:"shortDescription";N;s:11:"description";N;s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:3:"$js";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:0:"";s:5:"types";a:1:{i:0;s:0:"";}s:12:"defaultValue";s:25:"[
