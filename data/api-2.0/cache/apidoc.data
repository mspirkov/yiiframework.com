Please refer to [[rules]] for the acceptable rule format.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/UrlManager.php";}s:7:"$append";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$append";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"true";s:19:"isPassedByReference";b:0;s:11:"description";s:80:"Whether to add the new rules by appending them to the end of the existing rules.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/UrlManager.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:96781;s:4:"name";s:8:"addRules";s:8:"fullName";s:28:"yii\web\UrlManager::addRules";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/UrlManager.php";s:9:"startLine";i:206;s:7:"endLine";i:217;s:16:"shortDescription";s:26:"Adds additional URL rules.";s:11:"description";s:208:"This method will call [[buildRules()]] to parse the given rule declarations and then append or insert
them to the existing [[rules]].

Note that if [[enablePrettyUrl]] is `false`, this method will do nothing.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:10:"buildRules";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:18:"yii\web\UrlManager";s:10:"sourceCode";s:1030:"protected function buildRules($ruleDeclarations)
{
    $builtRules = $this->getBuiltRulesFromCache($ruleDeclarations);
    if ($builtRules !== false) {
        return $builtRules;
    }
    $builtRules = [];
    $verbs = 'GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS';
    foreach ($ruleDeclarations as $key => $rule) {
        if (is_string($rule)) {
            $rule = ['route' => $rule];
            if (preg_match("/^((?:($verbs),)*($verbs))\\s+(.*)$/", $key, $matches)) {
                $rule['verb'] = explode(',', $matches[1]);
                $key = $matches[4];
            }
            $rule['pattern'] = $key;
        }
        if (is_array($rule)) {
            $rule = Yii::createObject(array_merge($this->ruleConfig, $rule));
        }
        if (!$rule instanceof UrlRuleInterface) {
            throw new InvalidConfigException('URL rule class must implement UrlRuleInterface.');
        }
        $builtRules[] = $rule;
    }
    $this->setBuiltRulesCache($ruleDeclarations, $builtRules);
    return $builtRules;
}
