{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\grid\ActionColumn";s:10:"sourceCode";s:376:"public function createUrl($action, $model, $key, $index)
{
    if (is_callable($this->urlCreator)) {
        return call_user_func($this->urlCreator, $action, $model, $key, $index, $this);
    }
    $params = is_array($key) ? $key : ['id' => (string) $key];
    $params[0] = $this->controller ? $this->controller . '/' . $action : $action;
    return Url::toRoute($params);
}
";s:6:"params";a:4:{s:7:"$action";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$action";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:30:"The button name (or action ID)";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/grid/ActionColumn.php";}s:6:"$model";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$model";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:14:"The data model";s:4:"type";s:29:"\yii\db\ActiveRecordInterface";s:5:"types";a:1:{i:0;s:29:"\yii\db\ActiveRecordInterface";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/grid/ActionColumn.php";}s:4:"$key";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:4:"$key";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:38:"The key associated with the data model";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/grid/ActionColumn.php";}s:6:"$index";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$index";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:21:"The current row index";s:4:"type";s:3:"int";s:5:"types";a:1:{i:0;s:3:"int";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/grid/ActionColumn.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:15:"The created URL";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:29162;s:4:"name";s:9:"createUrl";s:8:"fullName";s:32:"yii\grid\ActionColumn::createUrl";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/grid/ActionColumn.php";s:9:"startLine";i:216;s:7:"endLine";i:226;s:16:"shortDescription";s:45:"Creates a URL for the given action and model.";s:11:"description";s:51:"This method is called for each button and each row.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:21:"renderDataCellContent";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:21:"yii\grid\ActionColumn";s:10:"sourceCode";s:773:"protected function renderDataCellContent($model, $key, $index)
{
    return preg_replace_callback('/\\{([\w\-\/]+)\\}/', function ($matches) use ($model, $key, $index) {
        $name = $matches[1];
        if (isset($this->visibleButtons[$name])) {
            $isVisible = $this->visibleButtons[$name] instanceof \Closure
                ? call_user_func($this->visibleButtons[$name], $model, $key, $index)
                : $this->visibleButtons[$name];
        } else {
            $isVisible = true;
        }
        if ($isVisible && isset($this->buttons[$name])) {
            $url = $this->createUrl($name, $model, $key, $index);
            return call_user_func($this->buttons[$name], $url, $model, $key);
        }
        return '';
    }, $this->template);
}
