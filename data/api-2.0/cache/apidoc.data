See [[timestampAttributeTimeZone]] for more description.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:14:"yii\validators";s:13:"phpDocContext";r:139760;s:4:"name";s:28:"yii\validators\DateValidator";s:8:"fullName";s:28:"yii\validators\DateValidator";s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/DateValidator.php";s:9:"startLine";i:37;s:7:"endLine";i:478;s:16:"shortDescription";s:99:"DateValidator verifies if the attribute represents a date, time or datetime in a proper [[format]].";s:11:"description";s:887:"It can also parse internationalized dates in a specific [[locale]] like e.g. `12 мая 2014` when [[format]]
is configured to use a time pattern in ICU format.

It is further possible to limit the date within a certain range using [[min]] and [[max]].

Additional to validating the date it can also export the parsed timestamp as a machine readable format
which can be configured using [[timestampAttribute]]. For values that include time information (not date-only values)
also the time zone will be adjusted. The time zone of the input value is assumed to be the one specified by the [[timeZone]]
property and the target timeZone will be UTC when [[timestampAttributeFormat]] is `null` (exporting as UNIX timestamp)
or [[timestampAttributeTimeZone]] otherwise. If you want to avoid the time zone conversion, make sure that [[timeZone]] and
[[timestampAttributeTimeZone]] are the same.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:41:"yii\validators\RegularExpressionValidator";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:24:"yii\validators\Validator";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:4:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:41:"yii\validators\RegularExpressionValidator";s:10:"sourceCode";s:277:"public function init()
{
    parent::init();
    if ($this->pattern === null) {
        throw new InvalidConfigException('The "pattern" property must be set.');
    }
    if ($this->message === null) {
        $this->message = Yii::t('yii', '{attribute} is invalid.');
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:14:"yii\validators";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:5:{s:3:"Yii";s:3:"Yii";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:4:"Html";s:16:"yii\helpers\Html";s:4:"Json";s:16:"yii\helpers\Json";s:12:"JsExpression";s:20:"yii\web\JsExpression";}}s:4:"name";s:4:"init";s:8:"fullName";s:47:"yii\validators\RegularExpressionValidator::init";s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/RegularExpressionValidator.php";s:9:"startLine";i:40;s:7:"endLine";i:49;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:13:"validateValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:41:"yii\validators\RegularExpressionValidator";s:10:"sourceCode";s:250:"protected function validateValue($value)
{
    $valid = !is_array($value) &&
        (!$this->not && preg_match($this->pattern, $value)
        || $this->not && !preg_match($this->pattern, $value));
    return $valid ? null : [$this->message, []];
}
