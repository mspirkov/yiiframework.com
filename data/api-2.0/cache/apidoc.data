{
    $timestamp = $this->parseDateValue($value);
    if ($timestamp === false) {
        return [$this->message, []];
    } elseif ($this->min !== null && $timestamp < $this->min) {
        return [$this->tooSmall, ['min' => $this->minString]];
    } elseif ($this->max !== null && $timestamp > $this->max) {
        return [$this->tooBig, ['max' => $this->maxString]];
    }
    return null;
}
