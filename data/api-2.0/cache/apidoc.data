{
    parent::init();
    if (
        !is_array($this->range)
        && !($this->range instanceof \Closure)
        && !($this->range instanceof \Traversable)
    ) {
        throw new InvalidConfigException('The "range" property must be set.');
    }
    if ($this->message === null) {
        $this->message = Yii::t('yii', '{attribute} is invalid.');
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:14:"yii\validators";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:4:{s:3:"Yii";s:3:"Yii";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:11:"ArrayHelper";s:23:"yii\helpers\ArrayHelper";s:4:"Json";s:16:"yii\helpers\Json";}}s:4:"name";s:4:"init";s:8:"fullName";s:35:"yii\validators\RangeValidator::init";s:10:"sourceFile";s:104:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/RangeValidator.php";s:9:"startLine";i:57;s:7:"endLine";i:70;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:13:"validateValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:29:"yii\validators\RangeValidator";s:10:"sourceCode";s:426:"protected function validateValue($value)
{
    $in = false;
    if (
        $this->allowArray
        && ($value instanceof \Traversable || is_array($value))
        && ArrayHelper::isSubset($value, $this->range, $this->strict)
    ) {
        $in = true;
    }
    if (!$in && ArrayHelper::isIn($value, $this->range, $this->strict)) {
        $in = true;
    }
    return $this->not !== $in ? null : [$this->message, []];
}
