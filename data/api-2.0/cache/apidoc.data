be applied when the value being validated is empty.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:14:"yii\validators";s:13:"phpDocContext";r:134765;s:4:"name";s:30:"yii\validators\FilterValidator";s:8:"fullName";s:30:"yii\validators\FilterValidator";s:10:"sourceFile";s:105:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/FilterValidator.php";s:9:"startLine";i:37;s:7:"endLine";i:112;s:16:"shortDescription";s:67:"FilterValidator converts the attribute value according to a filter.";s:11:"description";s:629:"FilterValidator is actually not a validator but a data processor.
It invokes the specified filter callback to process the attribute value
and save the processed value back to the attribute. The filter must be
a valid PHP callback with the following signature:

```
function foo($value) {
    // compute $newValue here
    return $newValue;
}
```

Many PHP functions qualify this signature (e.g. `trim()`).
If the callback function requires non-null argument (important since PHP 8.1)
remember to set [[skipOnEmpty]] to `true` otherwise you may trigger an error.

To specify the filter, set [[filter]] property to be the callback.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:29:"yii\validators\EmailValidator";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:24:"yii\validators\Validator";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:5:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:29:"yii\validators\EmailValidator";s:10:"sourceCode";s:365:"public function init()
{
    parent::init();
    if ($this->enableIDN && !function_exists('idn_to_ascii')) {
        throw new InvalidConfigException('In order to use IDN validation intl extension must be installed and enabled.');
    }
    if ($this->message === null) {
        $this->message = Yii::t('yii', '{attribute} is not a valid email address.');
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:14:"yii\validators";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:5:{s:3:"Yii";s:3:"Yii";s:14:"ErrorException";s:23:"yii\base\ErrorException";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:4:"Json";s:16:"yii\helpers\Json";s:12:"JsExpression";s:20:"yii\web\JsExpression";}}s:4:"name";s:4:"init";s:8:"fullName";s:35:"yii\validators\EmailValidator::init";s:10:"sourceFile";s:104:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/EmailValidator.php";s:9:"startLine";i:77;s:7:"endLine";i:86;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:13:"validateValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:29:"yii\validators\EmailValidator";s:10:"sourceCode";s:1812:"protected function validateValue($value)
{
    if (!is_string($value)) {
        $valid = false;
    } elseif (!preg_match('/^(?P<name>(?:"?([^"]*)"?\s)?)(?:\s+)?(?:(?P<open><?)((?P<local>.+)@(?P<domain>[^>]+))(?P<close>>?))$/i', $value, $matches)) {
        $valid = false;
    } else {
        if ($this->enableIDN) {
            if ($this->enableLocalIDN) {
                $matches['local'] = $this->idnToAsciiWithFallback($matches['local']);
            }
            $matches['domain'] = $this->idnToAscii($matches['domain']);
            $value = $matches['name'] . $matches['open'] . $matches['local'] . '@' . $matches['domain'] . $matches['close'];
        }
        if (strlen($matches['local']) > 64) {
            // The maximum total length of a user name or other local-part is 64 octets. RFC 5322 section 4.5.3.1.1
            // https://datatracker.ietf.org/doc/html/rfc5321#section-4.5.3.1.1
            $valid = false;
        } elseif (strlen($matches['local'] . '@' . $matches['domain']) > 254) {
            // There is a restriction in RFC 2821 on the length of an address in MAIL and RCPT commands
            // of 254 characters. Since addresses that do not fit in those fields are not normally useful, the
            // upper limit on address lengths should normally be considered to be 254.
            //
            // Dominic Sayers, RFC 3696 erratum 1690
            // https://www.rfc-editor.org/errata_search.php?eid=1690
            $valid = false;
        } else {
            $valid = preg_match($this->pattern, $value) || ($this->allowName && preg_match($this->fullPattern, $value));
            if ($valid && $this->checkDNS) {
                $valid = $this->isDNSValid($matches['domain']);
            }
        }
    }
    return $valid ? null : [$this->message, []];
}
