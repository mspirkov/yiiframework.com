{
    if ($columns instanceof ExpressionInterface) {
        $columns = [$columns];
    } elseif (!is_array($columns) && !is_null($columns)) {
        $columns = preg_split('/\s*,\s*/', trim($columns), -1, PREG_SPLIT_NO_EMPTY);
    }
    $this->groupBy = $columns;
    return $this;
}
";s:6:"params";a:1:{s:8:"$columns";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$columns";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:693:"The columns to be grouped by.
Columns can be specified in either a string (e.g. "id, name") or an array (e.g. ['id', 'name']).
The method will automatically quote the column names unless a column contains some parenthesis
(which means the column contains a DB expression).

Note that if your group-by is an expression containing commas, you should always use an array
to represent the group-by information. Otherwise, the method will not be able to correctly determine
the group-by columns.

Since version 2.0.7, an [[ExpressionInterface]] object can be passed to specify the GROUP BY part explicitly in plain SQL.
Since version 2.0.14, an [[ExpressionInterface]] object can be passed as well.";s:4:"type";s:45:"string|array|\yii\db\ExpressionInterface|null";s:5:"types";a:4:{i:0;s:6:"string";i:1;s:5:"array";i:2;s:27:"\yii\db\ExpressionInterface";i:3;s:4:"null";}s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:23:"The query object itself";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:164108;s:4:"name";s:7:"groupBy";s:8:"fullName";s:21:"yii\db\Query::groupBy";s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";s:9:"startLine";i:1066;s:7:"endLine";i:1075;s:16:"shortDescription";s:36:"Sets the GROUP BY part of the query.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:2;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:20:"\yii\db\addGroupBy()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:10:"addGroupBy";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:10:"addGroupBy";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:12:"yii\db\Query";s:10:"sourceCode";s:422:"public function addGroupBy($columns)
{
    if ($columns instanceof ExpressionInterface) {
        $columns = [$columns];
    } elseif (!is_array($columns)) {
        $columns = preg_split('/\s*,\s*/', trim($columns), -1, PREG_SPLIT_NO_EMPTY);
    }
    if ($this->groupBy === null) {
        $this->groupBy = $columns;
    } else {
        $this->groupBy = array_merge($this->groupBy, $columns);
    }
    return $this;
}
