;a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:13:"getColumnType";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\db\mssql\QueryBuilder";s:10:"sourceCode";s:282:"public function getColumnType($type)
{
    $columnType = parent::getColumnType($type);
    // remove unsupported keywords
    $columnType = preg_replace("/\s*comment '.*'/i", '', $columnType);
    $columnType = preg_replace('/ first$/i', '', $columnType);
    return $columnType;
}
