This method attempts to authenticate a user using the information in the identity cookie.";s:5:"since";s:5:"2.0.9";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:1;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:24:"\yii\web\loginByCookie()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:13:"loginByCookie";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:20:"removeIdentityCookie";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:12:"yii\web\User";s:10:"sourceCode";s:199:"protected function removeIdentityCookie()
{
    Yii::$app->getResponse()->getCookies()->remove(Yii::createObject(array_merge($this->identityCookie, [
        'class' => 'yii\web\Cookie',
    ])));
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:109840;s:4:"name";s:20:"removeIdentityCookie";s:8:"fullName";s:34:"yii\web\User::removeIdentityCookie";s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/User.php";s:9:"startLine";i:655;s:7:"endLine";i:660;s:16:"shortDescription";s:28:"Removes the identity cookie.";s:11:"description";s:53:"This method is used when [[enableAutoLogin]] is true.";s:5:"since";s:5:"2.0.9";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"switchIdentity";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:12:"yii\web\User";s:10:"sourceCode";s:1115:"public function switchIdentity($identity, $duration = 0)
{
    $this->setIdentity($identity);
    if (!$this->enableSession) {
        return;
    }
    /* Ensure any existing identity cookies are removed. */
    if ($this->enableAutoLogin && ($this->autoRenewCookie || $identity === null)) {
        $this->removeIdentityCookie();
    }
    $session = Yii::$app->getSession();
    $session->regenerateID(true);
    $session->remove($this->idParam);
    $session->remove($this->authTimeoutParam);
    $session->remove($this->authKeyParam);
    if ($identity) {
        $session->set($this->idParam, $identity->getId());
        $session->set($this->authKeyParam, $identity->getAuthKey());
        if ($this->authTimeout !== null) {
            $session->set($this->authTimeoutParam, time() + $this->authTimeout);
        }
        if ($this->absoluteAuthTimeout !== null) {
            $session->set($this->absoluteAuthTimeoutParam, time() + $this->absoluteAuthTimeout);
        }
        if ($this->enableAutoLogin && $duration > 0) {
            $this->sendIdentityCookie($identity, $duration);
        }
    }
}
