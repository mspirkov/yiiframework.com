    $options['encode'] = $this->encodeErrorSummary;
    return Html::errorSummary($models, $options);
}
";s:6:"params";a:2:{s:7:"$models";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$models";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:39:"The model(s) associated with this form.";s:4:"type";s:33:"\yii\base\Model|\yii\base\Model[]";s:5:"types";a:2:{i:0;s:15:"\yii\base\Model";i:1;s:17:"\yii\base\Model[]";}s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveForm.php";}s:8:"$options";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$options";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:484:"The tag options in terms of name-value pairs. The following options are specially handled:

- `header`: string, the header HTML for the error summary. If not set, a default prompt string will be used.
- `footer`: string, the footer HTML for the error summary.

The rest of the options will be rendered as the attributes of the container tag. The values will
be HTML-encoded using [[\yii\helpers\Html::encode()]]. If a value is `null`, the corresponding attribute will not be rendered.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveForm.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:28:"The generated error summary.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:21287;s:4:"name";s:12:"errorSummary";s:8:"fullName";s:36:"yii\widgets\ActiveForm::errorSummary";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveForm.php";s:9:"startLine";i:302;s:7:"endLine";i:307;s:16:"shortDescription";s:45:"Generates a summary of the validation errors.";s:11:"description";s:110:"If there is no validation error, an empty error summary markup will still be generated, but it will be hidden.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:3;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:33:"\yii\widgets\errorSummaryCssClass";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:20:"errorSummaryCssClass";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:5:"field";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:22:"yii\widgets\ActiveForm";s:10:"sourceCode";s:456:"public function field($model, $attribute, $options = [])
{
    $config = $this->fieldConfig;
    if ($config instanceof \Closure) {
        $config = call_user_func($config, $model, $attribute);
    }
    if (!isset($config['class'])) {
        $config['class'] = $this->fieldClass;
    }
    return Yii::createObject(ArrayHelper::merge($config, $options, [
        'model' => $model,
        'attribute' => $attribute,
        'form' => $this,
    ]));
}
