MessageSource";s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/DbMessageSource.php";s:9:"startLine";i:39;s:7:"endLine";i:188;s:16:"shortDescription";s:118:"DbMessageSource extends [[MessageSource]] and represents a message source that stores translated
messages in database.";s:11:"description";s:597:"The database must contain the following two tables: source_message and message.

The `source_message` table stores the messages to be translated, and the `message` table stores
the translated messages. The name of these two tables can be customized by setting [[sourceMessageTable]]
and [[messageTable]], respectively.

The database connection is specified by [[db]]. Database schema could be initialized by applying migration:

```
yii migrate --migrationPath=@yii/i18n/migrations/
```

If you don't want to use migration and need SQL instead, files for all databases are in migrations directory.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:22:"yii\i18n\MessageSource";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:18:"yii\base\Component";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:1:{s:25:"EVENT_MISSING_TRANSLATION";O:26:"yii\apidoc\models\EventDoc":18:{s:4:"type";s:32:"yii\i18n\MissingTranslationEvent";s:5:"types";a:1:{i:0;s:32:"yii\i18n\MissingTranslationEvent";}s:9:"definedBy";s:22:"yii\i18n\MessageSource";s:5:"value";s:20:"'missingTranslation'";s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:8:"yii\i18n";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:2:{s:3:"Yii";s:3:"Yii";s:9:"Component";s:18:"yii\base\Component";}}s:4:"name";s:25:"EVENT_MISSING_TRANSLATION";s:8:"fullName";s:49:"yii\i18n\MessageSource::EVENT_MISSING_TRANSLATION";s:10:"sourceFile";N;s:9:"startLine";i:28;s:7:"endLine";i:28;s:16:"shortDescription";s:67:"An event that is triggered when a message translation is not found.";s:11:"description";s:67:"An event that is triggered when a message translation is not found.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:4:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:22:"yii\i18n\MessageSource";s:10:"sourceCode";s:154:"public function init()
{
    parent::init();
    if ($this->sourceLanguage === null) {
        $this->sourceLanguage = Yii::$app->sourceLanguage;
    }
}
