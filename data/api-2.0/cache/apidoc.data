{
    $permissions = [];
    foreach ($this->getAssignments($userId) as $name => $assignment) {
        $item = $this->items[$assignment->roleName];
        if ($item->type === Item::TYPE_PERMISSION) {
            /** @var Permission $item */
            $permissions[$name] = $item;
        }
    }
    return $permissions;
}
