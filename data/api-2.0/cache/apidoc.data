name";s:16:"CACHE_KEY_PREFIX";s:8:"fullName";s:42:"yii\i18n\DbMessageSource::CACHE_KEY_PREFIX";s:10:"sourceFile";N;s:9:"startLine";i:45;s:7:"endLine";i:45;s:16:"shortDescription";s:53:"Prefix which would be used when generating cache key.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";s:63:"This constant has never been used and will be removed in 2.1.0.";s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:7:"authors";a:1:{s:7:"resurtm";s:17:"resurtm@gmail.com";}s:7:"methods";a:4:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:24:"yii\i18n\DbMessageSource";s:10:"sourceCode";s:240:"public function init()
{
    parent::init();
    $this->db = Instance::ensure($this->db, Connection::className());
    if ($this->enableCaching) {
        $this->cache = Instance::ensure($this->cache, 'yii\caching\CacheInterface');
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:45:"if [[db]] is invalid or [[cache]] is invalid.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:7086;s:4:"name";s:4:"init";s:8:"fullName";s:30:"yii\i18n\DbMessageSource::init";s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/DbMessageSource.php";s:9:"startLine";i:95;s:7:"endLine";i:102;s:16:"shortDescription";s:42:"Initializes the DbMessageSource component.";s:11:"description";s:154:"This method will initialize the [[db]] property to make sure it refers to a valid DB connection.
Configured [[cache]] component would also be initialized.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:12:"loadMessages";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:24:"yii\i18n\DbMessageSource";s:10:"sourceCode";s:514:"protected function loadMessages($category, $language)
{
    if ($this->enableCaching) {
        $key = [
            __CLASS__,
            $category,
            $language,
        ];
        $messages = $this->cache->get($key);
        if ($messages === false) {
            $messages = $this->loadMessagesFromDb($category, $language);
            $this->cache->set($key, $messages, $this->cachingDuration);
        }
        return $messages;
    }
    return $this->loadMessagesFromDb($category, $language);
}
";s:6:"params";a:2:{s:9:"$category";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$category";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:20:"The message category";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/DbMessageSource.php";}s:9:"$language";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$language";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:19:"The target language";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/DbMessageSource.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:92:"The loaded messages. The keys are original messages, and the values
are translated messages.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:7086;s:4:"name";s:12:"loadMessages";s:8:"fullName";s:38:"yii\i18n\DbMessageSource::loadMessages";s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/DbMessageSource.php";s:9:"startLine";i:114;s:7:"endLine";i:132;s:16:"shortDescription";s:70:"Loads the message translation for the specified language and category.";s:11:"description";s:95:"If translation for specific locale code such as `en-US` isn't found it
tries more generic `en`.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:18:"loadMessagesFromDb";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:24:"yii\i18n\DbMessageSource";s:10:"sourceCode";s:972:"protected function loadMessagesFromDb($category, $language)
{
    $mainQuery = (new Query())->select(['message' => 't1.message', 'translation' => 't2.translation'])
        ->from(['t1' => $this->sourceMessageTable, 't2' => $this->messageTable])
        ->where([
            't1.id' => new Expression('[[t2.id]]'),
            't1.category' => $category,
            't2.language' => $language,
        ]);
    $fallbackLanguage = substr($language, 0, 2);
    $fallbackSourceLanguage = substr($this->sourceLanguage, 0, 2);
    if ($fallbackLanguage !== $language) {
        $mainQuery->union($this->createFallbackQuery($category, $language, $fallbackLanguage), true);
    } elseif ($language === $fallbackSourceLanguage) {
        $mainQuery->union($this->createFallbackQuery($category, $language, $fallbackSourceLanguage), true);
    }
    $messages = $mainQuery->createCommand($this->db)->queryAll();
    return ArrayHelper::map($messages, 'message', 'translation');
}
";s:6:"params";a:2:{s:9:"$category";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$category";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:21:"The message category.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/DbMessageSource.php";}s:9:"$language";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$language";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:20:"The target language.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/DbMessageSource.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:34:"The messages loaded from database.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:7086;s:4:"name";s:18:"loadMessagesFromDb";s:8:"fullName";s:44:"yii\i18n\DbMessageSource::loadMessagesFromDb";s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/DbMessageSource.php";s:9:"startLine";i:141;s:7:"endLine";i:163;s:16:"shortDescription";s:33:"Loads the messages from database.";s:11:"description";s:78:"You may override this method to customize the message storage in the database.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:19:"createFallbackQuery";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:24:"yii\i18n\DbMessageSource";s:10:"sourceCode";s:580:"protected function createFallbackQuery($category, $language, $fallbackLanguage)
{
    return (new Query())->select(['message' => 't1.message', 'translation' => 't2.translation'])
        ->from(['t1' => $this->sourceMessageTable, 't2' => $this->messageTable])
        ->where([
            't1.id' => new Expression('[[t2.id]]'),
            't1.category' => $category,
            't2.language' => $fallbackLanguage,
        ])->andWhere([
            'NOT IN', 't2.id', (new Query())->select('[[id]]')->from($this->messageTable)->where(['language' => $language]),
        ]);
}
