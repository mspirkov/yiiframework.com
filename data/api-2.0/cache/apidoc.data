e/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MessageController.php";}s:8:"$catalog";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$catalog";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:15:"Message catalog";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MessageController.php";}s:11:"$markUnused";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:11:"$markUnused";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:41:"If obsolete translations should be marked";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MessageController.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:40168;s:4:"name";s:16:"saveMessagesToPO";s:8:"fullName";s:59:"yii\console\controllers\MessageController::saveMessagesToPO";s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MessageController.php";s:9:"startLine";i:810;s:7:"endLine";i:893;s:16:"shortDescription";s:29:"Writes messages into PO file.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"saveMessagesToPOT";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:41:"yii\console\controllers\MessageController";s:10:"sourceCode";s:892:"protected function saveMessagesToPOT($messages, $dirName, $catalog)
{
    $file = str_replace('\\', '/', "$dirName/$catalog.pot");
    FileHelper::createDirectory(dirname($file));
    $this->stdout("Saving messages to $file...\n");
    $poFile = new GettextPoFile();
    $merged = [];
    $hasSomethingToWrite = false;
    foreach ($messages as $category => $msgs) {
        $msgs = array_values(array_unique($msgs));
        sort($msgs);
        foreach ($msgs as $message) {
            $merged[$category . chr(4) . $message] = '';
        }
        $this->stdout("Category \"$category\" merged.\n");
        $hasSomethingToWrite = true;
    }
    if ($hasSomethingToWrite) {
        ksort($merged);
        $poFile->save($file, $merged);
        $this->stdout("Translation saved.\n", Console::FG_GREEN);
    } else {
        $this->stdout("Nothing to save.\n", Console::FG_GREEN);
    }
}
