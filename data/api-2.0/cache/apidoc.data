}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:13:"yii\behaviors";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:5:{s:7:"Closure";s:7:"Closure";s:8:"Behavior";s:17:"yii\base\Behavior";s:5:"Event";s:14:"yii\base\Event";s:12:"ActiveRecord";s:19:"yii\db\ActiveRecord";s:16:"BaseActiveRecord";s:23:"yii\db\BaseActiveRecord";}}s:4:"name";s:6:"events";s:8:"fullName";s:40:"yii\behaviors\AttributesBehavior::events";s:10:"sourceFile";s:107:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/behaviors/AttributesBehavior.php";s:9:"startLine";i:131;s:7:"endLine";i:139;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:18:"evaluateAttributes";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:32:"yii\behaviors\AttributesBehavior";s:10:"sourceCode";s:868:"public function evaluateAttributes($event)
{
    if (
        $this->skipUpdateOnClean
        && $event->name === ActiveRecord::EVENT_BEFORE_UPDATE
        && empty($this->owner->dirtyAttributes)
    ) {
        return;
    }
    $attributes = array_keys(array_filter($this->attributes, function ($carry) use ($event) {
        return array_key_exists($event->name, $carry);
    }));
    if (!empty($this->order[$event->name])) {
        $attributes = array_merge(
            array_intersect((array) $this->order[$event->name], $attributes),
            array_diff($attributes, (array) $this->order[$event->name])
        );
    }
    foreach ($attributes as $attribute) {
        if ($this->preserveNonEmptyValues && !empty($this->owner->$attribute)) {
            continue;
        }
        $this->owner->$attribute = $this->getValue($attribute, $event);
    }
}
";s:6:"params";a:1:{s:6:"$event";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$event";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:15:"\yii\base\Event";s:5:"types";a:1:{i:0;s:15:"\yii\base\Event";}s:10:"sourceFile";s:107:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/behaviors/AttributesBehavior.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:30198;s:4:"name";s:18:"evaluateAttributes";s:8:"fullName";s:52:"yii\behaviors\AttributesBehavior::evaluateAttributes";s:10:"sourceFile";s:107:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/behaviors/AttributesBehavior.php";s:9:"startLine";i:145;s:7:"endLine";i:169;s:16:"shortDescription";s:73:"Evaluates the attributes values and assigns it to the current attributes.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"getValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:32:"yii\behaviors\AttributesBehavior";s:10:"sourceCode";s:350:"protected function getValue($attribute, $event)
{
    if (!isset($this->attributes[$attribute][$event->name])) {
        return null;
    }
    $value = $this->attributes[$attribute][$event->name];
    if ($value instanceof Closure || (is_array($value) && is_callable($value))) {
        return $value($event, $attribute);
    }
    return $value;
}
