/yiiframework.com/data/yii-2.0/framework/db/QueryBuilder.php";s:9:"startLine";i:458;s:7:"endLine";i:504;s:16:"shortDescription";s:39:"Generates a batch INSERT SQL statement.";s:11:"description";s:305:"For example,

```
$sql = $queryBuilder->batchInsert('user', ['name', 'age'], [
    ['Tom', 30],
    ['Jane', 20],
    ['Linda', 25],
]);
```

Note that the values in each row must match the corresponding column names.

The method will properly escape the column names, and quote the values to be inserted.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"upsert";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\db\QueryBuilder";s:10:"sourceCode";s:183:"public function upsert($table, $insertColumns, $updateColumns, &$params)
{
    throw new NotSupportedException($this->db->getDriverName() . ' does not support upsert statements.');
}
