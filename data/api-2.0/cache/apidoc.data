ii-2.0/framework/db/sqlite/QueryBuilder.php";s:9:"startLine";i:134;s:7:"endLine";i:187;s:16:"shortDescription";s:39:"Generates a batch INSERT SQL statement.";s:11:"description";s:236:"For example,

```
