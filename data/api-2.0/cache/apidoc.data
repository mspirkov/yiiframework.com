";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:195066;s:4:"name";s:25:"defaultExpressionBuilders";s:8:"fullName";s:52:"yii\db\pgsql\QueryBuilder::defaultExpressionBuilders";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/QueryBuilder.php";s:9:"startLine";i:96;s:7:"endLine";i:102;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:11:"createIndex";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\db\pgsql\QueryBuilder";s:10:"sourceCode";s:504:"public function createIndex($name, $table, $columns, $unique = false)
{
    if ($unique === self::INDEX_UNIQUE || $unique === true) {
        $index = false;
        $unique = true;
    } else {
        $index = $unique;
        $unique = false;
    }
    return ($unique ? 'CREATE UNIQUE INDEX ' : 'CREATE INDEX ') .
    $this->db->quoteTableName($name) . ' ON ' .
    $this->db->quoteTableName($table) .
    ($index !== false ? " USING $index" : '') .
    ' (' . $this->buildColumns($columns) . ')';
}
