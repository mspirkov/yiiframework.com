atedReason";N;s:4:"tags";a:1:{i:1;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:11:"getTypecast";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:34:"yii\db\pgsql\JsonExpressionBuilder";s:10:"sourceCode";s:173:"protected function getTypecast(JsonExpression $expression)
{
    if ($expression->getType() === null) {
        return '';
    }
    return '::' . $expression->getType();
}
