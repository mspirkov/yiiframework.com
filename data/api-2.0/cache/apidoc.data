";s:6:"params";a:1:{s:5:"$name";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$name";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:15:"The method name";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/BaseObject.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:29:"Whether the method is defined";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:68600;s:4:"name";s:9:"hasMethod";s:8:"fullName";s:30:"yii\base\BaseObject::hasMethod";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/BaseObject.php";s:9:"startLine";i:294;s:7:"endLine";i:297;s:16:"shortDescription";s:55:"Returns a value indicating whether a method is defined.";s:11:"description";s:154:"The default implementation is a call to php function `method_exists()`.
You may override this method when you implemented the php magic method `__call()`.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:10:"properties";a:0:{}s:9:"namespace";s:8:"yii\base";s:13:"phpDocContext";r:68600;s:4:"name";s:19:"yii\base\BaseObject";s:8:"fullName";s:19:"yii\base\BaseObject";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/BaseObject.php";s:9:"startLine";i:77;s:7:"endLine";i:298;s:16:"shortDescription";s:68:"BaseObject is the base class that implements the *property* feature.";s:11:"description";s:2061:"A property is defined by a getter method (e.g. `getLabel`), and/or a setter method (e.g. `setLabel`). For example,
the following getter and setter methods define a property named `label`:

```
private $_label;

public function getLabel()
{
    return $this->_label;
}

public function setLabel($value)
{
    $this->_label = $value;
}
```

Property names are *case-insensitive*.

A property can be accessed like a member variable of an object. Reading or writing a property will cause the invocation
of the corresponding getter or setter method. For example,

```
// equivalent to $label = $object->getLabel();
$label = $object->label;
// equivalent to $object->setLabel('abc');
$object->label = 'abc';
```

If a property has only a getter method and has no setter method, it is considered as *read-only*. In this case, trying
to modify the property value will cause an exception.

One can call [[hasProperty()]], [[canGetProperty()]] and/or [[canSetProperty()]] to check the existence of a property.

Besides the property feature, BaseObject also introduces an important object initialization life cycle. In particular,
creating an new instance of BaseObject or its derived class will involve the following life cycles sequentially:

1. the class constructor is invoked;
2. object properties are initialized according to the given configuration;
3. the `init()` method is invoked.

In the above, both Step 2 and 3 occur at the end of the class constructor. It is recommended that
you perform object initialization in the `init()` method because at that stage, the object configuration
is already applied.

In order to ensure the above life cycles, if a child class of BaseObject needs to override the constructor,
it should be done like the following:

```
public function __construct($param1, $param2, ..., $config = [])
{
    ...
    parent::__construct($config);
}
```

That is, a `$config` parameter (defaults to `[]`) should be declared as the last parameter
of the constructor, and the parent implementation should be called at the end of the constructor.";s:5:"since";s:6:"2.0.13";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"yii\base\Response";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:18:"yii\base\Component";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:2:{s:4:"send";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\base\Response";s:10:"sourceCode";s:27:"public function send()
{
}
