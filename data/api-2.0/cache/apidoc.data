";s:6:"params";a:2:{s:5:"$name";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$name";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";}s:6:"$table";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$table";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:160667;s:4:"name";s:16:"dropDefaultValue";s:8:"fullName";s:43:"yii\db\mssql\QueryBuilder::dropDefaultValue";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";s:9:"startLine";i:229;s:7:"endLine";i:233;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:13:"resetSequence";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\db\mssql\QueryBuilder";s:10:"sourceCode";s:1225:"public function resetSequence($tableName, $value = null)
{
    $table = $this->db->getTableSchema($tableName);
    if ($table !== null && $table->sequenceName !== null) {
        $tableName = $this->db->quoteTableName($tableName);
        if ($value === null || $value === 1) {
            $key = $this->db->quoteColumnName(reset($table->primaryKey));
            $subSql = (new Query())
                ->select('last_value')
                ->from('sys.identity_columns')
                ->where(['object_id' => new Expression("OBJECT_ID('{$tableName}')")])
                ->andWhere(['IS NOT', 'last_value', null])
                ->createCommand($this->db)
                ->getRawSql();
            $sql = "SELECT COALESCE(MAX({$key}), CASE WHEN EXISTS({$subSql}) THEN 0 ELSE 1 END) FROM {$tableName}";
            $value = $this->db->createCommand($sql)->queryScalar();
        } else {
            $value = (int) $value;
        }
        return "DBCC CHECKIDENT ('{$tableName}', RESEED, {$value})";
    } elseif ($table === null) {
        throw new InvalidArgumentException("Table not found: $tableName");
    }
    throw new InvalidArgumentException("There is not sequence associated with table '$tableName'.");
}
";s:6:"params";a:2:{s:10:"$tableName";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$tableName";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:62:"The name of the table whose primary key sequence will be reset";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";}s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:131:"The value for the primary key of the next new row inserted. If this is not set,
the next new row's primary key will have a value 1.";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";}}s:10:"exceptions";a:1:{s:34:"\yii\base\InvalidArgumentException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:78:"if the table does not exist or there is no sequence associated with the table.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:40:"The SQL statement for resetting sequence";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:160667;s:4:"name";s:13:"resetSequence";s:8:"fullName";s:40:"yii\db\mssql\QueryBuilder::resetSequence";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";s:9:"startLine";i:245;s:7:"endLine";i:272;s:16:"shortDescription";s:82:"Creates a SQL statement for resetting the sequence value of a table's primary key.";s:11:"description";s:117:"The sequence will be reset such that the primary key of the next new row inserted
will have the specified value or 1.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"checkIntegrity";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\db\mssql\QueryBuilder";s:10:"sourceCode";s:727:"public function checkIntegrity($check = true, $schema = '', $table = '')
{
    /**
     * @var Schema
     * @phpstan-var Schema<ColumnSchema>
     */
    $dbSchema = $this->db->getSchema();
    $enable = $check ? 'CHECK' : 'NOCHECK';
    $schema = $schema ?: $dbSchema->defaultSchema;
    $tableNames = $this->db->getTableSchema($table) ? [$table] : $dbSchema->getTableNames($schema);
    $viewNames = $dbSchema->getViewNames($schema);
    $tableNames = array_diff($tableNames, $viewNames);
    $command = '';
    foreach ($tableNames as $tableName) {
        $tableName = $this->db->quoteTableName("{$schema}.{$tableName}");
        $command .= "ALTER TABLE $tableName $enable CONSTRAINT ALL; ";
    }
    return $command;
}
