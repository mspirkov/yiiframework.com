:19:"isPassedByReference";N;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveRelationTrait.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:1:" ";s:10:"returnType";s:31:"\yii\db\ActiveRecordInterface[]";s:11:"returnTypes";a:1:{i:0;s:31:"\yii\db\ActiveRecordInterface[]";}s:19:"isReturnByReference";N;s:13:"phpDocContext";N;s:4:"name";s:3:"all";s:8:"fullName";s:31:"yii\db\ActiveRelationTrait::all";s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveRelationTrait.php";s:9:"startLine";N;s:7:"endLine";N;s:16:"shortDescription";s:50:"See [[ActiveQueryInterface::all()]] for more info.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:7:"__clone";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:26:"yii\db\ActiveRelationTrait";s:10:"sourceCode";s:338:"public function __clone()
{
    parent::__clone();
    // make a clone of "via" object so that the same query object can be reused multiple times
    if (is_object($this->via)) {
        $this->via = clone $this->via;
    } elseif (is_array($this->via)) {
        $this->via = [$this->via[0], clone $this->via[1], $this->via[2]];
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:6:"yii\db";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:2:{s:24:"InvalidArgumentException";s:33:"yii\base\InvalidArgumentException";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";}}s:4:"name";s:7:"__clone";s:8:"fullName";s:35:"yii\db\ActiveRelationTrait::__clone";s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveRelationTrait.php";s:9:"startLine";i:74;s:7:"endLine";i:83;s:16:"shortDescription";s:24:"Clones internal objects.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:3:"via";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:26:"yii\db\ActiveRelationTrait";s:10:"sourceCode";s:332:"public function via($relationName, ?callable $callable = null)
{
    $relation = $this->primaryModel->getRelation($relationName);
    $callableUsed = $callable !== null;
    $this->via = [$relationName, $relation, $callableUsed];
    if ($callable !== null) {
        call_user_func($callable, $relation);
    }
    return $this;
}
";s:6:"params";a:2:{s:13:"$relationName";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:13:"$relationName";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:74:"The relation name. This refers to a relation declared in [[primaryModel]].";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveRelationTrait.php";}s:9:"$callable";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$callable";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:169:"A PHP callback for customizing the relation associated with the junction table.
Its signature should be `function($query)`, where `$query` is the query to be customized.";s:4:"type";s:13:"callable|null";s:5:"types";a:2:{i:0;s:8:"callable";i:1;s:4:"null";}s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveRelationTrait.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:27:"The relation object itself.";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:215316;s:4:"name";s:3:"via";s:8:"fullName";s:31:"yii\db\ActiveRelationTrait::via";s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveRelationTrait.php";s:9:"startLine";i:109;s:7:"endLine";i:119;s:16:"shortDescription";s:58:"Specifies the relation associated with the junction table.";s:11:"description";s:403:"Use this method to specify a pivot record/table when declaring a relation in the [[ActiveRecord]] class:

```
class Order extends ActiveRecord
{
   public function getOrderItems() {
       return $this->hasMany(OrderItem::class, ['order_id' => 'id']);
   }

   public function getItems() {
       return $this->hasMany(Item::class, ['id' => 'item_id'])
                   ->via('orderItems');
   }
}
