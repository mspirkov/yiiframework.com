";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:103:"An HTML hyperlink that can be displayed on your Web page showing "Powered by Yii Framework" information";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:152664;s:4:"name";s:7:"powered";s:8:"fullName";s:20:"yii\BaseYii::powered";s:10:"sourceFile";s:86:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/BaseYii.php";s:9:"startLine";i:517;s:7:"endLine";i:522;s:16:"shortDescription";s:112:"Returns an HTML hyperlink that can be displayed on your Web page showing "Powered by Yii Framework" information.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";s:51:"since 2.0.14, this method will be removed in 2.1.0.";s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:1:"t";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:11:"yii\BaseYii";s:10:"sourceCode";s:450:"public static function t($category, $message, $params = [], $language = null)
{
    if (static::$app !== null) {
        return static::$app->getI18n()->translate($category, $message, $params, $language ?: static::$app->language);
    }
    $placeholders = [];
    foreach ((array) $params as $name => $value) {
        $placeholders['{' . $name . '}'] = $value;
    }
    return ($placeholders === []) ? $message : strtr($message, $placeholders);
}
