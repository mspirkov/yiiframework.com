Note that if the page size is infinite, a value -1 will be returned.";s:10:"returnType";s:3:"int";s:11:"returnTypes";a:1:{i:0;s:3:"int";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:9077;s:4:"name";s:8:"getLimit";s:8:"fullName";s:29:"yii\data\Pagination::getLimit";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/Pagination.php";s:9:"startLine";i:305;s:7:"endLine";i:310;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"getLinks";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\data\Pagination";s:10:"sourceCode";s:695:"public function getLinks($absolute = false)
{
    $currentPage = $this->getPage();
    $pageCount = $this->getPageCount();
    $links = [Link::REL_SELF => $this->createUrl($currentPage, null, $absolute)];
    if ($pageCount > 0) {
        $links[self::LINK_FIRST] = $this->createUrl(0, null, $absolute);
        $links[self::LINK_LAST] = $this->createUrl($pageCount - 1, null, $absolute);
        if ($currentPage > 0) {
            $links[self::LINK_PREV] = $this->createUrl($currentPage - 1, null, $absolute);
        }
        if ($currentPage < $pageCount - 1) {
            $links[self::LINK_NEXT] = $this->createUrl($currentPage + 1, null, $absolute);
        }
    }
    return $links;
}
