be ordered by the preference level.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:113036;s:4:"name";s:22:"setAcceptableLanguages";s:8:"fullName";s:39:"yii\web\Request::setAcceptableLanguages";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";s:9:"startLine";i:1576;s:7:"endLine";i:1579;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"parseAcceptHeader";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\web\Request";s:10:"sourceCode";s:1622:"public function parseAcceptHeader($header)
{
    $accepts = [];
    foreach (explode(',', $header) as $i => $part) {
        $params = preg_split('/\s*;\s*/', trim($part), -1, PREG_SPLIT_NO_EMPTY);
        if (empty($params)) {
            continue;
        }
        $values = [
            'q' => [$i, array_shift($params), 1],
        ];
        foreach ($params as $param) {
            if (strpos($param, '=') !== false) {
                list($key, $value) = explode('=', $param, 2);
                if ($key === 'q') {
                    $values['q'][2] = (float) $value;
                } else {
                    $values[$key] = $value;
                }
            } else {
                $values[] = $param;
            }
        }
        $accepts[] = $values;
    }
    usort($accepts, function ($a, $b) {
        $a = $a['q']; // index, name, q
        $b = $b['q'];
        if ($a[2] > $b[2]) {
            return -1;
        }
        if ($a[2] < $b[2]) {
            return 1;
        }
        if ($a[1] === $b[1]) {
            return $a[0] > $b[0] ? 1 : -1;
        }
        if ($a[1] === '*/*') {
            return 1;
        }
        if ($b[1] === '*/*') {
            return -1;
        }
        $wa = $a[1][strlen($a[1]) - 1] === '*';
        $wb = $b[1][strlen($b[1]) - 1] === '*';
        if ($wa xor $wb) {
            return $wa ? 1 : -1;
        }
        return $a[0] > $b[0] ? 1 : -1;
    });
    $result = [];
    foreach ($accepts as $accept) {
        $name = $accept['q'][1];
        $accept['q'] = $accept['q'][2];
        $result[$name] = $accept;
    }
    return $result;
}
";s:6:"params";a:1:{s:7:"$header";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$header";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:23:"The header to be parsed";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:112:"The acceptable values ordered by their quality score. The values with the highest scores
will be returned first.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:113036;s:4:"name";s:17:"parseAcceptHeader";s:8:"fullName";s:34:"yii\web\Request::parseAcceptHeader";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";s:9:"startLine";i:1605;s:7:"endLine";i:1671;s:16:"shortDescription";s:56:"Parses the given `Accept` (or `Accept-Language`) header.";s:11:"description";s:744:"This method will return the acceptable values with their quality scores and the corresponding parameters
as specified in the given `Accept` header. The array keys of the return value are the acceptable values,
while the array values consisting of the corresponding quality scores and parameters. The acceptable
values with the highest quality scores will be returned first. For example,

```
$header = 'text/plain; q=0.5, application/json; version=1.0, application/xml; version=2.0;';
$accepts = $request->parseAcceptHeader($header);
print_r($accepts);
// displays:
// [
//     'application/json' => ['q' => 1, 'version' => '1.0'],
//      'application/xml' => ['q' => 1, 'version' => '2.0'],
//           'text/plain' => ['q' => 0.5],
// ]
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:20:"getPreferredLanguage";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\web\Request";s:10:"sourceCode";s:805:"public function getPreferredLanguage(array $languages = [])
{
    if (empty($languages)) {
        return Yii::$app->language;
    }
    foreach ($this->getAcceptableLanguages() as $acceptableLanguage) {
        $acceptableLanguage = str_replace('_', '-', strtolower($acceptableLanguage));
        foreach ($languages as $language) {
            $normalizedLanguage = str_replace('_', '-', strtolower($language));
            if (
                $normalizedLanguage === $acceptableLanguage // en-us==en-us
                || strpos($acceptableLanguage, $normalizedLanguage . '-') === 0 // en==en-us
                || strpos($normalizedLanguage, $acceptableLanguage . '-') === 0 // en-us==en
            ) {
                return $language;
            }
        }
    }
    return reset($languages);
}
";s:6:"params";a:1:{s:10:"$languages";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$languages";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:149:"A list of the languages supported by the application. If this is empty, the current
application language will be returned without further processing.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:45:"The language that the application should use.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:113036;s:4:"name";s:20:"getPreferredLanguage";s:8:"fullName";s:37:"yii\web\Request::getPreferredLanguage";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";s:9:"startLine";i:1681;s:7:"endLine";i:1702;s:16:"shortDescription";s:76:"Returns the user-preferred language that should be used by this application.";s:11:"description";s:156:"The language resolution is based on the user preferred languages and the languages
supported by the application. The method will try to find the best match.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"getETags";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\web\Request";s:10:"sourceCode";s:228:"public function getETags()
{
    if ($this->headers->has('If-None-Match')) {
        return preg_split('/[\s,]+/', str_replace('-gzip', '', $this->headers->get('If-None-Match')), -1, PREG_SPLIT_NO_EMPTY);
    }
    return [];
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:15:"The entity tags";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:113036;s:4:"name";s:8:"getETags";s:8:"fullName";s:25:"yii\web\Request::getETags";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";s:9:"startLine";i:1709;s:7:"endLine";i:1716;s:16:"shortDescription";s:15:"Gets the Etags.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:10:"getCookies";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\web\Request";s:10:"sourceCode";s:218:"public function getCookies()
{
    if ($this->_cookies === null) {
        $this->_cookies = new CookieCollection($this->loadCookies(), [
            'readOnly' => true,
        ]);
    }
    return $this->_cookies;
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:22:"The cookie collection.";s:10:"returnType";s:25:"\yii\web\CookieCollection";s:11:"returnTypes";a:1:{i:0;s:25:"\yii\web\CookieCollection";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:113036;s:4:"name";s:10:"getCookies";s:8:"fullName";s:27:"yii\web\Request::getCookies";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";s:9:"startLine";i:1735;s:7:"endLine";i:1744;s:16:"shortDescription";s:30:"Returns the cookie collection.";s:11:"description";s:255:"Through the returned cookie collection, you may access a cookie using the following syntax:

```
$cookie = $request->cookies['name']
if ($cookie !== null) {
    $value = $cookie->value;
}

// alternatively
$value = $request->cookies->getValue('name');
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"loadCookies";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:15:"yii\web\Request";s:10:"sourceCode";s:1467:"protected function loadCookies()
{
    $cookies = [];
    if ($this->enableCookieValidation) {
        if ($this->cookieValidationKey == '') {
            throw new InvalidConfigException(get_class($this) . '::cookieValidationKey must be configured with a secret key.');
        }
        foreach ($_COOKIE as $name => $value) {
            if (!is_string($value)) {
                continue;
            }
            $data = Yii::$app->getSecurity()->validateData($value, $this->cookieValidationKey);
            if ($data === false) {
                continue;
            }
            if (defined('PHP_VERSION_ID') && PHP_VERSION_ID >= 70000) {
                $data = @unserialize($data, ['allowed_classes' => false]);
            } else {
                $data = @unserialize($data);
            }
            if (is_array($data) && isset($data[0], $data[1]) && $data[0] === $name) {
                $cookies[$name] = Yii::createObject([
                    'class' => 'yii\web\Cookie',
                    'name' => $name,
                    'value' => $data[1],
                    'expire' => null,
                ]);
            }
        }
    } else {
        foreach ($_COOKIE as $name => $value) {
            $cookies[$name] = Yii::createObject([
                'class' => 'yii\web\Cookie',
                'name' => $name,
                'value' => $value,
                'expire' => null,
            ]);
        }
    }
    return $cookies;
}
";s:6:"params";a:0:{}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:77:"if [[cookieValidationKey]] is not set when [[enableCookieValidation]] is true";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:33:"The cookies obtained from request";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:113036;s:4:"name";s:11:"loadCookies";s:8:"fullName";s:28:"yii\web\Request::loadCookies";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";s:9:"startLine";i:1751;s:7:"endLine";i:1792;s:16:"shortDescription";s:48:"Converts `$_COOKIE` into an array of [[Cookie]].";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:12:"getCsrfToken";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\web\Request";s:10:"sourceCode";s:423:"public function getCsrfToken($regenerate = false)
{
    if ($this->validateCsrfHeaderOnly) {
        return null;
    }
    if ($this->_csrfToken === null || $regenerate) {
        $token = $this->loadCsrfToken();
        if ($regenerate || empty($token)) {
            $token = $this->generateCsrfToken();
        }
        $this->_csrfToken = Yii::$app->security->maskToken($token);
    }
    return $this->_csrfToken;
}
";s:6:"params";a:1:{s:11:"$regenerate";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:11:"$regenerate";s:10:"isOptional";b:1;s:12:"defaultValue";s:5:"false";s:19:"isPassedByReference";b:0;s:11:"description";s:168:"Whether to regenerate CSRF token. When this parameter is true, each time
this method is called, a new CSRF token will be generated and persisted (in session or cookie).";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:102:"The token used to perform CSRF validation. Null is returned if the [[validateCsrfHeaderOnly]] is true.";s:10:"returnType";s:11:"null|string";s:11:"returnTypes";a:2:{i:0;s:4:"null";i:1;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:113036;s:4:"name";s:12:"getCsrfToken";s:8:"fullName";s:29:"yii\web\Request::getCsrfToken";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";s:9:"startLine";i:1805;s:7:"endLine";i:1820;s:16:"shortDescription";s:50:"Returns the token used to perform CSRF validation.";s:11:"description";s:209:"This token is generated in a way to prevent [BREACH attacks](https://en.wikipedia.org/wiki/BREACH). It may be passed
along via a hidden field of an HTML form or an HTTP header value to support CSRF validation.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"loadCsrfToken";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:15:"yii\web\Request";s:10:"sourceCode";s:203:"protected function loadCsrfToken()
{
    if ($this->enableCsrfCookie) {
        return $this->getCookies()->getValue($this->csrfParam);
    }
    return Yii::$app->getSession()->get($this->csrfParam);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:113:"The CSRF token loaded from cookie or session. Null is returned if the cookie or session
does not have CSRF token.";s:10:"returnType";s:11:"string|null";s:11:"returnTypes";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:113036;s:4:"name";s:13:"loadCsrfToken";s:8:"fullName";s:30:"yii\web\Request::loadCsrfToken";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";s:9:"startLine";i:1827;s:7:"endLine";i:1834;s:16:"shortDescription";s:44:"Loads the CSRF token from cookie or session.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"generateCsrfToken";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:15:"yii\web\Request";s:10:"sourceCode";s:356:"protected function generateCsrfToken()
{
    $token = Yii::$app->getSecurity()->generateRandomString();
    if ($this->enableCsrfCookie) {
        $cookie = $this->createCsrfCookie($token);
        Yii::$app->getResponse()->getCookies()->add($cookie);
    } else {
        Yii::$app->getSession()->set($this->csrfParam, $token);
    }
    return $token;
}
