are translated messages.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:7575;s:4:"name";s:12:"loadMessages";s:8:"fullName";s:36:"yii\i18n\MessageSource::loadMessages";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/MessageSource.php";s:9:"startLine";i:65;s:7:"endLine";i:68;s:16:"shortDescription";s:70:"Loads the message translation for the specified language and category.";s:11:"description";s:95:"If translation for specific locale code such as `en-US` isn't found it
tries more generic `en`.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"translate";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:22:"yii\i18n\MessageSource";s:10:"sourceCode";s:232:"public function translate($category, $message, $language)
{
    if ($this->forceTranslation || $language !== $this->sourceLanguage) {
        return $this->translateMessage($category, $message, $language);
    }
    return false;
}
";s:6:"params";a:3:{s:9:"$category";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$category";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:20:"The message category";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/MessageSource.php";}s:8:"$message";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$message";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:28:"The message to be translated";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/MessageSource.php";}s:9:"$language";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$language";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:19:"The target language";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/MessageSource.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:77:"The translated message or false if translation wasn't found or isn't required";s:10:"returnType";s:11:"string|bool";s:11:"returnTypes";a:2:{i:0;s:6:"string";i:1;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:7575;s:4:"name";s:9:"translate";s:8:"fullName";s:33:"yii\i18n\MessageSource::translate";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/MessageSource.php";s:9:"startLine";i:84;s:7:"endLine";i:91;s:16:"shortDescription";s:47:"Translates a message to the specified language.";s:11:"description";s:268:"Note that unless [[forceTranslation]] is true, if the target language
is the same as the [[sourceLanguage|source language]], the message
will NOT be translated.

If a translation is not found, a [[EVENT_MISSING_TRANSLATION|missingTranslation]] event will be triggered.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"translateMessage";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:22:"yii\i18n\MessageSource";s:10:"sourceCode";s:886:"protected function translateMessage($category, $message, $language)
{
    $key = $language . '/' . $category;
    if (!isset($this->_messages[$key])) {
        $this->_messages[$key] = $this->loadMessages($category, $language);
    }
    if (isset($this->_messages[$key][$message]) && $this->_messages[$key][$message] !== '') {
        return $this->_messages[$key][$message];
    } elseif ($this->hasEventHandlers(self::EVENT_MISSING_TRANSLATION)) {
        $event = new MissingTranslationEvent([
            'category' => $category,
            'message' => $message,
            'language' => $language,
        ]);
        $this->trigger(self::EVENT_MISSING_TRANSLATION, $event);
        if ($event->translatedMessage !== null) {
            return $this->_messages[$key][$message] = $event->translatedMessage;
        }
    }
    return $this->_messages[$key][$message] = false;
}
