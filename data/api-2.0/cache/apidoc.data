";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:70140;s:4:"name";s:15:"ensureBehaviors";s:8:"fullName";s:35:"yii\base\Component::ensureBehaviors";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Component.php";s:9:"startLine";i:770;s:7:"endLine";i:778;s:16:"shortDescription";s:89:"Makes sure that the behaviors declared in [[behaviors()]] are attached to this component.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:10:"properties";a:1:{s:10:"$behaviors";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:20:"\yii\base\Behavior[]";s:5:"types";a:1:{i:0;s:20:"\yii\base\Behavior[]";}s:12:"defaultValue";N;s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:18:"yii\base\Component";s:13:"phpDocContext";N;s:4:"name";s:10:"$behaviors";s:8:"fullName";s:30:"yii\base\Component::$behaviors";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Component.php";s:9:"startLine";N;s:7:"endLine";N;s:16:"shortDescription";s:45:"List of behaviors attached to this component.";s:11:"description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:45:"List of behaviors attached to this component.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:9:"namespace";s:8:"yii\base";s:13:"phpDocContext";r:70140;s:4:"name";s:18:"yii\base\Component";s:8:"fullName";s:18:"yii\base\Component";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Component.php";s:9:"startLine";i:104;s:7:"endLine";i:810;s:16:"shortDescription";s:92:"Component is the base class that implements the *property*, *event* and *behavior* features.";s:11:"description";s:2992:"Component provides the *event* and *behavior* features, in addition to the *property* feature which is implemented in
its parent class [[\yii\base\BaseObject|BaseObject]].

Event is a way to "inject" custom code into existing code at certain places. For example, a comment object can trigger
an "add" event when the user adds a comment. We can write custom code and attach it to this event so that when the event
is triggered (i.e. comment will be added), our custom code will be executed.

An event is identified by a name that should be unique within the class it is defined at. Event names are *case-sensitive*.

One or multiple PHP callbacks, called *event handlers*, can be attached to an event. You can call [[trigger()]] to
raise an event. When an event is raised, the event handlers will be invoked automatically in the order they were
attached.

To attach an event handler to an event, call [[on()]]:

```
$post->on('update', function ($event) {
    // send email notification
});
```

In the above, an anonymous function is attached to the "update" event of the post. You may attach
the following types of event handlers:

- anonymous function: `function ($event) { ... }`
- object method: `[$object, 'handleAdd']`
- static class method: `['Page', 'handleAdd']`
- global function: `'handleAdd'`

The signature of an event handler should be like the following:

```
function foo($event)
```

where `$event` is an [[Event]] object which includes parameters associated with the event.

You can also attach a handler to an event when configuring a component with a configuration array.
The syntax is like the following:

```
[
    'on add' => function ($event) { ... }
]
```

where `on add` stands for attaching an event to the `add` event.

Sometimes, you may want to associate extra data with an event handler when you attach it to an event
and then access it when the handler is invoked. You may do so by

```
$post->on('update', function ($event) {
    // the data can be accessed via $event->data
}, $data);
```

A behavior is an instance of [[Behavior]] or its child class. A component can be attached with one or multiple
behaviors. When a behavior is attached to a component, its public properties and methods can be accessed via the
component directly, as if the component owns those properties and methods.

To attach a behavior to a component, declare it in [[behaviors()]], or explicitly call [[attachBehavior]]. Behaviors
declared in [[behaviors()]] are automatically attached to the corresponding component.

One can also attach a behavior to a component when configuring it with a configuration array. The syntax is like the
following:

```
[
    'as tree' => [
        'class' => 'Tree',
    ],
]
```

where `as tree` stands for attaching a behavior named `tree`, and the array will be passed to [[\Yii::createObject()]]
to create the behavior object.

For more details and usage information on Component, see the [guide article on components](guide:concept-components).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:3:{i:0;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:9:"behaviors";s:7:"␀*␀type";O:37:"phpDocumentor\Reflection\Types\Array_":3:{s:12:"␀*␀valueType";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:18:"\yii\base\Behavior";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:8:"Behavior";}}s:10:"␀*␀keyType";N;s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:71232;}i:3;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:21:"phpstan-property-read";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:28:"Behavior<$this>[] $behaviors";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:4;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:19:"psalm-property-read";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:28:"Behavior<$this>[] $behaviors";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:20:"yii\base\WidgetEvent";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:14:"yii\base\Event";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits