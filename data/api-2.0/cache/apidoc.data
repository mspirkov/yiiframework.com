If so, the corresponding file will be loaded as the application configuration.
Otherwise, the configuration provided as the parameter will be returned back.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\console\Application";s:10:"sourceCode";s:501:"public function init()
{
    parent::init();
    if ($this->enableCoreCommands) {
        foreach ($this->coreCommands() as $id => $command) {
            if (!isset($this->controllerMap[$id])) {
                $this->controllerMap[$id] = $command;
            }
        }
    }
    // ensure we have the 'help' command so that we can list the available commands
    if (!isset($this->controllerMap['help'])) {
        $this->controllerMap['help'] = 'yii\console\controllers\HelpController';
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:34831;s:4:"name";s:4:"init";s:8:"fullName";s:29:"yii\console\Application::init";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/Application.php";s:9:"startLine";i:126;s:7:"endLine";i:140;s:16:"shortDescription";s:27:"Initialize the application.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"handleRequest";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\console\Application";s:10:"sourceCode";s:344:"public function handleRequest($request)
{
    list($route, $params) = $request->resolve();
    $this->requestedRoute = $route;
    $result = $this->runAction($route, $params);
    if ($result instanceof Response) {
        return $result;
    }
    $response = $this->getResponse();
    $response->exitStatus = $result;
    return $response;
}
";s:6:"params";a:1:{s:8:"$request";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$request";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:25:"The request to be handled";s:4:"type";s:20:"\yii\console\Request";s:5:"types";a:1:{i:0;s:20:"\yii\console\Request";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/Application.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:22:"The resulting response";s:10:"returnType";s:21:"\yii\console\Response";s:11:"returnTypes";a:1:{i:0;s:21:"\yii\console\Response";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:34831;s:4:"name";s:13:"handleRequest";s:8:"fullName";s:38:"yii\console\Application::handleRequest";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/Application.php";s:9:"startLine";i:147;s:7:"endLine";i:160;s:16:"shortDescription";s:30:"Handles the specified request.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"runAction";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\console\Application";s:10:"sourceCode";s:277:"public function runAction($route, $params = [])
{
    try {
        $res = parent::runAction($route, $params);
        return is_object($res) ? $res : (int) $res;
    } catch (InvalidRouteException $e) {
        throw new UnknownCommandException($route, $this, 0, $e);
    }
}
