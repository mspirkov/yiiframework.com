data format of the cache changes.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:7:"authors";a:2:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";s:14:"Sergey Makinen";s:17:"sergey@makinen.ru";}s:7:"methods";a:8:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\filters\PageCache";s:10:"sourceCode";s:129:"public function init()
