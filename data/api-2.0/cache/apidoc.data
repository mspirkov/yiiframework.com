Defaults to false.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:7:"yii\log";s:13:"phpDocContext";r:66390;s:4:"name";s:14:"yii\log\Target";s:8:"fullName";s:14:"yii\log\Target";s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/Target.php";s:9:"startLine";i:42;s:7:"endLine";i:413;s:16:"shortDescription";s:52:"Target is the base class for all log target classes.";s:11:"description";s:443:"A log target object will filter the messages logged by [[Logger]] according
to its [[levels]] and [[categories]] properties. It may also export the filtered
messages to specific destination defined by the target, such as emails, files.

Level filter and category filter are combinatorial, i.e., only messages
satisfying both filter conditions will be handled. Additionally, you
may specify [[except]] to exclude messages of certain categories.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:0;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:7:"enabled";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Boolean":0:{}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:66828;}i:1;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:6:"levels";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Integer":0:{}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:66854;}}s:5:"todos";a:0:{}}s:20:"yii\log\SyslogTarget";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:14:"yii\log\Target";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:7:"miramir";s:18:"gmiramir@gmail.com";}s:7:"methods";a:3:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\log\SyslogTarget";s:10:"sourceCode";s:135:"public function init()
{
    parent::init();
    if ($this->options === null) {
        $this->options = LOG_ODELAY | LOG_PID;
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:7:"yii\log";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:1:{s:9:"VarDumper";s:21:"yii\helpers\VarDumper";}}s:4:"name";s:4:"init";s:8:"fullName";s:26:"yii\log\SyslogTarget::init";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/SyslogTarget.php";s:9:"startLine";i:53;s:7:"endLine";i:59;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:6:"export";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\log\SyslogTarget";s:10:"sourceCode";s:354:"public function export()
{
    openlog($this->identity, $this->options, $this->facility);
    foreach ($this->messages as $message) {
        if (syslog($this->_syslogLevels[$message[1]], $this->formatMessage($message)) === false) {
            throw new LogRuntimeException('Unable to export log through system log!');
        }
    }
    closelog();
}
";s:6:"params";a:0:{}s:10:"exceptions";a:1:{s:28:"\yii\log\LogRuntimeException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:67217;s:4:"name";s:6:"export";s:8:"fullName";s:28:"yii\log\SyslogTarget::export";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/SyslogTarget.php";s:9:"startLine";i:66;s:7:"endLine";i:75;s:16:"shortDescription";s:30:"Writes log messages to syslog.";s:11:"description";s:105:"Starting from version 2.0.14, this method throws LogRuntimeException in case the log can not be exported.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"formatMessage";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\log\SyslogTarget";s:10:"sourceCode";s:552:"public function formatMessage($message)
{
    list($text, $level, $category, $timestamp) = $message;
    $level = Logger::getLevelName($level);
    if (!is_string($text)) {
        // exceptions may not be serializable if in the call stack somewhere is a Closure
        if ($text instanceof \Exception || $text instanceof \Throwable) {
            $text = (string) $text;
        } else {
            $text = VarDumper::export($text);
        }
    }
    $prefix = $this->getMessagePrefix($message);
    return "{$prefix}[$level][$category] $text";
}
