/QueryBuilder.php";s:9:"startLine";i:79;s:7:"endLine";i:106;s:16:"shortDescription";s:45:"Builds a SQL statement for renaming a column.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"createIndex";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\db\mysql\QueryBuilder";s:10:"sourceCode";s:284:"public function createIndex($name, $table, $columns, $unique = false)
{
    return 'ALTER TABLE '
    . $this->db->quoteTableName($table)
    . ($unique ? ' ADD UNIQUE INDEX ' : ' ADD INDEX ')
    . $this->db->quoteTableName($name)
    . ' (' . $this->buildColumns($columns) . ')';
}
