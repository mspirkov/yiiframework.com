";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:173874;s:4:"name";s:6:"rewind";s:8:"fullName";s:31:"yii\db\BatchQueryResult::rewind";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BatchQueryResult.php";s:9:"startLine";i:119;s:7:"endLine";i:124;s:16:"shortDescription";s:41:"Resets the iterator to the initial state.";s:11:"description";s:55:"This method is required by the interface [[\Iterator]].";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:4:"next";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\db\BatchQueryResult";s:10:"sourceCode";s:695:"#[\ReturnTypeWillChange]
public function next()
{
    if ($this->_batch === null || !$this->each || $this->each && next($this->_batch) === false) {
        $this->_batch = $this->fetchData();
        reset($this->_batch);
    }
    if ($this->each) {
        $this->_value = current($this->_batch);
        if ($this->query->indexBy !== null) {
            $this->_key = key($this->_batch);
        } elseif (key($this->_batch) !== null) {
            $this->_key = $this->_key === null ? 0 : $this->_key + 1;
        } else {
            $this->_key = null;
        }
    } else {
        $this->_value = $this->_batch;
        $this->_key = $this->_key === null ? 0 : $this->_key + 1;
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:173874;s:4:"name";s:4:"next";s:8:"fullName";s:29:"yii\db\BatchQueryResult::next";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BatchQueryResult.php";s:9:"startLine";i:130;s:7:"endLine";i:151;s:16:"shortDescription";s:47:"Moves the internal pointer to the next dataset.";s:11:"description";s:55:"This method is required by the interface [[\Iterator]].";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"fetchData";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:23:"yii\db\BatchQueryResult";s:10:"sourceCode";s:230:"protected function fetchData()
{
    if ($this->_dataReader === null) {
        $this->_dataReader = $this->query->createCommand($this->db)->query();
    }
    $rows = $this->getRows();
    return $this->query->populate($rows);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:1:{s:17:"\yii\db\Exception";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:16:"The data fetched";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:173874;s:4:"name";s:9:"fetchData";s:8:"fullName";s:34:"yii\db\BatchQueryResult::fetchData";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BatchQueryResult.php";s:9:"startLine";i:158;s:7:"endLine";i:167;s:16:"shortDescription";s:31:"Fetches the next batch of data.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:7:"getRows";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:23:"yii\db\BatchQueryResult";s:10:"sourceCode";s:635:"protected function getRows()
{
    $rows = [];
    $count = 0;
    try {
        while ($count++ < $this->batchSize) {
            if ($row = $this->_dataReader->read()) {
                $rows[] = $row;
            } else {
                // we've reached the end
                $this->trigger(self::EVENT_FINISH);
                break;
            }
        }
    } catch (\PDOException $e) {
        $errorCode = isset($e->errorInfo[1]) ? $e->errorInfo[1] : null;
        if ($this->getDbDriverName() !== 'sqlsrv' || $errorCode !== self::MSSQL_NO_MORE_ROWS_ERROR_CODE) {
            throw $e;
        }
    }
    return $rows;
}
