n 9.3.x and higher).";s:11:"description";s:0:"";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:20:"yii\db\cubrid\Schema";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:13:"yii\db\Schema";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:1:{i:0;s:32:"yii\db\ConstraintFinderInterface";}s:6:"traits";a:1:{i:0;s:28:"yii\db\ConstraintFinderTrait";}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:14:"Carsten Brandt";s:12:"mail@cebe.cc";}s:7:"methods";a:14:{s:14:"findTableNames";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:20:"yii\db\cubrid\Schema";s:10:"sourceCode";s:364:"protected function findTableNames($schema = '')
{
    $pdo = $this->db->getSlavePdo(true);
    $tables = $pdo->cubrid_schema(\PDO::CUBRID_SCH_TABLE);
    $tableNames = [];
    foreach ($tables as $table) {
        // do not list system tables
        if ($table['TYPE'] != 0) {
            $tableNames[] = $table['NAME'];
        }
    }
    return $tableNames;
}
";s:6:"params";a:1:{s:7:"$schema";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$schema";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"''";s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/cubrid/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:13:"yii\db\cubrid";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:13:{s:3:"Yii";s:3:"Yii";s:21:"NotSupportedException";s:30:"yii\base\NotSupportedException";s:12:"ColumnSchema";s:19:"yii\db\ColumnSchema";s:10:"Constraint";s:17:"yii\db\Constraint";s:25:"ConstraintFinderInterface";s:32:"yii\db\ConstraintFinderInterface";s:21:"ConstraintFinderTrait";s:28:"yii\db\ConstraintFinderTrait";s:10:"Expression";s:17:"yii\db\Expression";s:20:"ForeignKeyConstraint";s:27:"yii\db\ForeignKeyConstraint";s:15:"IndexConstraint";s:22:"yii\db\IndexConstraint";s:11:"TableSchema";s:18:"yii\db\TableSchema";s:11:"Transaction";s:18:"yii\db\Transaction";s:11:"ArrayHelper";s:23:"yii\helpers\ArrayHelper";s:10:"BaseSchema";s:13:"yii\db\Schema";}}s:4:"name";s:14:"findTableNames";s:8:"fullName";s:36:"yii\db\cubrid\Schema::findTableNames";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/cubrid/Schema.php";s:9:"startLine";i:98;s:7:"endLine";i:111;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:15:"loadTableSchema";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:20:"yii\db\cubrid\Schema";s:10:"sourceCode";s:1451:"protected function loadTableSchema($name)
{
    $pdo = $this->db->getSlavePdo(true);
    $tableInfo = $pdo->cubrid_schema(\PDO::CUBRID_SCH_TABLE, $name);
    if (!isset($tableInfo[0]['NAME'])) {
        return null;
    }
    $table = new TableSchema();
    $table->fullName = $table->name = $tableInfo[0]['NAME'];
    $sql = 'SHOW FULL COLUMNS FROM ' . $this->quoteSimpleTableName($table->name);
    $columns = $this->db->createCommand($sql)->queryAll();
    foreach ($columns as $info) {
        $column = $this->loadColumnSchema($info);
        $table->columns[$column->name] = $column;
    }
    $primaryKeys = $pdo->cubrid_schema(\PDO::CUBRID_SCH_PRIMARY_KEY, $table->name);
    foreach ($primaryKeys as $key) {
        $column = $table->columns[$key['ATTR_NAME']];
        $column->isPrimaryKey = true;
        $table->primaryKey[] = $column->name;
        if ($column->autoIncrement) {
            $table->sequenceName = '';
        }
    }
    $foreignKeys = $pdo->cubrid_schema(\PDO::CUBRID_SCH_IMPORTED_KEYS, $table->name);
    foreach ($foreignKeys as $key) {
        if (isset($table->foreignKeys[$key['FK_NAME']])) {
            $table->foreignKeys[$key['FK_NAME']][$key['FKCOLUMN_NAME']] = $key['PKCOLUMN_NAME'];
        } else {
            $table->foreignKeys[$key['FK_NAME']] = [
                $key['PKTABLE_NAME'],
                $key['FKCOLUMN_NAME'] => $key['PKCOLUMN_NAME'],
            ];
        }
    }
    return $table;
}
