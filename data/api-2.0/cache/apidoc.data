";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:30:"Description of the last error.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:1974;s:4:"name";s:15:"getErrorMessage";s:8:"fullName";s:42:"yii\i18n\MessageFormatter::getErrorMessage";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/MessageFormatter.php";s:9:"startLine";i:67;s:7:"endLine";i:70;s:16:"shortDescription";s:43:"Get the error text from the last operation.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Link":3:{s:7:"␀*␀name";s:4:"link";s:49:"␀phpDocumentor\Reflection\DocBlock\Tags\Link␀link";s:66:"https://www.php.net/manual/en/messageformatter.geterrormessage.php";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:6:"format";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\i18n\MessageFormatter";s:10:"sourceCode";s:1529:"public function format($pattern, $params, $language)
{
    $this->_errorCode = 0;
    $this->_errorMessage = '';
    if ($params === []) {
        return $pattern;
    }
    if (!class_exists('MessageFormatter', false)) {
        return $this->fallbackFormat($pattern, $params, $language);
    }
    // replace named arguments (https://github.com/yiisoft/yii2/issues/9678)
    $newParams = [];
    $pattern = $this->replaceNamedArguments($pattern, $params, $newParams);
    $params = $newParams;
    try {
        $formatter = new \MessageFormatter($language, $pattern);
        if ($formatter === null) {
            // formatter may be null in PHP 5.x
            $this->_errorCode = intl_get_error_code();
            $this->_errorMessage = 'Message pattern is invalid: ' . intl_get_error_message();
            return false;
        }
    } catch (\IntlException $e) {
        // IntlException is thrown since PHP 7
        $this->_errorCode = $e->getCode();
        $this->_errorMessage = 'Message pattern is invalid: ' . $e->getMessage();
        return false;
    } catch (\Exception $e) {
        // Exception is thrown by HHVM
        $this->_errorCode = $e->getCode();
        $this->_errorMessage = 'Message pattern is invalid: ' . $e->getMessage();
        return false;
    }
    $result = $formatter->format($params);
    if ($result === false) {
        $this->_errorCode = $formatter->getErrorCode();
        $this->_errorMessage = $formatter->getErrorMessage();
        return false;
    }
    return $result;
}
