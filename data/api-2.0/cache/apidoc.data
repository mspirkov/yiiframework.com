(must start with `@`) and the array values are the corresponding paths or aliases.
For example,

```
[
    '@models' => '@app/models', // an existing alias
    '@backend' => __DIR__ . '/../backend',  // a directory
]
```";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Module.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:77136;s:4:"name";s:10:"setAliases";s:8:"fullName";s:27:"yii\base\Module::setAliases";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Module.php";s:9:"startLine";i:395;s:7:"endLine";i:400;s:16:"shortDescription";s:21:"Defines path aliases.";s:11:"description";s:154:"This method calls [[Yii::setAlias()]] to register the path aliases.
This method is provided so that you can define path aliases when configuring a module.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"hasModule";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\base\Module";s:10:"sourceCode";s:293:"public function hasModule($id)
{
    if (($pos = strpos($id, '/')) !== false) {
        // sub-module
        $module = $this->getModule(substr($id, 0, $pos));
        return $module === null ? false : $module->hasModule(substr($id, $pos + 1));
    }
    return isset($this->_modules[$id]);
}
";s:6:"params";a:1:{s:3:"$id";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:3:"$id";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:95:"Module ID. For grand child modules, use ID path relative to this module (e.g. `admin/content`).";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Module.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:81:"Whether the named module exists. Both loaded and unloaded modules
are considered.";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:77136;s:4:"name";s:9:"hasModule";s:8:"fullName";s:26:"yii\base\Module::hasModule";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Module.php";s:9:"startLine";i:409;s:7:"endLine";i:419;s:16:"shortDescription";s:59:"Checks whether the child module of the specified ID exists.";s:11:"description";s:82:"This method supports checking the existence of both child and grand child modules.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"getModule";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\base\Module";s:10:"sourceCode";s:732:"public function getModule($id, $load = true)
{
    if (($pos = strpos($id, '/')) !== false) {
        // sub-module
        $module = $this->getModule(substr($id, 0, $pos));
        return $module === null ? null : $module->getModule(substr($id, $pos + 1), $load);
    }
    if (isset($this->_modules[$id])) {
        if ($this->_modules[$id] instanceof self) {
            return $this->_modules[$id];
        } elseif ($load) {
            Yii::debug("Loading module: $id", __METHOD__);
            /** @var self $module */
            $module = Yii::createObject($this->_modules[$id], [$id, $this]);
            $module::setInstance($module);
            return $this->_modules[$id] = $module;
        }
    }
    return null;
}
