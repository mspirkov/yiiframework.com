";s:6:"params";a:1:{s:5:"$name";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$name";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:19:"The attribute name.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/DynamicModel.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:79346;s:4:"name";s:17:"undefineAttribute";s:8:"fullName";s:40:"yii\base\DynamicModel::undefineAttribute";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/DynamicModel.php";s:9:"startLine";i:180;s:7:"endLine";i:183;s:16:"shortDescription";s:23:"Undefines an attribute.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:7:"addRule";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\base\DynamicModel";s:10:"sourceCode";s:430:"public function addRule($attributes, $validator, $options = [])
{
    $validators = $this->getValidators();
    if ($validator instanceof Validator) {
        $validator->attributes = (array)$attributes;
    } else {
        $validator = Validator::createValidator($validator, $this, (array)$attributes, $options);
    }
    $validators->append($validator);
    $this->defineAttributesByValidator($validator);
    return $this;
}
