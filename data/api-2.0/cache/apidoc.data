d";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:38:"yii\db\conditions\HashConditionBuilder";s:10:"sourceCode";s:1044:"public function build(ExpressionInterface $expression, array &$params = [])
{
    $hash = $expression->getHash();
    $parts = [];
    foreach ($hash as $column => $value) {
        if (ArrayHelper::isTraversable($value) || $value instanceof Query) {
            // IN condition
            $parts[] = $this->queryBuilder->buildCondition(new InCondition($column, 'IN', $value), $params);
        } else {
            if (strpos($column, '(') === false) {
                $column = $this->queryBuilder->db->quoteColumnName($column);
            }
            if ($value === null) {
                $parts[] = "$column IS NULL";
            } elseif ($value instanceof ExpressionInterface) {
                $parts[] = "$column=" . $this->queryBuilder->buildExpression($value, $params);
            } else {
                $phName = $this->queryBuilder->bindParam($value, $params);
                $parts[] = "$column=$phName";
            }
        }
    }
    return count($parts) === 1 ? $parts[0] : '(' . implode(') AND (', $parts) . ')';
}
