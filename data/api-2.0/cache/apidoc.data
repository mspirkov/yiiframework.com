{i:1;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:17:"buildPlaceholders";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:35:"yii\db\pgsql\ArrayExpressionBuilder";s:10:"sourceCode";s:1082:"protected function buildPlaceholders(ExpressionInterface $expression, &$params)
{
    $value = $expression->getValue();
    $placeholders = [];
    if ($value === null || !is_array($value) && !$value instanceof \Traversable) {
        return $placeholders;
    }
    if ($expression->getDimension() > 1) {
        foreach ($value as $item) {
            $placeholders[] = $this->build($this->unnestArrayExpression($expression, $item), $params);
        }
        return $placeholders;
    }
    foreach ($value as $item) {
        if ($item instanceof Query) {
            list ($sql, $params) = $this->queryBuilder->build($item, $params);
            $placeholders[] = $this->buildSubqueryArray($sql, $expression);
            continue;
        }
        $item = $this->typecastValue($expression, $item);
        if ($item instanceof ExpressionInterface) {
            $placeholders[] = $this->queryBuilder->buildExpression($item, $params);
            continue;
        }
        $placeholders[] = $this->queryBuilder->bindParam($item, $params);
    }
    return $placeholders;
}
";s:6:"params";a:2:{s:11:"$expression";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:11:"$expression";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:51:"\yii\db\ExpressionInterface|\yii\db\ArrayExpression";s:5:"types";a:2:{i:0;s:27:"\yii\db\ExpressionInterface";i:1;s:23:"\yii\db\ArrayExpression";}s:10:"sourceFile";s:110:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/ArrayExpressionBuilder.php";}s:7:"$params";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$params";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:1;s:11:"description";s:23:"The binding parameters.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:110:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/ArrayExpressionBuilder.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:0:"";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:194830;s:4:"name";s:17:"buildPlaceholders";s:8:"fullName";s:54:"yii\db\pgsql\ArrayExpressionBuilder::buildPlaceholders";s:10:"sourceFile";s:110:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/ArrayExpressionBuilder.php";s:9:"startLine";i:55;s:7:"endLine";i:88;s:16:"shortDescription";s:51:"Builds placeholders array out of $expression values";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"getTypehint";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:35:"yii\db\pgsql\ArrayExpressionBuilder";s:10:"sourceCode";s:259:"protected function getTypehint(ArrayExpression $expression)
{
    if ($expression->getType() === null) {
        return '';
    }
    $result = '::' . $expression->getType();
    $result .= str_repeat('[]', $expression->getDimension());
    return $result;
}
";s:6:"params";a:1:{s:11:"$expression";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:11:"$expression";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:23:"\yii\db\ArrayExpression";s:5:"types";a:1:{i:0;s:23:"\yii\db\ArrayExpression";}s:10:"sourceFile";s:110:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/ArrayExpressionBuilder.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:42:"The typecast expression based on [[type]].";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:194830;s:4:"name";s:11:"getTypehint";s:8:"fullName";s:48:"yii\db\pgsql\ArrayExpressionBuilder::getTypehint";s:10:"sourceFile";s:110:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/ArrayExpressionBuilder.php";s:9:"startLine";i:106;s:7:"endLine";i:116;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:18:"buildSubqueryArray";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:35:"yii\db\pgsql\ArrayExpressionBuilder";s:10:"sourceCode";s:145:"protected function buildSubqueryArray($sql, ArrayExpression $expression)
{
    return 'ARRAY(' . $sql . ')' . $this->getTypehint($expression);
}
