";s:6:"params";a:1:{s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:222:"The message formatter to be used to format message via ICU message format.
Can be given as array or string configuration that will be given to [[Yii::createObject]] to create an instance
or a [[MessageFormatter]] instance.";s:4:"type";s:39:"string|array|\yii\i18n\MessageFormatter";s:5:"types";a:3:{i:0;s:6:"string";i:1;s:5:"array";i:2;s:26:"\yii\i18n\MessageFormatter";}s:10:"sourceFile";s:88:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/I18N.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:5746;s:4:"name";s:19:"setMessageFormatter";s:8:"fullName";s:34:"yii\i18n\I18N::setMessageFormatter";s:10:"sourceFile";s:88:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/I18N.php";s:9:"startLine";i:159;s:7:"endLine";i:162;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"getMessageSource";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:13:"yii\i18n\I18N";s:10:"sourceCode";s:1129:"public function getMessageSource($category)
{
    if (isset($this->translations[$category])) {
        $source = $this->translations[$category];
        if ($source instanceof MessageSource) {
            return $source;
        }
        return $this->translations[$category] = Yii::createObject($source);
    }
    // try wildcard matching
    foreach ($this->translations as $pattern => $source) {
        if (strpos($pattern, '*') > 0 && strpos($category, rtrim($pattern, '*')) === 0) {
            if ($source instanceof MessageSource) {
                return $source;
            }
            return $this->translations[$category] = $this->translations[$pattern] = Yii::createObject($source);
        }
    }
    // match '*' in the last
    if (isset($this->translations['*'])) {
        $source = $this->translations['*'];
        if ($source instanceof MessageSource) {
            return $source;
        }
        return $this->translations[$category] = $this->translations['*'] = Yii::createObject($source);
    }
    throw new InvalidConfigException("Unable to locate message source for category '$category'.");
}
