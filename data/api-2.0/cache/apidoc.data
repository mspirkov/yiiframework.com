```
[
    'IndexName1' => ['col1' [, ...]],
    'IndexName2' => ['col2' [, ...]],
]
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"loadColumnSchema";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:20:"yii\db\sqlite\Schema";s:10:"sourceCode";s:1837:"protected function loadColumnSchema($info)
{
    $column = $this->createColumnSchema();
    $column->name = $info['name'];
    $column->allowNull = !$info['notnull'];
    $column->isPrimaryKey = $info['pk'] != 0;
    $column->dbType = strtolower($info['type']);
    $column->unsigned = strpos($column->dbType, 'unsigned') !== false;
    $column->type = self::TYPE_STRING;
    if (preg_match('/^(\w+)(?:\(([^\)]+)\))?/', $column->dbType, $matches)) {
        $type = strtolower($matches[1]);
        if (isset($this->typeMap[$type])) {
            $column->type = $this->typeMap[$type];
        }
        if (!empty($matches[2])) {
            $values = explode(',', $matches[2]);
            $column->size = $column->precision = (int) $values[0];
            if (isset($values[1])) {
                $column->scale = (int) $values[1];
            }
            if ($column->size === 1 && ($type === 'tinyint' || $type === 'bit')) {
                $column->type = 'boolean';
            } elseif ($type === 'bit') {
                if ($column->size > 32) {
                    $column->type = 'bigint';
                } elseif ($column->size === 32) {
                    $column->type = 'integer';
                }
            }
        }
    }
    $column->phpType = $this->getColumnPhpType($column);
    if (!$column->isPrimaryKey) {
        if ($info['dflt_value'] === 'null' || $info['dflt_value'] === '' || $info['dflt_value'] === null) {
            $column->defaultValue = null;
        } elseif ($column->type === 'timestamp' && $info['dflt_value'] === 'CURRENT_TIMESTAMP') {
            $column->defaultValue = new Expression('CURRENT_TIMESTAMP');
        } else {
            $value = trim($info['dflt_value'], "'\"");
            $column->defaultValue = $column->phpTypecast($value);
        }
    }
    return $column;
}
";s:6:"params";a:1:{s:5:"$info";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$info";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:18:"Column information";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/sqlite/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:24:"The column schema object";s:10:"returnType";s:20:"\yii\db\ColumnSchema";s:11:"returnTypes";a:1:{i:0;s:20:"\yii\db\ColumnSchema";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:201941;s:4:"name";s:16:"loadColumnSchema";s:8:"fullName";s:38:"yii\db\sqlite\Schema::loadColumnSchema";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/sqlite/Schema.php";s:9:"startLine";i:317;s:7:"endLine";i:365;s:16:"shortDescription";s:60:"Loads the column information into a [[ColumnSchema]] object.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:2;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:14:"phpstan-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:1:"T";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:3;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:12:"psalm-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:1:"T";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:28:"setTransactionIsolationLevel";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\db\sqlite\Schema";s:10:"sourceCode";s:539:"public function setTransactionIsolationLevel($level)
{
    switch ($level) {
        case Transaction::SERIALIZABLE:
            $this->db->createCommand('PRAGMA read_uncommitted = False;')->execute();
            break;
        case Transaction::READ_UNCOMMITTED:
            $this->db->createCommand('PRAGMA read_uncommitted = True;')->execute();
            break;
        default:
            throw new NotSupportedException(get_class($this) . ' only supports transaction isolation levels READ UNCOMMITTED and SERIALIZABLE.');
    }
}
