";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:22:"yii\web\AssetConverter";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:18:"yii\base\Component";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:1:{i:0;s:31:"yii\web\AssetConverterInterface";}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:2:{s:7:"convert";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:22:"yii\web\AssetConverter";s:10:"sourceCode";s:564:"public function convert($asset, $basePath)
{
    $pos = strrpos($asset, '.');
    if ($pos !== false) {
        $ext = substr($asset, $pos + 1);
        if (isset($this->commands[$ext])) {
            list($ext, $command) = $this->commands[$ext];
            $result = substr($asset, 0, $pos + 1) . $ext;
            if ($this->forceConvert || @filemtime("$basePath/$result") < @filemtime("$basePath/$asset")) {
                $this->runCommand($command, $basePath, $asset, $result);
            }
            return $result;
        }
    }
    return $asset;
}
";s:6:"params";a:2:{s:6:"$asset";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$asset";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:42:"The asset file path, relative to $basePath";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetConverter.php";}s:9:"$basePath";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$basePath";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:40:"The directory the $asset is relative to.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetConverter.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:53:"The converted asset file path, relative to $basePath.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:7:"yii\web";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:3:{s:3:"Yii";s:3:"Yii";s:9:"Component";s:18:"yii\base\Component";s:9:"Exception";s:18:"yii\base\Exception";}}s:4:"name";s:7:"convert";s:8:"fullName";s:31:"yii\web\AssetConverter::convert";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetConverter.php";s:9:"startLine";i:66;s:7:"endLine";i:83;s:16:"shortDescription";s:50:"Converts a given asset file into a CSS or JS file.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:10:"runCommand";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:22:"yii\web\AssetConverter";s:10:"sourceCode";s:1083:"protected function runCommand($command, $basePath, $asset, $result)
{
    $command = Yii::getAlias($command);
    $command = strtr($command, [
        '{from}' => escapeshellarg("$basePath/$asset"),
        '{to}' => escapeshellarg("$basePath/$result"),
    ]);
    $descriptor = [
        1 => ['pipe', 'w'],
        2 => ['pipe', 'w'],
    ];
    $pipes = [];
    $proc = proc_open($command, $descriptor, $pipes, $basePath);
    $stdout = stream_get_contents($pipes[1]);
    $stderr = stream_get_contents($pipes[2]);
    foreach ($pipes as $pipe) {
        fclose($pipe);
    }
    $status = proc_close($proc);
    if ($status === 0) {
        Yii::debug("Converted $asset into $result:\nSTDOUT:\n$stdout\nSTDERR:\n$stderr", __METHOD__);
    } elseif (YII_DEBUG) {
        throw new Exception("AssetConverter command '$command' failed with exit code $status:\nSTDOUT:\n$stdout\nSTDERR:\n$stderr");
    } else {
        Yii::error("AssetConverter command '$command' failed with exit code $status:\nSTDOUT:\n$stdout\nSTDERR:\n$stderr", __METHOD__);
    }
    return $status === 0;
}
