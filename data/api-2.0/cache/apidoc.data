}
";s:6:"params";a:0:{}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:21:"if [[db]] is invalid.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:7:"yii\log";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:5:{s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:10:"Connection";s:17:"yii\db\Connection";s:9:"Exception";s:16:"yii\db\Exception";s:8:"Instance";s:15:"yii\di\Instance";s:9:"VarDumper";s:21:"yii\helpers\VarDumper";}}s:4:"name";s:4:"init";s:8:"fullName";s:22:"yii\log\DbTarget::init";s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/DbTarget.php";s:9:"startLine";i:52;s:7:"endLine";i:56;s:16:"shortDescription";s:35:"Initializes the DbTarget component.";s:11:"description";s:96:"This method will initialize the [[db]] property to make sure it refers to a valid DB connection.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"export";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:16:"yii\log\DbTarget";s:10:"sourceCode";s:1411:"public function export()
{
    if ($this->db->getTransaction()) {
        // create new database connection, if there is an open transaction
        // to ensure insert statement is not affected by a rollback
        $this->db = clone $this->db;
    }
    $tableName = $this->db->quoteTableName($this->logTable);
    $sql = "INSERT INTO $tableName ([[level]], [[category]], [[log_time]], [[prefix]], [[message]])
            VALUES (:level, :category, :log_time, :prefix, :message)";
    $command = $this->db->createCommand($sql);
    foreach ($this->messages as $message) {
        list($text, $level, $category, $timestamp) = $message;
        if (!is_string($text)) {
            // exceptions may not be serializable if in the call stack somewhere is a Closure
            if ($text instanceof \Exception || $text instanceof \Throwable) {
                $text = (string) $text;
            } else {
                $text = VarDumper::export($text);
            }
        }
        if (
            $command->bindValues([
                ':level' => $level,
                ':category' => $category,
                ':log_time' => $timestamp,
                ':prefix' => $this->getMessagePrefix($message),
                ':message' => $text,
            ])->execute() > 0
        ) {
            continue;
        }
        throw new LogRuntimeException('Unable to export log through database!');
    }
}
