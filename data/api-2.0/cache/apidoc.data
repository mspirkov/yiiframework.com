For more details and usage information on Cache, see the [guide article on caching](guide:caching-overview).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:26:"yii\caching\FileDependency";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:22:"yii\caching\Dependency";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:1:{s:22:"generateDependencyData";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:26:"yii\caching\FileDependency";s:10:"sourceCode";s:298:"protected function generateDependencyData($cache)
{
    if ($this->fileName === null) {
        throw new InvalidConfigException('FileDependency::fileName must be set');
    }
    $fileName = Yii::getAlias($this->fileName);
    clearstatcache(false, $fileName);
    return @filemtime($fileName);
}
