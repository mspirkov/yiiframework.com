{
    $this->trigger(self::EVENT_END_PAGE);
    $this->isPageEnded = true;
    $content = ob_get_clean();
    echo strtr($content, [
        self::PH_HEAD => $this->renderHeadHtml(),
        self::PH_BODY_BEGIN => $this->renderBodyBeginHtml(),
        self::PH_BODY_END => $this->renderBodyEndHtml($ajaxMode),
    ]);
    $this->clear();
}
