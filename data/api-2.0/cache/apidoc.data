or the configuration for creating the log target instance.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:7:"yii\log";s:13:"phpDocContext";r:67464;s:4:"name";s:18:"yii\log\Dispatcher";s:8:"fullName";s:18:"yii\log\Dispatcher";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/Dispatcher.php";s:9:"startLine";i:63;s:7:"endLine";i:227;s:16:"shortDescription";s:51:"Dispatcher manages a set of [[Target|log targets]].";s:11:"description";s:1063:"Dispatcher implements the [[dispatch()]]-method that forwards the log messages from a [[Logger]] to
the registered log [[targets]].

An instance of Dispatcher is registered as a core application component and can be accessed using `Yii::$app->log`.

You may configure the targets in application configuration, like the following:

```
[
    'components' => [
        'log' => [
            'targets' => [
                'file' => [
                    'class' => 'yii\log\FileTarget',
                    'levels' => ['trace', 'info'],
                    'categories' => ['yii\*'],
                ],
                'email' => [
                    'class' => 'yii\log\EmailTarget',
                    'levels' => ['error', 'warning'],
                    'message' => [
                        'to' => 'admin@example.com',
                    ],
                ],
            ],
        ],
    ],
]
```

Each log target can have a name and can be referenced via the [[targets]] property as follows:

```
Yii::$app->log->targets['file']->enabled = false;
```";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:3:{i:0;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:13:"flushInterval";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Integer":0:{}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:67840;}i:1;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:6:"logger";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:15:"\yii\log\Logger";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:6:"Logger";}}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:67866;}i:2;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:10:"traceLevel";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Integer":0:{}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:67892;}}s:5:"todos";a:0:{}}s:16:"yii\log\DbTarget";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:14:"yii\log\Target";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:2:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:16:"yii\log\DbTarget";s:10:"sourceCode";s:117:"public function init()
{
