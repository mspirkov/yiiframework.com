0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:39:"the scenario used for creating a model.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:1;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:28:"\yii\base\Model::scenarios()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:9:"scenarios";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}}s:9:"namespace";s:8:"yii\rest";s:13:"phpDocContext";r:152340;s:4:"name";s:25:"yii\rest\ActiveController";s:8:"fullName";s:25:"yii\rest\ActiveController";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/rest/ActiveController.php";s:9:"startLine";i:44;s:7:"endLine";i:141;s:16:"shortDescription";s:98:"ActiveController implements a common set of actions for supporting RESTful access to ActiveRecord.";s:11:"description";s:1012:"The class of the ActiveRecord should be specified via [[modelClass]], which must implement [[\yii\db\ActiveRecordInterface]].
By default, the following actions are supported:

- `index`: list of models
- `view`: return the details of a model
- `create`: create a new model
- `update`: update an existing model
- `delete`: delete an existing model
- `options`: return the allowed HTTP methods

You may disable some of these actions by overriding [[actions()]] and unsetting the corresponding actions.

To add a new action, either override [[actions()]] by appending a new action class or write a new action method.
Make sure you also override [[verbs()]] to properly declare what HTTP methods are allowed by the new action.

You should usually override [[checkAccess()]] to check whether the current user has the privilege to perform
the specified action against the specified model.

For more details and usage information on ActiveController, see the [guide article on rest controllers](guide:rest-controllers).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:2;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Template":5:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀templateName";s:1:"T";s:54:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀bound";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:16:"\yii\base\Module";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:6:"Module";}}s:56:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀default";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:7:"␀*␀name";s:8:"template";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:3;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Extends_":3:{s:7:"␀*␀type";O:41:"phpDocumentor\Reflection\Types\Collection":4:{s:48:"␀phpDocumentor\Reflection\Types\Collection␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:20:"\yii\rest\Controller";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:10:"Controller";}s:12:"␀*␀valueType";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:11:"\yii\rest\T";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:1:"T";}}s:10:"␀*␀keyType";N;s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}s:7:"␀*␀name";s:7:"extends";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:11:"yii\BaseYii";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";N;s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:19:{s:10:"getVersion";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:11:"yii\BaseYii";s:10:"sourceCode";s:65:"public static function getVersion()
