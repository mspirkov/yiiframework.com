This is used when serving a resource collection with pagination.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:19:"$collectionEnvelope";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:12:"defaultValue";N;s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:19:"yii\rest\Serializer";s:13:"phpDocContext";r:151417;s:4:"name";s:19:"$collectionEnvelope";s:8:"fullName";s:40:"yii\rest\Serializer::$collectionEnvelope";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/rest/Serializer.php";s:9:"startLine";i:91;s:7:"endLine";i:91;s:16:"shortDescription";s:91:"The name of the envelope (e.g. `items`) for returning the resource objects in a collection.";s:11:"description";s:884:"The name of the envelope (e.g. `items`) for returning the resource objects in a collection.
This is used when serving a resource collection. When this is set and pagination is enabled, the serializer
will return a collection in the following format:

```
[
    'items' => [...],  // assuming collectionEnvelope is "items"
    '_links' => {  // pagination links as returned by Pagination::getLinks()
        'self' => '...',
        'next' => '...',
        'last' => '...',
    },
    '_meta' => {  // meta information as returned by Pagination::toArray()
        'totalCount' => 100,
        'pageCount' => 5,
        'currentPage' => 1,
        'perPage' => 20,
    },
]
```

If this property is not set, the resource arrays will be directly returned without using envelope.
The pagination information as shown in `_links` and `_meta` can be accessed from the response HTTP headers.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:36:"phpDocumentor\Reflection\Types\Null_":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:884:"the name of the envelope (e.g. `items`) for returning the resource objects in a collection.
This is used when serving a resource collection. When this is set and pagination is enabled, the serializer
will return a collection in the following format:

```
[
    'items' => [...],  // assuming collectionEnvelope is "items"
    '_links' => {  // pagination links as returned by Pagination::getLinks()
        'self' => '...',
        'next' => '...',
        'last' => '...',
    },
    '_meta' => {  // meta information as returned by Pagination::toArray()
        'totalCount' => 100,
        'pageCount' => 5,
        'currentPage' => 1,
        'perPage' => 20,
    },
]
```

If this property is not set, the resource arrays will be directly returned without using envelope.
The pagination information as shown in `_links` and `_meta` can be accessed from the response HTTP headers.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:14:"$linksEnvelope";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:12:"defaultValue";s:8:"'_links'";s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:19:"yii\rest\Serializer";s:13:"phpDocContext";r:151417;s:4:"name";s:14:"$linksEnvelope";s:8:"fullName";s:35:"yii\rest\Serializer::$linksEnvelope";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/rest/Serializer.php";s:9:"startLine";i:97;s:7:"endLine";i:97;s:16:"shortDescription";s:73:"The name of the envelope (e.g. `_links`) for returning the links objects.";s:11:"description";s:127:"The name of the envelope (e.g. `_links`) for returning the links objects.
