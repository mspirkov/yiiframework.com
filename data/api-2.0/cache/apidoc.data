";s:6:"params";a:1:{s:6:"$class";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$class";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:40:"Class name, interface name or alias name";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/Container.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:88261;s:4:"name";s:5:"clear";s:8:"fullName";s:23:"yii\di\Container::clear";s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/Container.php";s:9:"startLine";i:332;s:7:"endLine";i:335;s:16:"shortDescription";s:46:"Removes the definition for the specified name.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:19:"normalizeDefinition";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:16:"yii\di\Container";s:10:"sourceCode";s:1063:"protected function normalizeDefinition($class, $definition)
{
    if (empty($definition)) {
        return ['class' => $class];
    } elseif (is_string($definition)) {
        return ['class' => $definition];
    } elseif ($definition instanceof Instance) {
        return ['class' => $definition->id];
    } elseif (is_callable($definition, true) || is_object($definition)) {
        return $definition;
    } elseif (is_array($definition)) {
        if (!isset($definition['class']) && isset($definition['__class'])) {
            $definition['class'] = $definition['__class'];
            unset($definition['__class']);
        }
        if (!isset($definition['class'])) {
            if (strpos($class, '\\') !== false) {
                $definition['class'] = $class;
            } else {
                throw new InvalidConfigException('A class definition requires a "class" member.');
            }
        }
        return $definition;
    }
    throw new InvalidConfigException("Unsupported definition type for \"$class\": " . gettype($definition));
}
