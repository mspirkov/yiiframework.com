and the second element the total time spent in SQL execution.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:65202;s:4:"name";s:14:"getDbProfiling";s:8:"fullName";s:30:"yii\log\Logger::getDbProfiling";s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/Logger.php";s:9:"startLine";i:309;s:7:"endLine";i:319;s:16:"shortDescription";s:46:"Returns the statistical results of DB queries.";s:11:"description";s:92:"The results returned include the number of SQL statements executed and
the total time spent.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"calculateTimings";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:14:"yii\log\Logger";s:10:"sourceCode";s:1129:"public function calculateTimings($messages)
{
    $timings = [];
    $stack = [];
    foreach ($messages as $i => $log) {
        list($token, $level, $category, $timestamp, $traces) = $log;
        $memory = isset($log[5]) ? $log[5] : 0;
        $log[6] = $i;
        $hash = md5(json_encode($token));
        if ($level == self::LEVEL_PROFILE_BEGIN) {
            $stack[$hash] = $log;
        } elseif ($level == self::LEVEL_PROFILE_END) {
            if (isset($stack[$hash])) {
                $timings[$stack[$hash][6]] = [
                    'info' => $stack[$hash][0],
                    'category' => $stack[$hash][2],
                    'timestamp' => $stack[$hash][3],
                    'trace' => $stack[$hash][4],
                    'level' => count($stack) - 1,
                    'duration' => $timestamp - $stack[$hash][3],
                    'memory' => $memory,
                    'memoryDiff' => $memory - (isset($stack[$hash][5]) ? $stack[$hash][5] : 0),
                ];
                unset($stack[$hash]);
            }
        }
    }
    ksort($timings);
    return array_values($timings);
}
