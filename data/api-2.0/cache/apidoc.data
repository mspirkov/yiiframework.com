exactly match the ending of the string in order to get a true value.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseStringHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:67:"Returns true if first input ends with second input, false otherwise";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:61427;s:4:"name";s:8:"endsWith";s:8:"fullName";s:38:"yii\helpers\BaseStringHelper::endsWith";s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseStringHelper.php";s:9:"startLine";i:289;s:7:"endLine";i:310;s:16:"shortDescription";s:79:"Check if given string ends with specified substring. Binary and multibyte safe.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:7:"explode";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:28:"yii\helpers\BaseStringHelper";s:10:"sourceCode";s:777:"public static function explode($string, $delimiter = ',', $trim = true, $skipEmpty = false)
{
    $result = explode($delimiter, $string);
    if ($trim !== false) {
        if ($trim === true) {
            $trim = 'trim';
        } elseif (!is_callable($trim)) {
            $trim = function ($v) use ($trim) {
                return trim($v, $trim);
            };
        }
        $result = array_map($trim, $result);
    }
    if ($skipEmpty) {
        // Wrapped with array_values to make array keys sequential after empty values removing
        $result = array_values(
            array_filter(
                $result,
                function ($value) {
                    return $value !== '';
                }
            )
        );
    }
    return $result;
}
