:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:92:"the name of the table storing authorization item assignments. Defaults to "auth_assignment".";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:10:"$ruleTable";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:12:"defaultValue";s:16:"'{{%auth_rule}}'";s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:18:"yii\rbac\DbManager";s:13:"phpDocContext";r:146884;s:4:"name";s:10:"$ruleTable";s:8:"fullName";s:30:"yii\rbac\DbManager::$ruleTable";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/rbac/DbManager.php";s:9:"startLine";i:63;s:7:"endLine";i:63;s:16:"shortDescription";s:36:"The name of the table storing rules.";s:11:"description";s:61:"The name of the table storing rules. Defaults to "auth_rule".";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:61:"the name of the table storing rules. Defaults to "auth_rule".";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:6:"$cache";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:45:"\yii\caching\CacheInterface|array|string|null";s:5:"types";a:4:{i:0;s:27:"\yii\caching\CacheInterface";i:1;s:5:"array";i:2;s:6:"string";i:3;s:4:"null";}s:12:"defaultValue";N;s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:18:"yii\rbac\DbManager";s:13:"phpDocContext";r:146884;s:4:"name";s:6:"$cache";s:8:"fullName";s:26:"yii\rbac\DbManager::$cache";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/rbac/DbManager.php";s:9:"startLine";i:83;s:7:"endLine";i:83;s:16:"shortDescription";s:43:"The cache used to improve RBAC performance.";s:11:"description";s:839:"The cache used to improve RBAC performance. This can be one of the following:

- an application component ID (e.g. `cache`)
- a configuration array
- a [[\yii\caching\Cache]] object

When this is not set, it means caching is not enabled.

Note that by enabling RBAC cache, all auth items, rules and auth item parent-child relationships will
be cached and loaded into memory. This will improve the performance of RBAC permission check. However,
it does require extra memory and as a result may not be appropriate if your RBAC system contains too many
auth items. You should seek other RBAC implementations (e.g. RBAC based on Redis storage) in this case.

Also note that if you modify RBAC items, rules or parent-child relationships from outside of this component,
you have to manually call [[invalidateCache()]] to ensure data consistency.";s:5:"since";s:5:"2.0.3";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:4:{i:0;O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:27:"\yii\caching\CacheInterface";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:14:"CacheInterface";}}i:1;O:37:"phpDocumentor\Reflection\Types\Array_":3:{s:12:"␀*␀valueType";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:10:"␀*␀keyType";N;s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}i:2;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:3;O:36:"phpDocumentor\Reflection\Types\Null_":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:839:"the cache used to improve RBAC performance. This can be one of the following:

- an application component ID (e.g. `cache`)
- a configuration array
- a [[\yii\caching\Cache]] object

When this is not set, it means caching is not enabled.

Note that by enabling RBAC cache, all auth items, rules and auth item parent-child relationships will
be cached and loaded into memory. This will improve the performance of RBAC permission check. However,
it does require extra memory and as a result may not be appropriate if your RBAC system contains too many
auth items. You should seek other RBAC implementations (e.g. RBAC based on Redis storage) in this case.

