lity";s:9:"protected";s:8:"isStatic";b:0;s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:12:"defaultValue";s:4:"null";s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:15:"yii\web\Session";s:13:"phpDocContext";r:106378;s:4:"name";s:19:"$_forceRegenerateId";s:8:"fullName";s:36:"yii\web\Session::$_forceRegenerateId";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Session.php";s:9:"startLine";i:100;s:7:"endLine";i:100;s:16:"shortDescription";s:96:"Holds the session id in case useStrictMode is enabled and the session id needs to be regenerated";s:11:"description";s:96:"Holds the session id in case useStrictMode is enabled and the session id needs to be regenerated";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:36:"phpDocumentor\Reflection\Types\Null_":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:96:"Holds the session id in case useStrictMode is enabled and the session id needs to be regenerated";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:7:"yii\web";s:13:"phpDocContext";r:106378;s:4:"name";s:15:"yii\web\Session";s:8:"fullName";s:15:"yii\web\Session";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Session.php";s:9:"startLine";i:77;s:7:"endLine";i:1082;s:16:"shortDescription";s:72:"Session provides session data management and the related configurations.";s:11:"description";s:1424:"Session is a Web application component that can be accessed via `Yii::$app->session`.

To start the session, call [[open()]]; To complete and send out session data, call [[close()]];
To destroy the session, call [[destroy()]].

Session can be used like an array to set and get session data. For example,

```
$session = new Session;
$session->open();
$value1 = $session['name1'];  // get session variable 'name1'
$value2 = $session['name2'];  // get session variable 'name2'
foreach ($session as $name => $value) // traverse all session variables
$session['name3'] = $value3;  // set session variable 'name3'
```

Session can be extended to support customized session storage.
To do so, override [[useCustomStorage]] so that it returns true, and
override these methods with the actual logic about using custom storage:
[[openSession()]], [[closeSession()]], [[readSession()]], [[writeSession()]],
[[destroySession()]] and [[gcSession()]].

Session also supports a special type of session data, called *flash messages*.
A flash message is available only in the current request and the next request.
After that, it will be deleted automatically. Flash messages are particularly
useful for displaying confirmation messages. To use flash messages, simply
call methods such as [[setFlash()]], [[getFlash()]].

For more details and usage information on Session, see the [guide article on sessions](guide:runtime-sessions-cookies).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:19:{i:0;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:10:"allFlashes";s:7:"␀*␀type";O:37:"phpDocumentor\Reflection\Types\Array_":3:{s:12:"␀*␀valueType";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:10:"␀*␀keyType";N;s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:108437;}i:1;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:12:"cacheLimiter";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:108463;}i:2;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:12:"cookieParams";s:7:"␀*␀type";O:37:"phpDocumentor\Reflection\Types\Array_":3:{s:12:"␀*␀valueType";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:10:"␀*␀keyType";N;s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:108489;}i:3;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:5:"count";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Integer":0:{}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:108515;}i:4;O:52:"phpDocumentor\Re