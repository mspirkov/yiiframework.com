";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:70140;s:4:"name";s:15:"detachBehaviors";s:8:"fullName";s:35:"yii\base\Component::detachBehaviors";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Component.php";s:9:"startLine";i:759;s:7:"endLine";i:765;s:16:"shortDescription";s:42:"Detaches all behaviors from the component.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:15:"ensureBehaviors";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\base\Component";s:10:"sourceCode";s:246:"public function ensureBehaviors()
