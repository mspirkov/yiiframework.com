";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:753;s:4:"name";s:6:"unload";s:8:"fullName";s:30:"yii\test\ActiveFixture::unload";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/test/ActiveFixture.php";s:9:"startLine";i:121;s:7:"endLine";i:125;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:10:"resetTable";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:22:"yii\test\ActiveFixture";s:10:"sourceCode";s:269:"protected function resetTable()
{
    $table = $this->getTableSchema();
    $this->db->createCommand()->delete($table->fullName)->execute();
    if ($table->sequenceName !== null) {
        $this->db->createCommand()->executeResetSequence($table->fullName, 1);
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:753;s:4:"name";s:10:"resetTable";s:8:"fullName";s:34:"yii\test\ActiveFixture::resetTable";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/test/ActiveFixture.php";s:9:"startLine";i:131;s:7:"endLine";i:138;s:16:"shortDescription";s:92:"Removes all existing data from the specified table and resets sequence number to 1 (if any).";s:11:"description";s:97:"This method is called before populating fixture data into the table associated with this fixture.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"getTableSchema";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:22:"yii\test\ActiveFixture";s:10:"sourceCode";s:553:"public function getTableSchema()
{
    if ($this->_table !== null) {
        return $this->_table;
    }
    $db = $this->db;
    $tableName = $this->tableName;
    if ($tableName === null) {
        /** @var \yii\db\ActiveRecord $modelClass */
        $modelClass = $this->modelClass;
        $tableName = $modelClass::tableName();
    }
    $this->_table = $db->getSchema()->getTableSchema($tableName);
    if ($this->_table === null) {
        throw new InvalidConfigException("Table does not exist: {$tableName}");
    }
    return $this->_table;
}
