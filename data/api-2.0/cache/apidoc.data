escaped or quoted.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"splitCondition";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:40:"yii\db\oci\conditions\InConditionBuilder";s:10:"sourceCode";s:804:"protected function splitCondition(InCondition $condition, &$params)
{
    $operator = $condition->getOperator();
    $values = $condition->getValues();
    $column = $condition->getColumn();
    if ($values instanceof \Traversable) {
        $values = iterator_to_array($values);
    }
    if (!is_array($values)) {
        return null;
    }
    $maxParameters = 1000;
    $count = count($values);
    if ($count <= $maxParameters) {
        return null;
    }
    $slices = [];
    for ($i = 0; $i < $count; $i += $maxParameters) {
        $slices[] = $this->queryBuilder->createConditionFromArray([$operator, $column, array_slice($values, $i, $maxParameters)]);
    }
    array_unshift($slices, ($operator === 'IN') ? 'OR' : 'AND');
    return $this->queryBuilder->buildCondition($slices, $params);
}
