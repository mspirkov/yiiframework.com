the return value of [[getFixtures()]] will be used.";s:4:"type";s:24:"\yii\test\Fixture[]|null";s:5:"types";a:2:{i:0;s:19:"\yii\test\Fixture[]";i:1;s:4:"null";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/test/FixtureTrait.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:213161;s:4:"name";s:12:"loadFixtures";s:8:"fullName";s:35:"yii\test\FixtureTrait::loadFixtures";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/test/FixtureTrait.php";s:9:"startLine";i:85;s:7:"endLine";i:100;s:16:"shortDescription";s:29:"Loads the specified fixtures.";s:11:"description";s:67:"This method will call [[Fixture::load()]] for every fixture object.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"unloadFixtures";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\test\FixtureTrait";s:10:"sourceCode";s:400:"public function unloadFixtures($fixtures = null)
{
    if ($fixtures === null) {
        $fixtures = $this->getFixtures();
    }
    foreach ($fixtures as $fixture) {
        $fixture->beforeUnload();
    }
    $fixtures = array_reverse($fixtures);
    foreach ($fixtures as $fixture) {
        $fixture->unload();
    }
    foreach ($fixtures as $fixture) {
        $fixture->afterUnload();
    }
}
