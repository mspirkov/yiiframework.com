chaValidator should be used together with [[CaptchaAction]].

Note that once CAPTCHA validation succeeds, a new CAPTCHA will be generated automatically. As a result,
CAPTCHA validation should not be used in AJAX validation mode because it may fail the validation
even if a user enters the same code as shown in the CAPTCHA image which is actually different from the latest CAPTCHA code.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:25:"yii\captcha\CaptchaAction";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:15:"yii\base\Action";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:1:{s:15:"REFRESH_GET_VAR";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:25:"yii\captcha\CaptchaAction";s:5:"value";s:9:"'refresh'";s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\captcha";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:6:{s:3:"Yii";s:3:"Yii";s:6:"Action";s:15:"yii\base\Action";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:3:"Url";s:15:"yii\helpers\Url";s:10:"Controller";s:18:"yii\web\Controller";s:8:"Response";s:16:"yii\web\Response";}}s:4:"name";s:15:"REFRESH_GET_VAR";s:8:"fullName";s:42:"yii\captcha\CaptchaAction::REFRESH_GET_VAR";s:10:"sourceFile";N;s:9:"startLine";i:48;s:7:"endLine";i:48;s:16:"shortDescription";s:89:"The name of the GET parameter indicating whether the CAPTCHA image should be regenerated.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:11:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\captcha\CaptchaAction";s:10:"sourceCode";s:217:"public function init()
{
    $this->fontFile = Yii::getAlias($this->fontFile);
    if (!is_file($this->fontFile)) {
        throw new InvalidConfigException("The font file does not exist: {$this->fontFile}");
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:32:"if the font file does not exist.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:129603;s:4:"name";s:4:"init";s:8:"fullName";s:31:"yii\captcha\CaptchaAction::init";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/CaptchaAction.php";s:9:"startLine";i:117;s:7:"endLine";i:123;s:16:"shortDescription";s:23:"Initializes the action.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:3:"run";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\captcha\CaptchaAction";s:10:"sourceCode";s:771:"public function run()
{
    if (Yii::$app->request->getQueryParam(self::REFRESH_GET_VAR) !== null) {
        // AJAX request for regenerating code
        $code = $this->getVerifyCode(true);
        Yii::$app->response->format = Response::FORMAT_JSON;
        return [
            'hash1' => $this->generateValidationHash($code),
            'hash2' => $this->generateValidationHash(strtolower($code)),
            // we add a random 'v' parameter so that FireFox can refresh the image
            // when src attribute of image tag is changed
            'url' => Url::to([$this->id, 'v' => uniqid('', true)]),
        ];
    }
    $this->setHttpHeaders();
    Yii::$app->response->format = Response::FORMAT_RAW;
    return $this->renderImage($this->getVerifyCode());
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:129603;s:4:"name";s:3:"run";s:8:"fullName";s:30:"yii\captcha\CaptchaAction::run";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/CaptchaAction.php";s:9:"startLine";i:128;s:7:"endLine";i:147;s:16:"shortDescription";s:16:"Runs the action.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:22:"generateValidationHash";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\captcha\CaptchaAction";s:10:"sourceCode";s:165:"public function generateValidationHash($code)
{
    for ($h = 0, $i = strlen($code) - 1; $i >= 0; --$i) {
        $h += ord($code[$i]) << $i;
    }
    return $h;
}
";s:6:"params";a:1:{s:5:"$code";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$code";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:16:"The CAPTCHA code";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/CaptchaAction.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:43:"A hash code generated from the CAPTCHA code";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:129603;s:4:"name";s:22:"generateValidationHash";s:8:"fullName";s:49:"yii\captcha\CaptchaAction::generateValidationHash";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/CaptchaAction.php";s:9:"startLine";i:154;s:7:"endLine";i:161;s:16:"shortDescription";s:66:"Generates a hash code that can be used for client-side validation.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"getVerifyCode";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\captcha\CaptchaAction";s:10:"sourceCode";s:420:"public function getVerifyCode($regenerate = false)
{
    if ($this->fixedVerifyCode !== null) {
        return $this->fixedVerifyCode;
    }
    $session = Yii::$app->getSession();
    $session->open();
    $name = $this->getSessionKey();
    if ($session[$name] === null || $regenerate) {
        $session[$name] = $this->generateVerifyCode();
        $session[$name . 'count'] = 1;
    }
    return $session[$name];
}
";s:6:"params";a:1:{s:11:"$regenerate";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:11:"$regenerate";s:10:"isOptional";b:1;s:12:"defaultValue";s:5:"false";s:19:"isPassedByReference";b:0;s:11:"description";s:52:"Whether the verification code should be regenerated.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/CaptchaAction.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:22:"The verification code.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:129603;s:4:"name";s:13:"getVerifyCode";s:8:"fullName";s:40:"yii\captcha\CaptchaAction::getVerifyCode";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/CaptchaAction.php";s:9:"startLine";i:168;s:7:"endLine";i:183;s:16:"shortDescription";s:27:"Gets the verification code.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"validate";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\captcha\CaptchaAction";s:10:"sourceCode";s:448:"public function validate($input, $caseSensitive)
{
    $code = $this->getVerifyCode();
    $valid = $caseSensitive ? ($input === $code) : strcasecmp($input, $code) === 0;
    $session = Yii::$app->getSession();
    $session->open();
    $name = $this->getSessionKey() . 'count';
    $session[$name] += 1;
    if ($valid || $session[$name] > $this->testLimit && $this->testLimit > 0) {
        $this->getVerifyCode(true);
    }
    return $valid;
}
";s:6:"params";a:2:{s:6:"$input";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$input";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:10:"User input";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/CaptchaAction.php";}s:14:"$caseSensitive";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:14:"$caseSensitive";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:47:"Whether the comparison should be case-sensitive";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/CaptchaAction.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:26:"Whether the input is valid";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:129603;s:4:"name";s:8:"validate";s:8:"fullName";s:35:"yii\captcha\CaptchaAction::validate";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/CaptchaAction.php";s:9:"startLine";i:191;s:7:"endLine";i:204;s:16:"shortDescription";s:60:"Validates the input to see if it matches the generated code.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:18:"generateVerifyCode";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:25:"yii\captcha\CaptchaAction";s:10:"sourceCode";s:694:"protected function generateVerifyCode()
{
    if ($this->minLength > $this->maxLength) {
        $this->maxLength = $this->minLength;
    }
    if ($this->minLength < 3) {
        $this->minLength = 3;
    }
    if ($this->maxLength > 20) {
        $this->maxLength = 20;
    }
    $length = random_int($this->minLength, $this->maxLength);
    $letters = 'bcdfghjklmnpqrstvwxyz';
    $vowels = 'aeiou';
    $code = '';
    for ($i = 0; $i < $length; ++$i) {
        if ($i % 2 && random_int(0, 10) > 2 || !($i % 2) && random_int(0, 10) > 9) {
            $code .= $vowels[random_int(0, 4)];
        } else {
            $code .= $letters[random_int(0, 20)];
        }
    }
    return $code;
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:31:"The generated verification code";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:129603;s:4:"name";s:18:"generateVerifyCode";s:8:"fullName";s:45:"yii\captcha\CaptchaAction::generateVerifyCode";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/CaptchaAction.php";s:9:"startLine";i:210;s:7:"endLine";i:236;s:16:"shortDescription";s:34:"Generates a new verification code.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"getSessionKey";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:25:"yii\captcha\CaptchaAction";s:10:"sourceCode";s:87:"protected function getSessionKey()
{
    return '__captcha/' . $this->getUniqueId();
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:25:"The session variable name";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:129603;s:4:"name";s:13:"getSessionKey";s:8:"fullName";s:40:"yii\captcha\CaptchaAction::getSessionKey";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/CaptchaAction.php";s:9:"startLine";i:242;s:7:"endLine";i:245;s:16:"shortDescription";s:66:"Returns the session variable name used to store verification code.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"renderImage";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:25:"yii\captcha\CaptchaAction";s:10:"sourceCode";s:472:"protected function renderImage($code)
{
    if (isset($this->imageLibrary)) {
        $imageLibrary = $this->imageLibrary;
    } else {
        $imageLibrary = Captcha::checkRequirements();
    }
    if ($imageLibrary === 'gd') {
        return $this->renderImageByGD($code);
    } elseif ($imageLibrary === 'imagick') {
        return $this->renderImageByImagick($code);
    }
    throw new InvalidConfigException("Defined library '{$imageLibrary}' is not supported");
}
";s:6:"params";a:1:{s:5:"$code";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$code";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:21:"The verification code";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/CaptchaAction.php";}}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:32:"if imageLibrary is not supported";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:14:"Image contents";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:129603;s:4:"name";s:11:"renderImage";s:8:"fullName";s:38:"yii\captcha\CaptchaAction::renderImage";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/CaptchaAction.php";s:9:"startLine";i:253;s:7:"endLine";i:267;s:16:"shortDescription";s:26:"Renders the CAPTCHA image.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:15:"renderImageByGD";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:25:"yii\captcha\CaptchaAction";s:10:"sourceCode";s:1516:"protected function renderImageByGD($code)
{
    $image = imagecreatetruecolor($this->width, $this->height);
    $backColor = imagecolorallocate(
        $image,
        (int) ($this->backColor % 0x1000000 / 0x10000),
        (int) ($this->backColor % 0x10000 / 0x100),
        $this->backColor % 0x100
    );
    imagefilledrectangle($image, 0, 0, $this->width - 1, $this->height - 1, $backColor);
    imagecolordeallocate($image, $backColor);
    if ($this->transparent) {
        imagecolortransparent($image, $backColor);
    }
    $foreColor = imagecolorallocate(
        $image,
        (int) ($this->foreColor % 0x1000000 / 0x10000),
        (int) ($this->foreColor % 0x10000 / 0x100),
        $this->foreColor % 0x100
    );
    $length = strlen($code);
    $box = imagettfbbox(30, 0, $this->fontFile, $code);
    $w = $box[4] - $box[0] + $this->offset * ($length - 1);
    $h = $box[1] - $box[5];
    $scale = min(($this->width - $this->padding * 2) / $w, ($this->height - $this->padding * 2) / $h);
    $x = 10;
    $y = round($this->height * 27 / 40);
    for ($i = 0; $i < $length; ++$i) {
        $fontSize = (int) (random_int(26, 32) * $scale * 0.8);
        $angle = random_int(-10, 10);
        $letter = $code[$i];
        $box = imagettftext($image, $fontSize, $angle, $x, $y, $foreColor, $this->fontFile, $letter);
        $x = $box[2] + $this->offset;
    }
    imagecolordeallocate($image, $foreColor);
    ob_start();
    imagepng($image);
    imagedestroy($image);
    return ob_get_clean();
}
";s:6:"params";a:1:{s:5:"$code";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$code";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:21:"The verification code";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/CaptchaAction.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:29:"Image contents in PNG format.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:129603;s:4:"name";s:15:"renderImageByGD";s:8:"fullName";s:42:"yii\captcha\CaptchaAction::renderImageByGD";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/CaptchaAction.php";s:9:"startLine";i:274;s:7:"endLine";i:320;s:16:"shortDescription";s:61:"Renders the CAPTCHA image based on the code using GD library.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:20:"renderImageByImagick";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:25:"yii\captcha\CaptchaAction";s:10:"sourceCode";s:1372:"protected function renderImageByImagick($code)
{
    $backColor = $this->transparent ? new \ImagickPixel('transparent') : new \ImagickPixel('#' . str_pad(dechex($this->backColor), 6, 0, STR_PAD_LEFT));
    $foreColor = new \ImagickPixel('#' . str_pad(dechex($this->foreColor), 6, 0, STR_PAD_LEFT));
    $image = new \Imagick();
    $image->newImage($this->width, $this->height, $backColor);
    $draw = new \ImagickDraw();
    $draw->setFont($this->fontFile);
    $draw->setFontSize(30);
    $fontMetrics = $image->queryFontMetrics($draw, $code);
    $length = strlen($code);
    $w = (int) $fontMetrics['textWidth'] - 8 + $this->offset * ($length - 1);
    $h = (int) $fontMetrics['textHeight'] - 8;
    $scale = min(($this->width - $this->padding * 2) / $w, ($this->height - $this->padding * 2) / $h);
    $x = 10;
    $y = round($this->height * 27 / 40);
    for ($i = 0; $i < $length; ++$i) {
        $draw = new \ImagickDraw();
        $draw->setFont($this->fontFile);
        $draw->setFontSize((int) (random_int(26, 32) * $scale * 0.8));
        $draw->setFillColor($foreColor);
        $image->annotateImage($draw, $x, $y, random_int(-10, 10), $code[$i]);
        $fontMetrics = $image->queryFontMetrics($draw, $code[$i]);
        $x += (int) $fontMetrics['textWidth'] + $this->offset;
    }
    $image->setImageFormat('png');
    return $image->getImageBlob();
}
