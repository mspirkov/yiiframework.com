:{}}s:17:"isCategoryIgnored";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:41:"yii\console\controllers\MessageController";s:10:"sourceCode";s:430:"protected function isCategoryIgnored($category, array $ignoreCategories)
{
    if (!empty($ignoreCategories)) {
        if (in_array($category, $ignoreCategories, true)) {
            return true;
        }
        foreach ($ignoreCategories as $pattern) {
            if (strpos($pattern, '*') > 0 && strpos($category, rtrim($pattern, '*')) === 0) {
                return true;
            }
        }
    }
    return false;
}
