See [[where()]] on how to specify this parameter.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/QueryTrait.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:23:"The query object itself";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:215869;s:4:"name";s:11:"filterWhere";s:8:"fullName";s:30:"yii\db\QueryTrait::filterWhere";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/QueryTrait.php";s:9:"startLine";i:166;s:7:"endLine";i:174;s:16:"shortDescription";s:74:"Sets the WHERE part of the query but ignores [[isEmpty()|empty operands]].";s:11:"description";s:613:"This method is similar to [[where()]]. The main difference is that this method will
remove [[isEmpty()|empty query operands]]. As a result, this method is best suited
for building query conditions based on filter values entered by users.

The following code shows the difference between this method and [[where()]]:

```
// WHERE `age`=:age
$query->filterWhere(['name' => null, 'age' => 20]);
// WHERE `age`=:age
$query->where(['age' => 20]);
// WHERE `name` IS NULL AND `age`=:age
$query->where(['name' => null, 'age' => 20]);
```

Note that unlike [[where()]], you cannot pass binding parameters to this method.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:3:{i:2;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:15:"\yii\db\where()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:5:"where";}}s:14:"␀*␀description";N;}i:3;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:24:"\yii\db\andFilterWhere()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:14:"andFilterWhere";}}s:14:"␀*␀description";N;}i:4;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:23:"\yii\db\orFilterWhere()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:13:"orFilterWhere";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:14:"andFilterWhere";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\db\QueryTrait";s:10:"sourceCode";s:196:"public function andFilterWhere(array $condition)
{
    $condition = $this->filterCondition($condition);
    if ($condition !== []) {
        $this->andWhere($condition);
    }
    return $this;
}
