Please refer to [[render()]] on how to specify this parameter.";s:10:"returnType";s:11:"string|bool";s:11:"returnTypes";a:2:{i:0;s:6:"string";i:1;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:74474;s:4:"name";s:14:"findLayoutFile";s:8:"fullName";s:35:"yii\base\Controller::findLayoutFile";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Controller.php";s:9:"startLine";i:561;s:7:"endLine";i:597;s:16:"shortDescription";s:33:"Finds the applicable layout file.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:18:"bindInjectedParams";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:1;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\base\Controller";s:10:"sourceCode";s:1079:"final protected function bindInjectedParams(\ReflectionNamedType $type, $name, &$args, &$requestedParams)
{
    // Since it is not a builtin type it must be DI injection.
    $typeName = $type->getName();
    if (($component = $this->module->get($name, false)) instanceof $typeName) {
        $args[] = $component;
        $requestedParams[$name] = 'Component: ' . get_class($component) . " \$$name";
    } elseif ($this->module->has($typeName) && ($service = $this->module->get($typeName)) instanceof $typeName) {
        $args[] = $service;
        $requestedParams[$name] = 'Module ' . get_class($this->module) . " DI: $typeName \$$name";
    } elseif (\Yii::$container->has($typeName) && ($service = \Yii::$container->get($typeName)) instanceof $typeName) {
        $args[] = $service;
        $requestedParams[$name] = "Container DI: $typeName \$$name";
    } elseif ($type->allowsNull()) {
        $args[] = null;
        $requestedParams[$name] = "Unavailable service: $name";
    } else {
        throw new Exception('Could not load required service: ' . $name);
    }
}
