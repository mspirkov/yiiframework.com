8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:15:"loadDummyBundle";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:20:"yii\web\AssetManager";s:10:"sourceCode";s:332:"protected function loadDummyBundle($name)
{
    if (!isset($this->_dummyBundles[$name])) {
        $bundle = Yii::createObject(['class' => $name]);
        $bundle->sourcePath = null;
        $bundle->js = [];
        $bundle->css = [];
        $this->_dummyBundles[$name] = $bundle;
    }
    return $this->_dummyBundles[$name];
}
";s:6:"params";a:1:{s:5:"$name";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$name";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetManager.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:0:"";s:10:"returnType";s:20:"\yii\web\AssetBundle";s:11:"returnTypes";a:1:{i:0;s:20:"\yii\web\AssetBundle";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:102062;s:4:"name";s:15:"loadDummyBundle";s:8:"fullName";s:37:"yii\web\AssetManager::loadDummyBundle";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetManager.php";s:9:"startLine";i:324;s:7:"endLine";i:336;s:16:"shortDescription";s:27:"Loads dummy bundle by name.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"getAssetUrl";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\web\AssetManager";s:10:"sourceCode";s:473:"public function getAssetUrl($bundle, $asset, $appendTimestamp = null)
{
    $assetUrl = $this->getActualAssetUrl($bundle, $asset);
    $assetPath = $this->getAssetPath($bundle, $asset);
    $withTimestamp = $this->appendTimestamp;
    if ($appendTimestamp !== null) {
        $withTimestamp = $appendTimestamp;
    }
    if ($withTimestamp && $assetPath && ($timestamp = @filemtime($assetPath)) > 0) {
        return "$assetUrl?v=$timestamp";
    }
    return $assetUrl;
}
";s:6:"params";a:3:{s:7:"$bundle";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$bundle";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:48:"The asset bundle which the asset file belongs to";s:4:"type";s:20:"\yii\web\AssetBundle";s:5:"types";a:1:{i:0;s:20:"\yii\web\AssetBundle";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetManager.php";}s:6:"$asset";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$asset";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:105:"The asset path. This should be one of the assets listed in [[AssetBundle::$js]] or [[AssetBundle::$css]].";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetManager.php";}s:16:"$appendTimestamp";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:16:"$appendTimestamp";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:39:"Whether to append timestamp to the URL.";s:4:"type";s:9:"bool|null";s:5:"types";a:2:{i:0;s:4:"bool";i:1;s:4:"null";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetManager.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:39:"The actual URL for the specified asset.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:102062;s:4:"name";s:11:"getAssetUrl";s:8:"fullName";s:33:"yii\web\AssetManager::getAssetUrl";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetManager.php";s:9:"startLine";i:346;s:7:"endLine";i:361;s:16:"shortDescription";s:47:"Returns the actual URL for the specified asset.";s:11:"description";s:128:"The actual URL is obtained by prepending either [[AssetBundle::$baseUrl]] or [[AssetManager::$baseUrl]] to the given asset path.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:12:"getAssetPath";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\web\AssetManager";s:10:"sourceCode";s:303:"public function getAssetPath($bundle, $asset)
{
    if (($actualAsset = $this->resolveAsset($bundle, $asset)) !== false) {
        return Url::isRelative($actualAsset) ? $this->basePath . '/' . $actualAsset : false;
    }
    return Url::isRelative($asset) ? $bundle->basePath . '/' . $asset : false;
}
";s:6:"params";a:2:{s:7:"$bundle";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$bundle";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:48:"The asset bundle which the asset file belongs to";s:4:"type";s:20:"\yii\web\AssetBundle";s:5:"types";a:1:{i:0;s:20:"\yii\web\AssetBundle";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetManager.php";}s:6:"$asset";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$asset";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:105:"The asset path. This should be one of the assets listed in [[AssetBundle::$js]] or [[AssetBundle::$css]].";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetManager.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:77:"The actual file path, or `false` if the asset is specified as an absolute URL";s:10:"returnType";s:12:"string|false";s:11:"returnTypes";a:2:{i:0;s:6:"string";i:1;s:5:"false";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:102062;s:4:"name";s:12:"getAssetPath";s:8:"fullName";s:34:"yii\web\AssetManager::getAssetPath";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetManager.php";s:9:"startLine";i:369;s:7:"endLine";i:376;s:16:"shortDescription";s:53:"Returns the actual file path for the specified asset.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:12:"resolveAsset";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:20:"yii\web\AssetManager";s:10:"sourceCode";s:552:"protected function resolveAsset($bundle, $asset)
{
    if (isset($this->assetMap[$asset])) {
        return $this->assetMap[$asset];
    }
    if ($bundle->sourcePath !== null && Url::isRelative($asset)) {
        $asset = $bundle->sourcePath . '/' . $asset;
    }
    $n = mb_strlen($asset, Yii::$app->charset);
    foreach ($this->assetMap as $from => $to) {
        $n2 = mb_strlen($from, Yii::$app->charset);
        if ($n2 <= $n && substr_compare($asset, $from, $n - $n2, $n2) === 0) {
            return $to;
        }
    }
    return false;
}
";s:6:"params";a:2:{s:7:"$bundle";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$bundle";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:20:"\yii\web\AssetBundle";s:5:"types";a:1:{i:0;s:20:"\yii\web\AssetBundle";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetManager.php";}s:6:"$asset";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$asset";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetManager.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:0:"";s:10:"returnType";s:12:"string|false";s:11:"returnTypes";a:2:{i:0;s:6:"string";i:1;s:5:"false";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:102062;s:4:"name";s:12:"resolveAsset";s:8:"fullName";s:34:"yii\web\AssetManager::resolveAsset";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetManager.php";s:9:"startLine";i:383;s:7:"endLine";i:401;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:12:"getConverter";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\web\AssetManager";s:10:"sourceCode";s:489:"public function getConverter()
{
    if ($this->_converter === null) {
        $this->_converter = Yii::createObject(AssetConverter::className());
    } elseif (is_array($this->_converter) || is_string($this->_converter)) {
        if (is_array($this->_converter) && !isset($this->_converter['class'])) {
            $this->_converter['class'] = AssetConverter::className();
        }
        $this->_converter = Yii::createObject($this->_converter);
    }
    return $this->_converter;
}
