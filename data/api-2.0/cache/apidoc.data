```";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:8:"yii\i18n";s:13:"phpDocContext";r:7920;s:4:"name";s:25:"yii\i18n\PhpMessageSource";s:8:"fullName";s:25:"yii\i18n\PhpMessageSource";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/PhpMessageSource.php";s:9:"startLine";i:35;s:7:"endLine";i:169;s:16:"shortDescription";s:92:"PhpMessageSource represents a message source that stores translated messages in PHP scripts.";s:11:"description";s:610:"PhpMessageSource uses PHP arrays to keep message translations.

- Each PHP script contains one array which stores the message translations in one particular
  language and for a single message category;
- Each PHP script is saved as a file named as "[[basePath]]/LanguageID/CategoryName.php";
- Within each PHP script, the message translations are returned as an array like the following:

```
return [
    'original message 1' => 'translated message 1',
    'original message 2' => 'translated message 2',
];
```

You may use [[fileMap]] to customize the association between category names and the file names.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:29:"yii\i18n\GettextMessageSource";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:22:"yii\i18n\MessageSource";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:2:{s:11:"MO_FILE_EXT";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:29:"yii\i18n\GettextMessageSource";s:5:"value";s:5:"'.mo'";s:13:"phpDocContext";N;s:4:"name";s:11:"MO_FILE_EXT";s:8:"fullName";s:42:"yii\i18n\GettextMessageSource::MO_FILE_EXT";s:10:"sourceFile";N;s:9:"startLine";i:32;s:7:"endLine";i:32;s:16:"shortDescription";N;s:11:"description";N;s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"PO_FILE_EXT";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:29:"yii\i18n\GettextMessageSource";s:5:"value";s:5:"'.po'";s:13:"phpDocContext";N;s:4:"name";s:11:"PO_FILE_EXT";s:8:"fullName";s:42:"yii\i18n\GettextMessageSource::PO_FILE_EXT";s:10:"sourceFile";N;s:9:"startLine";i:33;s:7:"endLine";i:33;s:16:"shortDescription";N;s:11:"description";N;s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:4:{s:12:"loadMessages";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:29:"yii\i18n\GettextMessageSource";s:10:"sourceCode";s:851:"protected function loadMessages($category, $language)
{
    $messageFile = $this->getMessageFilePath($language);
    $messages = $this->loadMessagesFromFile($messageFile, $category);
    $fallbackLanguage = substr($language, 0, 2);
    $fallbackSourceLanguage = substr($this->sourceLanguage, 0, 2);
    if ($fallbackLanguage !== '' && $fallbackLanguage !== $language) {
        $messages = $this->loadFallbackMessages($category, $fallbackLanguage, $messages, $messageFile);
    } elseif ($fallbackSourceLanguage !== '' && $language === $fallbackSourceLanguage) {
        $messages = $this->loadFallbackMessages($category, $this->sourceLanguage, $messages, $messageFile);
    } elseif ($messages === null) {
        Yii::error("The message file for category '$category' does not exist: $messageFile", __METHOD__);
    }
    return (array) $messages;
}
";s:6:"params";a:2:{s:9:"$category";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$category";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:20:"The message category";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:104:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/GettextMessageSource.php";}s:9:"$language";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$language";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:19:"The target language";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:104:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/GettextMessageSource.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:92:"The loaded messages. The keys are original messages, and the values are translated messages.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:8:"yii\i18n";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:2:{s:3:"Yii";s:3:"Yii";s:24:"InvalidArgumentException";s:33:"yii\base\InvalidArgumentException";}}s:4:"name";s:12:"loadMessages";s:8:"fullName";s:43:"yii\i18n\GettextMessageSource::loadMessages";s:10:"sourceFile";s:104:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/GettextMessageSource.php";s:9:"startLine";i:68;s:7:"endLine";i:85;s:16:"shortDescription";s:72:"Loads the message translation for the specified $language and $category.";s:11:"description";s:466:"If translation for specific locale code such as `en-US` isn't found it
tries more generic `en`. When both are present, the `en-US` messages will be merged
over `en`. See [[loadFallbackMessages]] for details.
If the $language is less specific than [[sourceLanguage]], the method will try to
load the messages for [[sourceLanguage]]. For example: [[sourceLanguage]] is `en-GB`,
$language is `en`. The method will load the messages for `en` and merge them over `en-GB`.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:3;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:30:"\yii\i18n\loadFallbackMessages";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:20:"loadFallbackMessages";}}s:14:"␀*␀description";N;}i:4;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:24:"\yii\i18n\sourceLanguage";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:14:"sourceLanguage";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:20:"loadFallbackMessages";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:29:"yii\i18n\GettextMessageSource";s:10:"sourceCode";s:980:"protected function loadFallbackMessages($category, $fallbackLanguage, $messages, $originalMessageFile)
{
    $fallbackMessageFile = $this->getMessageFilePath($fallbackLanguage);
    $fallbackMessages = $this->loadMessagesFromFile($fallbackMessageFile, $category);
    if (
        $messages === null && $fallbackMessages === null
        && $fallbackLanguage !== $this->sourceLanguage
        && strpos($this->sourceLanguage, $fallbackLanguage) !== 0
    ) {
        Yii::error("The message file for category '$category' does not exist: $originalMessageFile "
            . "Fallback file does not exist as well: $fallbackMessageFile", __METHOD__);
    } elseif (empty($messages)) {
        return $fallbackMessages;
    } elseif (!empty($fallbackMessages)) {
        foreach ($fallbackMessages as $key => $value) {
            if (!empty($value) && empty($messages[$key])) {
                $messages[$key] = $value;
            }
        }
    }
    return (array) $messages;
}
