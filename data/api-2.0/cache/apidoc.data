will have the specified value or 1.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"checkIntegrity";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\db\mysql\QueryBuilder";s:10:"sourceCode";s:136:"public function checkIntegrity($check = true, $schema = '', $table = '')
{
    return 'SET FOREIGN_KEY_CHECKS = ' . ($check ? 1 : 0);
}
