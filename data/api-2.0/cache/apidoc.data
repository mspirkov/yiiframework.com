false immediately in case lock was already acquired.";s:4:"type";s:3:"int";s:5:"types";a:1:{i:0;s:3:"int";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mutex/Mutex.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:22:"Lock acquiring result.";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:127993;s:4:"name";s:7:"acquire";s:8:"fullName";s:24:"yii\mutex\Mutex::acquire";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mutex/Mutex.php";s:9:"startLine";i:70;s:7:"endLine";i:79;s:16:"shortDescription";s:24:"Acquires a lock by name.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:7:"release";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\mutex\Mutex";s:10:"sourceCode";s:254:"public function release($name)
{
    if ($this->releaseLock($name)) {
        $index = array_search($name, $this->_locks);
        if ($index !== false) {
            unset($this->_locks[$index]);
        }
        return true;
    }
    return false;
}
";s:6:"params";a:1:{s:5:"$name";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$name";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:57:"Of the lock to be released. This lock must already exist.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mutex/Mutex.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:61:"Lock release result: false in case named lock was not found..";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:127993;s:4:"name";s:7:"release";s:8:"fullName";s:24:"yii\mutex\Mutex::release";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mutex/Mutex.php";s:9:"startLine";i:86;s:7:"endLine";i:98;s:16:"shortDescription";s:85:"Releases acquired lock. This method will return false in case the lock was not found.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:10:"isAcquired";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\mutex\Mutex";s:10:"sourceCode";s:87:"public function isAcquired($name)
{
    return in_array($name, $this->_locks, true);
}
