escaped or quoted.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:10:"properties";a:0:{}s:9:"namespace";s:17:"yii\db\conditions";s:13:"phpDocContext";r:154723;s:4:"name";s:40:"yii\db\conditions\SimpleConditionBuilder";s:8:"fullName";s:40:"yii\db\conditions\SimpleConditionBuilder";s:10:"sourceFile";s:115:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/conditions/SimpleConditionBuilder.php";s:9:"startLine";i:20;s:7:"endLine";i:55;s:16:"shortDescription";s:63:"Class NotConditionBuilder builds objects of [[SimpleCondition]]";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.14";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:36:"yii\db\conditions\InConditionBuilder";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";N;s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:1:{i:0;s:33:"yii\db\ExpressionBuilderInterface";}s:6:"traits";a:1:{i:0;s:29:"yii\db\ExpressionBuilderTrait";}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:15:"Dmytro Naumenko";s:22:"d.naumenko.a@gmail.com";}s:7:"methods";a:6:{s:5:"build";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:36:"yii\db\conditions\InConditionBuilder";s:10:"sourceCode";s:2358:"public function build(ExpressionInterface $expression, array &$params = [])
{
    $operator = strtoupper($expression->getOperator());
    $column = $expression->getColumn();
    $values = $expression->getValues();
    if ($column === []) {
        // no columns to test against
        return $operator === 'IN' ? '0=1' : '';
    }
    if ($values instanceof Query) {
        return $this->buildSubqueryInCondition($operator, $column, $values, $params);
    }
    if (!is_array($values) && !$values instanceof \Traversable) {
        // ensure values is an array
        $values = (array) $values;
    }
    if (is_array($column)) {
        if (count($column) > 1) {
            return $this->buildCompositeInCondition($operator, $column, $values, $params);
        }
        $column = reset($column);
    }
    if ($column instanceof \Traversable) {
        if (iterator_count($column) > 1) {
            return $this->buildCompositeInCondition($operator, $column, $values, $params);
        }
        $column->rewind();
        $column = $column->current();
    }
    if ($column instanceof Expression) {
        $column = $column->expression;
    }
    if (is_array($values)) {
        $rawValues = $values;
    } elseif ($values instanceof \Traversable) {
        $rawValues = $this->getRawValuesFromTraversableObject($values);
    }
    $nullCondition = null;
    $nullConditionOperator = null;
    if (isset($rawValues) && in_array(null, $rawValues, true)) {
        $nullCondition = $this->getNullCondition($operator, $column);
        $nullConditionOperator = $operator === 'IN' ? 'OR' : 'AND';
    }
    $sqlValues = $this->buildValues($expression, $values, $params);
    if (empty($sqlValues)) {
        if ($nullCondition === null) {
            return $operator === 'IN' ? '0=1' : '';
        }
        return $nullCondition;
    }
    if (strpos($column, '(') === false) {
        $column = $this->queryBuilder->db->quoteColumnName($column);
    }
    if (count($sqlValues) > 1) {
        $sql = "$column $operator (" . implode(', ', $sqlValues) . ')';
    } else {
        $operator = $operator === 'IN' ? '=' : '<>';
        $sql = $column . $operator . reset($sqlValues);
    }
    return $nullCondition !== null && $nullConditionOperator !== null
        ? sprintf('%s %s %s', $sql, $nullConditionOperator, $nullCondition)
        : $sql;
}
";s:6:"params";a:2:{s:11:"$expression";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:11:"$expression";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:27:"The expression to be built.";s:4:"type";s:58:"\yii\db\ExpressionInterface|\yii\db\conditions\InCondition";s:5:"types";a:2:{i:0;s:27:"\yii\db\ExpressionInterface";i:1;s:30:"\yii\db\conditions\InCondition";}s:10:"sourceFile";s:111:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/conditions/InConditionBuilder.php";}s:7:"$params";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$params";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:1;s:11:"description";s:23:"The binding parameters.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:111:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/conditions/InConditionBuilder.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:60:"The raw SQL that will not be additionally escaped or quoted.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:17:"yii\db\conditions";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:5:{s:10:"Expression";s:17:"yii\db\Expression";s:26:"ExpressionBuilderInterface";s:33:"yii\db\ExpressionBuilderInterface";s:22:"ExpressionBuilderTrait";s:29:"yii\db\ExpressionBuilderTrait";s:19:"ExpressionInterface";s:26:"yii\db\ExpressionInterface";s:5:"Query";s:12:"yii\db\Query";}}s:4:"name";s:5:"build";s:8:"fullName";s:43:"yii\db\conditions\InConditionBuilder::build";s:10:"sourceFile";s:111:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/conditions/InConditionBuilder.php";s:9:"startLine";i:35;s:7:"endLine";i:108;s:16:"shortDescription";s:95:"Method builds the raw SQL from the $expression that will not be additionally
escaped or quoted.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"buildValues";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:36:"yii\db\conditions\InConditionBuilder";s:10:"sourceCode";s:930:"protected function buildValues(ConditionInterface $condition, $values, &$params)
{
    $sqlValues = [];
    $column = $condition->getColumn();
    if (is_array($column)) {
        $column = reset($column);
    }
    if ($column instanceof \Traversable) {
        $column->rewind();
        $column = $column->current();
    }
    if ($column instanceof Expression) {
        $column = $column->expression;
    }
    foreach ($values as $i => $value) {
        if (is_array($value) || $value instanceof \ArrayAccess) {
            $value = isset($value[$column]) ? $value[$column] : null;
        }
        if ($value === null) {
            continue;
        } elseif ($value instanceof ExpressionInterface) {
            $sqlValues[$i] = $this->queryBuilder->buildExpression($value, $params);
        } else {
            $sqlValues[$i] = $this->queryBuilder->bindParam($value, $params);
        }
    }
    return $sqlValues;
}
