See [[booleanInput()]] for details about accepted attributes.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:30:"The generated radio button tag";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:56244;s:4:"name";s:5:"radio";s:8:"fullName";s:27:"yii\helpers\BaseHtml::radio";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";s:9:"startLine";i:728;s:7:"endLine";i:731;s:16:"shortDescription";s:31:"Generates a radio button input.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"checkbox";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\helpers\BaseHtml";s:10:"sourceCode";s:148:"public static function checkbox($name, $checked = false, $options = [])
