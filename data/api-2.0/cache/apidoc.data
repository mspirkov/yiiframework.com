Application configuration example:

```
[
    'components' => [
        'mutex' => [
            'class' => 'yii\mutex\FileMutex'
        ],
    ],
]
```

> Note: this component can maintain the locks only for the single web server,
> it probably will not suffice in case you are using cloud server solution.

> Warning: due to `flock()` function nature this component is unreliable when
> using a multithreaded server API like ISAPI.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:16:"\yii\mutex\Mutex";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:5:"Mutex";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:15:"yii\mutex\Mutex";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:18:"yii\base\Component";s:10:"isAbstract";b:1;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:7:"resurtm";s:17:"resurtm@gmail.com";}s:7:"methods";a:6:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\mutex\Mutex";s:10:"sourceCode";s:264:"public function init()
{
    if ($this->autoRelease) {
        $locks = &$this->_locks;
        register_shutdown_function(function () use (&$locks) {
            foreach ($locks as $lock) {
                $this->release($lock);
            }
        });
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:9:"yii\mutex";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:1:{s:9:"Component";s:18:"yii\base\Component";}}s:4:"name";s:4:"init";s:8:"fullName";s:21:"yii\mutex\Mutex::init";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mutex/Mutex.php";s:9:"startLine";i:51;s:7:"endLine";i:61;s:16:"shortDescription";s:32:"Initializes the Mutex component.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:7:"acquire";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\mutex\Mutex";s:10:"sourceCode";s:215:"public function acquire($name, $timeout = 0)
{
    if (!in_array($name, $this->_locks, true) && $this->acquireLock($name, $timeout)) {
        $this->_locks[] = $name;
        return true;
    }
    return false;
}
