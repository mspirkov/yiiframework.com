meaning all attributes that are loaded from DB will be saved.";s:4:"type";s:10:"array|null";s:5:"types";a:2:{i:0;s:5:"array";i:1;s:4:"null";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveRecord.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:44:"Whether the record is inserted successfully.";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:159117;s:4:"name";s:14:"insertInternal";s:8:"fullName";s:35:"yii\db\ActiveRecord::insertInternal";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveRecord.php";s:9:"startLine";i:637;s:7:"endLine";i:657;s:16:"shortDescription";s:64:"Inserts an ActiveRecord into DB without considering transaction.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"update";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\db\ActiveRecord";s:10:"sourceCode";s:807:"public function update($runValidation = true, $attributeNames = null)
{
    if ($runValidation && !$this->validate($attributeNames)) {
        Yii::info('Model not updated due to validation error.', __METHOD__);
        return false;
    }
    if (!$this->isTransactional(self::OP_UPDATE)) {
        return $this->updateInternal($attributeNames);
    }
    $transaction = static::getDb()->beginTransaction();
    try {
        $result = $this->updateInternal($attributeNames);
        if ($result === false) {
            $transaction->rollBack();
        } else {
            $transaction->commit();
        }
        return $result;
    } catch (\Exception $e) {
        $transaction->rollBack();
        throw $e;
    } catch (\Throwable $e) {
        $transaction->rollBack();
        throw $e;
    }
}
";s:6:"params";a:2:{s:14:"$runValidation";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:14:"$runValidation";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"true";s:19:"isPassedByReference";b:0;s:11:"description";s:207:"Whether to perform validation (calling [[validate()]])
before saving the record. Defaults to `true`. If the validation fails, the record
