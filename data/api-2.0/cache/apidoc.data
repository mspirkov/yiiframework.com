";s:6:"params";a:1:{s:7:"$params";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$params";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:26:"The command line arguments";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/Request.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:43958;s:4:"name";s:9:"setParams";s:8:"fullName";s:30:"yii\console\Request::setParams";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/Request.php";s:9:"startLine";i:48;s:7:"endLine";i:51;s:16:"shortDescription";s:32:"Sets the command line arguments.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:7:"resolve";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\console\Request";s:10:"sourceCode";s:1582:"public function resolve()
{
    $rawParams = $this->getParams();
    $endOfOptionsFound = false;
    if (isset($rawParams[0])) {
        $route = array_shift($rawParams);
        if ($route === '--') {
            $endOfOptionsFound = true;
            $route = array_shift($rawParams);
        }
    } else {
        $route = '';
    }
    $params = [];
    $prevOption = null;
    foreach ($rawParams as $param) {
        if ($endOfOptionsFound) {
            $params[] = $param;
        } elseif ($param === '--') {
            $endOfOptionsFound = true;
        } elseif (preg_match('/^--([\w-]+)(?:=(.*))?$/', $param, $matches)) {
            $name = $matches[1];
            if (is_numeric(substr($name, 0, 1))) {
                throw new Exception('Parameter "' . $name . '" is not valid');
            }
            if ($name !== Application::OPTION_APPCONFIG) {
                $params[$name] = isset($matches[2]) ? $matches[2] : true;
                $prevOption = &$params[$name];
            }
        } elseif (preg_match('/^-([\w-]+)(?:=(.*))?$/', $param, $matches)) {
            $name = $matches[1];
            if (is_numeric($name)) {
                $params[] = $param;
            } else {
                $params['_aliases'][$name] = isset($matches[2]) ? $matches[2] : true;
                $prevOption = &$params['_aliases'][$name];
            }
        } elseif ($prevOption === true) {
            // `--option value` syntax
            $prevOption = $param;
        } else {
            $params[] = $param;
        }
    }
    return [$route, $params];
}
