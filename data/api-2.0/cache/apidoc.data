mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/DataReader.php";s:9:"startLine";N;s:7:"endLine";N;s:16:"shortDescription";s:39:"Number of rows contained in the result.";s:11:"description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:39:"Number of rows contained in the result.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:9:"namespace";s:6:"yii\db";s:13:"phpDocContext";r:167331;s:4:"name";s:17:"yii\db\DataReader";s:8:"fullName";s:17:"yii\db\DataReader";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/DataReader.php";s:9:"startLine";i:53;s:7:"endLine";i:276;s:16:"shortDescription";s:76:"DataReader represents a forward-only stream of rows from a query result set.";s:11:"description";s:813:"To read the current row of data, call [[read()]]. The method [[readAll()]]
returns all the rows in a single array. Rows of data can also be read by
iterating through the reader. For example,

```
$command = $connection->createCommand('SELECT * FROM post');
$reader = $command->query();

while ($row = $reader->read()) {
    $rows[] = $row;
}

// equivalent to:
foreach ($reader as $row) {
    $rows[] = $row;
}

// equivalent to:
$rows = $reader->readAll();
```

Note that since DataReader is a forward-only stream, you can only traverse it once.
Doing it the second time will throw an exception.

It is possible to use a specific mode of data fetching by setting
[[fetchMode]]. See the [PHP manual](https://www.php.net/manual/en/function.PDOStatement-setFetchMode.php)
for more details about possible fetch mode.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:5:{i:0;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:11:"columnCount";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Integer":0:{}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:167928;}i:1;O:52:"phpDocumentor\Reflection\DocBlock\Tags\PropertyWrite":4:{s:15:"␀*␀variableName";s:9:"fetchMode";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Integer":0:{}s:7:"␀*␀name";s:14:"property-write";s:14:"␀*␀description";r:167954;}i:2;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:8:"isClosed";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Boolean":0:{}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:167980;}i:3;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:8:"rowCount";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Integer":0:{}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:168006;}i:6;O:50:"phpDocumentor\Reflection\DocBlock\Tags\Implements_":3:{s:7:"␀*␀type";O:41:"phpDocumentor\Reflection\Types\Collection":4:{s:48:"␀phpDocumentor\Reflection\Types\Collection␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:9:"\Iterator";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:8:"Iterator";}s:12:"␀*␀valueType";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:10:"␀*␀keyType";O:38:"phpDocumentor\Reflection\Types\Integer":0:{}s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}s:7:"␀*␀name";s:10:"implements";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock