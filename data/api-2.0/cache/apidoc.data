```";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:7:"yii\web";s:13:"phpDocContext";r:93420;s:4:"name";s:25:"yii\web\MultiFieldSession";s:8:"fullName";s:25:"yii\web\MultiFieldSession";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/MultiFieldSession.php";s:9:"startLine";i:30;s:7:"endLine";i:131;s:16:"shortDescription";s:110:"MultiFieldSession is the base class for session storage implementations with multi-field data storage support.";s:11:"description";s:757:"With multi-field data storage, session data can be split between several fields in the storage record.
Using such a storage allows saving particular session data into separated field, which then can be used
to manipulate sessions in the way plain PHP does not allow.

For example the ID of the authenticated user can be saved as separated column in the MySQL 'session' table,
which allows to query all active sessions for a particular user or terminate them at will.

Customizing of the session writing is performed via [[writeCallback]], reading via [[readCallback]].

While extending this class you should use [[composeFields()]] method - while writing the session data into the storage and
[[extractData()]] - while reading session data from the storage.";s:5:"since";s:5:"2.0.6";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:16:"useCustomStorage";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Boolean":0:{}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:93542;}}s:5:"todos";a:0:{}}s:23:"yii\web\SessionIterator";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";N;s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:1:{i:0;s:8:"Iterator";}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:6:{s:11:"__construct";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\web\SessionIterator";s:10:"sourceCode";s:121:"public function __construct()
{
