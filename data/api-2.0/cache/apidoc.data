    $options = $this->csrfCookie;
    return Yii::createObject(array_merge($options, [
        'class' => 'yii\web\Cookie',
        'name' => $this->csrfParam,
        'value' => $token,
    ]));
}
";s:6:"params";a:1:{s:6:"$token";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$token";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:14:"The CSRF token";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:20:"The generated cookie";s:10:"returnType";s:15:"\yii\web\Cookie";s:11:"returnTypes";a:1:{i:0;s:15:"\yii\web\Cookie";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:113036;s:4:"name";s:16:"createCsrfCookie";s:8:"fullName";s:33:"yii\web\Request::createCsrfCookie";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";s:9:"startLine";i:1868;s:7:"endLine";i:1876;s:16:"shortDescription";s:54:"Creates a cookie with a randomly generated CSRF token.";s:11:"description";s:83:"Initial values specified in [[csrfCookie]] will be applied to the generated cookie.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:2;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:29:"\yii\web\enableCsrfValidation";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:20:"enableCsrfValidation";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:17:"validateCsrfToken";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\web\Request";s:10:"sourceCode";s:770:"public function validateCsrfToken($clientSuppliedToken = null)
{
    $method = $this->getMethod();
    if ($this->validateCsrfHeaderOnly) {
        return in_array($method, $this->csrfHeaderUnsafeMethods, true)
            ? $this->headers->has($this->csrfHeader)
            : true;
    }
    if (!$this->enableCsrfValidation || in_array($method, $this->csrfTokenSafeMethods, true)) {
        return true;
    }
    $trueToken = $this->getCsrfToken();
    if ($clientSuppliedToken !== null) {
        return $this->validateCsrfTokenInternal($clientSuppliedToken, $trueToken);
    }
    return $this->validateCsrfTokenInternal($this->getBodyParam($this->csrfParam), $trueToken)
        || $this->validateCsrfTokenInternal($this->getCsrfTokenFromHeader(), $trueToken);
}
";s:6:"params";a:1:{s:20:"$clientSuppliedToken";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:20:"$clientSuppliedToken";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:181:"The user-provided CSRF token to be validated. If null, the token will be retrieved from
the [[csrfParam]] POST field or HTTP header.
This parameter is available since version 2.0.4.";s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:96:"Whether CSRF token is valid. If [[enableCsrfValidation]] is false, this method will return true.";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:113036;s:4:"name";s:17:"validateCsrfToken";s:8:"fullName";s:34:"yii\web\Request::validateCsrfToken";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";s:9:"startLine";i:1892;s:7:"endLine";i:1914;s:16:"shortDescription";s:29:"Performs the CSRF validation.";s:11:"description";s:318:"This method will validate the user-provided CSRF token by comparing it with the one stored in cookie or session.
This method is mainly called in [[Controller::beforeAction()]].

Note that the method will NOT perform CSRF validation if [[enableCsrfValidation]] is false or the HTTP method
is among GET, HEAD or OPTIONS.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:35:"getSecureForwardedHeaderTrustedPart";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:15:"yii\web\Request";s:10:"sourceCode";s:341:"protected function getSecureForwardedHeaderTrustedPart($token)
{
    $token = strtolower($token);
    if ($parts = $this->getSecureForwardedHeaderTrustedParts()) {
        $lastElement = array_pop($parts);
        if ($lastElement && isset($lastElement[$token])) {
            return $lastElement[$token];
        }
    }
    return null;
}
";s:6:"params";a:1:{s:6:"$token";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$token";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:12:"Header token";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:0:"";s:10:"returnType";s:11:"string|null";s:11:"returnTypes";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:113036;s:4:"name";s:35:"getSecureForwardedHeaderTrustedPart";s:8:"fullName";s:52:"yii\web\Request::getSecureForwardedHeaderTrustedPart";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";s:9:"startLine";i:1943;s:7:"endLine";i:1954;s:16:"shortDescription";s:45:"Gets first `Forwarded` header value for token";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.31";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:36:"getSecureForwardedHeaderTrustedParts";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:15:"yii\web\Request";s:10:"sourceCode";s:855:"protected function getSecureForwardedHeaderTrustedParts()
{
    if ($this->_secureForwardedHeaderTrustedParts !== null) {
        return $this->_secureForwardedHeaderTrustedParts;
    }
    $validator = $this->getIpValidator();
    $trustedHosts = [];
    foreach ($this->trustedHosts as $trustedCidr => $trustedCidrOrHeaders) {
        if (!is_array($trustedCidrOrHeaders)) {
            $trustedCidr = $trustedCidrOrHeaders;
        }
        $trustedHosts[] = $trustedCidr;
    }
    $validator->setRanges($trustedHosts);
    $this->_secureForwardedHeaderTrustedParts = array_filter(
        $this->getSecureForwardedHeaderParts(),
        function ($headerPart) use ($validator) {
            return isset($headerPart['for']) ? !$validator->validate($headerPart['for']) : true;
        }
    );
    return $this->_secureForwardedHeaderTrustedParts;
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:0:"";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:113036;s:4:"name";s:36:"getSecureForwardedHeaderTrustedParts";s:8:"fullName";s:53:"yii\web\Request::getSecureForwardedHeaderTrustedParts";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";s:9:"startLine";i:1965;s:7:"endLine";i:1989;s:16:"shortDescription";s:42:"Gets only trusted `Forwarded` header parts";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.31";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:29:"getSecureForwardedHeaderParts";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:15:"yii\web\Request";s:10:"sourceCode";s:1563:"protected function getSecureForwardedHeaderParts()
{
    if ($this->_secureForwardedHeaderParts !== null) {
        return $this->_secureForwardedHeaderParts;
    }
    if (count(preg_grep('/^forwarded$/i', $this->secureHeaders)) === 0) {
        return $this->_secureForwardedHeaderParts = [];
    }
    /*
     * First header is always correct, because proxy CAN add headers
     * after last one is found.
     * Keep in mind that it is NOT enforced, therefore we cannot be
     * sure, that this is really a first one.
     *
     * FPM keeps last header sent which is a bug. You need to merge
     * headers together on your web server before letting FPM handle it
     * @see https://bugs.php.net/bug.php?id=78844
     */
    $forwarded = $this->headers->get('Forwarded', '');
    if ($forwarded === '') {
        return $this->_secureForwardedHeaderParts = [];
    }
    preg_match_all('/(?:[^",]++|"[^"]++")+/', $forwarded, $forwardedElements);
    foreach ($forwardedElements[0] as $forwardedPairs) {
        preg_match_all('/(?P<key>\w+)\s*=\s*(?:(?P<value>[^",;]*[^",;\s])|"(?P<value2>[^"]+)")/', $forwardedPairs, $matches, PREG_SET_ORDER);
        $this->_secureForwardedHeaderParts[] = array_reduce($matches, function ($carry, $item) {
            $value = $item['value'];
            if (isset($item['value2']) && $item['value2'] !== '') {
                $value = $item['value2'];
            }
            $carry[strtolower($item['key'])] = $value;
            return $carry;
        }, []);
    }
    return $this->_secureForwardedHeaderParts;
}
