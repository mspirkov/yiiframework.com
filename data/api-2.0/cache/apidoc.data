fixture class names.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:8:"yii\test";s:13:"phpDocContext";r:1188;s:4:"name";s:16:"yii\test\Fixture";s:8:"fullName";s:16:"yii\test\Fixture";s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/test/Fixture.php";s:9:"startLine";i:32;s:7:"endLine";i:86;s:16:"shortDescription";s:55:"Fixture represents a fixed state of a test environment.";s:11:"description";s:866:"Each fixture instance represents a particular aspect of a test environment. For example,
you may use `UserFixture` to initialize the user database table with a set of known data. You may
load the fixture when running every test method so that the user table always contains the fixed data
and thus allows your test predictable and repeatable.

A fixture may depend on other fixtures, specified via the [[depends]] property. When a fixture is being loaded,
its dependent fixtures will be automatically loaded BEFORE the fixture; and when the fixture is being unloaded,
its dependent fixtures will be unloaded AFTER the fixture.

You should normally override [[load()]] to specify how to set up a fixture; and override [[unload()]]
for clearing up a fixture.

For more details and usage information on Fixture, see the [guide article on fixtures](guide:test-fixtures).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:26:"yii\test\BaseActiveFixture";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:18:"yii\test\DbFixture";s:10:"isAbstract";b:1;s:7:"isFinal";b:0;s:10:"interfaces";a:3:{i:0;s:17:"IteratorAggregate";i:1;s:11:"ArrayAccess";i:2;s:9:"Countable";}s:6:"traits";a:2:{i:0;s:25:"yii\base\ArrayAccessTrait";i:1;s:25:"yii\test\FileFixtureTrait";}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:4:{s:8:"getModel";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:26:"yii\test\BaseActiveFixture";s:10:"sourceCode";s:638:"public function getModel($name)
{
    if (!isset($this->data[$name])) {
        return null;
    }
    if (array_key_exists($name, $this->_models)) {
        return $this->_models[$name];
    }
    if ($this->modelClass === null) {
        throw new InvalidConfigException('The "modelClass" property must be set.');
    }
    $row = $this->data[$name];
    /** @var \yii\db\ActiveRecord $modelClass */
    $modelClass = $this->modelClass;
    $keys = [];
    foreach ($modelClass::primaryKey() as $key) {
        $keys[$key] = isset($row[$key]) ? $row[$key] : null;
    }
    return $this->_models[$name] = $modelClass::findOne($keys);
}
