:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\i18n\Locale";s:10:"sourceCode";s:262:"public function init()
{
    if (!extension_loaded('intl')) {
        throw new InvalidConfigException('Locale component requires PHP intl extension to be installed.');
    }
    if ($this->locale === null) {
        $this->locale = Yii::$app->language;
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:8:"yii\i18n";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:3:{s:3:"Yii";s:3:"Yii";s:9:"Component";s:18:"yii\base\Component";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";}}s:4:"name";s:4:"init";s:8:"fullName";s:21:"yii\i18n\Locale::init";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Locale.php";s:9:"startLine";i:35;s:7:"endLine";i:44;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:17:"getCurrencySymbol";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\i18n\Locale";s:10:"sourceCode";s:323:"public function getCurrencySymbol($currencyCode = null)
{
    $locale = $this->locale;
    if ($currencyCode !== null) {
        $locale .= '@currency=' . $currencyCode;
    }
    $formatter = new \NumberFormatter($locale, \NumberFormatter::CURRENCY);
    return $formatter->getSymbol(\NumberFormatter::CURRENCY_SYMBOL);
}
