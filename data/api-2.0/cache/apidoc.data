";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\caching";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:2:{s:3:"Yii";s:3:"Yii";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";}}s:4:"name";s:4:"init";s:8:"fullName";s:26:"yii\caching\MemCache::init";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/MemCache.php";s:9:"startLine";i:113;s:7:"endLine";i:117;s:16:"shortDescription";s:39:"Initializes this application component.";s:11:"description";s:59:"It creates the memcache instance and adds memcache servers.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:10:"addServers";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:20:"yii\caching\MemCache";s:10:"sourceCode";s:597:"protected function addServers($cache, $servers)
{
    if (empty($servers)) {
        $servers = [new MemCacheServer([
            'host' => '127.0.0.1',
            'port' => 11211,
        ])];
    } else {
        foreach ($servers as $server) {
            if ($server->host === null) {
                throw new InvalidConfigException("The 'host' property must be specified for every memcache server.");
            }
        }
    }
    if ($this->useMemcached) {
        $this->addMemcachedServers($cache, $servers);
    } else {
        $this->addMemcacheServers($cache, $servers);
    }
}
";s:6:"params";a:2:{s:6:"$cache";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$cache";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:20:"\Memcache|\Memcached";s:5:"types";a:2:{i:0;s:9:"\Memcache";i:1;s:10:"\Memcached";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/MemCache.php";}s:8:"$servers";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$servers";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:29:"\yii\caching\MemCacheServer[]";s:5:"types";a:1:{i:0;s:29:"\yii\caching\MemCacheServer[]";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/MemCache.php";}}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:122990;s:4:"name";s:10:"addServers";s:8:"fullName";s:32:"yii\caching\MemCache::addServers";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/MemCache.php";s:9:"startLine";i:126;s:7:"endLine";i:145;s:16:"shortDescription";s:54:"Add servers to the server pool of the cache specified.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:19:"addMemcachedServers";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:20:"yii\caching\MemCache";s:10:"sourceCode";s:496:"protected function addMemcachedServers($cache, $servers)
{
    $existingServers = [];
    if ($this->persistentId !== null) {
        foreach ($cache->getServerList() as $s) {
            $existingServers[$s['host'] . ':' . $s['port']] = true;
        }
    }
    foreach ($servers as $server) {
        if (empty($existingServers) || !isset($existingServers[$server->host . ':' . $server->port])) {
            $cache->addServer($server->host, $server->port, $server->weight);
        }
    }
}
";s:6:"params";a:2:{s:6:"$cache";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$cache";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:10:"\Memcached";s:5:"types";a:1:{i:0;s:10:"\Memcached";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/MemCache.php";}s:8:"$servers";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$servers";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:29:"\yii\caching\MemCacheServer[]";s:5:"types";a:1:{i:0;s:29:"\yii\caching\MemCacheServer[]";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/MemCache.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:122990;s:4:"name";s:19:"addMemcachedServers";s:8:"fullName";s:41:"yii\caching\MemCache::addMemcachedServers";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/MemCache.php";s:9:"startLine";i:154;s:7:"endLine";i:167;s:16:"shortDescription";s:88:"Add servers to the server pool of the cache specified
Used for memcached PECL extension.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:18:"addMemcacheServers";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:20:"yii\caching\MemCache";s:10:"sourceCode";s:1132:"protected function addMemcacheServers($cache, $servers)
{
    $class = new \ReflectionClass($cache);
    $paramCount = $class->getMethod('addServer')->getNumberOfParameters();
    foreach ($servers as $server) {
        // $timeout is used for memcache versions that do not have $timeoutms parameter
        $timeout = (int) ($server->timeout / 1000) + (($server->timeout % 1000 > 0) ? 1 : 0);
        if ($paramCount === 9) {
            $cache->addserver(
                $server->host,
                $server->port,
                $server->persistent,
                $server->weight,
                $timeout,
                $server->retryInterval,
                $server->status,
                $server->failureCallback,
                $server->timeout
            );
        } else {
            $cache->addserver(
                $server->host,
                $server->port,
                $server->persistent,
                $server->weight,
                $timeout,
                $server->retryInterval,
                $server->status,
                $server->failureCallback
            );
        }
    }
}
