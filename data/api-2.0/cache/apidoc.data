";s:6:"params";a:1:{s:7:"$config";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$config";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:19:"View configuration.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mail/BaseMailer.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:14:"View instance.";s:10:"returnType";s:13:"\yii\web\View";s:11:"returnTypes";a:1:{i:0;s:13:"\yii\web\View";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:15039;s:4:"name";s:10:"createView";s:8:"fullName";s:31:"yii\mail\BaseMailer::createView";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mail/BaseMailer.php";s:9:"startLine";i:142;s:7:"endLine";i:149;s:16:"shortDescription";s:47:"Creates view instance from given configuration.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:7:"compose";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\mail\BaseMailer";s:10:"sourceCode";s:1454:"public function compose($view = null, array $params = [])
{
    $message = $this->createMessage();
    if ($view === null) {
        return $message;
    }
    if (!array_key_exists('message', $params)) {
        $params['message'] = $message;
    }
    $this->_message = $message;
    if (is_array($view)) {
        if (isset($view['html'])) {
            $html = $this->render($view['html'], $params, $this->htmlLayout);
        }
        if (isset($view['text'])) {
            $text = $this->render($view['text'], $params, $this->textLayout);
        }
    } else {
        $html = $this->render($view, $params, $this->htmlLayout);
    }
    $this->_message = null;
    if (isset($html)) {
        $message->setHtmlBody($html);
    }
    if (isset($text)) {
        $message->setTextBody($text);
    } elseif (isset($html)) {
        if (preg_match('~<body[^>]*>(.*?)</body>~is', $html, $match)) {
            $html = $match[1];
        }
        // remove style and script
        $html = preg_replace('~<((style|script))[^>]*>(.*?)</\1>~is', '', $html);
        // strip all HTML tags and decoded HTML entities
        $text = html_entity_decode(strip_tags($html), ENT_QUOTES | ENT_HTML5, Yii::$app ? Yii::$app->charset : 'UTF-8');
        // improve whitespace
        $text = preg_replace("~^[ \t]+~m", '', trim($text));
        $text = preg_replace('~\R\R+~mu', "\n\n", $text);
        $message->setTextBody($text);
    }
    return $message;
}
";s:6:"params";a:2:{s:5:"$view";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$view";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:802:"The view to be used for rendering the message body. This can be:

- a string, which represents the view name or [path alias](guide:concept-aliases) for rendering the HTML body of the email.
  In this case, the text body will be generated by applying `strip_tags()` to the HTML body.
- an array with 'html' and/or 'text' elements. The 'html' element refers to the view name or path alias
  for rendering the HTML body, while 'text' element is for rendering the text body. For example,
  `['html' => 'contact-html', 'text' => 'contact-text']`.
- null, meaning the message instance will be returned without body content.

The view to be rendered can be specified in one of the following formats:

- path alias (e.g. "@app/mail/contact");
- a relative view name (e.g. "contact") located under [[viewPath]].";s:4:"type";s:17:"string|array|null";s:5:"types";a:3:{i:0;s:6:"string";i:1;s:5:"array";i:2;s:4:"null";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mail/BaseMailer.php";}s:7:"$params";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$params";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:93:"The parameters (name-value pairs) that will be extracted and made available in the view file.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mail/BaseMailer.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:17:"Message instance.";s:10:"returnType";s:26:"\yii\mail\MessageInterface";s:11:"returnTypes";a:1:{i:0;s:26:"\yii\mail\MessageInterface";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:15039;s:4:"name";s:7:"compose";s:8:"fullName";s:28:"yii\mail\BaseMailer::compose";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mail/BaseMailer.php";s:9:"startLine";i:173;s:7:"endLine";i:220;s:16:"shortDescription";s:91:"Creates a new message instance and optionally composes its body content via view rendering.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"createMessage";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\mail\BaseMailer";s:10:"sourceCode";s:246:"protected function createMessage()
{
    $config = $this->messageConfig;
    if (!array_key_exists('class', $config)) {
        $config['class'] = $this->messageClass;
    }
    $config['mailer'] = $this;
    return Yii::createObject($config);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:17:"Message instance.";s:10:"returnType";s:26:"\yii\mail\MessageInterface";s:11:"returnTypes";a:1:{i:0;s:26:"\yii\mail\MessageInterface";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:15039;s:4:"name";s:13:"createMessage";s:8:"fullName";s:34:"yii\mail\BaseMailer::createMessage";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mail/BaseMailer.php";s:9:"startLine";i:229;s:7:"endLine";i:237;s:16:"shortDescription";s:31:"Creates a new message instance.";s:11:"description";s:226:"The newly created instance will be initialized with the configuration specified by [[messageConfig]].
If the configuration does not specify a 'class', the [[messageClass]] will be used as the class
of the new message instance.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:4:"send";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\mail\BaseMailer";s:10:"sourceCode";s:563:"public function send($message)
{
    if (!$this->beforeSend($message)) {
        return false;
    }
    $address = $message->getTo();
    if (is_array($address)) {
        $address = implode(', ', array_keys($address));
    }
    Yii::info('Sending email "' . $message->getSubject() . '" to "' . $address . '"', __METHOD__);
    if ($this->useFileTransport) {
        $isSuccessful = $this->saveMessage($message);
    } else {
        $isSuccessful = $this->sendMessage($message);
    }
    $this->afterSend($message, $isSuccessful);
    return $isSuccessful;
}
