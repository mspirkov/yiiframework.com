/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/CompareValidator.php";s:9:"startLine";i:215;s:7:"endLine";i:244;s:16:"shortDescription";s:48:"Compares two values with the specified operator.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:23:"clientValidateAttribute";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:31:"yii\validators\CompareValidator";s:10:"sourceCode";s:422:"public function clientValidateAttribute($model, $attribute, $view)
{
    if ($this->compareValue != null && $this->compareValue instanceof \Closure) {
        $this->compareValue = call_user_func($this->compareValue);
    }
    ValidationAsset::register($view);
    $options = $this->getClientOptions($model, $attribute);
    return 'yii.validation.compare(value, messages, ' . Json::htmlEncode($options) . ', $form);';
}
";s:6:"params";a:3:{s:6:"$model";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$model";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:106:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/CompareValidator.php";}s:10:"$attribute";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$attribute";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:106:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/CompareValidator.php";}s:5:"$view";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$view";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:106:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/CompareValidator.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:131993;s:4:"name";s:23:"clientValidateAttribute";s:8:"fullName";s:56:"yii\validators\CompareValidator::clientValidateAttribute";s:10:"sourceFile";s:106:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/CompareValidator.php";s:9:"startLine";i:249;s:7:"endLine";i:259;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:16:"getClientOptions";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:31:"yii\validators\CompareValidator";s:10:"sourceCode";s:1186:"public function getClientOptions($model, $attribute)
{
    $options = [
        'operator' => $this->operator,
        'type' => $this->type,
    ];
    if ($this->compareValue !== null) {
        $options['compareValue'] = $this->compareValue;
        $compareLabel = $compareValue = $compareValueOrAttribute = $this->compareValue;
    } else {
        $compareAttribute = $this->compareAttribute === null ? $attribute . '_repeat' : $this->compareAttribute;
        $compareValue = $model->getAttributeLabel($compareAttribute);
        $options['compareAttribute'] = Html::getInputId($model, $compareAttribute);
        $options['compareAttributeName'] = Html::getInputName($model, $compareAttribute);
        $compareLabel = $compareValueOrAttribute = $model->getAttributeLabel($compareAttribute);
    }
    if ($this->skipOnEmpty) {
        $options['skipOnEmpty'] = 1;
    }
    $options['message'] = $this->formatMessage($this->message, [
        'attribute' => $model->getAttributeLabel($attribute),
        'compareAttribute' => $compareLabel,
        'compareValue' => $compareValue,
        'compareValueOrAttribute' => $compareValueOrAttribute,
    ]);
    return $options;
}
