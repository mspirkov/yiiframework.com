Its signature should be `function($query)`, where `$query` is the query to be customized.";s:4:"type";s:13:"callable|null";s:5:"types";a:2:{i:0;s:8:"callable";i:1;s:4:"null";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQueryInterface.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:27:"The relation object itself.";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:211227;s:4:"name";s:3:"via";s:8:"fullName";s:32:"yii\db\ActiveQueryInterface::via";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQueryInterface.php";s:9:"startLine";i:99;s:7:"endLine";i:99;s:16:"shortDescription";s:86:"Specifies the relation associated with the junction table for use in relational query.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:7:"findFor";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:1;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\db\ActiveQueryInterface";s:10:"sourceCode";s:40:"public function findFor($name, $model);
