{
    $descriptions = [];
    foreach ($this->getCommands() as $command) {
        $result = Yii::$app->createController($command);
        /**
         * @var Controller $controller
         * @phpstan-var Controller<Application> $controller
         */
        list($controller, $actionID) = $result;
        $descriptions[$command] = $controller->getHelpSummary();
    }
    return $descriptions;
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:63:"All available commands as keys and their description as values.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:41876;s:4:"name";s:22:"getCommandDescriptions";s:8:"fullName";s:62:"yii\console\controllers\HelpController::getCommandDescriptions";s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/HelpController.php";s:9:"startLine";i:210;s:7:"endLine";i:224;s:16:"shortDescription";s:51:"Returns an array of commands an their descriptions.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:10:"getActions";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:38:"yii\console\controllers\HelpController";s:10:"sourceCode";s:477:"public function getActions($controller)
{
    $actions = array_keys($controller->actions());
    $class = new \ReflectionClass($controller);
    foreach ($class->getMethods() as $method) {
        $name = $method->getName();
        if ($name !== 'actions' && $method->isPublic() && !$method->isStatic() && strncmp($name, 'action', 6) === 0) {
            $actions[] = $this->camel2id(substr($name, 6));
        }
    }
    sort($actions);
    return array_unique($actions);
}
";s:6:"params";a:1:{s:11:"$controller";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:11:"$controller";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:23:"The controller instance";s:4:"type";s:23:"\yii\console\Controller";s:5:"types";a:1:{i:0;s:23:"\yii\console\Controller";}s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/HelpController.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:25:"All available action IDs.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:41876;s:4:"name";s:10:"getActions";s:8:"fullName";s:50:"yii\console\controllers\HelpController::getActions";s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/HelpController.php";s:9:"startLine";i:234;s:7:"endLine";i:247;s:16:"shortDescription";s:58:"Returns all available actions of the specified controller.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:2;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:13:"phpstan-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:30:"Controller<Module> $controller";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:3;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:11:"psalm-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:30:"Controller<Module> $controller";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:17:"getModuleCommands";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:38:"yii\console\controllers\HelpController";s:10:"sourceCode";s:1645:"protected function getModuleCommands($module)
{
    $prefix = $module instanceof Application ? '' : $module->getUniqueId() . '/';
    $commands = [];
    foreach (array_keys($module->controllerMap) as $id) {
        $commands[] = $prefix . $id;
    }
    foreach ($module->getModules() as $id => $child) {
        if (($child = $module->getModule($id)) === null) {
            continue;
        }
        foreach ($this->getModuleCommands($child) as $command) {
            $commands[] = $command;
        }
    }
    $controllerPath = $module->getControllerPath();
    if (is_dir($controllerPath)) {
        $iterator = new \RecursiveIteratorIterator(new \RecursiveDirectoryIterator($controllerPath, \RecursiveDirectoryIterator::KEY_AS_PATHNAME));
        $iterator = new \RegexIterator($iterator, '/.*Controller\.php$/', \RecursiveRegexIterator::GET_MATCH);
        foreach ($iterator as $matches) {
            $file = $matches[0];
            $relativePath = str_replace($controllerPath, '', $file);
            $class = strtr($relativePath, [
                '/' => '\\',
                '.php' => '',
            ]);
            $controllerClass = $module->controllerNamespace . $class;
            if ($this->validateControllerClass($controllerClass)) {
                $dir = ltrim(pathinfo($relativePath, PATHINFO_DIRNAME), '\\/');
                $command = Inflector::camel2id(substr(basename($file), 0, -14), '-', true);
                if (!empty($dir)) {
                    $command = $dir . '/' . $command;
                }
                $commands[] = $prefix . $command;
            }
        }
    }
    return $commands;
}
";s:6:"params";a:1:{s:7:"$module";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$module";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:19:"The module instance";s:4:"type";s:16:"\yii\base\Module";s:5:"types";a:1:{i:0;s:16:"\yii\base\Module";}s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/HelpController.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:27:"The available command names";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:41876;s:4:"name";s:17:"getModuleCommands";s:8:"fullName";s:57:"yii\console\controllers\HelpController::getModuleCommands";s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/HelpController.php";s:9:"startLine";i:254;s:7:"endLine";i:297;s:16:"shortDescription";s:49:"Returns available commands of a specified module.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:23:"validateControllerClass";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:38:"yii\console\controllers\HelpController";s:10:"sourceCode";s:276:"protected function validateControllerClass($controllerClass)
{
    if (class_exists($controllerClass)) {
        $class = new \ReflectionClass($controllerClass);
        return !$class->isAbstract() && $class->isSubclassOf('yii\console\Controller');
    }
    return false;
}
";s:6:"params";a:1:{s:16:"$controllerClass";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:16:"$controllerClass";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/HelpController.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:0:"";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:41876;s:4:"name";s:23:"validateControllerClass";s:8:"fullName";s:63:"yii\console\controllers\HelpController::validateControllerClass";s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/HelpController.php";s:9:"startLine";i:304;s:7:"endLine";i:312;s:16:"shortDescription";s:65:"Validates if the given class is a valid console controller class.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"getDefaultHelp";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:38:"yii\console\controllers\HelpController";s:10:"sourceCode";s:2692:"protected function getDefaultHelp()
{
    $commands = $this->getCommandDescriptions();
    $this->stdout($this->getDefaultHelpHeader());
    if (empty($commands)) {
        $this->stdout("\nNo commands are found.\n\n", Console::BOLD);
        return;
    }
    $this->stdout("\nThe following commands are available:\n\n", Console::BOLD);
    $maxLength = 0;
    foreach ($commands as $command => $description) {
        $result = Yii::$app->createController($command);
        /**
         * @var Controller $controller
         * @phpstan-var Controller<Application> $controller
         */
        list($controller, $actionID) = $result;
        $actions = $this->getActions($controller);
        $prefix = $controller->getUniqueId();
        foreach ($actions as $action) {
            $string = $prefix . '/' . $action;
            if ($action === $controller->defaultAction) {
                $string .= ' (default)';
            }
            $maxLength = max($maxLength, strlen($string));
        }
    }
    foreach ($commands as $command => $description) {
        $result = Yii::$app->createController($command);
        /**
         * @var Controller $controller
         * @phpstan-var Controller<Application> $controller
         */
        list($controller, $actionID) = $result;
        $actions = $this->getActions($controller);
        $this->stdout('- ' . $this->ansiFormat($command, Console::FG_YELLOW));
        $this->stdout(str_repeat(' ', $maxLength + 4 - strlen($command)));
        $this->stdout(Console::wrapText($description, $maxLength + 4 + 2), Console::BOLD);
        $this->stdout("\n");
        $prefix = $controller->getUniqueId();
        foreach ($actions as $action) {
            $string = '  ' . $prefix . '/' . $action;
            $this->stdout('  ' . $this->ansiFormat($string, Console::FG_GREEN));
            if ($action === $controller->defaultAction) {
                $string .= ' (default)';
                $this->stdout(' (default)', Console::FG_YELLOW);
            }
            $summary = $controller->getActionHelpSummary($controller->createAction($action));
            if ($summary !== '') {
                $this->stdout(str_repeat(' ', $maxLength + 4 - strlen($string)));
                $this->stdout(Console::wrapText($summary, $maxLength + 4 + 2));
            }
            $this->stdout("\n");
        }
        $this->stdout("\n");
    }
    $scriptName = $this->getScriptName();
    $this->stdout("\nTo see the help of each command, enter:\n", Console::BOLD);
    $this->stdout("\n  $scriptName " . $this->ansiFormat('help', Console::FG_YELLOW) . ' '
        . $this->ansiFormat('<command-name>', Console::FG_CYAN) . "\n\n");
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:41876;s:4:"name";s:14:"getDefaultHelp";s:8:"fullName";s:54:"yii\console\controllers\HelpController::getDefaultHelp";s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/HelpController.php";s:9:"startLine";i:317;s:7:"endLine";i:378;s:16:"shortDescription";s:32:"Displays all available commands.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"getCommandHelp";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:38:"yii\console\controllers\HelpController";s:10:"sourceCode";s:1638:"protected function getCommandHelp($controller)
{
    $controller->color = $this->color;
    $this->stdout("\nDESCRIPTION\n", Console::BOLD);
    $comment = $controller->getHelp();
    if ($comment !== '') {
        $this->stdout("\n$comment\n\n");
    }
    $actions = $this->getActions($controller);
    if (!empty($actions)) {
        $this->stdout("\nSUB-COMMANDS\n\n", Console::BOLD);
        $prefix = $controller->getUniqueId();
        $maxlen = 5;
        foreach ($actions as $action) {
            $len = strlen($prefix . '/' . $action) + 2 + ($action === $controller->defaultAction ? 10 : 0);
            $maxlen = max($maxlen, $len);
        }
        foreach ($actions as $action) {
            $this->stdout('- ' . $this->ansiFormat($prefix . '/' . $action, Console::FG_YELLOW));
            $len = strlen($prefix . '/' . $action) + 2;
            if ($action === $controller->defaultAction) {
                $this->stdout(' (default)', Console::FG_GREEN);
                $len += 10;
            }
            $summary = $controller->getActionHelpSummary($controller->createAction($action));
            if ($summary !== '') {
                $this->stdout(str_repeat(' ', $maxlen - $len + 2) . Console::wrapText($summary, $maxlen + 2));
            }
            $this->stdout("\n");
        }
        $scriptName = $this->getScriptName();
        $this->stdout("\nTo see the detailed information about individual sub-commands, enter:\n");
        $this->stdout("\n  $scriptName " . $this->ansiFormat('help', Console::FG_YELLOW) . ' '
            . $this->ansiFormat('<sub-command>', Console::FG_CYAN) . "\n\n");
    }
}
";s:6:"params";a:1:{s:11:"$controller";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:11:"$controller";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:23:"The controller instance";s:4:"type";s:23:"\yii\console\Controller";s:5:"types";a:1:{i:0;s:23:"\yii\console\Controller";}s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/HelpController.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:41876;s:4:"name";s:14:"getCommandHelp";s:8:"fullName";s:54:"yii\console\controllers\HelpController::getCommandHelp";s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/HelpController.php";s:9:"startLine";i:387;s:7:"endLine";i:425;s:16:"shortDescription";s:48:"Displays the overall information of the command.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:1;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:13:"phpstan-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:30:"Controller<Module> $controller";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:2;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:11:"psalm-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:30:"Controller<Module> $controller";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:17:"getSubCommandHelp";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:38:"yii\console\controllers\HelpController";s:10:"sourceCode";s:2505:"protected function getSubCommandHelp($controller, $actionID)
{
    $action = $controller->createAction($actionID);
    if ($action === null) {
        $name = $this->ansiFormat(rtrim($controller->getUniqueId() . '/' . $actionID, '/'), Console::FG_YELLOW);
        throw new Exception("No help for unknown sub-command \"$name\".");
    }
    $description = $controller->getActionHelp($action);
    if ($description !== '') {
        $this->stdout("\nDESCRIPTION\n", Console::BOLD);
        $this->stdout("\n$description\n\n");
    }
    $this->stdout("\nUSAGE\n\n", Console::BOLD);
    $scriptName = $this->getScriptName();
    if ($action->id === $controller->defaultAction) {
        $this->stdout($scriptName . ' ' . $this->ansiFormat($controller->getUniqueId(), Console::FG_YELLOW));
    } else {
        $this->stdout($scriptName . ' ' . $this->ansiFormat($action->getUniqueId(), Console::FG_YELLOW));
    }
    $args = $controller->getActionArgsHelp($action);
    foreach ($args as $name => $arg) {
        if ($arg['required']) {
            $this->stdout(' <' . $name . '>', Console::FG_CYAN);
        } else {
            $this->stdout(' [' . $name . ']', Console::FG_CYAN);
        }
    }
    $options = $controller->getActionOptionsHelp($action);
    $options[\yii\console\Application::OPTION_APPCONFIG] = [
        'type' => 'string',
        'default' => null,
        'comment' => "custom application configuration file path.\nIf not set, default application configuration is used.",
    ];
    ksort($options);
    $this->stdout(' [...options...]', Console::FG_RED);
    $this->stdout("\n\n");
    if (!empty($args)) {
        foreach ($args as $name => $arg) {
            $this->stdout($this->formatOptionHelp(
                '- ' . $this->ansiFormat($name, Console::FG_CYAN),
                $arg['required'],
                $arg['type'],
                $arg['default'],
                $arg['comment']
            ) . "\n\n");
        }
    }
    $this->stdout("\nOPTIONS\n\n", Console::BOLD);
    foreach ($options as $name => $option) {
        $this->stdout($this->formatOptionHelp(
            $this->ansiFormat(
                '--' . $name . $this->formatOptionAliases($controller, $name),
                Console::FG_RED,
                empty($option['required']) ? Console::FG_RED : Console::BOLD
            ),
            !empty($option['required']),
            $option['type'],
            $option['default'],
            $option['comment']
        ) . "\n\n");
    }
}
