}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:94:"The CSRF token sent via [[csrfHeader]] by browser. Null is returned if no such header is sent.";s:10:"returnType";s:11:"string|null";s:11:"returnTypes";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:113036;s:4:"name";s:22:"getCsrfTokenFromHeader";s:8:"fullName";s:39:"yii\web\Request::getCsrfTokenFromHeader";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";s:9:"startLine";i:1856;s:7:"endLine";i:1859;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"createCsrfCookie";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:15:"yii\web\Request";s:10:"sourceCode";s:244:"protected function createCsrfCookie($token)
