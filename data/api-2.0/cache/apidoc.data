ager that stores authorization
information in terms of a PHP script file.";s:11:"description";s:644:"The authorization data will be saved to and loaded from three files
specified by [[itemFile]], [[assignmentFile]] and [[ruleFile]].

PhpManager is mainly suitable for authorization data that is not too big
(for example, the authorization data for a personal blog system).
Use [[DbManager]] for more complex authorization data.

Note that PhpManager is not compatible with facebooks [HHVM](https://hhvm.com/) because
it relies on writing php files and including them afterwards which is not supported by HHVM.

For more details and usage information on PhpManager, see the [guide article on security authorization](guide:security-authorization).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:18:"yii\rbac\DbManager";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:20:"yii\rbac\BaseManager";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:2:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";s:18:"Alexander Kochetov";s:19:"creocoder@gmail.com";}s:7:"methods";a:46:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\rbac\DbManager";s:10:"sourceCode";s:241:"public function init()
{
    parent::init();
    $this->db = Instance::ensure($this->db, Connection::className());
    if ($this->cache !== null) {
        $this->cache = Instance::ensure($this->cache, 'yii\caching\CacheInterface');
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:8:"yii\rbac";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:8:{s:3:"Yii";s:3:"Yii";s:24:"InvalidArgumentException";s:33:"yii\base\InvalidArgumentException";s:20:"InvalidCallException";s:29:"yii\base\InvalidCallException";s:14:"CacheInterface";s:26:"yii\caching\CacheInterface";s:10:"Connection";s:17:"yii\db\Connection";s:10:"Expression";s:17:"yii\db\Expression";s:5:"Query";s:12:"yii\db\Query";s:8:"Instance";s:15:"yii\di\Instance";}}s:4:"name";s:4:"init";s:8:"fullName";s:24:"yii\rbac\DbManager::init";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/rbac/DbManager.php";s:9:"startLine";i:119;s:7:"endLine";i:126;s:16:"shortDescription";s:38:"Initializes the application component.";s:11:"description";s:88:"This method overrides the parent implementation by establishing the database connection.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"checkAccess";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\rbac\DbManager";s:10:"sourceCode";s:682:"public function checkAccess($userId, $permissionName, $params = [])
{
    if (isset($this->checkAccessAssignments[(string) $userId])) {
        $assignments = $this->checkAccessAssignments[(string) $userId];
    } else {
        $assignments = $this->getAssignments($userId);
        $this->checkAccessAssignments[(string) $userId] = $assignments;
    }
    if ($this->hasNoAssignments($assignments)) {
        return false;
    }
    $this->loadFromCache();
    if ($this->items !== null) {
        return $this->checkAccessFromCache($userId, $permissionName, $params, $assignments);
    }
    return $this->checkAccessRecursive($userId, $permissionName, $params, $assignments);
}
