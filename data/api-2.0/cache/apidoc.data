Alternatively [APCu PHP extension](https://www.php.net/apcu) could be used via setting `useApcu` to `true`.
In order to enable APC or APCu for CLI you should add "apc.enable_cli = 1" to your php.ini.

See [[Cache]] for common cache operations that ApcCache supports.

For more details and usage information on Cache, see the [guide article on caching](guide:caching-overview).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:19:"yii\mutex\FileMutex";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:15:"yii\mutex\Mutex";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:1:{i:0;s:27:"yii\mutex\RetryAcquireTrait";}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:7:"resurtm";s:17:"resurtm@gmail.com";}s:7:"methods";a:4:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\mutex\FileMutex";s:10:"sourceCode";s:323:"public function init()
{
    parent::init();
    $this->mutexPath = Yii::getAlias($this->mutexPath);
    if (!is_dir($this->mutexPath)) {
        FileHelper::createDirectory($this->mutexPath, $this->dirMode, true);
    }
    if ($this->isWindows === null) {
        $this->isWindows = DIRECTORY_SEPARATOR === '\\';
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:9:"yii\mutex";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:3:{s:3:"Yii";s:3:"Yii";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:10:"FileHelper";s:22:"yii\helpers\FileHelper";}}s:4:"name";s:4:"init";s:8:"fullName";s:25:"yii\mutex\FileMutex::init";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mutex/FileMutex.php";s:9:"startLine";i:83;s:7:"endLine";i:93;s:16:"shortDescription";s:122:"Initializes mutex component implementation dedicated for UNIX, GNU/Linux, Mac OS X, and other UNIX-like
operating systems.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"acquireLock";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\mutex\FileMutex";s:10:"sourceCode";s:1553:"protected function acquireLock($name, $timeout = 0)
{
    $filePath = $this->getLockFilePath($name);
    return $this->retryAcquire($timeout, function () use ($filePath, $name) {
        $file = fopen($filePath, 'w+');
        if ($file === false) {
            return false;
        }
        if ($this->fileMode !== null) {
            @chmod($filePath, $this->fileMode);
        }
        if (!flock($file, LOCK_EX | LOCK_NB)) {
            fclose($file);
            return false;
        }
        // Under unix we delete the lock file before releasing the related handle. Thus it's possible that we've acquired a lock on
        // a non-existing file here (race condition). We must compare the inode of the lock file handle with the inode of the actual lock file.
        // If they do not match we simply continue the loop since we can assume the inodes will be equal on the next try.
        // Example of race condition without inode-comparison:
        // Script A: locks file
        // Script B: opens file
        // Script A: unlinks and unlocks file
        // Script B: locks handle of *unlinked* file
        // Script C: opens and locks *new* file
        // In this case we would have acquired two locks for the same file path.
        if (DIRECTORY_SEPARATOR !== '\\' && fstat($file)['ino'] !== @fileinode($filePath)) {
            clearstatcache(true, $filePath);
            flock($file, LOCK_UN);
            fclose($file);
            return false;
        }
        $this->_files[$name] = $file;
        return true;
    });
}
";s:6:"params";a:2:{s:5:"$name";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$name";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:27:"Of the lock to be acquired.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mutex/FileMutex.php";}s:8:"$timeout";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$timeout";s:10:"isOptional";b:1;s:12:"defaultValue";s:1:"0";s:19:"isPassedByReference";b:0;s:11:"description";s:54:"Time (in seconds) to wait for lock to become released.";s:4:"type";s:3:"int";s:5:"types";a:1:{i:0;s:3:"int";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mutex/FileMutex.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:17:"Acquiring result.";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:127667;s:4:"name";s:11:"acquireLock";s:8:"fullName";s:32:"yii\mutex\FileMutex::acquireLock";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mutex/FileMutex.php";s:9:"startLine";i:101;s:7:"endLine";i:139;s:16:"shortDescription";s:28:"Acquires lock by given name.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"releaseLock";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\mutex\FileMutex";s:10:"sourceCode";s:903:"protected function releaseLock($name)
{
    if (!isset($this->_files[$name])) {
        return false;
    }
    if ($this->isWindows) {
        // Under windows it's not possible to delete a file opened via fopen (either by own or other process).
        // That's why we must first unlock and close the handle and then *try* to delete the lock file.
        flock($this->_files[$name], LOCK_UN);
        fclose($this->_files[$name]);
        @unlink($this->getLockFilePath($name));
    } else {
        // Under unix it's possible to delete a file opened via fopen (either by own or other process).
        // That's why we must unlink (the currently locked) lock file first and then unlock and close the handle.
        unlink($this->getLockFilePath($name));
        flock($this->_files[$name], LOCK_UN);
        fclose($this->_files[$name]);
    }
    unset($this->_files[$name]);
    return true;
}
