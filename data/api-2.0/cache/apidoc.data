";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:64:"A key that is used to check the validity of a given identity ID.";s:10:"returnType";s:11:"string|null";s:11:"returnTypes";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:207544;s:4:"name";s:10:"getAuthKey";s:8:"fullName";s:37:"yii\web\IdentityInterface::getAuthKey";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/IdentityInterface.php";s:9:"startLine";i:100;s:7:"endLine";i:100;s:16:"shortDescription";s:76:"Returns a key that can be used to check the validity of a given identity ID.";s:11:"description";s:511:"The key should be unique for each individual user, and should be persistent
so that it can be used to check the validity of the user identity.

The space of such keys should be big enough to defeat potential identity attacks.

The returned key is used to validate session and auto-login (if [[User::enableAutoLogin]] is enabled).

Make sure to invalidate earlier issued authKeys when you implement force user logout, password change and
other scenarios, that require forceful access revocation for old sessions.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:1;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:26:"\yii\web\validateAuthKey()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:15:"validateAuthKey";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:15:"validateAuthKey";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:1;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\web\IdentityInterface";s:10:"sourceCode";s:43:"public function validateAuthKey($authKey);
