";s:6:"params";a:0:{}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:21:"if [[db]] is invalid.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:7:"yii\web";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:6:{s:3:"Yii";s:3:"Yii";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:10:"Connection";s:17:"yii\db\Connection";s:8:"PdoValue";s:15:"yii\db\PdoValue";s:5:"Query";s:12:"yii\db\Query";s:8:"Instance";s:15:"yii\di\Instance";}}s:4:"name";s:4:"init";s:8:"fullName";s:23:"yii\web\DbSession::init";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/DbSession.php";s:9:"startLine";i:90;s:7:"endLine";i:94;s:16:"shortDescription";s:36:"Initializes the DbSession component.";s:11:"description";s:96:"This method will initialize the [[db]] property to make sure it refers to a valid DB connection.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:12:"regenerateID";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\web\DbSession";s:10:"sourceCode";s:1089:"public function regenerateID($deleteOldSession = false)
{
    $oldID = session_id();
    // if no session is started, there is nothing to regenerate
    if (empty($oldID)) {
        return;
    }
    parent::regenerateID(false);
    $newID = session_id();
    // if session id regeneration failed, no need to create/update it.
    if (empty($newID)) {
        Yii::warning('Failed to generate new session ID', __METHOD__);
        return;
    }
    $row = $this->db->useMaster(function () use ($oldID) {
        return (new Query())->from($this->sessionTable)
           ->where(['id' => $oldID])
           ->createCommand($this->db)
           ->queryOne();
    });
    if ($row !== false && $this->getIsActive()) {
        if ($deleteOldSession) {
            $this->db->createCommand()
                ->update($this->sessionTable, ['id' => $newID], ['id' => $oldID])
                ->execute();
        } else {
            $row['id'] = $newID;
            $this->db->createCommand()
                ->insert($this->sessionTable, $row)
                ->execute();
        }
    }
}
