for creating the object.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:8:"$comment";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:12:"defaultValue";s:2:"''";s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:41:"yii\console\controllers\MigrateController";s:13:"phpDocContext";r:42610;s:4:"name";s:8:"$comment";s:8:"fullName";s:51:"yii\console\controllers\MigrateController::$comment";s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MigrateController.php";s:9:"startLine";i:145;s:7:"endLine";i:145;s:16:"shortDescription";s:40:"The comment for the table being created.";s:11:"description";s:40:"The comment for the table being created.";s:5:"since";s:6:"2.0.14";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:40:"the comment for the table being created.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:23:"yii\console\controllers";s:13:"phpDocContext";r:42610;s:4:"name";s:41:"yii\console\controllers\MigrateController";s:8:"fullName";s:41:"yii\console\controllers\MigrateController";s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MigrateController.php";s:9:"startLine";i:80;s:7:"endLine";i:620;s:16:"shortDescription";s:31:"Manages application migrations.";s:11:"description";s:1571:"A migration means a set of persistent changes to the application environment
that is shared among different developers. For example, in an application
backed by a database, a migration may refer to a set of changes to
the database, such as creating a new table, adding a new table column.

This command provides support for tracking the migration history, upgrading
or downloading with migrations, and creating new migration skeletons.

The migration history is stored in a database table named
as [[migrationTable]]. The table will be automatically created the first time
this command is executed, if it does not exist. You may also manually
create it as follows:

```
CREATE TABLE migration (
    version varchar(180) PRIMARY KEY,
    apply_time integer
)
```

Below are some common usages of this command:

```
# creates a new migration named 'create_user_table'
yii migrate/create create_user_table

# applies ALL new migrations
yii migrate

# reverts the last applied migration
yii migrate/down
```

Since 2.0.10 you can use namespaced migrations. In order to enable this feature you should configure [[migrationNamespaces]]
property for the controller at application configuration:

```
return [
    'controllerMap' => [
        'migrate' => [
            'class' => 'yii\console\controllers\MigrateController',
            'migrationNamespaces' => [
                'app\migrations',
                'some\extension\migrations',
            ],
            //'migrationPath' => null, // allows to disable not namespaced migration completely
        ],
    ],
];
```";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:2;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Template":5:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀templateName";s:1:"T";s:54:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀bound";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:24:"\yii\console\Application";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:11:"Application";}}s:56:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀default";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:7:"␀*␀name";s:8:"template";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:3;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Extends_":3:{s:7:"␀*␀type";O:41:"phpDocumentor\Reflection\Types\Collection":4:{s:48:"␀phpDocumentor\Reflection\Types\Collection␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:46:"\yii\console\controllers\BaseMigrateController";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:21:"BaseMigrateController";}s:12:"␀*␀valueType";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:26:"\yii\console\controllers\T";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:1:"T";}}s:10:"␀*␀keyType";N;s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}s:7:"