ourceFile";N;s:9:"startLine";i:63;s:7:"endLine";i:63;s:16:"shortDescription";s:73:"A constant representing the transaction isolation level `READ COMMITTED`.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:79:"https://en.wikipedia.org/wiki/Isolation_%28database_systems%29#Isolation_levels";}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:15:"REPEATABLE_READ";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:18:"yii\db\Transaction";s:5:"value";s:17:"'REPEATABLE READ'";s:13:"phpDocContext";r:170079;s:4:"name";s:15:"REPEATABLE_READ";s:8:"fullName";s:35:"yii\db\Transaction::REPEATABLE_READ";s:10:"sourceFile";N;s:9:"startLine";i:68;s:7:"endLine";i:68;s:16:"shortDescription";s:74:"A constant representing the transaction isolation level `REPEATABLE READ`.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:79:"https://en.wikipedia.org/wiki/Isolation_%28database_systems%29#Isolation_levels";}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:12:"SERIALIZABLE";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:18:"yii\db\Transaction";s:5:"value";s:14:"'SERIALIZABLE'";s:13:"phpDocContext";r:170079;s:4:"name";s:12:"SERIALIZABLE";s:8:"fullName";s:32:"yii\db\Transaction::SERIALIZABLE";s:10:"sourceFile";N;s:9:"startLine";i:73;s:7:"endLine";i:73;s:16:"shortDescription";s:71:"A constant representing the transaction isolation level `SERIALIZABLE`.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:79:"https://en.wikipedia.org/wiki/Isolation_%28database_systems%29#Isolation_levels";}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:6:{s:11:"getIsActive";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\db\Transaction";s:10:"sourceCode";s:100:"public function getIsActive()
{
    return $this->_level > 0 && $this->db && $this->db->isActive;
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:98:"Whether this transaction is active. Only an active transaction
can [[commit()]] or [[rollBack()]].";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:170079;s:4:"name";s:11:"getIsActive";s:8:"fullName";s:31:"yii\db\Transaction::getIsActive";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Transaction.php";s:9:"startLine";i:91;s:7:"endLine";i:94;s:16:"shortDescription";s:62:"Returns a value indicating whether this transaction is active.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:5:"begin";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\db\Transaction";s:10:"sourceCode";s:1185:"public function begin($isolationLevel = null)
{
    if ($this->db === null) {
        throw new InvalidConfigException('Transaction::db must be set.');
    }
    $this->db->open();
    if ($this->_level === 0) {
        if ($isolationLevel !== null) {
            $this->db->getSchema()->setTransactionIsolationLevel($isolationLevel);
        }
        Yii::debug('Begin transaction' . ($isolationLevel ? ' with isolation level ' . $isolationLevel : ''), __METHOD__);
        $this->db->trigger(Connection::EVENT_BEGIN_TRANSACTION);
        $this->db->pdo->beginTransaction();
        $this->_level = 1;
        return;
    }
    $schema = $this->db->getSchema();
    if ($schema->supportsSavepoint()) {
        Yii::debug('Set savepoint ' . $this->_level, __METHOD__);
        // make sure the transaction wasn't autocommitted
        if ($this->db->pdo->inTransaction()) {
            $schema->createSavepoint('LEVEL' . $this->_level);
        }
    } else {
        Yii::info('Transaction not started: nested transaction not supported', __METHOD__);
        throw new NotSupportedException('Transaction not started: nested transaction not supported.');
    }
    $this->_level++;
}
";s:6:"params";a:1:{s:15:"$isolationLevel";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:15:"$isolationLevel";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:1190:"The [isolation level][] to use for this transaction.
This can be one of [[READ_UNCOMMITTED]], [[READ_COMMITTED]], [[REPEATABLE_READ]] and [[SERIALIZABLE]] but
also a string containing DBMS specific syntax to be used after `SET TRANSACTION ISOLATION LEVEL`.
If not specified (`null`) the isolation level will not be set explicitly and the DBMS default will be used.

> Note: This setting does not work for PostgreSQL, where setting the isolation level before the transaction
has no effect. You have to call [[setIsolationLevel()]] in this case after the transaction has started.

> Note: Some DBMS allow setting of the isolation level only for the whole connection so subsequent transactions
may get the same isolation level even if you did not specify any. When using this feature
you may need to set the isolation level for all transactions explicitly to avoid conflicting settings.
At the time of this writing affected DBMS are MSSQL and SQLite.

[isolation level]: https://en.wikipedia.org/wiki/Isolation_%28database_systems%29#Isolation_levels

Starting from version 2.0.16, this method throws exception when beginning nested transaction and underlying DBMS
does not support savepoints.";s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Transaction.php";}}s:10:"exceptions";a:3:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:19:"if [[db]] is `null`";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}s:31:"\yii\base\NotSupportedException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:48:"if the DBMS does not support nested transactions";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}s:17:"\yii\db\Exception";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:22:"if DB connection fails";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:170079;s:4:"name";s:5:"begin";s:8:"fullName";s:25:"yii\db\Transaction::begin";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Transaction.php";s:9:"startLine";i:119;s:7:"endLine";i:151;s:16:"shortDescription";s:21:"Begins a transaction.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"commit";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\db\Transaction";s:10:"sourceCode";s:943:"public function commit()
{
    if (!$this->getIsActive()) {
        throw new Exception('Failed to commit transaction: transaction was inactive.');
    }
    $this->_level--;
    if ($this->_level === 0) {
        Yii::debug('Commit transaction', __METHOD__);
        // make sure the transaction wasn't autocommitted
        if ($this->db->pdo->inTransaction()) {
            $this->db->pdo->commit();
        }
        $this->db->trigger(Connection::EVENT_COMMIT_TRANSACTION);
        return;
    }
    $schema = $this->db->getSchema();
    if ($schema->supportsSavepoint()) {
        Yii::debug('Release savepoint ' . $this->_level, __METHOD__);
        // make sure the transaction wasn't autocommitted
        if ($this->db->pdo->inTransaction()) {
            $schema->releaseSavepoint('LEVEL' . $this->_level);
        }
    } else {
        Yii::info('Transaction not committed: nested transaction not supported', __METHOD__);
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:1:{s:17:"\yii\db\Exception";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:32:"if the transaction is not active";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:170079;s:4:"name";s:6:"commit";s:8:"fullName";s:26:"yii\db\Transaction::commit";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Transaction.php";s:9:"startLine";i:157;s:7:"endLine";i:184;s:16:"shortDescription";s:22:"Commits a transaction.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"rollBack";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\db\Transaction";s:10:"sourceCode";s:1058:"public function rollBack()
{
    if (!$this->getIsActive()) {
        // do nothing if transaction is not active: this could be the transaction is committed
        // but the event handler to "commitTransaction" throw an exception
        return;
    }
    $this->_level--;
    if ($this->_level === 0) {
        Yii::debug('Roll back transaction', __METHOD__);
        // make sure the transaction wasn't autocommitted
        if ($this->db->pdo->inTransaction()) {
            $this->db->pdo->rollBack();
        }
        $this->db->trigger(Connection::EVENT_ROLLBACK_TRANSACTION);
        return;
    }
    $schema = $this->db->getSchema();
    if ($schema->supportsSavepoint()) {
        Yii::debug('Roll back to savepoint ' . $this->_level, __METHOD__);
        // make sure the transaction wasn't autocommitted
        if ($this->db->pdo->inTransaction()) {
            $schema->rollBackSavepoint('LEVEL' . $this->_level);
        }
    } else {
        Yii::info('Transaction not rolled back: nested transaction not supported', __METHOD__);
    }
}
