sses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:0:{}s:7:"methods";a:2:{s:5:"build";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:40:"yii\db\oci\conditions\InConditionBuilder";s:10:"sourceCode";s:269:"public function build(ExpressionInterface $expression, array &$params = [])
{
    $splitCondition = $this->splitCondition($expression, $params);
    if ($splitCondition !== null) {
        return $splitCondition;
    }
    return parent::build($expression, $params);
}
