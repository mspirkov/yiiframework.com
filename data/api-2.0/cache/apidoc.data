}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:79:"Events (array keys) and the corresponding event handler methods (array values).";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\filters";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:7:{s:3:"Yii";s:3:"Yii";s:6:"Action";s:15:"yii\base\Action";s:11:"ActionEvent";s:20:"yii\base\ActionEvent";s:8:"Behavior";s:17:"yii\base\Behavior";s:6:"Module";s:15:"yii\base\Module";s:10:"Controller";s:18:"yii\web\Controller";s:29:"MethodNotAllowedHttpException";s:37:"yii\web\MethodNotAllowedHttpException";}}s:4:"name";s:6:"events";s:8:"fullName";s:30:"yii\filters\VerbFilter::events";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/VerbFilter.php";s:9:"startLine";i:85;s:7:"endLine";i:88;s:16:"shortDescription";s:51:"Declares event handlers for the [[owner]]'s events.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:12:"beforeAction";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:22:"yii\filters\VerbFilter";s:10:"sourceCode";s:803:"public function beforeAction($event)
{
    $action = $event->action->id;
    if (isset($this->actions[$action])) {
        $verbs = $this->actions[$action];
    } elseif (isset($this->actions['*'])) {
        $verbs = $this->actions['*'];
    } else {
        return $event->isValid;
    }
    $verb = Yii::$app->getRequest()->getMethod();
    $allowed = array_map('strtoupper', $verbs);
    if (!in_array($verb, $allowed)) {
        $event->isValid = false;
        // https://tools.ietf.org/html/rfc2616#section-14.7
        Yii::$app->getResponse()->getHeaders()->set('Allow', implode(', ', $allowed));
        throw new MethodNotAllowedHttpException('Method Not Allowed. This URL can only handle the following request methods: ' . implode(', ', $allowed) . '.');
    }
    return $event->isValid;
}
