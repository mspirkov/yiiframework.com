For example:

```
[
   yii\db\Expression::class => yii\db\ExpressionBuilder::class
]
```
This property is mainly used by [[buildExpression()]] to build SQL expressions form expression objects.
See default values in [[defaultExpressionBuilders()]] method.


To override existing builders or add custom, use [[setExpressionBuilder()]] method. New items will be added
to the end of this array.

To find a builder, [[buildExpression()]] will check the expression class for its exact presence in this map.
In case it is NOT present, the array will be iterated in reverse direction, checking whether the expression
extends the class, defined in this map.";s:5:"since";s:6:"2.0.14";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:3:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:37:"phpDocumentor\Reflection\Types\Array_":3:{s:12:"␀*␀valueType";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:10:"␀*␀keyType";N;s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}i:1;O:37:"phpDocumentor\Reflection\Types\Array_":3:{s:12:"␀*␀valueType";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:34:"\yii\db\ExpressionBuilderInterface";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:26:"ExpressionBuilderInterface";}}s:10:"␀*␀keyType";N;s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:699:"maps expression class to expression builder class.
For example:

```
[
   yii\db\Expression::class => yii\db\ExpressionBuilder::class
]
```
This property is mainly used by [[buildExpression()]] to build SQL expressions form expression objects.
See default values in [[defaultExpressionBuilders()]] method.


To override existing builders or add custom, use [[setExpressionBuilder()]] method. New items will be added
to the end of this array.

To find a builder, [[buildExpression()]] will check the expression class for its exact presence in this map.
In case it is NOT present, the array will be iterated in reverse direction, checking whether the expression
extends the class, defined in this map.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:1;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:31:"\yii\db\setExpressionBuilders()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:21:"setExpressionBuilders";}}s:14:"␀*␀description";N;}i:2;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:35:"\yii\db\defaultExpressionBuilders()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:25:"defaultExpressionBuilders";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:3:"$db";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:18:"\yii\db\Connection";s:5:"types";a:1:{i:0;s:18:"\yii\db\Connection";}s:12:"defaultValue";N;s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:19:"yii\db\QueryBuilder";s:13:"phpDocContext";r:174411;s:4:"name";s:3:"$db";s:8:"fullName";s:24:"yii\db\QueryBuilder::$db";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/QueryBuilder.php";s:9:"startLine";i:46;s:7:"endLine";i:46;s:16:"shortDescription";s:24:"The database connection.";s:11:"description";s:24:"The database connection.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";