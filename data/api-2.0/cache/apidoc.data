;b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:17:"yii\grid\GridView";s:10:"sourceCode";s:611:"protected function initColumns()
{
    if (empty($this->columns)) {
        $this->guessColumns();
    }
    foreach ($this->columns as $i => $column) {
        if (is_string($column)) {
            $column = $this->createDataColumn($column);
        } else {
            $column = Yii::createObject(array_merge([
                'class' => $this->dataColumnClass ?: DataColumn::className(),
                'grid' => $this,
            ], $column));
        }
        if (!$column->visible) {
            unset($this->columns[$i]);
            continue;
        }
        $this->columns[$i] = $column;
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:27606;s:4:"name";s:11:"initColumns";s:8:"fullName";s:30:"yii\grid\GridView::initColumns";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/grid/GridView.php";s:9:"startLine";i:540;s:7:"endLine";i:560;s:16:"shortDescription";s:44:"Creates column objects and initializes them.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"createDataColumn";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:17:"yii\grid\GridView";s:10:"sourceCode";s:569:"protected function createDataColumn($text)
{
    if (!preg_match('/^([^:]+)(:(\w*))?(:(.*))?$/', $text, $matches)) {
        throw new InvalidConfigException('The column must be specified in the format of "attribute", "attribute:format" or "attribute:format:label"');
    }
    return Yii::createObject([
        'class' => $this->dataColumnClass ?: DataColumn::className(),
        'grid' => $this,
        'attribute' => $matches[1],
        'format' => isset($matches[3]) ? $matches[3] : 'text',
        'label' => isset($matches[5]) ? $matches[5] : null,
    ]);
}
";s:6:"params";a:1:{s:5:"$text";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$text";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:31:"The column specification string";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/grid/GridView.php";}}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:38:"if the column specification is invalid";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:19:"The column instance";s:10:"returnType";s:20:"\yii\grid\DataColumn";s:11:"returnTypes";a:1:{i:0;s:20:"\yii\grid\DataColumn";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:27606;s:4:"name";s:16:"createDataColumn";s:8:"fullName";s:35:"yii\grid\GridView::createDataColumn";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/grid/GridView.php";s:9:"startLine";i:568;s:7:"endLine";i:581;s:16:"shortDescription";s:92:"Creates a [[DataColumn]] object based on a string in the format of "attribute:format:label".";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:12:"guessColumns";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:17:"yii\grid\GridView";s:10:"sourceCode";s:386:"protected function guessColumns()
{
    $models = $this->dataProvider->getModels();
    $model = reset($models);
    if (is_array($model) || is_object($model)) {
        foreach ($model as $name => $value) {
            if ($value === null || is_scalar($value) || is_callable([$value, '__toString'])) {
                $this->columns[] = (string) $name;
            }
        }
    }
