This can be either an instance of [[Formatter]] or an configuration array for creating the [[Formatter]]
instance. If this property is not set, the `formatter` application component will be used.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:11:"yii\widgets";s:13:"phpDocContext";r:24548;s:4:"name";s:22:"yii\widgets\DetailView";s:8:"fullName";s:22:"yii\widgets\DetailView";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/DetailView.php";s:9:"startLine";i:52;s:7:"endLine";i:251;s:16:"shortDescription";s:58:"DetailView displays the detail of a single data [[model]].";s:11:"description";s:947:"DetailView is best used for displaying a model in a regular format (e.g. each model attribute
is displayed as a row in a table.) The model can be either an instance of [[Model]]
or an associative array.

DetailView uses the [[attributes]] property to determines which model attributes
should be displayed and how they should be formatted.

A typical usage of DetailView is as follows:

```
echo DetailView::widget([
    'model' => $model,
    'attributes' => [
        'title',               // title attribute (in plain text)
        'description:html',    // description attribute in HTML
        [                      // the owner name of the model
            'label' => 'Owner',
            'value' => $model->owner->name,
        ],
        'created_at:datetime', // creation date formatted as datetime
    ],
]);
```

For more details and usage information on DetailView, see the [guide article on data widgets](guide:output-data-widgets).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:28:"yii\widgets\ContentDecorator";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:15:"yii\base\Widget";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:2:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:28:"yii\widgets\ContentDecorator";s:10:"sourceCode";s:220:"public function init()
{
    parent::init();
    if ($this->viewFile === null) {
        throw new InvalidConfigException('ContentDecorator::viewFile must be set.');
    }
    ob_start();
    ob_implicit_flush(false);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\widgets";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:2:{s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:6:"Widget";s:15:"yii\base\Widget";}}s:4:"name";s:4:"init";s:8:"fullName";s:34:"yii\widgets\ContentDecorator::init";s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ContentDecorator.php";s:9:"startLine";i:59;s:7:"endLine";i:68;s:16:"shortDescription";s:24:"Starts recording a clip.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:3:"run";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:28:"yii\widgets\ContentDecorator";s:10:"sourceCode";s:197:"public function run()
{
    $params = $this->params;
    $params['content'] = ob_get_clean();
    // render under the existing context
    echo $this->view->renderFile($this->viewFile, $params);
}
