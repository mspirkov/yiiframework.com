but additionally works on objects that implement the [[Traversable]] interface.";s:5:"since";s:5:"2.0.8";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:2;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:51:"https://www.php.net/manual/en/function.is-array.php";}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:8:"isSubset";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\helpers\BaseArrayHelper";s:10:"sourceCode";s:384:"public static function isSubset($needles, $haystack, $strict = false)
{
    if (!static::isTraversable($needles)) {
        throw new InvalidArgumentException('Argument $needles must be an array or implement Traversable');
    }
    foreach ($needles as $needle) {
        if (!static::isIn($needle, $haystack, $strict)) {
            return false;
        }
    }
    return true;
}
";s:6:"params";a:3:{s:8:"$needles";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$needles";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:47:"The values that must **all** be in `$haystack`.";s:4:"type";s:8:"iterable";s:5:"types";a:1:{i:0;s:8:"iterable";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:9:"$haystack";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$haystack";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:27:"The set of value to search.";s:4:"type";s:8:"iterable";s:5:"types";a:1:{i:0;s:8:"iterable";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:7:"$strict";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$strict";s:10:"isOptional";b:1;s:12:"defaultValue";s:5:"false";s:19:"isPassedByReference";b:0;s:11:"description";s:44:"Whether to enable strict (`===`) comparison.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}}s:10:"exceptions";a:1:{s:34:"\yii\base\InvalidArgumentException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:65:"if `$haystack` or `$needles` is neither traversable nor an array.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:67:"`true` if `$needles` is a subset of `$haystack`, `false` otherwise.";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:54807;s:4:"name";s:8:"isSubset";s:8:"fullName";s:37:"yii\helpers\BaseArrayHelper::isSubset";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";s:9:"startLine";i:918;s:7:"endLine";i:931;s:16:"shortDescription";s:91:"Checks whether an array or [[Traversable]] is a subset of another array or [[Traversable]].";s:11:"description";s:153:"This method will return `true`, if all elements of `$needles` are contained in
`$haystack`. If at least one element is missing, `false` will be returned.";s:5:"since";s:5:"2.0.7";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"filter";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\helpers\BaseArrayHelper";s:10:"sourceCode";s:1558:"public static function filter($array, $filters)
{
    $result = [];
    $excludeFilters = [];
    foreach ($filters as $filter) {
        if (!is_string($filter) && !is_int($filter)) {
            continue;
        }
        if (is_string($filter) && strncmp($filter, '!', 1) === 0) {
            $excludeFilters[] = substr($filter, 1);
            continue;
        }
        $nodeValue = $array; //set $array as root node
        $keys = explode('.', (string) $filter);
        foreach ($keys as $key) {
            if (!array_key_exists($key, $nodeValue)) {
                continue 2; //Jump to next filter
            }
            $nodeValue = $nodeValue[$key];
        }
        //We've found a value now let's insert it
        $resultNode = &$result;
        foreach ($keys as $key) {
            if (!array_key_exists($key, $resultNode)) {
                $resultNode[$key] = [];
            }
            $resultNode = &$resultNode[$key];
        }
        $resultNode = $nodeValue;
    }
    foreach ($excludeFilters as $filter) {
        $excludeNode = &$result;
        $keys = explode('.', (string) $filter);
        $numNestedKeys = count($keys) - 1;
        foreach ($keys as $i => $key) {
            if (!array_key_exists($key, $excludeNode)) {
                continue 2; //Jump to next filter
            }
            if ($i < $numNestedKeys) {
                $excludeNode = &$excludeNode[$key];
            } else {
                unset($excludeNode[$key]);
                break;
            }
        }
    }
    return $result;
}
";s:6:"params";a:2:{s:6:"$array";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$array";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:12:"Source array";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:8:"$filters";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$filters";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:269:"Rules that define array keys which should be left or removed from results.
Each rule is:
- `var` - `$array['var']` will be left in result.
- `var.key` = only `$array['var']['key'] will be left in result.
- `!var.key` = `$array['var']['key'] will be removed from result.";s:4:"type";s:8:"iterable";s:5:"types";a:1:{i:0;s:8:"iterable";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:14:"Filtered array";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:54807;s:4:"name";s:6:"filter";s:8:"fullName";s:35:"yii\helpers\BaseArrayHelper::filter";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";s:9:"startLine";i:977;s:7:"endLine";i:1031;s:16:"shortDescription";s:43:"Filters array according to rules specified.";s:11:"description";s:505:"For example:

```
$array = [
    'A' => [1, 2],
    'B' => [
        'C' => 1,
        'D' => 2,
    ],
    'E' => 1,
];

$result = \yii\helpers\ArrayHelper::filter($array, ['A']);
// $result will be:
// [
//     'A' => [1, 2],
// ]

$result = \yii\helpers\ArrayHelper::filter($array, ['A', 'B.C']);
// $result will be:
// [
//     'A' => [1, 2],
//     'B' => ['C' => 1],
// ]

$result = \yii\helpers\ArrayHelper::filter($array, ['B', '!B.C']);
// $result will be:
// [
//     'B' => ['D' => 2],
// ]
```";s:5:"since";s:5:"2.0.9";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"recursiveSort";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\helpers\BaseArrayHelper";s:10:"sourceCode";s:388:"public static function recursiveSort(array &$array, $sorter = null)
{
    foreach ($array as &$value) {
        if (is_array($value)) {
            static::recursiveSort($value, $sorter);
        }
    }
    unset($value);
    if ($sorter === null) {
        $sorter = static::isIndexed($array) ? 'sort' : 'ksort';
    }
    call_user_func_array($sorter, [&$array]);
    return $array;
}
";s:6:"params";a:2:{s:6:"$array";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$array";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:1;s:11:"description";s:30:"An array passing by reference.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:7:"$sorter";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$sorter";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:83:"The array sorter. If omitted, sort index array by values, sort assoc array by keys.";s:4:"type";s:13:"callable|null";s:5:"types";a:2:{i:0;s:8:"callable";i:1;s:4:"null";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:0:"";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:54807;s:4:"name";s:13:"recursiveSort";s:8:"fullName";s:42:"yii\helpers\BaseArrayHelper::recursiveSort";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";s:9:"startLine";i:1040;s:7:"endLine";i:1056;s:16:"shortDescription";s:24:"Sorts array recursively.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:7:"flatten";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\helpers\BaseArrayHelper";s:10:"sourceCode";s:640:"public static function flatten($array, $separator = '.'): array
{
    if (!static::isTraversable($array)) {
        throw new InvalidArgumentException('Argument $array must be an array or implement Traversable');
    }
    $result = [];
    foreach ($array as $key => $value) {
        $newKey = $key;
        if (is_array($value)) {
            $flattenedArray = self::flatten($value, $separator);
            foreach ($flattenedArray as $subKey => $subValue) {
                $result[$newKey . $separator . $subKey] = $subValue;
            }
        } else {
            $result[$newKey] = $value;
        }
    }
    return $result;
}
";s:6:"params";a:2:{s:6:"$array";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$array";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:61:"The input array to be flattened in terms of name-value pairs.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:10:"$separator";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$separator";s:10:"isOptional";b:1;s:12:"defaultValue";s:3:"'.'";s:19:"isPassedByReference";b:0;s:11:"description";s:51:"The separator to use between keys. Defaults to '.'.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}}s:10:"exceptions";a:1:{s:34:"\yii\base\InvalidArgumentException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:48:"if `$array` is neither traversable nor an array.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:20:"The flattened array.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:54807;s:4:"name";s:7:"flatten";s:8:"fullName";s:36:"yii\helpers\BaseArrayHelper::flatten";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";s:9:"startLine";i:1092;s:7:"endLine";i:1113;s:16:"shortDescription";s:63:"Flattens a multidimensional array into a one-dimensional array.";s:11:"description";s:433:"This method recursively traverses the input array and concatenates the keys
in a dot format to form a new key in the resulting array.

Example:

```
$array = [
     'A' => [1, 2],
     'B' => [
         'C' => 1,
         'D' => 2,
     ],
     'E' => 1,
 ];
$result = \yii\helpers\ArrayHelper::flatten($array);
// $result will be:
// [
//     'A.0' => 1
//     'A.1' => 2
//     'B.C' => 1
//     'B.D' => 2
//     'E' => 1
// ]
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:10:"properties";a:0:{}s:9:"namespace";s:11:"yii\helpers";s:13:"phpDocContext";r:54807;s:4:"name";s:27:"yii\helpers\BaseArrayHelper";s:8:"fullName";s:27:"yii\helpers\BaseArrayHelper";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";s:9:"startLine";i:24;s:7:"endLine";i:1114;s:16:"shortDescription";s:69:"BaseArrayHelper provides concrete implementation for [[ArrayHelper]].";s:11:"description";s:56:"Do not use BaseArrayHelper. Use [[ArrayHelper]] instead.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:29:"yii\helpers\ReplaceArrayValue";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";N;s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:16:"Robert Korulczyk";s:19:"robert@korulczyk.pl";}s:7:"methods";a:2:{s:11:"__construct";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:29:"yii\helpers\ReplaceArrayValue";s:10:"sourceCode";s:67:"public function __construct($value)
