{
    $getter = 'get' . $name;
    try {
        // the relation could be defined in a behavior
        $relation = $this->$getter();
    } catch (UnknownMethodException $e) {
        if ($throwException) {
            throw new InvalidArgumentException(get_class($this) . ' has no relation named "' . $name . '".', 0, $e);
        }
        return null;
    }
    if (!$relation instanceof ActiveQueryInterface) {
        if ($throwException) {
            throw new InvalidArgumentException(get_class($this) . ' has no relation named "' . $name . '".');
        }
        return null;
    }
    if (method_exists($this, $getter)) {
        // relation name is case sensitive, trying to validate it when the relation is defined within this class
        $method = new \ReflectionMethod($this, $getter);
        $realName = lcfirst(substr($method->getName(), 3));
        if ($realName !== $name) {
            if ($throwException) {
                throw new InvalidArgumentException('Relation names are case sensitive. ' . get_class($this) . " has a relation named \"$realName\" instead of \"$name\".");
            }
            return null;
        }
    }
    return $relation;
}
";s:6:"params";a:2:{s:5:"$name";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$name";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:98:"The relation name, e.g. `orders` for a relation defined via `getOrders()` method (case-sensitive).";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";}s:15:"$throwException";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:15:"$throwException";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"true";s:19:"isPassedByReference";b:0;s:11:"description";s:58:"Whether to throw exception if the relation does not exist.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";}}s:10:"exceptions";a:1:{s:34:"\yii\base\InvalidArgumentException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:37:"if the named relation does not exist.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:118:"The relational query object. If the relation does not exist
and `$throwException` is `false`, `null` will be returned.";s:10:"returnType";s:53:"\yii\db\ActiveQueryInterface|\yii\db\ActiveQuery|null";s:11:"returnTypes";a:3:{i:0;s:28:"\yii\db\ActiveQueryInterface";i:1;s:19:"\yii\db\ActiveQuery";i:2;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:170608;s:4:"name";s:11:"getRelation";s:8:"fullName";s:36:"yii\db\BaseActiveRecord::getRelation";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";s:9:"startLine";i:1267;s:7:"endLine";i:1302;s:16:"shortDescription";s:52:"Returns the relation object with the specified name.";s:11:"description";s:175:"A relation is defined by a getter method which returns an [[ActiveQueryInterface]] object.
It can be declared in either the Active Record class itself or one of its behaviors.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:4:"link";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\db\BaseActiveRecord";s:10:"sourceCode";s:3256:"public function link($name, $model, $extraColumns = [])
{
    /** @var ActiveQueryInterface|ActiveQuery $relation */
    $relation = $this->getRelation($name);
    if ($relation->via !== null) {
        if ($this->getIsNewRecord() || $model->getIsNewRecord()) {
            throw new InvalidCallException('Unable to link models: the models being linked cannot be newly created.');
        }
        if (is_array($relation->via)) {
            /**
             * @var ActiveQuery $viaRelation
             * @phpstan-var ActiveQuery<ActiveRecord|array<string, mixed>> $viaRelation
             */
            list($viaName, $viaRelation) = $relation->via;
            $viaClass = $viaRelation->modelClass;
            // unset $viaName so that it can be reloaded to reflect the change
            unset($this->_related[$viaName]);
        } else {
            $viaRelation = $relation->via;
            $viaTable = reset($relation->via->from);
        }
        $columns = [];
        foreach ($viaRelation->link as $a => $b) {
            $columns[$a] = $this->$b;
        }
        foreach ($relation->link as $a => $b) {
            $columns[$b] = $model->$a;
        }
        foreach ($extraColumns as $k => $v) {
            $columns[$k] = $v;
        }
        if (is_array($relation->via)) {
            /** @var ActiveRecordInterface $viaClass */
            /** @var ActiveRecordInterface $record */
            $record = Yii::createObject($viaClass);
            foreach ($columns as $column => $value) {
                $record->$column = $value;
            }
            $record->insert(false);
        } else {
            /** @var string $viaTable */
            static::getDb()->createCommand()->insert($viaTable, $columns)->execute();
        }
    } else {
        $p1 = $model->isPrimaryKey(array_keys($relation->link));
        $p2 = static::isPrimaryKey(array_values($relation->link));
        if ($p1 && $p2) {
            if ($this->getIsNewRecord()) {
                if ($model->getIsNewRecord()) {
                    throw new InvalidCallException('Unable to link models: at most one model can be newly created.');
                }
                $this->bindModels(array_flip($relation->link), $this, $model);
            } else {
                $this->bindModels($relation->link, $model, $this);
            }
        } elseif ($p1) {
            $this->bindModels(array_flip($relation->link), $this, $model);
        } elseif ($p2) {
            $this->bindModels($relation->link, $model, $this);
        } else {
            throw new InvalidCallException('Unable to link models: the link defining the relation does not involve any primary key.');
        }
    }
    // update lazily loaded related objects
    if (!$relation->multiple) {
        $this->_related[$name] = $model;
    } elseif (isset($this->_related[$name])) {
        if ($relation->indexBy !== null) {
            if ($relation->indexBy instanceof \Closure) {
                $index = call_user_func($relation->indexBy, $model);
            } else {
                $index = $model->{$relation->indexBy};
            }
            $this->_related[$name][$index] = $model;
        } else {
            $this->_related[$name][] = $model;
        }
    }
}
";s:6:"params";a:3:{s:5:"$name";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$name";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:107:"The case sensitive name of the relationship, e.g. `orders` for a relation defined via `getOrders()` method.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";}s:6:"$model";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$model";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:44:"The model to be linked with the current one.";s:4:"type";s:29:"\yii\db\ActiveRecordInterface";s:5:"types";a:1:{i:0;s:29:"\yii\db\ActiveRecordInterface";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";}s:13:"$extraColumns";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:13:"$extraColumns";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:232:"Additional column values to be saved into the junction table.
This parameter is only meaningful for a relationship involving a junction table
(i.e., a relation set with [[ActiveRelationTrait::via()]] or [[ActiveQuery::viaTable()]].)";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";}}s:10:"exceptions";a:1:{s:30:"\yii\base\InvalidCallException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:43:"if the method is unable to link two models.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:170608;s:4:"name";s:4:"link";s:8:"fullName";s:29:"yii\db\BaseActiveRecord::link";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";s:9:"startLine";i:1324;s:7:"endLine";i:1404;s:16:"shortDescription";s:48:"Establishes the relationship between two models.";s:11:"description";s:499:"The relationship is established by setting the foreign key value(s) in one model
to be the corresponding primary key value(s) in the other model.
The model with the foreign key will be saved into database **without** performing validation
and **without** events/behaviors.

If the relationship involves a junction table, a new row will be inserted into the
junction table which contains the primary key values from both models.

Note that this method requires that the primary key value is not null.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"unlink";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\db\BaseActiveRecord";s:10:"sourceCode";s:3265:"public function unlink($name, $model, $delete = false)
{
    /** @var ActiveQueryInterface|ActiveQuery $relation */
    $relation = $this->getRelation($name);
    if ($relation->via !== null) {
        if (is_array($relation->via)) {
            /**
             * @var ActiveQuery $viaRelation
             * @phpstan-var ActiveQuery<ActiveRecord> $viaRelation
             */
            list($viaName, $viaRelation) = $relation->via;
            $viaClass = $viaRelation->modelClass;
            unset($this->_related[$viaName]);
        } else {
            $viaRelation = $relation->via;
            $viaTable = reset($relation->via->from);
        }
        $columns = [];
        foreach ($viaRelation->link as $a => $b) {
            $columns[$a] = $this->$b;
        }
        foreach ($relation->link as $a => $b) {
            $columns[$b] = $model->$a;
        }
        $nulls = [];
        foreach (array_keys($columns) as $a) {
            $nulls[$a] = null;
        }
        if (property_exists($viaRelation, 'on') && $viaRelation->on !== null) {
            $columns = ['and', $columns, $viaRelation->on];
        }
        if (is_array($relation->via)) {
            /** @var ActiveRecordInterface $viaClass */
            if ($delete) {
                $viaClass::deleteAll($columns);
            } else {
                $viaClass::updateAll($nulls, $columns);
            }
        } else {
            /** @var string $viaTable */
            /** @var Command $command */
            $command = static::getDb()->createCommand();
            if ($delete) {
                $command->delete($viaTable, $columns)->execute();
            } else {
                $command->update($viaTable, $nulls, $columns)->execute();
            }
        }
    } else {
        $p1 = $model->isPrimaryKey(array_keys($relation->link));
        $p2 = static::isPrimaryKey(array_values($relation->link));
        if ($p2) {
            if ($delete) {
                $model->delete();
            } else {
                foreach ($relation->link as $a => $b) {
                    $model->$a = null;
                }
                $model->save(false);
            }
        } elseif ($p1) {
            foreach ($relation->link as $a => $b) {
                if (is_array($this->$b)) { // relation via array valued attribute
                    if (($key = array_search($model->$a, $this->$b, false)) !== false) {
                        $values = $this->$b;
                        unset($values[$key]);
                        $this->$b = array_values($values);
                    }
                } else {
                    $this->$b = null;
                }
            }
            $delete ? $this->delete() : $this->save(false);
        } else {
            throw new InvalidCallException('Unable to unlink models: the link does not involve any primary key.');
        }
    }
    if (!$relation->multiple) {
        unset($this->_related[$name]);
    } elseif (isset($this->_related[$name])) {
        /** @var ActiveRecordInterface $b */
        foreach ($this->_related[$name] as $a => $b) {
            if ($model->getPrimaryKey() === $b->getPrimaryKey()) {
                unset($this->_related[$name][$a]);
            }
        }
    }
}
";s:6:"params";a:3:{s:5:"$name";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$name";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:107:"The case sensitive name of the relationship, e.g. `orders` for a relation defined via `getOrders()` method.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";}s:6:"$model";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$model";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:160:"The model to be unlinked from the current one.
You have to make sure that the model is really related with the current model as this method
does not check this.";s:4:"type";s:29:"\yii\db\ActiveRecordInterface";s:5:"types";a:1:{i:0;s:29:"\yii\db\ActiveRecordInterface";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";}s:7:"$delete";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$delete";s:10:"isOptional";b:1;s:12:"defaultValue";s:5:"false";s:19:"isPassedByReference";b:0;s:11:"description";s:189:"Whether to delete the model that contains the foreign key.
If `false`, the model's foreign key will be set `null` and saved.
If `true`, the model containing the foreign key will be deleted.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";}}s:10:"exceptions";a:3:{s:30:"\yii\base\InvalidCallException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:32:"if the models cannot be unlinked";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}s:17:"\yii\db\Exception";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}s:28:"\yii\db\StaleObjectException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:170608;s:4:"name";s:6:"unlink";s:8:"fullName";s:31:"yii\db\BaseActiveRecord::unlink";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";s:9:"startLine";i:1423;s:7:"endLine";i:1512;s:16:"shortDescription";s:45:"Destroys the relationship between two models.";s:11:"description";s:184:"The model with the foreign key of the relationship will be deleted if `$delete` is `true`.
Otherwise, the foreign key will be set `null` and the model will be saved without validation.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"unlinkAll";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\db\BaseActiveRecord";s:10:"sourceCode";s:2823:"public function unlinkAll($name, $delete = false)
{
    /** @var ActiveQueryInterface|ActiveQuery $relation */
    $relation = $this->getRelation($name);
    if ($relation->via !== null) {
        if (is_array($relation->via)) {
            /**
             * @var ActiveQuery $viaRelation
             * @phpstan-var ActiveQuery<ActiveRecord|array<string, mixed>> $viaRelation
             */
            list($viaName, $viaRelation) = $relation->via;
            $viaClass = $viaRelation->modelClass;
            unset($this->_related[$viaName]);
        } else {
            $viaRelation = $relation->via;
            $viaTable = reset($relation->via->from);
        }
        $condition = [];
        $nulls = [];
        foreach ($viaRelation->link as $a => $b) {
            $nulls[$a] = null;
            $condition[$a] = $this->$b;
        }
        if (!empty($viaRelation->where)) {
            $condition = ['and', $condition, $viaRelation->where];
        }
        if (property_exists($viaRelation, 'on') && !empty($viaRelation->on)) {
            $condition = ['and', $condition, $viaRelation->on];
        }
        if (is_array($relation->via)) {
            /** @var ActiveRecordInterface $viaClass */
            if ($delete) {
                $viaClass::deleteAll($condition);
            } else {
                $viaClass::updateAll($nulls, $condition);
            }
        } else {
            /** @var string $viaTable */
            /** @var Command $command */
            $command = static::getDb()->createCommand();
            if ($delete) {
                $command->delete($viaTable, $condition)->execute();
            } else {
                $command->update($viaTable, $nulls, $condition)->execute();
            }
        }
    } else {
        /** @var ActiveRecordInterface $relatedModel */
        $relatedModel = $relation->modelClass;
        if (!$delete && count($relation->link) === 1 && is_array($this->{$b = reset($relation->link)})) {
            // relation via array valued attribute
            $this->$b = [];
            $this->save(false);
        } else {
            $nulls = [];
            $condition = [];
            foreach ($relation->link as $a => $b) {
                $nulls[$a] = null;
                $condition[$a] = $this->$b;
            }
            if (!empty($relation->where)) {
                $condition = ['and', $condition, $relation->where];
            }
            if (property_exists($relation, 'on') && !empty($relation->on)) {
                $condition = ['and', $condition, $relation->on];
            }
            if ($delete) {
                $relatedModel::deleteAll($condition);
            } else {
                $relatedModel::updateAll($nulls, $condition);
            }
        }
    }
    unset($this->_related[$name]);
}
";s:6:"params";a:2:{s:5:"$name";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$name";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:107:"The case sensitive name of the relationship, e.g. `orders` for a relation defined via `getOrders()` method.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";}s:7:"$delete";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$delete";s:10:"isOptional";b:1;s:12:"defaultValue";s:5:"false";s:19:"isPassedByReference";b:0;s:11:"description";s:348:"Whether to delete the model that contains the foreign key.

Note that the deletion will be performed using [[deleteAll()]], which will not trigger any events on the related models.
If you need [[EVENT_BEFORE_DELETE]] or [[EVENT_AFTER_DELETE]] to be triggered, you need to [[find()|find]] the models first
and then call [[delete()]] on each of them.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:170608;s:4:"name";s:9:"unlinkAll";s:8:"fullName";s:34:"yii\db\BaseActiveRecord::unlinkAll";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";s:9:"startLine";i:1529;s:7:"endLine";i:1605;s:16:"shortDescription";s:43:"Destroys the relationship in current model.";s:11:"description";s:287:"The model with the foreign key of the relationship will be deleted if `$delete` is `true`.
Otherwise, the foreign key will be set `null` and the model will be saved without validation.

Note that to destroy the relationship without removing records make sure your keys can be set to null";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:12:"isPrimaryKey";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\db\BaseActiveRecord";s:10:"sourceCode";s:212:"public static function isPrimaryKey($keys)
{
    $pks = static::primaryKey();
    if (count($keys) === count($pks)) {
        return count(array_intersect($keys, $pks)) === count($pks);
    }
    return false;
}
";s:6:"params";a:1:{s:5:"$keys";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$keys";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:30:"The set of attributes to check";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:77:"Whether the given set of attributes represents the primary key for this model";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:170608;s:4:"name";s:12:"isPrimaryKey";s:8:"fullName";s:37:"yii\db\BaseActiveRecord::isPrimaryKey";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";s:9:"startLine";i:1634;s:7:"endLine";i:1642;s:16:"shortDescription";s:105:"Returns a value indicating whether the given set of attributes represents the primary key for this model.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"getAttributeLabel";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\db\BaseActiveRecord";s:10:"sourceCode";s:989:"public function getAttributeLabel($attribute)
{
    $model = $this;
    $modelAttribute = $attribute;
    for (;;) {
        $labels = $model->attributeLabels();
        if (isset($labels[$modelAttribute])) {
            return $labels[$modelAttribute];
        }
        $parts = explode('.', $modelAttribute, 2);
        if (count($parts) < 2) {
            break;
        }
        list ($relationName, $modelAttribute) = $parts;
        if ($model->isRelationPopulated($relationName) && $model->$relationName instanceof self) {
            $model = $model->$relationName;
        } else {
            try {
                $relation = $model->getRelation($relationName);
            } catch (InvalidArgumentException $e) {
                break;
            }
            /** @var ActiveRecordInterface $modelClass */
            $modelClass = $relation->modelClass;
            $model = $modelClass::instance();
        }
    }
    return $this->generateAttributeLabel($attribute);
}
";s:6:"params";a:1:{s:10:"$attribute";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$attribute";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:18:"The attribute name";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:19:"The attribute label";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:170608;s:4:"name";s:17:"getAttributeLabel";s:8:"fullName";s:42:"yii\db\BaseActiveRecord::getAttributeLabel";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/BaseActiveRecord.php";s:9:"startLine";i:1658;s:7:"endLine";i:1690;s:16:"shortDescription";s:51:"Returns the text label for the specified attribute.";s:11:"description";s:794:"The attribute may be specified in a dot format to retrieve the label from related model or allow this model to override the label defined in related model.
For example, if the attribute is specified as 'relatedModel1.relatedModel2.attr' the function will return the first label definition it can find
in the following order:
- the label for 'relatedModel1.relatedModel2.attr' defined in [[attributeLabels()]] of this model;
- the label for 'relatedModel2.attr' defined in related model represented by relation 'relatedModel1' of this model;
- the label for 'attr' defined in related model represented by relation 'relatedModel2' of relation 'relatedModel1'.
  If no label definition was found then the value of $this->generateAttributeLabel('relatedModel1.relatedModel2.attr') will be returned.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:2;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:25:"\yii\db\attributeLabels()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:15:"attributeLabels";}}s:14:"␀*␀description";N;}i:3;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:32:"\yii\db\generateAttributeLabel()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:22:"generateAttributeLabel";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:16:"getAttributeHint";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\db\BaseActiveRecord";s:10:"sourceCode";s:1159:"public function getAttributeHint($attribute)
{
    $hints = $this->attributeHints();
    if (isset($hints[$attribute])) {
        return $hints[$attribute];
    } elseif (strpos($attribute, '.')) {
        $attributeParts = explode('.', $attribute);
        $neededAttribute = array_pop($attributeParts);
        $relatedModel = $this;
        foreach ($attributeParts as $relationName) {
            if ($relatedModel->isRelationPopulated($relationName) && $relatedModel->$relationName instanceof self) {
                $relatedModel = $relatedModel->$relationName;
            } else {
                try {
                    $relation = $relatedModel->getRelation($relationName);
                } catch (InvalidParamException $e) {
                    return '';
                }
                /** @var ActiveRecordInterface $modelClass */
                $modelClass = $relation->modelClass;
                $relatedModel = $modelClass::instance();
            }
        }
        $hints = $relatedModel->attributeHints();
        if (isset($hints[$neededAttribute])) {
            return $hints[$neededAttribute];
        }
    }
    return '';
}
