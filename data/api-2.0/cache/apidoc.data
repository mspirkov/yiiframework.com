[[\yii\base\Application::sourceLanguage]].";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:36:"phpDocumentor\Reflection\Types\Null_":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:127:"the language that the original messages are in. If not set, it will use the value of
[[\yii\base\Application::sourceLanguage]].";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:8:"yii\i18n";s:13:"phpDocContext";r:7575;s:4:"name";s:22:"yii\i18n\MessageSource";s:8:"fullName";s:22:"yii\i18n\MessageSource";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/MessageSource.php";s:9:"startLine";i:23;s:7:"endLine";i:125;s:16:"shortDescription";s:75:"MessageSource is the base class for message translation repository classes.";s:11:"description";s:154:"A message source stores message translations in some persistent storage.

Child classes should override [[loadMessages()]] to provide translated messages.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:25:"yii\i18n\PhpMessageSource";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:22:"yii\i18n\MessageSource";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:4:{s:12:"loadMessages";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:25:"yii\i18n\PhpMessageSource";s:10:"sourceCode";s:861:"protected function loadMessages($category, $language)
{
    $messageFile = $this->getMessageFilePath($category, $language);
    $messages = $this->loadMessagesFromFile($messageFile);
    $fallbackLanguage = substr((string)$language, 0, 2);
    $fallbackSourceLanguage = substr($this->sourceLanguage, 0, 2);
    if ($fallbackLanguage !== '' && $language !== $fallbackLanguage) {
        $messages = $this->loadFallbackMessages($category, $fallbackLanguage, $messages, $messageFile);
    } elseif ($fallbackSourceLanguage !== '' && $language === $fallbackSourceLanguage) {
        $messages = $this->loadFallbackMessages($category, $this->sourceLanguage, $messages, $messageFile);
    } elseif ($messages === null) {
        Yii::warning("The message file for category '$category' does not exist: $messageFile", __METHOD__);
    }
    return (array) $messages;
}
";s:6:"params";a:2:{s:9:"$category";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$category";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:20:"The message category";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/PhpMessageSource.php";}s:9:"$language";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$language";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:19:"The target language";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/PhpMessageSource.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:96:"The loaded messages. The keys are original messages, and the values are the translated messages.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:8:"yii\i18n";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:2:{s:3:"Yii";s:3:"Yii";s:24:"InvalidArgumentException";s:33:"yii\base\InvalidArgumentException";}}s:4:"name";s:12:"loadMessages";s:8:"fullName";s:39:"yii\i18n\PhpMessageSource::loadMessages";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/PhpMessageSource.php";s:9:"startLine";i:70;s:7:"endLine";i:87;s:16:"shortDescription";s:72:"Loads the message translation for the specified $language and $category.";s:11:"description";s:466:"If translation for specific locale code such as `en-US` isn't found it
tries more generic `en`. When both are present, the `en-US` messages will be merged
over `en`. See [[loadFallbackMessages]] for details.
If the $language is less specific than [[sourceLanguage]], the method will try to
load the messages for [[sourceLanguage]]. For example: [[sourceLanguage]] is `en-GB`,
$language is `en`. The method will load the messages for `en` and merge them over `en-GB`.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:3;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:30:"\yii\i18n\loadFallbackMessages";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:20:"loadFallbackMessages";}}s:14:"␀*␀description";N;}i:4;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:24:"\yii\i18n\sourceLanguage";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:14:"sourceLanguage";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:20:"loadFallbackMessages";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:25:"yii\i18n\PhpMessageSource";s:10:"sourceCode";s:980:"protected function loadFallbackMessages($category, $fallbackLanguage, $messages, $originalMessageFile)
{
    $fallbackMessageFile = $this->getMessageFilePath($category, $fallbackLanguage);
    $fallbackMessages = $this->loadMessagesFromFile($fallbackMessageFile);
    if (
        $messages === null && $fallbackMessages === null
        && $fallbackLanguage !== $this->sourceLanguage
        && strpos($this->sourceLanguage, $fallbackLanguage) !== 0
    ) {
        Yii::error("The message file for category '$category' does not exist: $originalMessageFile "
            . "Fallback file does not exist as well: $fallbackMessageFile", __METHOD__);
    } elseif (empty($messages)) {
        return $fallbackMessages;
    } elseif (!empty($fallbackMessages)) {
        foreach ($fallbackMessages as $key => $value) {
            if (!empty($value) && empty($messages[$key])) {
                $messages[$key] = $value;
            }
        }
    }
    return (array) $messages;
}
