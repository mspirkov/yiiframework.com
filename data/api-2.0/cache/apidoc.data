See [[Transaction::begin()]] for details.";s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Command.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:22:"This command instance.";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:184737;s:4:"name";s:18:"requireTransaction";s:8:"fullName";s:34:"yii\db\Command::requireTransaction";s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Command.php";s:9:"startLine";i:1266;s:7:"endLine";i:1270;s:16:"shortDescription";s:48:"Marks the command to be executed in transaction.";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.14";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:15:"setRetryHandler";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:14:"yii\db\Command";s:10:"sourceCode";s:113:"protected function setRetryHandler(callable $handler)
