{
    $roles = $this->getDefaultRoleInstances();
    foreach ($this->getAssignments($userId) as $name => $assignment) {
        $item = $this->items[$assignment->roleName];
        if ($item->type === Item::TYPE_ROLE) {
            /** @var Role $item */
            $roles[$name] = $item;
        }
    }
    return $roles;
}
