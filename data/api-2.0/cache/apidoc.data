'php:m/d/Y H:i:s' // the same date and time in PHP format
```";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:9:"$calendar";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:22:"\IntlCalendar|int|null";s:5:"types";a:3:{i:0;s:13:"\IntlCalendar";i:1;s:3:"int";i:2;s:4:"null";}s:12:"defaultValue";N;s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:18:"yii\i18n\Formatter";s:13:"phpDocContext";r:2299;s:4:"name";s:9:"$calendar";s:8:"fullName";s:29:"yii\i18n\Formatter::$calendar";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";s:9:"startLine";i:213;s:7:"endLine";i:213;s:16:"shortDescription";s:44:"The calendar to be used for date formatting.";s:11:"description";s:1249:"The calendar to be used for date formatting. The value of this property will be directly
passed to the [constructor of the `IntlDateFormatter` class](https://www.php.net/manual/en/intldateformatter.create.php).

Defaults to `null`, which means the Gregorian calendar will be used. You may also explicitly pass the constant
`\IntlDateFormatter::GREGORIAN` for Gregorian calendar.

To use an alternative calendar like for example the [Jalali calendar](https://en.wikipedia.org/wiki/Jalali_calendar),
set this property to `\IntlDateFormatter::TRADITIONAL`.
The calendar must then be specified in the [[locale]], for example for the persian calendar the configuration for the formatter would be:

```
'formatter' => [
    'locale' => 'fa_IR@calendar=persian',
    'calendar' => \IntlDateFormatter::TRADITIONAL,
],
```

Available calendar names can be found in the [ICU manual](https://unicode-org.github.io/icu/userguide/datetime/calendar/).

Since PHP 5.5 you may also use an instance of the [[\IntlCalendar]] class.
Check the [PHP manual](https://www.php.net/manual/en/intldateformatter.create.php) for more details.

If the [PHP intl extension](https://www.php.net/manual/en/book.intl.php) is not available, setting this property will have no effect.";s:5:"since";s:5:"2.0.7";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:4:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:3:{i:0;O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:13:"\IntlCalendar";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:12:"IntlCalendar";}}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}i:2;O:36:"phpDocumentor\Reflection\Types\Null_":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:1249:"the calendar to be used for date formatting. The value of this property will be directly
passed to the [constructor of the `IntlDateFormatter` class](https://www.php.net/manual/en/intldateformatter.create.php).

Defaults to `null`, which means the Gregorian calendar will be used. You may also explicitly pass the constant
`\IntlDateFormatter::GREGORIAN` for Gregorian calendar.

To use an alternative calendar like for example the [Jalali calendar](https://en.wikipedia.org/wiki/Jalali_calendar),
set this property to `\IntlDateFormatter::TRADITIONAL`.
The calendar must then be specified in the [[locale]], for example for the persian calendar the configuration for the formatter would be:

```
'formatter' => [
    'locale' => 'fa_IR@calendar=persian',
    'calendar' => \IntlDateFormatter::TRADITIONAL,
],
```

Available calendar names can be found in the [ICU manual](https://unicode-org.github.io/icu/userguide/datetime/calendar/).

Since PHP 5.5 you may also use an instance of the [[\IntlCalendar]] class.
Check the [PHP manual](https://www.php.net/manual/en/intldateformatter.create.php) for more details.

If the [PHP intl extension](https://www.php.net/manual/en/book.intl.php) is not available, setting this property will have no effect.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:1;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:58:"https://www.php.net/manual/en/intldateformatter.create.php";}s:14:"␀*␀description";N;}i:2;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:104:"https://www.php.net/manual/en/class.intldateformatter.php#intl.intldateformatter-constants.calendartypes";}s:14:"␀*␀description";N;}i:3;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:52:"https://www.php.net/manual/en/class.intlcalendar.php";}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:17:"$decimalSeparator";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:12:"defaultValue";N;s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:18:"yii\i18n\Formatter";s:13:"phpDocContext";r:2299;s:4:"name";s:17:"$decimalSeparator";s:8:"fullName";s:37:"yii\i18n\Formatter::$decimalSeparator";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";s:9:"startLine";i:219;s:7:"endLine";i:219;s:16:"shortDescription";s:70:"The character displayed as the decimal point when formatting a number.";s:11:"description";s:259:"The character displayed as the decimal point when formatting a number.
