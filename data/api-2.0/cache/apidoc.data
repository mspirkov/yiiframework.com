Null is returned if no file is uploaded for the specified name.";s:10:"returnType";s:26:"\yii\web\UploadedFile|null";s:11:"returnTypes";a:2:{i:0;s:21:"\yii\web\UploadedFile";i:1;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:100459;s:4:"name";s:17:"getInstanceByName";s:8:"fullName";s:39:"yii\web\UploadedFile::getInstanceByName";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/UploadedFile.php";s:9:"startLine";i:136;s:7:"endLine";i:140;s:16:"shortDescription";s:64:"Returns an uploaded file according to the given file input name.";s:11:"description";s:115:"The name can be a plain string or a string like an array element (e.g. 'Post[imageFile]', or 'Post[0][imageFile]').";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:18:"getInstancesByName";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\web\UploadedFile";s:10:"sourceCode";s:353:"public static function getInstancesByName($name)
{
    $files = self::loadFiles();
    if (isset($files[$name])) {
        return [new static($files[$name])];
    }
    $results = [];
    foreach ($files as $key => $file) {
        if (strpos($key, "{$name}[") === 0) {
            $results[] = new static($file);
        }
    }
    return $results;
}
