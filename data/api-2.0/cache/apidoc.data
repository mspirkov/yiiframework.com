on";s:48:"The default schema used for the current session.";s:11:"description";s:48:"The default schema used for the current session.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:48:"the default schema used for the current session.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:18:"$columnSchemaClass";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";N;s:5:"types";N;s:12:"defaultValue";s:27:"'yii\db\pgsql\ColumnSchema'";s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:19:"yii\db\pgsql\Schema";s:13:"phpDocContext";r:196321;s:4:"name";s:18:"$columnSchemaClass";s:8:"fullName";s:39:"yii\db\pgsql\Schema::$columnSchemaClass";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/Schema.php";s:9:"startLine";i:48;s:7:"endLine";i:48;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:8:"$typeMap";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:12:"defaultValue";s:2306:"[
