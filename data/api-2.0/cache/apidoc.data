{
    $cacheKey = $this->getCacheKey();
    $fragmentCacheConfiguration = $this->getFragmentCacheConfiguration();
    if (!$this->owner->view->beginCache($cacheKey, $fragmentCacheConfiguration)) {
        $event->isValid = false;
    }
}
";s:6:"params";a:1:{s:6:"$event";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$event";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:33:"`Widget::EVENT_BEFORE_RUN` event.";s:4:"type";s:21:"\yii\base\WidgetEvent";s:5:"types";a:1:{i:0;s:21:"\yii\base\WidgetEvent";}s:10:"sourceFile";s:112:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/behaviors/CacheableWidgetBehavior.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:30527;s:4:"name";s:9:"beforeRun";s:8:"fullName";s:48:"yii\behaviors\CacheableWidgetBehavior::beforeRun";s:10:"sourceFile";s:112:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/behaviors/CacheableWidgetBehavior.php";s:9:"startLine";i:123;s:7:"endLine";i:131;s:16:"shortDescription";s:110:"Begins fragment caching. Prevents owner widget from execution
if its contents can be retrieved from the cache.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"afterRun";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:37:"yii\behaviors\CacheableWidgetBehavior";s:10:"sourceCode";s:125:"public function afterRun($event)
{
