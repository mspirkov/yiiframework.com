";s:6:"params";a:1:{s:8:"$options";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$options";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:536:"The tag options in terms of name-value pairs. It will be merged with [[errorOptions]].
The options will be rendered as the attributes of the resulting tag. The values will be HTML-encoded
using [[Html::encode()]]. If this parameter is `false`, no error tag will be rendered.

The following options are specially handled:

- `tag`: this specifies the tag name. If not set, `div` will be used.
  See also [[\yii\helpers\Html::tag()]].

If you set a custom `id` for the error element, you may need to adjust the [[$selectors]] accordingly.";s:4:"type";s:11:"array|false";s:5:"types";a:2:{i:0;s:5:"array";i:1;s:5:"false";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveField.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:24:"The field object itself.";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:22694;s:4:"name";s:5:"error";s:8:"fullName";s:30:"yii\widgets\ActiveField::error";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveField.php";s:9:"startLine";i:314;s:7:"endLine";i:324;s:16:"shortDescription";s:74:"Generates a tag that contains the first validation error of [[attribute]].";s:11:"description";s:97:"Note that even if there is no validation error, this method will still return an empty error tag.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:1;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:25:"\yii\widgets\errorOptions";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:12:"errorOptions";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:4:"hint";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\widgets\ActiveField";s:10:"sourceCode";s:382:"public function hint($content, $options = [])
{
    if ($content === false) {
        $this->parts['{hint}'] = '';
        return $this;
    }
    $options = array_merge($this->hintOptions, $options);
    if ($content !== null) {
        $options['hint'] = $content;
    }
    $this->parts['{hint}'] = Html::activeHint($this->model, $this->attribute, $options);
    return $this;
}
