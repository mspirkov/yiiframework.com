the next new row's primary key will have a value 1.";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/cubrid/QueryBuilder.php";}}s:10:"exceptions";a:1:{s:34:"\yii\base\InvalidArgumentException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:78:"if the table does not exist or there is no sequence associated with the table.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:40:"The SQL statement for resetting sequence";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:157502;s:4:"name";s:13:"resetSequence";s:8:"fullName";s:41:"yii\db\cubrid\QueryBuilder::resetSequence";s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/cubrid/QueryBuilder.php";s:9:"startLine";i:131;s:7:"endLine";i:149;s:16:"shortDescription";s:82:"Creates a SQL statement for resetting the sequence value of a table's primary key.";s:11:"description";s:117:"The sequence will be reset such that the primary key of the next new row inserted
will have the specified value or 1.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:10:"buildLimit";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:26:"yii\db\cubrid\QueryBuilder";s:10:"sourceCode";s:596:"public function buildLimit($limit, $offset)
{
    $sql = '';
    // limit is not optional in CUBRID
    // https://www.cubrid.org/manual/en/9.3.0/sql/query/select.html#limit-clause
    // "You can specify a very big integer for row_count to display to the last row, starting from a specific row."
    if ($this->hasLimit($limit)) {
        $sql = 'LIMIT ' . $limit;
        if ($this->hasOffset($offset)) {
            $sql .= ' OFFSET ' . $offset;
        }
    } elseif ($this->hasOffset($offset)) {
        $sql = "LIMIT 9223372036854775807 OFFSET $offset"; // 2^63-1
    }
    return $sql;
}
