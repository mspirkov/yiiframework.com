    $table = $this->db->quoteTableName($table);
    $oldName = $this->db->quoteColumnName($oldName);
    $newName = $this->db->quoteColumnName($newName);
    return "sp_rename '{$table}.{$oldName}', {$newName}, 'COLUMN'";
}
";s:6:"params";a:3:{s:6:"$table";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$table";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:88:"The table whose column is to be renamed. The name will be properly quoted by the method.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";}s:8:"$oldName";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$oldName";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:75:"The old name of the column. The name will be properly quoted by the method.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";}s:8:"$newName";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$newName";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:75:"The new name of the column. The name will be properly quoted by the method.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:43:"The SQL statement for renaming a DB column.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:160667;s:4:"name";s:12:"renameColumn";s:8:"fullName";s:39:"yii\db\mssql\QueryBuilder::renameColumn";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";s:9:"startLine";i:158;s:7:"endLine";i:164;s:16:"shortDescription";s:45:"Builds a SQL statement for renaming a column.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"alterColumn";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\db\mssql\QueryBuilder";s:10:"sourceCode";s:1488:"public function alterColumn($table, $column, $type)
{
    $sqlAfter = [$this->dropConstraintsForColumn($table, $column, 'D')];
    $columnName = $this->db->quoteColumnName($column);
    $tableName = $this->db->quoteTableName($table);
    $constraintBase = preg_replace('/[^a-z0-9_]/i', '', $table . '_' . $column);
    if ($type instanceof \yii\db\mssql\ColumnSchemaBuilder) {
        $type->setAlterColumnFormat();
        $defaultValue = $type->getDefaultValue();
        if ($defaultValue !== null) {
            $sqlAfter[] = $this->addDefaultValue(
                "DF_{$constraintBase}",
                $table,
                $column,
                $defaultValue instanceof Expression ? $defaultValue : new Expression($defaultValue)
            );
        }
        $checkValue = $type->getCheckValue();
        if ($checkValue !== null) {
            $sqlAfter[] = "ALTER TABLE {$tableName} ADD CONSTRAINT " .
                $this->db->quoteColumnName("CK_{$constraintBase}") .
                ' CHECK (' . ($defaultValue instanceof Expression ?  $checkValue : new Expression($checkValue)) . ')';
        }
        if ($type->isUnique()) {
            $sqlAfter[] = "ALTER TABLE {$tableName} ADD CONSTRAINT " . $this->db->quoteColumnName("UQ_{$constraintBase}") . " UNIQUE ({$columnName})";
        }
    }
    return 'ALTER TABLE ' . $tableName . ' ALTER COLUMN '
        . $columnName . ' '
        . $this->getColumnType($type) . "\n"
        . implode("\n", $sqlAfter);
}
