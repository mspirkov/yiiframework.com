";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:14:"yii\validators";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:4:{s:3:"Yii";s:3:"Yii";s:12:"DynamicModel";s:21:"yii\base\DynamicModel";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:5:"Model";s:14:"yii\base\Model";}}s:4:"name";s:4:"init";s:8:"fullName";s:34:"yii\validators\EachValidator::init";s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/EachValidator.php";s:9:"startLine";i:78;s:7:"endLine";i:84;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:17:"validateAttribute";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:28:"yii\validators\EachValidator";s:10:"sourceCode";s:1200:"public function validateAttribute($model, $attribute)
{
    $arrayOfValues = $model->$attribute;
    if (!is_array($arrayOfValues) && !$arrayOfValues instanceof \ArrayAccess) {
        $this->addError($model, $attribute, $this->message, []);
        return;
    }
    foreach ($arrayOfValues as $k => $v) {
        $dynamicModel = new DynamicModel($model->getAttributes());
        $dynamicModel->setAttributeLabels($model->attributeLabels());
        $dynamicModel->addRule($attribute, $this->createEmbeddedValidator($model, $v));
        $dynamicModel->defineAttribute($attribute, $v);
        $dynamicModel->validate();
        $arrayOfValues[$k] = $dynamicModel->$attribute; // filtered values like 'trim'
        if (!$dynamicModel->hasErrors($attribute)) {
            continue;
        }
        if ($this->allowMessageFromRule) {
            $validationErrors = $dynamicModel->getErrors($attribute);
            $model->addErrors([$attribute => $validationErrors]);
        } else {
            $this->addError($model, $attribute, $this->message, ['value' => $v]);
        }
        if ($this->stopOnFirstError) {
            break;
        }
    }
    $model->$attribute = $arrayOfValues;
}
