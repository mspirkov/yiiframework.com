This is the implementation of the method declared in the parent class.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:2:"gc";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\caching\DbCache";s:10:"sourceCode";s:257:"public function gc($force = false)
{
    if ($force || random_int(0, 1000000) < $this->gcProbability) {
        $this->db->createCommand()
            ->delete($this->cacheTable, '[[expire]] > 0 AND [[expire]] < ' . time())
            ->execute();
    }
}
