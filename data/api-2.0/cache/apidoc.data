enCondition]]";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.14";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:38:"yii\db\conditions\LikeConditionBuilder";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";N;s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:1:{i:0;s:33:"yii\db\ExpressionBuilderInterface";}s:6:"traits";a:1:{i:0;s:29:"yii\db\ExpressionBuilderTrait";}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:15:"Dmytro Naumenko";s:22:"d.naumenko.a@gmail.com";}s:7:"methods";a:2:{s:5:"build";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:38:"yii\db\conditions\LikeConditionBuilder";s:10:"sourceCode";s:1328:"public function build(ExpressionInterface $expression, array &$params = [])
{
    $operator = strtoupper($expression->getOperator());
    $column = $expression->getColumn();
    $values = $expression->getValue();
    $escape = $expression->getEscapingReplacements();
    if ($escape === null || $escape === []) {
        $escape = $this->escapingReplacements;
    }
    list($andor, $not, $operator) = $this->parseOperator($operator);
    if (!is_array($values)) {
        $values = [$values];
    }
    if (empty($values)) {
        return $not ? '' : '0=1';
    }
    if ($column instanceof ExpressionInterface) {
        $column = $this->queryBuilder->buildExpression($column, $params);
    } elseif (is_string($column) && strpos($column, '(') === false) {
        $column = $this->queryBuilder->db->quoteColumnName($column);
    }
    $escapeSql = $this->getEscapeSql();
    $parts = [];
    foreach ($values as $value) {
        if ($value instanceof ExpressionInterface) {
            $phName = $this->queryBuilder->buildExpression($value, $params);
        } else {
            $phName = $this->queryBuilder->bindParam(empty($escape) ? $value : ('%' . strtr((string)$value, $escape) . '%'), $params);
        }
        $parts[] = "{$column} {$operator} {$phName}{$escapeSql}";
    }
    return implode($andor, $parts);
}
