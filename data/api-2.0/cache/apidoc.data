is returned in terms of (key, value) pairs.
If a value is not cached or expired, the corresponding array value will be false.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:125687;s:4:"name";s:4:"mget";s:8:"fullName";s:23:"yii\caching\Cache::mget";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/Cache.php";s:9:"startLine";i:181;s:7:"endLine";i:184;s:16:"shortDescription";s:61:"Retrieves multiple values from cache with the specified keys.";s:11:"description";s:221:"Some caches (such as memcache, apc) allow retrieving multiple cached values at the same time,
which may improve the performance. In case a cache does not support this feature natively,
this method will try to simulate it.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";s:72:"This method is an alias for [[multiGet()]] and will be removed in 2.1.0.";s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"multiGet";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\caching\Cache";s:10:"sourceCode";s:832:"public function multiGet($keys)
{
    $keyMap = [];
    foreach ($keys as $key) {
        $keyMap[$key] = $this->buildKey($key);
    }
    $values = $this->getValues(array_values($keyMap));
    $results = [];
    foreach ($keyMap as $key => $newKey) {
        $results[$key] = false;
        if (isset($values[$newKey])) {
            if ($this->serializer === false) {
                $results[$key] = $values[$newKey];
            } else {
                $value = $this->serializer === null ? unserialize($values[$newKey])
                    : call_user_func($this->serializer[1], $values[$newKey]);
                if (is_array($value) && !($value[1] instanceof Dependency && $value[1]->isChanged($this))) {
                    $results[$key] = $value[0];
                }
            }
        }
    }
    return $results;
}
