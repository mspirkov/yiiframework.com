";s:6:"params";a:0:{}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:21:"if [[db]] is invalid.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\caching";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:6:{s:3:"Yii";s:3:"Yii";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:10:"Connection";s:17:"yii\db\Connection";s:8:"PdoValue";s:15:"yii\db\PdoValue";s:5:"Query";s:12:"yii\db\Query";s:8:"Instance";s:15:"yii\di\Instance";}}s:4:"name";s:4:"init";s:8:"fullName";s:25:"yii\caching\DbCache::init";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/DbCache.php";s:9:"startLine";i:95;s:7:"endLine";i:99;s:16:"shortDescription";s:34:"Initializes the DbCache component.";s:11:"description";s:96:"This method will initialize the [[db]] property to make sure it refers to a valid DB connection.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"exists";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\caching\DbCache";s:10:"sourceCode";s:625:"public function exists($key)
{
    $key = $this->buildKey($key);
    $query = new Query();
    $query->select(['COUNT(*)'])
        ->from($this->cacheTable)
        ->where('[[id]] = :id AND ([[expire]] = 0 OR [[expire]] >' . time() . ')', [':id' => $key]);
    if ($this->db->enableQueryCache) {
        // temporarily disable and re-enable query caching
        $this->db->enableQueryCache = false;
        $result = $query->createCommand($this->db)->queryScalar();
        $this->db->enableQueryCache = true;
    } else {
        $result = $query->createCommand($this->db)->queryScalar();
    }
    return $result > 0;
}
";s:6:"params";a:1:{s:4:"$key";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:4:"$key";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:135:"A key identifying the cached value. This can be a simple string or
a complex data structure consisting of factors representing the key.";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/DbCache.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:83:"True if a value exists in cache, false if the value is not in the cache or expired.";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:121881;s:4:"name";s:6:"exists";s:8:"fullName";s:27:"yii\caching\DbCache::exists";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/DbCache.php";s:9:"startLine";i:111;s:7:"endLine";i:129;s:16:"shortDescription";s:51:"Checks whether a specified key exists in the cache.";s:11:"description";s:264:"This can be faster than getting the value from the cache if the data is big.
Note that this method does not check whether the dependency associated
with the cached data, if there is any, has changed. So a call to [[get]]
may return false while exists returns true.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"getValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\caching\DbCache";s:10:"sourceCode";s:591:"protected function getValue($key)
{
    $query = new Query();
    $query->select([$this->getDataFieldName()])
        ->from($this->cacheTable)
        ->where('[[id]] = :id AND ([[expire]] = 0 OR [[expire]] >' . time() . ')', [':id' => $key]);
    if ($this->db->enableQueryCache) {
        // temporarily disable and re-enable query caching
        $this->db->enableQueryCache = false;
        $result = $query->createCommand($this->db)->queryScalar();
        $this->db->enableQueryCache = true;
        return $result;
    }
    return $query->createCommand($this->db)->queryScalar();
}
";s:6:"params";a:1:{s:4:"$key";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:4:"$key";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:41:"A unique key identifying the cached value";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/DbCache.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:77:"The value stored in cache, false if the value is not in the cache or expired.";s:10:"returnType";s:12:"string|false";s:11:"returnTypes";a:2:{i:0;s:6:"string";i:1;s:5:"false";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:121881;s:4:"name";s:8:"getValue";s:8:"fullName";s:29:"yii\caching\DbCache::getValue";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/DbCache.php";s:9:"startLine";i:137;s:7:"endLine";i:153;s:16:"shortDescription";s:50:"Retrieves a value from cache with a specified key.";s:11:"description";s:70:"This is the implementation of the method declared in the parent class.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"getValues";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\caching\DbCache";s:10:"sourceCode";s:957:"protected function getValues($keys)
{
    if (empty($keys)) {
        return [];
    }
    $query = new Query();
    $query->select(['id', $this->getDataFieldName()])
        ->from($this->cacheTable)
        ->where(['id' => $keys])
        ->andWhere('([[expire]] = 0 OR [[expire]] > ' . time() . ')');
    if ($this->db->enableQueryCache) {
        $this->db->enableQueryCache = false;
        $rows = $query->createCommand($this->db)->queryAll();
        $this->db->enableQueryCache = true;
    } else {
        $rows = $query->createCommand($this->db)->queryAll();
    }
    $results = [];
    foreach ($keys as $key) {
        $results[$key] = false;
    }
    foreach ($rows as $row) {
        if (is_resource($row['data']) && get_resource_type($row['data']) === 'stream') {
            $results[$row['id']] = stream_get_contents($row['data']);
        } else {
            $results[$row['id']] = $row['data'];
        }
    }
    return $results;
}
";s:6:"params";a:1:{s:5:"$keys";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$keys";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:44:"A list of keys identifying the cached values";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/DbCache.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:43:"A list of cached values indexed by the keys";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:121881;s:4:"name";s:9:"getValues";s:8:"fullName";s:30:"yii\caching\DbCache::getValues";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/DbCache.php";s:9:"startLine";i:160;s:7:"endLine";i:192;s:16:"shortDescription";s:61:"Retrieves multiple values from cache with the specified keys.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"setValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\caching\DbCache";s:10:"sourceCode";s:606:"protected function setValue($key, $value, $duration)
{
    try {
        $this->db->noCache(function (Connection $db) use ($key, $value, $duration) {
            $db->createCommand()->upsert($this->cacheTable, [
                'id' => $key,
                'expire' => $duration > 0 ? $duration + time() : 0,
                'data' => $this->getDataFieldValue($value),
            ])->execute();
        });
        $this->gc();
        return true;
    } catch (\Exception $e) {
        Yii::warning("Unable to update or insert cache data: {$e->getMessage()}", __METHOD__);
        return false;
    }
}
";s:6:"params";a:3:{s:4:"$key";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:4:"$key";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:42:"The key identifying the value to be cached";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/DbCache.php";}s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:90:"The value to be cached. Other types (if you have disabled [[serializer]]) cannot be saved.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/DbCache.php";}s:9:"$duration";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$duration";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:82:"The number of seconds in which the cached value will expire. 0 means never expire.";s:4:"type";s:3:"int";s:5:"types";a:1:{i:0;s:3:"int";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/DbCache.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:68:"True if the value is successfully stored into cache, false otherwise";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:121881;s:4:"name";s:8:"setValue";s:8:"fullName";s:29:"yii\caching\DbCache::setValue";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/DbCache.php";s:9:"startLine";i:203;s:7:"endLine";i:222;s:16:"shortDescription";s:44:"Stores a value identified by a key in cache.";s:11:"description";s:70:"This is the implementation of the method declared in the parent class.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"addValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\caching\DbCache";s:10:"sourceCode";s:625:"protected function addValue($key, $value, $duration)
{
    $this->gc();
    try {
        $this->db->noCache(function (Connection $db) use ($key, $value, $duration) {
            $db->createCommand()
                ->insert($this->cacheTable, [
                    'id' => $key,
                    'expire' => $duration > 0 ? $duration + time() : 0,
                    'data' => $this->getDataFieldValue($value),
                ])->execute();
        });
        return true;
    } catch (\Exception $e) {
        Yii::warning("Unable to insert cache data: {$e->getMessage()}", __METHOD__);
        return false;
    }
}
