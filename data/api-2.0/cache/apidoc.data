{
    if ($this->value === null) {
        $request = Yii::$app->getRequest();
        $lock = $this->getLockAttribute();
        $formName = $this->owner->formName();
        $formValue = $formName ? ArrayHelper::getValue($request->getBodyParams(), $formName . '.' . $lock) : null;
        $input = $formValue ?: $request->getBodyParam($lock);
        $isValid = $input && (new NumberValidator())->validate($input);
        return $isValid ? $input : 0;
    }
    return parent::getValue($event);
}
";s:6:"params";a:1:{s:6:"$event";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$event";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:111:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/behaviors/OptimisticLockBehavior.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:30911;s:4:"name";s:8:"getValue";s:8:"fullName";s:46:"yii\behaviors\OptimisticLockBehavior::getValue";s:10:"sourceFile";s:111:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/behaviors/OptimisticLockBehavior.php";s:9:"startLine";i:139;s:7:"endLine";i:152;s:16:"shortDescription";s:0:"";s:11:"description";s:109:"In case of `null`, value will be parsed from [[\yii\web\Request::getBodyParam()|getBodyParam()]] or set to 0.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:7:"upgrade";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:36:"yii\behaviors\OptimisticLockBehavior";s:10:"sourceCode";s:372:"public function upgrade()
{
    /** @var BaseActiveRecord $owner */
    $owner = $this->owner;
    if ($owner->getIsNewRecord()) {
        throw new InvalidCallException('Upgrading the model version is not possible on a new record.');
    }
    $lock = $this->getLockAttribute();
    $version = $owner->$lock ?: 0;
    $owner->updateAttributes([$lock => $version + 1]);
}
