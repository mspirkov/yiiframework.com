ultiple data models.";s:11:"description";s:106:"For more details and usage information on ActiveForm, see the [guide article on forms](guide:input-forms).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:23:"yii\widgets\ActiveField";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:18:"yii\base\Component";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:28:{s:10:"__toString";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\widgets\ActiveField";s:10:"sourceCode";s:377:"public function __toString()
{
    // __toString cannot throw exception
    // use trigger_error to bypass this limitation
    try {
        return $this->render();
    } catch (\Throwable $e) {
        if (PHP_VERSION_ID < 70400) {
            trigger_error(ErrorHandler::convertExceptionToString($e), E_USER_ERROR);
            return '';
        }
        throw $e;
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:41:"The string representation of this object.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\widgets";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:7:{s:3:"Yii";s:3:"Yii";s:9:"Component";s:18:"yii\base\Component";s:12:"ErrorHandler";s:21:"yii\base\ErrorHandler";s:5:"Model";s:14:"yii\base\Model";s:11:"ArrayHelper";s:23:"yii\helpers\ArrayHelper";s:4:"Html";s:16:"yii\helpers\Html";s:12:"JsExpression";s:20:"yii\web\JsExpression";}}s:4:"name";s:10:"__toString";s:8:"fullName";s:35:"yii\widgets\ActiveField::__toString";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveField.php";s:9:"startLine";i:171;s:7:"endLine";i:186;s:16:"shortDescription";s:71:"PHP magic method that returns the string representation of this object.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"render";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\widgets\ActiveField";s:10:"sourceCode";s:639:"public function render($content = null)
{
    if ($content === null) {
        if (!isset($this->parts['{input}'])) {
            $this->textInput();
        }
        if (!isset($this->parts['{label}'])) {
            $this->label();
        }
        if (!isset($this->parts['{error}'])) {
            $this->error();
        }
        if (!isset($this->parts['{hint}'])) {
            $this->hint(null);
        }
        $content = strtr($this->template, $this->parts);
    } elseif (!is_string($content)) {
        $content = call_user_func($content, $this);
    }
    return $this->begin() . "\n" . $content . "\n" . $this->end();
}
";s:6:"params";a:1:{s:8:"$content";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$content";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:320:"The content within the field container.
If `null` (not set), the default methods will be called to generate the label, error tag and input tag,
and use them as the content.
If a callable, it will be called to generate the content. The signature of the callable should be:

```
function ($field) {
    return $html;
}
```";s:4:"type";s:20:"string|callable|null";s:5:"types";a:3:{i:0;s:6:"string";i:1;s:8:"callable";i:2;s:4:"null";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveField.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:21:"The rendering result.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:22694;s:4:"name";s:6:"render";s:8:"fullName";s:31:"yii\widgets\ActiveField::render";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveField.php";s:9:"startLine";i:205;s:7:"endLine";i:226;s:16:"shortDescription";s:24:"Renders the whole field.";s:11:"description";s:135:"This method will generate the label, error tag, input tag and hint tag (if any), and
assemble them into HTML according to [[template]].";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:5:"begin";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\widgets\ActiveField";s:10:"sourceCode";s:864:"public function begin()
{
    if ($this->form->enableClientScript) {
        $clientOptions = $this->getClientOptions();
        if (!empty($clientOptions)) {
            $this->form->attributes[] = $clientOptions;
        }
    }
    $inputID = $this->getInputId();
    $attribute = Html::getAttributeName($this->attribute);
    $options = $this->options;
    $class = isset($options['class']) ? (array) $options['class'] : [];
    $class[] = "field-$inputID";
    if ($this->model->isAttributeRequired($attribute)) {
        $class[] = $this->form->requiredCssClass;
    }
    $options['class'] = implode(' ', $class);
    if ($this->form->validationStateOn === ActiveForm::VALIDATION_STATE_ON_CONTAINER) {
        $this->addErrorClassIfNeeded($options);
    }
    $tag = ArrayHelper::remove($options, 'tag', 'div');
    return Html::beginTag($tag, $options);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:21:"The rendering result.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:22694;s:4:"name";s:5:"begin";s:8:"fullName";s:30:"yii\widgets\ActiveField::begin";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveField.php";s:9:"startLine";i:232;s:7:"endLine";i:256;s:16:"shortDescription";s:47:"Renders the opening tag of the field container.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:3:"end";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\widgets\ActiveField";s:10:"sourceCode";s:130:"public function end()
{
    return Html::endTag(ArrayHelper::keyExists('tag', $this->options) ? $this->options['tag'] : 'div');
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:21:"The rendering result.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:22694;s:4:"name";s:3:"end";s:8:"fullName";s:28:"yii\widgets\ActiveField::end";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveField.php";s:9:"startLine";i:262;s:7:"endLine";i:265;s:16:"shortDescription";s:47:"Renders the closing tag of the field container.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:5:"label";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\widgets\ActiveField";s:10:"sourceCode";s:457:"public function label($label = null, $options = [])
{
    if ($label === false) {
        $this->parts['{label}'] = '';
        return $this;
    }
    $options = array_merge($this->labelOptions, $options);
    if ($label !== null) {
        $options['label'] = $label;
    }
    if ($this->_skipLabelFor) {
        $options['for'] = null;
    }
    $this->parts['{label}'] = Html::activeLabel($this->model, $this->attribute, $options);
    return $this;
}
