If this is null, the validators for ALL attributes in the model will be returned.";s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Model.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:54:"The validators applicable to the current [[scenario]].";s:10:"returnType";s:27:"\yii\validators\Validator[]";s:11:"returnTypes";a:1:{i:0;s:27:"\yii\validators\Validator[]";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:83412;s:4:"name";s:19:"getActiveValidators";s:8:"fullName";s:35:"yii\base\Model::getActiveValidators";s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Model.php";s:9:"startLine";i:481;s:7:"endLine";i:502;s:16:"shortDescription";s:62:"Returns the validators applicable to the current [[scenario]].";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"createValidators";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:14:"yii\base\Model";s:10:"sourceCode";s:642:"public function createValidators()
{
    $validators = new ArrayObject();
    foreach ($this->rules() as $rule) {
        if ($rule instanceof Validator) {
            $validators->append($rule);
        } elseif (is_array($rule) && isset($rule[0], $rule[1])) { // attributes, validator type
            $validator = Validator::createValidator($rule[1], $this, (array) $rule[0], array_slice($rule, 2));
            $validators->append($validator);
        } else {
            throw new InvalidConfigException('Invalid validation rule: a rule must specify both attribute names and validator type.');
        }
    }
    return $validators;
}
