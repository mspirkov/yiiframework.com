";s:6:"params";a:1:{s:10:"$exception";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$exception";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:40:"The exception to convert to a PHP error.";s:4:"type";s:10:"\Throwable";s:5:"types";a:1:{i:0;s:10:"\Throwable";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/ErrorHandler.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:0:"";s:10:"returnType";s:5:"never";s:11:"returnTypes";a:1:{i:0;s:5:"never";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:80701;s:4:"name";s:23:"convertExceptionToError";s:8:"fullName";s:46:"yii\base\ErrorHandler::convertExceptionToError";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/ErrorHandler.php";s:9:"startLine";i:393;s:7:"endLine";i:396;s:16:"shortDescription";s:39:"Converts an exception into a PHP error.";s:11:"description";s:149:"This method can be used to convert exceptions inside of methods like `__toString()`
to PHP errors because exceptions cannot be thrown inside of them.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";s:293:"since 2.0.53. Use conditional exception throwing in `__toString()` methods instead.
For PHP < 7.4: use `trigger_error()` directly with `convertExceptionToString()` method.
For PHP >= 7.4: throw the exception directly as `__toString()` supports exceptions.
This method will be removed in 2.2.0.";s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:24:"convertExceptionToString";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\base\ErrorHandler";s:10:"sourceCode";s:331:"public static function convertExceptionToString($exception)
{
    if ($exception instanceof UserException) {
        return "{$exception->getName()}: {$exception->getMessage()}";
    }
    if (YII_DEBUG) {
        return static::convertExceptionToVerboseString($exception);
    }
    return 'An internal server error occurred.';
}
