dler.php";}s:6:"$index";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$index";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:33:"Number of the call stack element.";s:4:"type";s:3:"int";s:5:"types";a:1:{i:0;s:3:"int";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/ErrorHandler.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:48:"HTML content of the rendered call stack element.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:105245;s:4:"name";s:19:"renderCallStackItem";s:8:"fullName";s:41:"yii\web\ErrorHandler::renderCallStackItem";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/ErrorHandler.php";s:9:"startLine";i:301;s:7:"endLine";i:328;s:16:"shortDescription";s:36:"Renders a single call stack element.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:15:"renderCallStack";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\web\ErrorHandler";s:10:"sourceCode";s:864:"public function renderCallStack($exception)
{
    $out = '<ul>';
    $out .= $this->renderCallStackItem($exception->getFile(), $exception->getLine(), null, null, [], 1);
    for ($i = 0, $trace = $exception->getTrace(), $length = count($trace); $i < $length; ++$i) {
        $file = !empty($trace[$i]['file']) ? $trace[$i]['file'] : null;
        $line = !empty($trace[$i]['line']) ? $trace[$i]['line'] : null;
        $class = !empty($trace[$i]['class']) ? $trace[$i]['class'] : null;
        $function = null;
        if (!empty($trace[$i]['function']) && $trace[$i]['function'] !== 'unknown') {
            $function = $trace[$i]['function'];
        }
        $args = !empty($trace[$i]['args']) ? $trace[$i]['args'] : [];
        $out .= $this->renderCallStackItem($file, $line, $class, $function, $args, $i + 2);
    }
    $out .= '</ul>';
    return $out;
}
";s:6:"params";a:1:{s:10:"$exception";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$exception";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:32:"Exception to get call stack from";s:4:"type";s:10:"\Throwable";s:5:"types";a:1:{i:0;s:10:"\Throwable";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/ErrorHandler.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:40:"HTML content of the rendered call stack.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:105245;s:4:"name";s:15:"renderCallStack";s:8:"fullName";s:37:"yii\web\ErrorHandler::renderCallStack";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/ErrorHandler.php";s:9:"startLine";i:336;s:7:"endLine";i:353;s:16:"shortDescription";s:19:"Renders call stack.";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.12";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"renderRequest";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\web\ErrorHandler";s:10:"sourceCode";s:320:"public function renderRequest()
{
    $request = '';
    foreach ($this->displayVars as $name) {
        if (!empty($GLOBALS[$name])) {
            $request .= '$' . $name . ' = ' . VarDumper::export($GLOBALS[$name]) . ";\n\n";
        }
    }
    return '<pre>' . $this->htmlEncode(rtrim($request, "\n")) . '</pre>';
}
