- `myapp` - will be ignored only `myapp` category;
- `myapp*` - will be ignored by all categories beginning with `myapp` (`myapp`, `myapplication`, `myapprove`, `myapp/widgets`, `myapp.widgets`, etc).";s:5:"since";s:5:"2.0.7";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"tokensEqual";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:41:"yii\console\controllers\MessageController";s:10:"sourceCode";s:236:"protected function tokensEqual($a, $b)
{
    if (is_string($a) && is_string($b)) {
        return $a === $b;
    }
    if (isset($a[0], $a[1], $b[0], $b[1])) {
        return $a[0] === $b[0] && $a[1] == $b[1];
    }
    return false;
}
