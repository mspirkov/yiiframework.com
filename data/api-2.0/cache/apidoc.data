";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:79346;s:4:"name";s:15:"attributeLabels";s:8:"fullName";s:38:"yii\base\DynamicModel::attributeLabels";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/DynamicModel.php";s:9:"startLine";i:300;s:7:"endLine";i:303;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}}s:10:"properties";a:0:{}s:9:"namespace";s:8:"yii\base";s:13:"phpDocContext";r:79346;s:4:"name";s:21:"yii\base\DynamicModel";s:8:"fullName";s:21:"yii\base\DynamicModel";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/DynamicModel.php";s:9:"startLine";i:54;s:7:"endLine";i:304;s:16:"shortDescription";s:220:"DynamicModel is a model class that supports defining attributes at run-time (the so-called
"dynamic attributes") using its constructor or [[defineAttribute()]]. DynamicModel can be used
to support ad hoc data validation.";s:11:"description";s:1137:"The typical usage of DynamicModel is as follows,

```
public function actionSearch($name, $email)
{
    $model = DynamicModel::validateData(compact('name', 'email'), [
        [['name', 'email'], 'string', 'max' => 128],
        ['email', 'email'],
    ]);
    if ($model->hasErrors()) {
        // validation fails
    } else {
        // validation succeeds
    }
}
```

The above example shows how to validate `$name` and `$email` with the help of DynamicModel.
The [[validateData()]] method creates an instance of DynamicModel, defines the attributes
using the given data (`name` and `email` in this example), and then calls [[Model::validate()]].

You can check the validation result using [[hasErrors()]], like you do with a normal model.
You may also access the dynamic attributes defined through the model instance, e.g.,
`$model->name` and `$model->email`.

Alternatively, you may use the following more "classic" syntax to perform ad-hoc data validation:

```
$model = new DynamicModel(compact('name', 'email'));
$model->addRule(['name', 'email'], 'string', ['max' => 128])
    ->addRule('email', 'email')
    ->validate();
```";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"yii\base\Behavior";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:19:"yii\base\BaseObject";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:3:{s:6:"events";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\base\Behavior";s:10:"sourceCode";s:44:"public function events()
{
    return [];
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:79:"Events (array keys) and the corresponding event handler methods (array values).";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:8:"yii\base";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:0:{}}s:4:"name";s:6:"events";s:8:"fullName";s:25:"yii\base\Behavior::events";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Behavior.php";s:9:"startLine";i:69;s:7:"endLine";i:72;s:16:"shortDescription";s:51:"Declares event handlers for the [[owner]]'s events.";s:11:"description";s:741:"Child classes may override this method to declare what PHP callbacks should
be attached to the events of the [[owner]] component.

The callbacks will be attached to the [[owner]]'s events when the behavior is
attached to the owner; and they will be detached from the events when
the behavior is detached from the component.

The callbacks can be any of the following:

- method in this behavior: `'handleClick'`, equivalent to `[$this, 'handleClick']`
- object method: `[$object, 'handleClick']`
- static method: `['Page', 'handleClick']`
- anonymous function: `function ($event) { ... }`

The following is an example:

```
[
    Model::EVENT_BEFORE_VALIDATE => 'myBeforeValidate',
    Model::EVENT_AFTER_VALIDATE => 'myAfterValidate',
]
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"attach";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\base\Behavior";s:10:"sourceCode";s:253:"public function attach($owner)
{
    $this->owner = $owner;
    foreach ($this->events() as $event => $handler) {
        $this->_attachedEvents[$event] = $handler;
        $owner->on($event, is_string($handler) ? [$this, $handler] : $handler);
    }
}
";s:6:"params";a:1:{s:6:"$owner";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$owner";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:54:"The component that this behavior is to be attached to.";s:4:"type";s:19:"\yii\base\Component";s:5:"types";a:1:{i:0;s:19:"\yii\base\Component";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Behavior.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:80097;s:4:"name";s:6:"attach";s:8:"fullName";s:25:"yii\base\Behavior::attach";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Behavior.php";s:9:"startLine";i:84;s:7:"endLine";i:91;s:16:"shortDescription";s:46:"Attaches the behavior object to the component.";s:11:"description";s:185:"The default implementation will set the [[owner]] property
and attach event handlers as declared in [[events]].
Make sure you call the parent implementation if you override this method.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:1;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:13:"phpstan-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:8:"T $owner";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:2;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:11:"psalm-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:8:"T $owner";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:6:"detach";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\base\Behavior";s:10:"sourceCode";s:291:"public function detach()
{
    if ($this->owner) {
        foreach ($this->_attachedEvents as $event => $handler) {
            $this->owner->off($event, is_string($handler) ? [$this, $handler] : $handler);
        }
        $this->_attachedEvents = [];
        $this->owner = null;
    }
}
