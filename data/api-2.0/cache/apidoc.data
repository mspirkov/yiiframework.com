er.php";s:9:"startLine";i:197;s:7:"endLine";i:228;s:16:"shortDescription";s:28:"Builds SQL for IN condition.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"getNullCondition";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:36:"yii\db\conditions\InConditionBuilder";s:10:"sourceCode";s:255:"protected function getNullCondition($operator, $column)
{
    $column = $this->queryBuilder->db->quoteColumnName($column);
    if ($operator === 'IN') {
        return sprintf('%s IS NULL', $column);
    }
    return sprintf('%s IS NOT NULL', $column);
}
