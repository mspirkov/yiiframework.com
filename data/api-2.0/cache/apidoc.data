itdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:9:"challenge";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:30:"yii\filters\auth\HttpBasicAuth";s:10:"sourceCode";s:129:"public function challenge($response)
{
    $response->getHeaders()->set('WWW-Authenticate', "Basic realm=\"{$this->realm}\"");
}
";s:6:"params";a:1:{s:9:"$response";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$response";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:105:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/auth/HttpBasicAuth.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:47341;s:4:"name";s:9:"challenge";s:8:"fullName";s:41:"yii\filters\auth\HttpBasicAuth::challenge";s:10:"sourceFile";s:105:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/auth/HttpBasicAuth.php";s:9:"startLine";i:129;s:7:"endLine";i:132;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}}s:10:"properties";a:2:{s:6:"$realm";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:12:"defaultValue";s:5:"'api'";s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:30:"yii\filters\auth\HttpBasicAuth";s:13:"phpDocContext";r:47341;s:4:"name";s:6:"$realm";s:8:"fullName";s:38:"yii\filters\auth\HttpBasicAuth::$realm";s:10:"sourceFile";s:105:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/auth/HttpBasicAuth.php";s:9:"startLine";i:70;s:7:"endLine";i:70;s:16:"shortDescription";s:29:"The HTTP authentication realm";s:11:"description";s:29:"The HTTP authentication realm";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:29:"the HTTP authentication realm";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:5:"$auth";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:13:"callable|null";s:5:"types";a:2:{i:0;s:8:"callable";i:1;s:4:"null";}s:12:"defaultValue";N;s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:30:"yii\filters\auth\HttpBasicAuth";s:13:"phpDocContext";r:47341;s:4:"name";s:5:"$auth";s:8:"fullName";s:37:"yii\filters\auth\HttpBasicAuth::$auth";s:10:"sourceFile";s:105:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/auth/HttpBasicAuth.php";s:9:"startLine";i:92;s:7:"endLine";i:92;s:16:"shortDescription";s:84:"A PHP callable that will authenticate the user with the HTTP basic auth information.";s:11:"description";s:819:"A PHP callable that will authenticate the user with the HTTP basic auth information.
The callable receives a username and a password as its parameters. It should return an identity object
that matches the username and password. Null should be returned if there is no such identity.
The callable will be called only if current user is not authenticated.

The following code is a typical implementation of this callable:

```
function ($username, $password) {
    return \app\models\User::findOne([
        'username' => $username,
        'password' => $password,
    ]);
}
```

If this property is not set, the username information will be considered as an access token
while the password information will be ignored. The [[\yii\web\User::loginByAccessToken()]]
method will be called to authenticate and login the user.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:40:"phpDocumentor\Reflection\Types\Callable_":2:{s:52:"␀phpDocumentor\Reflection\Types\Callable_␀returnType";N;s:52:"␀phpDocumentor\Reflection\Types\Callable_␀parameters";a:0:{}}i:1;O:36:"phpDocumentor\Reflection\Types\Null_":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:819:"a PHP callable that will authenticate the user with the HTTP basic auth information.
The callable receives a username and a password as its parameters. It should return an identity object
that matches the username and password. Null should be returned if there is no such identity.
The callable will be called only if current user is not authenticated.

The following code is a typical implementation of this callable:

```
function ($username, $password) {
    return \app\models\User::findOne([
        'username' => $username,
        'password' => $password,
    ]);
}
```

If this property is not set, the username information will be considered as an access token
while the password information will be ignored. The [[\yii\web\User::loginByAccessToken()]]
method will be called to authenticate and login the user.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:16:"yii\filters\auth";s:13:"phpDocContext";r:47341;s:4:"name";s:30:"yii\filters\auth\HttpBasicAuth";s:8:"fullName";s:30:"yii\filters\auth\HttpBasicAuth";s:10:"sourceFile";s:105:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/auth/HttpBasicAuth.php";s:9:"startLine";i:65;s:7:"endLine";i:133;s:16:"shortDescription";s:85:"HttpBasicAuth is an action filter that supports the HTTP Basic authentication method.";s:11:"description";s:1461:"You may use HttpBasicAuth by attaching it as a behavior to a controller or module, like the following:

```
public function behaviors()
{
    return [
        'basicAuth' => [
            'class' => \yii\filters\auth\HttpBasicAuth::class,
        ],
    ];
}
```

The default implementation of HttpBasicAuth uses the [[\yii\web\User::loginByAccessToken()|loginByAccessToken()]]
method of the `user` application component and only passes the user name. This implementation is used
for authenticating API clients.

If you want to authenticate users using username and password, you should provide the [[auth]] function for example like the following:

```
public function behaviors()
{
    return [
        'basicAuth' => [
            'class' => \yii\filters\auth\HttpBasicAuth::class,
            'auth' => function ($username, $password) {
                $user = User::find()->where(['username' => $username])->one();
                if ($user && $user->validatePassword($password)) {
                    return $user;
                }
                return null;
            },
        ],
    ];
}
```

> Tip: In case authentication does not work like expected, make sure your web server passes
username and password to `$_SERVER['PHP_AUTH_USER']` and `$_SERVER['PHP_AUTH_PW']` variables.
If you are using Apache with PHP-CGI, you might need to add this line to your `.htaccess` file:
```
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization},L]
```";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:2;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Template":5:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀templateName";s:1:"T";s:54:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀bound";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:19:"\yii\base\Component";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:9:"Component";}}s:56:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀default";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:7:"␀*␀name";s:8:"template";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:3;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Extends_":3:{s:7:"␀*␀type";O:41:"phpDocumentor\Reflection\Types\Collection":4:{s:48:"␀phpDocumentor\Reflection\Types\Collection␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:28:"\yii\filters\auth\AuthMethod";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:10:"AuthMethod";}s:12:"␀*␀valueType";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:19:"\yii\filters\auth\T";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:1:"T";}}s:10:"␀*␀keyType";N;s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}s:7:"␀*␀name";s:7:"extends";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:31:"yii\filters\auth\HttpHeaderAuth";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:27:"yii\filters\auth\AuthMethod";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:2:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";s:13:"Benoît Boure";s:22:"benoit.boure@gmail.com";}s:7:"methods";a:1:{s:12:"authenticate";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:31:"yii\filters\auth\HttpHeaderAuth";s:10:"sourceCode";s:637:"public function authenticate($user, $request, $response)
{
    $authHeader = $request->getHeaders()->get($this->header);
    if ($authHeader !== null) {
        if ($this->pattern !== null) {
            if (preg_match($this->pattern, $authHeader, $matches)) {
                $authHeader = $matches[1];
            } else {
                return null;
            }
        }
        $identity = $user->loginByAccessToken($authHeader, get_class($this));
        if ($identity === null) {
            $this->challenge($response);
            $this->handleFailure($response);
        }
        return $identity;
    }
    return null;
}
