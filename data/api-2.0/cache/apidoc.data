{
    $parts = $this->buildExpressionsFrom($condition, $params);
    if (empty($parts)) {
        return '';
    }
    if (count($parts) === 1) {
        return reset($parts);
    }
    return '(' . implode(") {$condition->getOperator()} (", $parts) . ')';
}
