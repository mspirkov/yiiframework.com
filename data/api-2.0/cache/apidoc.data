* a Validator.";s:4:"type";s:41:"string|\yii\validators\Validator|\Closure";s:5:"types";a:3:{i:0;s:6:"string";i:1;s:25:"\yii\validators\Validator";i:2;s:8:"\Closure";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/DynamicModel.php";}s:8:"$options";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$options";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:62:"The options (name-value pairs) to be applied to the validator.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/DynamicModel.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:0:"";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:79346;s:4:"name";s:7:"addRule";s:8:"fullName";s:30:"yii\base\DynamicModel::addRule";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/DynamicModel.php";s:9:"startLine";i:199;s:7:"endLine";i:213;s:16:"shortDescription";s:37:"Adds a validation rule to this model.";s:11:"description";s:115:"You can also directly manipulate [[validators]] to add or remove validation rules.
This method provides a shortcut.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:12:"validateData";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\base\DynamicModel";s:10:"sourceCode";s:949:"public static function validateData(array $data, $rules = [])
{
    /** @var static $model */
    $model = new static($data);
    if (!empty($rules)) {
        $validators = $model->getValidators();
        foreach ($rules as $rule) {
            if ($rule instanceof Validator) {
                $validators->append($rule);
                $model->defineAttributesByValidator($rule);
            } elseif (is_array($rule) && isset($rule[0], $rule[1])) { // attributes, validator type
                $validator = Validator::createValidator($rule[1], $model, (array)$rule[0], array_slice($rule, 2));
                $validators->append($validator);
                $model->defineAttributesByValidator($validator);
            } else {
                throw new InvalidConfigException('Invalid validation rule: a rule must specify both attribute names and validator type.');
            }
        }
    }
    $model->validate();
    return $model;
}
