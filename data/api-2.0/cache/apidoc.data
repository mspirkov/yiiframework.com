{
    if ($force || random_int(0, 1000000) < $this->gcProbability) {
        $this->gcRecursive($this->cachePath, $expiredOnly);
    }
}
";s:6:"params";a:2:{s:6:"$force";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$force";s:10:"isOptional";b:1;s:12:"defaultValue";s:5:"false";s:19:"isPassedByReference";b:0;s:11:"description";s:185:"Whether to enforce the garbage collection regardless of [[gcProbability]].
Defaults to false, meaning the actual deletion happens with the probability as specified by [[gcProbability]].";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/FileCache.php";}s:12:"$expiredOnly";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:12:"$expiredOnly";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"true";s:19:"isPassedByReference";b:0;s:11:"description";s:107:"Whether to removed expired cache files only.
If false, all cache files under [[cachePath]] will be removed.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/FileCache.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:124459;s:4:"name";s:2:"gc";s:8:"fullName";s:25:"yii\caching\FileCache::gc";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/FileCache.php";s:9:"startLine";i:257;s:7:"endLine";i:262;s:16:"shortDescription";s:28:"Removes expired cache files.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"gcRecursive";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:21:"yii\caching\FileCache";s:10:"sourceCode";s:1255:"protected function gcRecursive($path, $expiredOnly)
{
    if (($handle = opendir($path)) !== false) {
        while (($file = readdir($handle)) !== false) {
            if (strncmp($file, '.', 1) === 0) {
                continue;
            }
            $fullPath = $path . DIRECTORY_SEPARATOR . $file;
            $message = null;
            if (is_dir($fullPath)) {
                $this->gcRecursive($fullPath, $expiredOnly);
                if (!$expiredOnly) {
                    if (!@rmdir($fullPath)) {
                        $message = "Unable to remove directory '$fullPath'";
                        if ($error = error_get_last()) {
                            $message .= ": {$error['message']}";
                        }
                    }
                }
            } elseif (!$expiredOnly || $expiredOnly && @filemtime($fullPath) < time()) {
                if (!@unlink($fullPath)) {
                    $message = "Unable to remove file '$fullPath'";
                    if ($error = error_get_last()) {
                        $message .= ": {$error['message']}";
                    }
                }
            }
            $message and Yii::warning($message, __METHOD__);
        }
        closedir($handle);
    }
}
