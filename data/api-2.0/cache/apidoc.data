processed by [[\yii\helpers\Url::to()]].";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:1;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:19:"\yii\widgets\method";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:6:"method";}}s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:45:"for specifying the HTTP method for this form.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:7:"$method";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:12:"defaultValue";s:6:"'post'";s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:22:"yii\widgets\ActiveForm";s:13:"phpDocContext";r:21287;s:4:"name";s:7:"$method";s:8:"fullName";s:31:"yii\widgets\ActiveForm::$method";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveForm.php";s:9:"startLine";i:60;s:7:"endLine";i:60;s:16:"shortDescription";s:27:"The form submission method.";s:11:"description";s:484:"The form submission method. This should be either `post` or `get`. Defaults to `post`.

When you set this to `get` you may see the url parameters repeated on each request.
This is because the default value of [[action]] is set to be the current request url and each submit
will add new parameters instead of replacing existing ones.
You may set [[action]] explicitly to avoid this:

```
$form = ActiveForm::begin([
    'method' => 'get',
    'action' => ['controller/action'],
]);
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:484:"the form submission method. This should be either `post` or `get`. Defaults to `post`.

When you set this to `get` you may see the url parameters repeated on each request.
This is because the default value of [[action]] is set to be the current request url and each submit
will add new parameters instead of replacing existing ones.
You may set [[action]] explicitly to avoid this:

```
$form = ActiveForm::begin([
    'method' => 'get',
