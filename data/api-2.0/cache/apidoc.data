";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:148:"The declarations of transactional operations. The array keys are scenarios names,
and the array values are the corresponding transaction operations.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:159117;s:4:"name";s:12:"transactions";s:8:"fullName";s:33:"yii\db\ActiveRecord::transactions";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveRecord.php";s:9:"startLine";i:506;s:7:"endLine";i:509;s:16:"shortDescription";s:93:"Declares which DB operations should be performed within a transaction in different scenarios.";s:11:"description";s:867:"The supported DB operations are: [[OP_INSERT]], [[OP_UPDATE]] and [[OP_DELETE]],
which correspond to the [[insert()]], [[update()]] and [[delete()]] methods, respectively.
By default, these methods are NOT enclosed in a DB transaction.

In some scenarios, to ensure data consistency, you may want to enclose some or all of them
in transactions. You can do so by overriding this method and returning the operations
that need to be transactional. For example,

```
return [
    'admin' => self::OP_INSERT,
    'api' => self::OP_INSERT | self::OP_UPDATE | self::OP_DELETE,
    // the above is equivalent to the following:
    // 'api' => self::OP_ALL,

];
```

The above declaration specifies that in the "admin" scenario, the insert operation ([[insert()]])
should be done in a transaction; and in the "api" scenario, all the operations should be done
in a transaction.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"populateRecord";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\db\ActiveRecord";s:10:"sourceCode";s:308:"public static function populateRecord($record, $row)
{
    $columns = static::getTableSchema()->columns;
    foreach ($row as $name => $value) {
        if (isset($columns[$name])) {
            $row[$name] = $columns[$name]->phpTypecast($value);
        }
    }
    parent::populateRecord($record, $row);
}
";s:6:"params";a:2:{s:7:"$record";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$record";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveRecord.php";}s:4:"$row";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:4:"$row";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveRecord.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:159117;s:4:"name";s:14:"populateRecord";s:8:"fullName";s:35:"yii\db\ActiveRecord::populateRecord";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveRecord.php";s:9:"startLine";i:514;s:7:"endLine";i:523;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:6:"insert";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\db\ActiveRecord";s:10:"sourceCode";s:792:"public function insert($runValidation = true, $attributes = null)
{
    if ($runValidation && !$this->validate($attributes)) {
        Yii::info('Model not inserted due to validation error.', __METHOD__);
        return false;
    }
    if (!$this->isTransactional(self::OP_INSERT)) {
        return $this->insertInternal($attributes);
    }
    $transaction = static::getDb()->beginTransaction();
    try {
        $result = $this->insertInternal($attributes);
        if ($result === false) {
            $transaction->rollBack();
        } else {
            $transaction->commit();
        }
        return $result;
    } catch (\Exception $e) {
        $transaction->rollBack();
        throw $e;
    } catch (\Throwable $e) {
        $transaction->rollBack();
        throw $e;
    }
}
