";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:18:"The cache tag name";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:190770;s:4:"name";s:11:"getCacheTag";s:8:"fullName";s:26:"yii\db\Schema::getCacheTag";s:10:"sourceFile";s:88:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Schema.php";s:9:"startLine";i:731;s:7:"endLine";i:738;s:16:"shortDescription";s:27:"Returns the cache tag name.";s:11:"description";s:65:"This allows [[refresh()]] to invalidate all cached table schemas.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"getTableMetadata";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:13:"yii\db\Schema";s:10:"sourceCode";s:875:"protected function getTableMetadata($name, $type, $refresh)
{
    $cache = null;
    if ($this->db->enableSchemaCache && !in_array($name, $this->db->schemaCacheExclude, true)) {
        $schemaCache = is_string($this->db->schemaCache) ? Yii::$app->get($this->db->schemaCache, false) : $this->db->schemaCache;
        if ($schemaCache instanceof CacheInterface) {
            $cache = $schemaCache;
        }
    }
    $rawName = $this->getRawTableName($name);
    if (!isset($this->_tableMetadata[$rawName])) {
        $this->loadTableMetadataFromCache($cache, $rawName);
    }
    if ($refresh || !array_key_exists($type, $this->_tableMetadata[$rawName])) {
        $this->_tableMetadata[$rawName][$type] = $this->{'loadTable' . ucfirst($type)}($rawName);
        $this->saveTableMetadataToCache($cache, $rawName);
    }
    return $this->_tableMetadata[$rawName][$type];
}
