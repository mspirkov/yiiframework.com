about a particular command.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:10:"actionList";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:38:"yii\console\controllers\HelpController";s:10:"sourceCode";s:666:"public function actionList()
{
    foreach ($this->getCommandDescriptions() as $command => $description) {
        $result = Yii::$app->createController($command);
        /**
         * @var Controller $controller
         * @phpstan-var Controller<Application> $controller
         */
        list($controller, $actionID) = $result;
        $actions = $this->getActions($controller);
        $prefix = $controller->getUniqueId();
        if ($controller->createAction($controller->defaultAction) !== null) {
            $this->stdout("$prefix\n");
        }
        foreach ($actions as $action) {
            $this->stdout("$prefix/$action\n");
        }
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:41876;s:4:"name";s:10:"actionList";s:8:"fullName";s:50:"yii\console\controllers\HelpController::actionList";s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/HelpController.php";s:9:"startLine";i:84;s:7:"endLine";i:102;s:16:"shortDescription";s:70:"List all available controllers and actions in machine readable format.";s:11:"description";s:34:"This is used for shell completion.";s:5:"since";s:6:"2.0.11";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:23:"actionListActionOptions";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:38:"yii\console\controllers\HelpController";s:10:"sourceCode";s:980:"public function actionListActionOptions($action)
{
    $result = Yii::$app->createController($action);
    if ($result === false || !($result[0] instanceof Controller)) {
        return;
    }
    /**
     * @var Controller $controller
     * @phpstan-var Controller<Application> $controller
     */
    list($controller, $actionID) = $result;
    $action = $controller->createAction($actionID);
    if ($action === null) {
        return;
    }
    foreach ($controller->getActionArgsHelp($action) as $argument => $help) {
        $description = preg_replace('~\R~', '', addcslashes($help['comment'], ':')) ?: $argument;
        $this->stdout($argument . ':' . $description . "\n");
    }
    $this->stdout("\n");
    foreach ($controller->getActionOptionsHelp($action) as $argument => $help) {
        $description = preg_replace('~\R~', '', addcslashes($help['comment'], ':'));
        $this->stdout('--' . $argument . ($description ? ':' . $description : '') . "\n");
    }
}
";s:6:"params";a:1:{s:7:"$action";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$action";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:15:"Route to action";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/HelpController.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:41876;s:4:"name";s:23:"actionListActionOptions";s:8:"fullName";s:63:"yii\console\controllers\HelpController::actionListActionOptions";s:10:"sourceFile";s:113:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/HelpController.php";s:9:"startLine";i:111;s:7:"endLine";i:139;s:16:"shortDescription";s:70:"List all available options for the $action in machine readable format.";s:11:"description";s:34:"This is used for shell completion.";s:5:"since";s:6:"2.0.11";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"actionUsage";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:38:"yii\console\controllers\HelpController";s:10:"sourceCode";s:1060:"public function actionUsage($action)
{
    $result = Yii::$app->createController($action);
    if ($result === false || !($result[0] instanceof Controller)) {
        return;
    }
    /**
     * @var Controller $controller
     * @phpstan-var Controller<Application> $controller
     */
    list($controller, $actionID) = $result;
    $action = $controller->createAction($actionID);
    if ($action === null) {
        return;
    }
    $scriptName = $this->getScriptName();
    if ($action->id === $controller->defaultAction) {
        $this->stdout($scriptName . ' ' . $this->ansiFormat($controller->getUniqueId(), Console::FG_YELLOW));
    } else {
        $this->stdout($scriptName . ' ' . $this->ansiFormat($action->getUniqueId(), Console::FG_YELLOW));
    }
    foreach ($controller->getActionArgsHelp($action) as $name => $arg) {
        if ($arg['required']) {
            $this->stdout(' <' . $name . '>', Console::FG_CYAN);
        } else {
            $this->stdout(' [' . $name . ']', Console::FG_CYAN);
        }
    }
    $this->stdout("\n");
}
