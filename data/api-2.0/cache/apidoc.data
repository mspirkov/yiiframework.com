{
    return [
        $this->linksEnvelope => Link::serialize($pagination->getLinks(true)),
        $this->metaEnvelope => [
            'totalCount' => $pagination->totalCount,
            'pageCount' => $pagination->getPageCount(),
            'currentPage' => $pagination->getPage() + 1,
            'perPage' => $pagination->getPageSize(),
        ],
    ];
}
