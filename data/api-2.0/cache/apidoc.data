data)
{
    static $typeMap = [
        // php type => PDO type
        'boolean' => \PDO::PARAM_INT, // PARAM_BOOL is not supported by CUBRID PDO
        'integer' => \PDO::PARAM_INT,
        'string' => \PDO::PARAM_STR,
        'resource' => \PDO::PARAM_LOB,
        'NULL' => \PDO::PARAM_NULL,
    ];
    $type = gettype($data);
    return isset($typeMap[$type]) ? $typeMap[$type] : \PDO::PARAM_STR;
}
