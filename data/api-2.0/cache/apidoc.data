";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:22:"Query builder instance";s:10:"returnType";s:26:"\yii\db\pgsql\QueryBuilder";s:11:"returnTypes";a:1:{i:0;s:26:"\yii\db\pgsql\QueryBuilder";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:196321;s:4:"name";s:18:"createQueryBuilder";s:8:"fullName";s:39:"yii\db\pgsql\Schema::createQueryBuilder";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/Schema.php";s:9:"startLine";i:294;s:7:"endLine";i:297;s:16:"shortDescription";s:52:"Creates a query builder for the PostgreSQL database.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"resolveTableNames";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\db\pgsql\Schema";s:10:"sourceCode";s:443:"protected function resolveTableNames($table, $name)
{
    $parts = explode('.', str_replace('"', '', $name));
    if (isset($parts[1])) {
        $table->schemaName = $parts[0];
        $table->name = $parts[1];
    } else {
        $table->schemaName = $this->defaultSchema;
        $table->name = $parts[0];
    }
    $table->fullName = $table->schemaName !== $this->defaultSchema ? $table->schemaName . '.' . $table->name : $table->name;
}
";s:6:"params";a:2:{s:6:"$table";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$table";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:25:"The table metadata object";s:4:"type";s:19:"\yii\db\TableSchema";s:5:"types";a:1:{i:0;s:19:"\yii\db\TableSchema";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/Schema.php";}s:5:"$name";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$name";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:14:"The table name";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:196321;s:4:"name";s:17:"resolveTableNames";s:8:"fullName";s:38:"yii\db\pgsql\Schema::resolveTableNames";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/Schema.php";s:9:"startLine";i:304;s:7:"endLine";i:317;s:16:"shortDescription";s:49:"Resolves the table name and schema name (if any).";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"findViewNames";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\db\pgsql\Schema";s:10:"sourceCode";s:402:"protected function findViewNames($schema = '')
{
    if ($schema === '') {
        $schema = $this->defaultSchema;
    }
    $sql = <<<'SQL'
CT c.relname AS table_name
 pg_class c
R JOIN pg_namespace ns ON ns.oid = c.relnamespace
E ns.nspname = :schemaName AND (c.relkind = 'v' OR c.relkind = 'm')
R BY c.relname

    return $this->db->createCommand($sql, [':schemaName' => $schema])->queryColumn();
}
";s:6:"params";a:1:{s:7:"$schema";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$schema";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"''";s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:196321;s:4:"name";s:13:"findViewNames";s:8:"fullName";s:34:"yii\db\pgsql\Schema::findViewNames";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/Schema.php";s:9:"startLine";i:322;s:7:"endLine";i:335;s:16:"shortDescription";s:13:"{@inheritdoc]";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:15:"findConstraints";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\db\pgsql\Schema";s:10:"sourceCode";s:2150:"protected function findConstraints($table)
{
    $tableName = $this->quoteValue($table->name);
    $tableSchema = $this->quoteValue($table->schemaName);
    //We need to extract the constraints de hard way since:
    //https://www.postgresql.org/message-id/26677.1086673982@sss.pgh.pa.us
    $sql = <<<SQL
ct
ct.conname as constraint_name,
a.attname as column_name,
fc.relname as foreign_table_name,
fns.nspname as foreign_table_schema,
fa.attname as foreign_column_name

(SELECT ct.conname, ct.conrelid, ct.confrelid, ct.conkey, ct.contype, ct.confkey, generate_subscripts(ct.conkey, 1) AS s
   FROM pg_constraint ct
) AS ct
inner join pg_class c on c.oid=ct.conrelid
inner join pg_namespace ns on c.relnamespace=ns.oid
inner join pg_attribute a on a.attrelid=ct.conrelid and a.attnum = ct.conkey[ct.s]
left join pg_class fc on fc.oid=ct.confrelid
left join pg_namespace fns on fc.relnamespace=fns.oid
left join pg_attribute fa on fa.attrelid=ct.confrelid and fa.attnum = ct.confkey[ct.s]
e
ct.contype='f'
and c.relname={$tableName}
and ns.nspname={$tableSchema}
r by
fns.nspname, fc.relname, a.attnum

    $constraints = [];
    foreach ($this->db->createCommand($sql)->queryAll() as $constraint) {
        if ($this->db->slavePdo->getAttribute(\PDO::ATTR_CASE) === \PDO::CASE_UPPER) {
            $constraint = array_change_key_case($constraint, CASE_LOWER);
        }
        if ($constraint['foreign_table_schema'] !== $this->defaultSchema) {
            $foreignTable = $constraint['foreign_table_schema'] . '.' . $constraint['foreign_table_name'];
        } else {
            $foreignTable = $constraint['foreign_table_name'];
        }
        $name = $constraint['constraint_name'];
        if (!isset($constraints[$name])) {
            $constraints[$name] = [
                'tableName' => $foreignTable,
                'columns' => [],
            ];
        }
        $constraints[$name]['columns'][$constraint['column_name']] = $constraint['foreign_column_name'];
    }
    foreach ($constraints as $name => $constraint) {
        $table->foreignKeys[$name] = array_merge([$constraint['tableName']], $constraint['columns']);
    }
}
";s:6:"params";a:1:{s:6:"$table";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$table";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:18:"The table metadata";s:4:"type";s:19:"\yii\db\TableSchema";s:5:"types";a:1:{i:0;s:19:"\yii\db\TableSchema";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:196321;s:4:"name";s:15:"findConstraints";s:8:"fullName";s:36:"yii\db\pgsql\Schema::findConstraints";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/Schema.php";s:9:"startLine";i:341;s:7:"endLine";i:396;s:16:"shortDescription";s:60:"Collects the foreign key column details for the given table.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:25:"getUniqueIndexInformation";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\db\pgsql\Schema";s:10:"sourceCode";s:632:"protected function getUniqueIndexInformation($table)
{
    $sql = <<<'SQL'
CT
i.relname as indexname,
pg_get_indexdef(idx.indexrelid, k + 1, TRUE) AS columnname
 (
LECT *, generate_subscripts(indkey, 1) AS k
OM pg_index
x
R JOIN pg_class i ON i.oid = idx.indexrelid
R JOIN pg_class c ON c.oid = idx.indrelid
R JOIN pg_namespace ns ON c.relnamespace = ns.oid
E idx.indisprimary = FALSE AND idx.indisunique = TRUE
c.relname = :tableName AND ns.nspname = :schemaName
R BY i.relname, k

    return $this->db->createCommand($sql, [
        ':schemaName' => $table->schemaName,
        ':tableName' => $table->name,
    ])->queryAll();
}
";s:6:"params";a:1:{s:6:"$table";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$table";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:18:"The table metadata";s:4:"type";s:19:"\yii\db\TableSchema";s:5:"types";a:1:{i:0;s:19:"\yii\db\TableSchema";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:27:"With index and column names";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:196321;s:4:"name";s:25:"getUniqueIndexInformation";s:8:"fullName";s:46:"yii\db\pgsql\Schema::getUniqueIndexInformation";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/Schema.php";s:9:"startLine";i:403;s:7:"endLine";i:425;s:16:"shortDescription";s:50:"Gets information about given table unique indexes.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"findUniqueIndexes";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\db\pgsql\Schema";s:10:"sourceCode";s:650:"public function findUniqueIndexes($table)
{
    $uniqueIndexes = [];
    foreach ($this->getUniqueIndexInformation($table) as $row) {
        if ($this->db->slavePdo->getAttribute(\PDO::ATTR_CASE) === \PDO::CASE_UPPER) {
            $row = array_change_key_case($row, CASE_LOWER);
        }
        $column = $row['columnname'];
        if (strncmp($column, '"', 1) === 0) {
            // postgres will quote names that are not lowercase-only
            // https://github.com/yiisoft/yii2/issues/10613
            $column = substr($column, 1, -1);
        }
        $uniqueIndexes[$row['indexname']][] = $column;
    }
    return $uniqueIndexes;
}
";s:6:"params";a:1:{s:6:"$table";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$table";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:18:"The table metadata";s:4:"type";s:19:"\yii\db\TableSchema";s:5:"types";a:1:{i:0;s:19:"\yii\db\TableSchema";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:39:"All unique indexes for the given table.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:196321;s:4:"name";s:17:"findUniqueIndexes";s:8:"fullName";s:38:"yii\db\pgsql\Schema::findUniqueIndexes";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/Schema.php";s:9:"startLine";i:442;s:7:"endLine";i:460;s:16:"shortDescription";s:47:"Returns all unique indexes for the given table.";s:11:"description";s:138:"Each array element is of the following structure:

```
[
    'IndexName1' => ['col1' [, ...]],
    'IndexName2' => ['col2' [, ...]],
]
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"findColumns";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\db\pgsql\Schema";s:10:"sourceCode";s:5221:"protected function findColumns($table)
{
    $tableName = $this->db->quoteValue($table->name);
    $schemaName = $this->db->quoteValue($table->schemaName);
    $orIdentity = '';
    if (version_compare($this->db->serverVersion, '12.0', '>=')) {
        $orIdentity = 'OR attidentity != \'\'';
    }
    $sql = <<<SQL
CT
d.nspname AS table_schema,
c.relname AS table_name,
a.attname AS column_name,
COALESCE(td.typname, tb.typname, t.typname) AS data_type,
COALESCE(td.typtype, tb.typtype, t.typtype) AS type_type,
(SELECT nspname FROM pg_namespace WHERE oid = COALESCE(td.typnamespace, tb.typnamespace, t.typnamespace)) AS type_scheme,
a.attlen AS character_maximum_length,
pg_catalog.col_description(c.oid, a.attnum) AS column_comment,
a.atttypmod AS modifier,
a.attnotnull = false AS is_nullable,
CAST(pg_get_expr(ad.adbin, ad.adrelid) AS varchar) AS column_default,
coalesce(pg_get_expr(ad.adbin, ad.adrelid) ~ 'nextval',false) {$orIdentity} AS is_autoinc,
pg_get_serial_sequence(quote_ident(d.nspname) || '.' || quote_ident(c.relname), a.attname) AS sequence_name,
CASE WHEN COALESCE(td.typtype, tb.typtype, t.typtype) = 'e'::char
    THEN array_to_string((SELECT array_agg(enumlabel) FROM pg_enum WHERE enumtypid = COALESCE(td.oid, tb.oid, a.atttypid))::varchar[], ',')
    ELSE NULL
END AS enum_values,
CASE atttypid
     WHEN 21 /*int2*/ THEN 16
     WHEN 23 /*int4*/ THEN 32
     WHEN 20 /*int8*/ THEN 64
     WHEN 1700 /*numeric*/ THEN
          CASE WHEN atttypmod = -1
           THEN null
           ELSE ((atttypmod - 4) >> 16) & 65535
           END
     WHEN 700 /*float4*/ THEN 24 /*FLT_MANT_DIG*/
     WHEN 701 /*float8*/ THEN 53 /*DBL_MANT_DIG*/
     ELSE null
  END   AS numeric_precision,
  CASE
    WHEN atttypid IN (21, 23, 20) THEN 0
    WHEN atttypid IN (1700) THEN
    CASE
        WHEN atttypmod = -1 THEN null
        ELSE (atttypmod - 4) & 65535
    END
       ELSE null
  END AS numeric_scale,
CAST(
         information_schema._pg_char_max_length(information_schema._pg_truetypid(a, t), information_schema._pg_truetypmod(a, t))
         AS numeric
) AS size,
a.attnum = any (ct.conkey) as is_pkey,
COALESCE(NULLIF(a.attndims, 0), NULLIF(t.typndims, 0), (t.typcategory='A')::int) AS dimension

pg_class c
LEFT JOIN pg_attribute a ON a.attrelid = c.oid
LEFT JOIN pg_attrdef ad ON a.attrelid = ad.adrelid AND a.attnum = ad.adnum
LEFT JOIN pg_type t ON a.atttypid = t.oid
LEFT JOIN pg_type tb ON (a.attndims > 0 OR t.typcategory='A') AND t.typelem > 0 AND t.typelem = tb.oid OR t.typbasetype > 0 AND t.typbasetype = tb.oid
LEFT JOIN pg_type td ON t.typndims > 0 AND t.typbasetype > 0 AND tb.typelem = td.oid
LEFT JOIN pg_namespace d ON d.oid = c.relnamespace
LEFT JOIN pg_constraint ct ON ct.conrelid = c.oid AND ct.contype = 'p'
E
a.attnum > 0 AND t.typname != '' AND NOT a.attisdropped
AND c.relname = {$tableName}
AND d.nspname = {$schemaName}
R BY
a.attnum;

    $columns = $this->db->createCommand($sql)->queryAll();
    if (empty($columns)) {
        return false;
    }
    foreach ($columns as $column) {
        if ($this->db->slavePdo->getAttribute(\PDO::ATTR_CASE) === \PDO::CASE_UPPER) {
            $column = array_change_key_case($column, CASE_LOWER);
        }
        $column = $this->loadColumnSchema($column);
        $table->columns[$column->name] = $column;
        if ($column->isPrimaryKey) {
            $table->primaryKey[] = $column->name;
            if ($table->sequenceName === null) {
                $table->sequenceName = $column->sequenceName;
            }
            $column->defaultValue = null;
        } elseif ($column->defaultValue) {
            if (
                in_array($column->type, [self::TYPE_TIMESTAMP, self::TYPE_DATE, self::TYPE_TIME], true) &&
                (
                    in_array(
                        strtoupper($column->defaultValue),
                        ['NOW()', 'CURRENT_TIMESTAMP', 'CURRENT_DATE', 'CURRENT_TIME'],
                        true
                    ) ||
                    (false !== strpos($column->defaultValue, '('))
                )
            ) {
                $column->defaultValue = new Expression($column->defaultValue);
            } elseif ($column->type === 'boolean') {
                $column->defaultValue = ($column->defaultValue === 'true');
            } elseif (preg_match("/^B'(.*?)'::/", $column->defaultValue, $matches)) {
                $column->defaultValue = bindec($matches[1]);
            } elseif (preg_match("/^'(\d+)'::\"bit\"$/", $column->defaultValue, $matches)) {
                $column->defaultValue = bindec($matches[1]);
            } elseif (preg_match("/^'(.*?)'::/", $column->defaultValue, $matches)) {
                $column->defaultValue = $column->phpTypecast($matches[1]);
            } elseif (preg_match('/^(\()?(.*?)(?(1)\))(?:::.+)?$/', $column->defaultValue, $matches)) {
                if ($matches[2] === 'NULL') {
                    $column->defaultValue = null;
                } else {
                    $column->defaultValue = $column->phpTypecast($matches[2]);
                }
            } else {
                $column->defaultValue = $column->phpTypecast($column->defaultValue);
            }
        }
    }
    return true;
}
";s:6:"params";a:1:{s:6:"$table";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$table";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:18:"The table metadata";s:4:"type";s:19:"\yii\db\TableSchema";s:5:"types";a:1:{i:0;s:19:"\yii\db\TableSchema";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:40:"Whether the table exists in the database";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:196321;s:4:"name";s:11:"findColumns";s:8:"fullName";s:32:"yii\db\pgsql\Schema::findColumns";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/Schema.php";s:9:"startLine";i:467;s:7:"endLine";i:590;s:16:"shortDescription";s:39:"Collects the metadata of table columns.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"loadColumnSchema";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\db\pgsql\Schema";s:10:"sourceCode";s:1870:"protected function loadColumnSchema($info)
{
    /** @var ColumnSchema $column */
    $column = $this->createColumnSchema();
    $column->allowNull = $info['is_nullable'];
    $column->autoIncrement = $info['is_autoinc'];
    $column->comment = $info['column_comment'];
    if ($info['type_scheme'] !== null && !in_array($info['type_scheme'], [$this->defaultSchema, 'pg_catalog'], true)) {
        $column->dbType = $info['type_scheme'] . '.' . $info['data_type'];
    } else {
        $column->dbType = $info['data_type'];
    }
    $column->defaultValue = $info['column_default'];
    $column->enumValues = ($info['enum_values'] !== null) ? explode(',', str_replace(["''"], ["'"], $info['enum_values'])) : null;
    $column->unsigned = false; // has no meaning in PG
    $column->isPrimaryKey = $info['is_pkey'];
    $column->name = $info['column_name'];
    $column->precision = $info['numeric_precision'];
    $column->scale = $info['numeric_scale'];
    $column->size = $info['size'] === null ? null : (int) $info['size'];
    $column->dimension = (int) $info['dimension'];
    // pg_get_serial_sequence() doesn't track DEFAULT value change. GENERATED BY IDENTITY columns always have null default value
    if (isset($column->defaultValue) && preg_match("/nextval\\('\"?\\w+\"?\.?\"?\\w+\"?'(::regclass)?\\)/", $column->defaultValue) === 1) {
        $column->sequenceName = preg_replace(['/nextval/', '/::/', '/regclass/', '/\'\)/', '/\(\'/'], '', $column->defaultValue);
    } elseif (isset($info['sequence_name'])) {
        $column->sequenceName = $this->resolveTableName($info['sequence_name'])->fullName;
    }
    if (isset($this->typeMap[$column->dbType])) {
        $column->type = $this->typeMap[$column->dbType];
    } else {
        $column->type = self::TYPE_STRING;
    }
    $column->phpType = $this->getColumnPhpType($column);
    return $column;
}
";s:6:"params";a:1:{s:5:"$info";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$info";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:18:"Column information";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:24:"The column schema object";s:10:"returnType";s:26:"\yii\db\pgsql\ColumnSchema";s:11:"returnTypes";a:1:{i:0;s:26:"\yii\db\pgsql\ColumnSchema";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:196321;s:4:"name";s:16:"loadColumnSchema";s:8:"fullName";s:37:"yii\db\pgsql\Schema::loadColumnSchema";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/Schema.php";s:9:"startLine";i:600;s:7:"endLine";i:636;s:16:"shortDescription";s:60:"Loads the column information into a [[ColumnSchema]] object.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:2;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:14:"phpstan-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:1:"T";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:3;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:12:"psalm-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:1:"T";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:6:"insert";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\db\pgsql\Schema";s:10:"sourceCode";s:635:"public function insert($table, $columns)
{
    $params = [];
    $sql = $this->db->getQueryBuilder()->insert($table, $columns, $params);
    $returnColumns = $this->getTableSchema($table)->primaryKey;
    if (!empty($returnColumns)) {
        $returning = [];
        foreach ((array) $returnColumns as $name) {
            $returning[] = $this->quoteColumnName($name);
        }
        $sql .= ' RETURNING ' . implode(', ', $returning);
    }
    $command = $this->db->createCommand($sql, $params);
    $command->prepare(false);
    $result = $command->queryOne();
    return !$command->pdoStatement->rowCount() ? false : $result;
}
