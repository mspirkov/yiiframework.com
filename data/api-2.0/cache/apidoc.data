";s:6:"params";a:1:{s:7:"$config";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$config";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/Application.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:34831;s:4:"name";s:11:"__construct";s:8:"fullName";s:36:"yii\console\Application::__construct";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/Application.php";s:9:"startLine";i:90;s:7:"endLine";i:94;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:10:"loadConfig";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:23:"yii\console\Application";s:10:"sourceCode";s:551:"protected function loadConfig($config)
{
    if (!empty($_SERVER['argv'])) {
        $option = '--' . self::OPTION_APPCONFIG . '=';
        foreach ($_SERVER['argv'] as $param) {
            if (strpos($param, $option) !== false) {
                $path = substr($param, strlen($option));
                if (!empty($path) && is_file($file = Yii::getAlias($path))) {
                    return require $file;
                }
                exit("The configuration file does not exist: $path\n");
            }
        }
    }
    return $config;
}
