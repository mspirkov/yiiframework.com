renaming files. Defaults to `true` to be more compatible with log tailers and windows
systems which do not play well with rename on open files. Rotation by renaming however is
a bit faster.

The problem with windows systems where the [rename()](https://www.php.net/manual/en/function.rename.php)
function does not work with files that are opened by some process is described in a
[comment by Martin Pelletier](https://www.php.net/manual/en/function.rename.php#102274) in
the PHP documentation. By setting rotateByCopy to `true` you can work
around this.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";s:101:"since 2.0.46 and setting it to false has no effect anymore
since rotating is now always done by copy.";s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Boolean":0:{}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:629:"Whether to rotate log files by copy and truncate in contrast to rotation by
renaming files. Defaults to `true` to be more compatible with log tailers and windows
systems which do not play well with rename on open files. Rotation by renaming however is
a bit faster.

The problem with windows systems where the [rename()](https://www.php.net/manual/en/function.rename.php)
function does not work with files that are opened by some process is described in a
[comment by Martin Pelletier](https://www.php.net/manual/en/function.rename.php#102274) in
the PHP documentation. By setting rotateByCopy to `true` you can work
around this.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:7:"yii\log";s:13:"phpDocContext";r:66040;s:4:"name";s:18:"yii\log\FileTarget";s:8:"fullName";s:18:"yii\log\FileTarget";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/FileTarget.php";s:9:"startLine";i:29;s:7:"endLine";i:201;s:16:"shortDescription";s:42:"FileTarget records log messages in a file.";s:11:"description";s:491:"The log file is specified via [[logFile]]. If the size of the log file exceeds
[[maxFileSize]] (in kilo-bytes), a rotation will be performed, which renames
the current log file by suffixing the file name with '.1'. All existing log
files are moved backwards by one place, i.e., '.2' to '.3', '.1' to '.2', and so on.
The property [[maxLogFiles]] specifies how many history files to keep.

Since 2.0.46 rotation of the files is done only by copy and the
`rotateByCopy` property is deprecated.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"yii\log\Target";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:18:"yii\base\Component";s:10:"isAbstract";b:1;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:11:{s:6:"export";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:1;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:14:"yii\log\Target";s:10:"sourceCode";s:35:"abstract public function export();
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:7:"yii\log";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:9:{s:3:"Yii";s:3:"Yii";s:9:"Component";s:18:"yii\base\Component";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:11:"ArrayHelper";s:23:"yii\helpers\ArrayHelper";s:12:"StringHelper";s:24:"yii\helpers\StringHelper";s:9:"VarDumper";s:21:"yii\helpers\VarDumper";s:17:"IdentityInterface";s:25:"yii\web\IdentityInterface";s:7:"Request";s:15:"yii\web\Request";s:4:"User";s:12:"yii\web\User";}}s:4:"name";s:6:"export";s:8:"fullName";s:22:"yii\log\Target::export";s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/Target.php";s:9:"startLine";i:144;s:7:"endLine";i:144;s:16:"shortDescription";s:51:"Exports log [[messages]] to a specific destination.";s:11:"description";s:41:"Child classes must implement this method.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:7:"collect";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:14:"yii\log\Target";s:10:"sourceCode";s:781:"public function collect($messages, $final)
{
    $this->messages = array_merge($this->messages, static::filterMessages($messages, $this->getLevels(), $this->categories, $this->except));
    $count = count($this->messages);
    if ($count > 0 && ($final || $this->exportInterval > 0 && $count >= $this->exportInterval)) {
        if (($context = $this->getContextMessage()) !== '') {
            $this->messages[] = [$context, Logger::LEVEL_INFO, 'application', YII_BEGIN_TIME, [], 0];
        }
        // set exportInterval to 0 to avoid triggering export again while exporting
        $oldExportInterval = $this->exportInterval;
        $this->exportInterval = 0;
        $this->export();
        $this->exportInterval = $oldExportInterval;
        $this->messages = [];
    }
}
";s:6:"params";a:2:{s:9:"$messages";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$messages";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:89:"Log messages to be processed. See [[Logger::messages]] for the structure
of each message.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/Target.php";}s:6:"$final";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$final";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:67:"Whether this method is called at the end of the current application";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/Target.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:66390;s:4:"name";s:7:"collect";s:8:"fullName";s:23:"yii\log\Target::collect";s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/Target.php";s:9:"startLine";i:154;s:7:"endLine";i:170;s:16:"shortDescription";s:33:"Processes the given log messages.";s:11:"description";s:170:"This method will filter the given messages with [[levels]] and [[categories]].
And if requested, it will also export the filtering result to specific medium (e.g. email).";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"getContextMessage";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:14:"yii\log\Target";s:10:"sourceCode";s:587:"protected function getContextMessage()
{
    $context = ArrayHelper::filter($GLOBALS, $this->logVars);
    $items = ArrayHelper::flatten($context);
    foreach ($this->maskVars as $var) {
        foreach ($items as $key => $value) {
            if (StringHelper::matchWildcard($var, $key, ['caseSensitive' => false])) {
                ArrayHelper::setValue($context, $key, '***');
            }
        }
    }
    $result = [];
    foreach ($context as $key => $value) {
        $result[] = "\${$key} = " . VarDumper::dumpAsString($value);
    }
    return implode("\n\n", $result);
}
