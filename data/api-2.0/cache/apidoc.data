{
    parent::init();
    static::checkRequirements();
    if (!isset($this->imageOptions['id'])) {
        $this->imageOptions['id'] = $this->options['id'] . '-image';
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\captcha";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:5:{s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:4:"Html";s:16:"yii\helpers\Html";s:4:"Json";s:16:"yii\helpers\Json";s:3:"Url";s:15:"yii\helpers\Url";s:11:"InputWidget";s:23:"yii\widgets\InputWidget";}}s:4:"name";s:4:"init";s:8:"fullName";s:25:"yii\captcha\Captcha::init";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/Captcha.php";s:9:"startLine";i:89;s:7:"endLine";i:98;s:16:"shortDescription";s:23:"Initializes the widget.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:3:"run";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\captcha\Captcha";s:10:"sourceCode";s:433:"public function run()
{
    $this->registerClientScript();
    $input = $this->renderInputHtml('text');
    $route = $this->captchaAction;
    if (is_array($route)) {
        $route['v'] = uniqid('', true);
    } else {
        $route = [$route, 'v' => uniqid('', true)];
    }
    $image = Html::img($route, $this->imageOptions);
    echo strtr($this->template, [
        '{input}' => $input,
        '{image}' => $image,
    ]);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:130631;s:4:"name";s:3:"run";s:8:"fullName";s:24:"yii\captcha\Captcha::run";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/Captcha.php";s:9:"startLine";i:103;s:7:"endLine";i:118;s:16:"shortDescription";s:19:"Renders the widget.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:20:"registerClientScript";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\captcha\Captcha";s:10:"sourceCode";s:316:"public function registerClientScript()
{
    $options = $this->getClientOptions();
    $options = empty($options) ? '' : Json::htmlEncode($options);
    $id = $this->imageOptions['id'];
    $view = $this->getView();
    CaptchaAsset::register($view);
    $view->registerJs("jQuery('#$id').yiiCaptcha($options);");
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:130631;s:4:"name";s:20:"registerClientScript";s:8:"fullName";s:41:"yii\captcha\Captcha::registerClientScript";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/Captcha.php";s:9:"startLine";i:123;s:7:"endLine";i:131;s:16:"shortDescription";s:32:"Registers the needed JavaScript.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"getClientOptions";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\captcha\Captcha";s:10:"sourceCode";s:390:"protected function getClientOptions()
{
    $route = $this->captchaAction;
    if (is_array($route)) {
        $route[CaptchaAction::REFRESH_GET_VAR] = 1;
    } else {
        $route = [$route, CaptchaAction::REFRESH_GET_VAR => 1];
    }
    $options = [
        'refreshUrl' => Url::toRoute($route),
        'hashKey' => 'yiiCaptcha/' . trim($route[0], '/'),
    ];
    return $options;
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:11:"The options";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:130631;s:4:"name";s:16:"getClientOptions";s:8:"fullName";s:37:"yii\captcha\Captcha::getClientOptions";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/captcha/Captcha.php";s:9:"startLine";i:137;s:7:"endLine";i:152;s:16:"shortDescription";s:46:"Returns the options for the captcha JS widget.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"checkRequirements";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\captcha\Captcha";s:10:"sourceCode";s:552:"public static function checkRequirements()
{
    if (extension_loaded('imagick')) {
        $imagickFormats = (new \Imagick())->queryFormats('PNG');
        if (in_array('PNG', $imagickFormats, true)) {
            return 'imagick';
        }
    }
    if (extension_loaded('gd')) {
        $gdInfo = gd_info();
        if (!empty($gdInfo['FreeType Support'])) {
            return 'gd';
        }
    }
    throw new InvalidConfigException('Either GD PHP extension with FreeType support or ImageMagick PHP extension with PNG support is required.');
}
