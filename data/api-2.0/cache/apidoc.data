1398:"You may use [[isGuest]] to determine whether the current user is a guest or not.
If the user is a guest, the [[identity]] property would return `null`. Otherwise, it would
be an instance of [[IdentityInterface]].

You may call various methods to change the user authentication status:

- [[login()]]: sets the specified identity and remembers the authentication status in session and cookie;
- [[logout()]]: marks the user as a guest and clears the relevant information from session and cookie;
- [[setIdentity()]]: changes the user identity without touching session or cookie
  (this is best used in stateless RESTful API implementation).

Note that User only maintains the user authentication status. It does NOT handle how to authenticate
a user. The logic of how to authenticate a user should be done in the class implementing [[IdentityInterface]].
You are also required to set [[identityClass]] with the name of this class.

User is configured as an application component in [[\yii\web\Application]] by default.
You can access that instance via `Yii::$app->user`.

You can modify its configuration by adding an array to your application config under `components`
as it is shown in the following example:

```
'user' => [
    'identityClass' => 'app\models\User', // User must implement the IdentityInterface
    'enableAutoLogin' => true,
    // 'loginUrl' => ['user/login'],
    // ...
]
```";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:8:{i:0;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:2:"id";s:7:"␀*␀type";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:3:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}i:2;O:36:"phpDocumentor\Reflection\Types\Null_":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:111042;}i:1;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:8:"identity";s:7:"␀*␀type";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:26:"\yii\web\IdentityInterface";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:17:"IdentityInterface";}}i:1;O:36:"phpDocumentor\Reflection\Types\Null_":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:111069;}i:2;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:7:"isGuest";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Boolean":0:{}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:111095;}i:3;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:9:"returnUrl";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:111121;}i:6;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:16:"phpstan-template";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:22:"T of IdentityInterface";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:7;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:14:"psalm-template";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:22:"T of IdentityInterface";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:8;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:16:"phpstan-property";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:16:"T|null $identity";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:9;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:14:"psalm-property";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:16:"T|null $identity";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:28:"yii\web\XmlResponseFormatter";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:18:"yii\base\Component";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:1:{i:0;s:34:"yii\web\ResponseFormatterInterface";}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:5:{s:6:"format";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:28:"yii\web\XmlResponseFormatter";s:10:"sourceCode";s:924:"public function format($response)
{
    $charset = $this->encoding === null ? $response->charset : $this->encoding;
    if (stripos($this->contentType, 'charset') === false) {
        $this->contentType .= '; charset=' . $charset;
    }
    $response->getHeaders()->set('Content-Type', $this->contentType);
    if ($response->data !== null) {
        $this->dom = new DOMDocument($this->version, $charset);
        if (!empty($this->rootTag)) {
            if (is_array($this->rootTag)) {
                $root = $this->dom->createElementNS($this->rootTag[0], $this->rootTag[1]);
            } else {
                $root = $this->dom->createElement($this->rootTag);
            }
            $this->dom->appendChild($root);
            $this->buildXml($root, $response->data);
        } else {
            $this->buildXml($this->dom, $response->data);
        }
        $response->content = $this->dom->saveXML();
    }
}
";s:6:"params";a:1:{s:9:"$response";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$response";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:29:"The response to be formatted.";s:4:"type";s:17:"\yii\web\Response";s:5:"types";a:1:{i:0;s:17:"\yii\web\Response";}s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/XmlResponseFormatter.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:7:"yii\web";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:6:{s:11:"DOMDocument";s:11:"DOMDocument";s:10:"DOMElement";s:10:"DOMElement";s:12:"DOMException";s:12:"DOMException";s:9:"Arrayable";s:18:"yii\base\Arrayable";s:9:"Component";s:18:"yii\base\Component";s:12:"StringHelper";s:24:"yii\helpers\StringHelper";}}s:4:"name";s:6:"format";s:8:"fullName";s:36:"yii\web\XmlResponseFormatter::format";s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/XmlResponseFormatter.php";s:9:"startLine";i:79;s:7:"endLine";i:101;s:16:"shortDescription";s:31:"Formats the specified response.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"buildXml";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:28:"yii\web\XmlResponseFormatter";s:10:"sourceCode";s:1676:"protected function buildXml($element, $data)
{
    if (
        is_array($data) ||
        ($data instanceof \Traversable && $this->useTraversableAsArray && !$data instanceof Arrayable)
    ) {
        foreach ($data as $name => $value) {
            if (is_int($name) && is_object($value)) {
                $this->buildXml($element, $value);
            } elseif (is_array($value) || is_object($value)) {
                $child = $this->dom->createElement($this->getValidXmlElementName($name));
                $element->appendChild($child);
                $this->buildXml($child, $value);
            } else {
                $child = $this->dom->createElement($this->getValidXmlElementName($name));
                $child->appendChild($this->dom->createTextNode($this->formatScalarValue($value)));
                $element->appendChild($child);
            }
        }
    } elseif (is_object($data)) {
        if ($this->useObjectTags) {
            $name = StringHelper::basename(get_class($data));
            if ($this->objectTagToLowercase) {
                $name = strtolower($name);
            }
            $child = $this->dom->createElement($name);
            $element->appendChild($child);
        } else {
            $child = $element;
        }
        if ($data instanceof Arrayable) {
            $this->buildXml($child, $data->toArray());
        } else {
            $array = [];
            foreach ($data as $name => $value) {
                $array[$name] = $value;
            }
            $this->buildXml($child, $array);
        }
    } else {
        $element->appendChild($this->dom->createTextNode($this->formatScalarValue($data)));
    }
}
