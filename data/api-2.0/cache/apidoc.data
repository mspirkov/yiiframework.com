If you set a custom `id` for the textarea element, you may need to adjust the [[$selectors]] accordingly.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveField.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:24:"The field object itself.";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:22694;s:4:"name";s:8:"textarea";s:8:"fullName";s:33:"yii\widgets\ActiveField::textarea";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveField.php";s:9:"startLine";i:508;s:7:"endLine";i:521;s:16:"shortDescription";s:20:"Renders a text area.";s:11:"description";s:70:"The model attribute value will be used as the content in the textarea.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:5:"radio";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\widgets\ActiveField";s:10:"sourceCode";s:921:"public function radio($options = [], $enclosedByLabel = true)
{
    if ($this->form->validationStateOn === ActiveForm::VALIDATION_STATE_ON_INPUT) {
        $this->addErrorClassIfNeeded($options);
    }
    $this->addAriaAttributes($options);
    $this->adjustLabelFor($options);
    if ($enclosedByLabel) {
        $this->parts['{input}'] = Html::activeRadio($this->model, $this->attribute, $options);
        $this->parts['{label}'] = '';
    } else {
        if (isset($options['label']) && !isset($this->parts['{label}'])) {
            $this->parts['{label}'] = $options['label'];
            if (!empty($options['labelOptions'])) {
                $this->labelOptions = $options['labelOptions'];
            }
        }
        unset($options['labelOptions']);
        $options['label'] = null;
        $this->parts['{input}'] = Html::activeRadio($this->model, $this->attribute, $options);
    }
    return $this;
}
";s:6:"params";a:2:{s:8:"$options";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$options";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:1355:"The tag options in terms of name-value pairs. The following options are specially handled:

- `uncheck`: string, the value associated with the uncheck state of the radio button. If not set,
  it will take the default value `0`. This method will render a hidden input so that if the radio button
  is not checked and is submitted, the value of this attribute will still be submitted to the server
  via the hidden input. If you do not want any hidden input, you should explicitly set this option as `null`.
- `label`: string, a label displayed next to the radio button. It will NOT be HTML-encoded. Therefore you can pass
  in HTML code such as an image tag. If this is coming from end users, you should [[Html::encode()|encode]] it to prevent XSS attacks.
  When this option is specified, the radio button will be enclosed by a label tag. If you do not want any label, you should
  explicitly set this option as `null`.
- `labelOptions`: array, the HTML attributes for the label tag. This is only used when the `label` option is specified.

The rest of the options will be rendered as the attributes of the resulting tag. The values will
be HTML-encoded using [[Html::encode()]]. If a value is `null`, the corresponding attribute will not be rendered.

If you set a custom `id` for the input element, you may need to adjust the [[$selectors]] accordingly.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveField.php";}s:16:"$enclosedByLabel";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:16:"$enclosedByLabel";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"true";s:19:"isPassedByReference";b:0;s:11:"description";s:197:"Whether to enclose the radio within the label.
If `true`, the method will still use [[template]] to layout the radio button and the error message
except that the radio is enclosed by the label tag.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveField.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:24:"The field object itself.";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:22694;s:4:"name";s:5:"radio";s:8:"fullName";s:30:"yii\widgets\ActiveField::radio";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveField.php";s:9:"startLine";i:548;s:7:"endLine";i:573;s:16:"shortDescription";s:23:"Renders a radio button.";s:11:"description";s:93:"This method will generate the `checked` tag attribute according to the model attribute value.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"checkbox";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\widgets\ActiveField";s:10:"sourceCode";s:930:"public function checkbox($options = [], $enclosedByLabel = true)
{
    if ($this->form->validationStateOn === ActiveForm::VALIDATION_STATE_ON_INPUT) {
        $this->addErrorClassIfNeeded($options);
    }
    $this->addAriaAttributes($options);
    $this->adjustLabelFor($options);
    if ($enclosedByLabel) {
        $this->parts['{input}'] = Html::activeCheckbox($this->model, $this->attribute, $options);
        $this->parts['{label}'] = '';
    } else {
        if (isset($options['label']) && !isset($this->parts['{label}'])) {
            $this->parts['{label}'] = $options['label'];
            if (!empty($options['labelOptions'])) {
                $this->labelOptions = $options['labelOptions'];
            }
        }
        unset($options['labelOptions']);
        $options['label'] = null;
        $this->parts['{input}'] = Html::activeCheckbox($this->model, $this->attribute, $options);
    }
    return $this;
}
";s:6:"params";a:2:{s:8:"$options";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$options";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:1347:"The tag options in terms of name-value pairs. The following options are specially handled:

- `uncheck`: string, the value associated with the uncheck state of the radio button. If not set,
  it will take the default value `0`. This method will render a hidden input so that if the radio button
  is not checked and is submitted, the value of this attribute will still be submitted to the server
  via the hidden input. If you do not want any hidden input, you should explicitly set this option as `null`.
- `label`: string, a label displayed next to the checkbox. It will NOT be HTML-encoded. Therefore you can pass
  in HTML code such as an image tag. If this is coming from end users, you should [[Html::encode()|encode]] it to prevent XSS attacks.
  When this option is specified, the checkbox will be enclosed by a label tag. If you do not want any label, you should
  explicitly set this option as `null`.
- `labelOptions`: array, the HTML attributes for the label tag. This is only used when the `label` option is specified.

The rest of the options will be rendered as the attributes of the resulting tag. The values will
be HTML-encoded using [[Html::encode()]]. If a value is `null`, the corresponding attribute will not be rendered.

If you set a custom `id` for the input element, you may need to adjust the [[$selectors]] accordingly.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveField.php";}s:16:"$enclosedByLabel";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:16:"$enclosedByLabel";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"true";s:19:"isPassedByReference";b:0;s:11:"description";s:199:"Whether to enclose the checkbox within the label.
