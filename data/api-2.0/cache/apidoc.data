If it is `all`, all available new migrations will be displayed.";s:4:"type";s:10:"int|string";s:5:"types";a:2:{i:0;s:3:"int";i:1;s:6:"string";}s:10:"sourceFile";s:120:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/BaseMigrateController.php";}}s:10:"exceptions";a:1:{s:22:"\yii\console\Exception";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:29:"if invalid limit value passed";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:37103;s:4:"name";s:9:"actionNew";s:8:"fullName";s:56:"yii\console\controllers\BaseMigrateController::actionNew";s:10:"sourceFile";s:120:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/BaseMigrateController.php";s:9:"startLine";i:596;s:7:"endLine";i:624;s:16:"shortDescription";s:39:"Displays the un-applied new migrations.";s:11:"description";s:255:"This command will show the new migrations that have not been applied.
