ntation for [[Json]].";s:11:"description";s:42:"Do not use BaseJson. Use [[Json]] instead.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"yii\helpers\Html";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:20:"yii\helpers\BaseHtml";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:0:{}s:10:"properties";a:0:{}s:9:"namespace";s:11:"yii\helpers";s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\helpers";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:0:{}}s:4:"name";s:16:"yii\helpers\Html";s:8:"fullName";s:16:"yii\helpers\Html";s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/Html.php";s:9:"startLine";i:22;s:7:"endLine";i:24;s:16:"shortDescription";s:77:"Html provides a set of static methods for generating commonly used HTML tags.";s:11:"description";s:393:"Nearly all of the methods in this class allow setting additional html attributes for the html
