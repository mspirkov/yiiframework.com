}
";s:6:"params";a:1:{s:7:"$offset";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$offset";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:16:"The given offset";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/QueryBuilder.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:31:"Whether the offset is effective";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:174411;s:4:"name";s:9:"hasOffset";s:8:"fullName";s:30:"yii\db\QueryBuilder::hasOffset";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/QueryBuilder.php";s:9:"startLine";i:1477;s:7:"endLine";i:1480;s:16:"shortDescription";s:47:"Checks to see if the given offset is effective.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:10:"buildUnion";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\db\QueryBuilder";s:10:"sourceCode";s:454:"public function buildUnion($unions, &$params)
{
    if (empty($unions)) {
        return '';
    }
    $result = '';
    foreach ($unions as $i => $union) {
        $query = $union['query'];
        if ($query instanceof Query) {
            list($unions[$i]['query'], $params) = $this->build($query, $params);
        }
        $result .= 'UNION ' . ($union['all'] ? 'ALL ' : '') . '( ' . $unions[$i]['query'] . ' ) ';
    }
    return trim($result);
}
