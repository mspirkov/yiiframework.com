You can access that instance via `Yii::$app->urlManager`.

You can modify its configuration by adding an array to your application config under `components`
as it is shown in the following example:

```
'urlManager' => [
    'enablePrettyUrl' => true,
    'rules' => [
        // your rules go here
    ],
    // ...
]
```

Rules are classes implementing the [[UrlRuleInterface]], by default that is [[UrlRule]].
For nesting rules, there is also a [[GroupUrlRule]] class.

For more details and usage information on UrlManager, see the [guide article on routing](guide:runtime-routing).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:3:{i:0;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:7:"baseUrl";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:97512;}i:1;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:8:"hostInfo";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:97538;}i:2;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:9:"scriptUrl";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:97564;}}s:5:"todos";a:0:{}}s:25:"yii\web\GoneHttpException";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:21:"yii\web\HttpException";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:11:"Dan Schmidt";s:24:"danschmidt5189@gmail.com";}s:7:"methods";a:1:{s:11:"__construct";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\web\GoneHttpException";s:10:"sourceCode";s:136:"public function __construct($message = null, $code = 0, $previous = null)
