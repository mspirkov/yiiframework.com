If null, it means the current user will be a guest without any associated identity.";s:4:"type";s:31:"\yii\web\IdentityInterface|null";s:5:"types";a:2:{i:0;s:26:"\yii\web\IdentityInterface";i:1;s:4:"null";}s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/User.php";}}s:10:"exceptions";a:1:{s:31:"\yii\base\InvalidValueException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:63:"if `$identity` object does not implement [[IdentityInterface]].";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:109840;s:4:"name";s:11:"setIdentity";s:8:"fullName";s:25:"yii\web\User::setIdentity";s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/User.php";s:9:"startLine";i:235;s:7:"endLine";i:245;s:16:"shortDescription";s:30:"Sets the user identity object.";s:11:"description";s:147:"Note that this method does not deal with session or cookie. You should usually use [[switchIdentity()]]
to change the identity of the current user.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:2;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:13:"phpstan-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:16:"T|null $identity";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:3;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:11:"psalm-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:16:"T|null $identity";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:5:"login";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:12:"yii\web\User";s:10:"sourceCode";s:652:"public function login(IdentityInterface $identity, $duration = 0)
{
    if ($this->beforeLogin($identity, false, $duration)) {
        $this->switchIdentity($identity, $duration);
        $id = $identity->getId();
        $ip = Yii::$app->getRequest()->getUserIP();
        if ($this->enableSession) {
            $log = "User '$id' logged in from $ip with duration $duration.";
        } else {
            $log = "User '$id' logged in from $ip. Session not enabled.";
        }
        $this->regenerateCsrfToken();
        Yii::info($log, __METHOD__);
        $this->afterLogin($identity, false, $duration);
    }
    return !$this->getIsGuest();
}
