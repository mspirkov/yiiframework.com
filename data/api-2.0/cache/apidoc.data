The possible values are:

- [[POS_HEAD]]: in the head section. This is the default value.
- [[POS_BEGIN]]: at the beginning of the body section.
- [[POS_END]]: at the end of the body section.
- [[POS_LOAD]]: enclosed within jQuery(window).load().
  Note that by using this position, the method will automatically register the jQuery js file.
- [[POS_READY]]: enclosed within jQuery(document).ready().
  Note that by using this position, the method will automatically register the jQuery js file.";s:4:"type";s:3:"int";s:5:"types";a:1:{i:0;s:3:"int";}s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/View.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:119100;s:4:"name";s:13:"registerJsVar";s:8:"fullName";s:27:"yii\web\View::registerJsVar";s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/View.php";s:9:"startLine";i:627;s:7:"endLine";i:631;s:16:"shortDescription";s:126:"Registers a JS code block defining a variable. The name of variable will be
used as key, preventing duplicated variable names.";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.14";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"renderHeadHtml";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:12:"yii\web\View";s:10:"sourceCode";s:718:"protected function renderHeadHtml()
{
    $lines = [];
    if (!empty($this->metaTags)) {
        $lines[] = implode("\n", $this->metaTags);
    }
    if (!empty($this->linkTags)) {
        $lines[] = implode("\n", $this->linkTags);
    }
    if (!empty($this->cssFiles)) {
        $lines[] = implode("\n", $this->cssFiles);
    }
    if (!empty($this->css)) {
        $lines[] = implode("\n", $this->css);
    }
    if (!empty($this->jsFiles[self::POS_HEAD])) {
        $lines[] = implode("\n", $this->jsFiles[self::POS_HEAD]);
    }
    if (!empty($this->js[self::POS_HEAD])) {
        $lines[] = Html::script(implode("\n", $this->js[self::POS_HEAD]));
    }
    return empty($lines) ? '' : implode("\n", $lines);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:20:"The rendered content";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:119100;s:4:"name";s:14:"renderHeadHtml";s:8:"fullName";s:28:"yii\web\View::renderHeadHtml";s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/View.php";s:9:"startLine";i:638;s:7:"endLine";i:662;s:16:"shortDescription";s:55:"Renders the content to be inserted in the head section.";s:11:"description";s:96:"The content is rendered using the registered meta tags, link tags, CSS/JS code blocks and files.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:19:"renderBodyBeginHtml";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:12:"yii\web\View";s:10:"sourceCode";s:369:"protected function renderBodyBeginHtml()
{
    $lines = [];
    if (!empty($this->jsFiles[self::POS_BEGIN])) {
        $lines[] = implode("\n", $this->jsFiles[self::POS_BEGIN]);
    }
    if (!empty($this->js[self::POS_BEGIN])) {
        $lines[] = Html::script(implode("\n", $this->js[self::POS_BEGIN]));
    }
    return empty($lines) ? '' : implode("\n", $lines);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:20:"The rendered content";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:119100;s:4:"name";s:19:"renderBodyBeginHtml";s:8:"fullName";s:33:"yii\web\View::renderBodyBeginHtml";s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/View.php";s:9:"startLine";i:669;s:7:"endLine";i:680;s:16:"shortDescription";s:72:"Renders the content to be inserted at the beginning of the body section.";s:11:"description";s:70:"The content is rendered using the registered JS code blocks and files.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"renderBodyEndHtml";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:12:"yii\web\View";s:10:"sourceCode";s:1343:"protected function renderBodyEndHtml($ajaxMode)
{
    $lines = [];
    if (!empty($this->jsFiles[self::POS_END])) {
        $lines[] = implode("\n", $this->jsFiles[self::POS_END]);
    }
    if ($ajaxMode) {
        $scripts = [];
        if (!empty($this->js[self::POS_END])) {
            $scripts[] = implode("\n", $this->js[self::POS_END]);
        }
        if (!empty($this->js[self::POS_READY])) {
            $scripts[] = implode("\n", $this->js[self::POS_READY]);
        }
        if (!empty($this->js[self::POS_LOAD])) {
            $scripts[] = implode("\n", $this->js[self::POS_LOAD]);
        }
        if (!empty($scripts)) {
            $lines[] = Html::script(implode("\n", $scripts));
        }
    } else {
        if (!empty($this->js[self::POS_END])) {
            $lines[] = Html::script(implode("\n", $this->js[self::POS_END]));
        }
        if (!empty($this->js[self::POS_READY])) {
            $js = "jQuery(function ($) {\n" . implode("\n", $this->js[self::POS_READY]) . "\n});";
            $lines[] = Html::script($js);
        }
        if (!empty($this->js[self::POS_LOAD])) {
            $js = "jQuery(window).on('load', function () {\n" . implode("\n", $this->js[self::POS_LOAD]) . "\n});";
            $lines[] = Html::script($js);
        }
    }
    return empty($lines) ? '' : implode("\n", $lines);
}
