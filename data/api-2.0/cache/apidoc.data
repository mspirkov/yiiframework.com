will remove non alphanumeric character from the word, so
"who's online" will be converted to "whoSOnline".";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"tableize";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\helpers\BaseInflector";s:10:"sourceCode";s:181:"public static function tableize($className)
