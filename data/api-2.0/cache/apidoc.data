of [[Query]] to perform `INSERT INTO ... SELECT` SQL statement.";s:4:"type";s:19:"array|\yii\db\Query";s:5:"types";a:2:{i:0;s:5:"array";i:1;s:13:"\yii\db\Query";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/QueryBuilder.php";}s:14:"$updateColumns";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:14:"$updateColumns";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:239:"The column data (name => value) to be updated if they already exist.
