and the array values are the corresponding CSS property values.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:73:"The CSS style string. If the CSS style is empty, a null will be returned.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:56244;s:4:"name";s:17:"cssStyleFromArray";s:8:"fullName";s:39:"yii\helpers\BaseHtml::cssStyleFromArray";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";s:9:"startLine";i:2211;s:7:"endLine";i:2219;s:16:"shortDescription";s:56:"Converts a CSS style array into a string representation.";s:11:"description";s:146:"For example,

```
