in a cache entry by returning an array instead of `true`.";s:5:"since";s:6:"2.0.11";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:20:"afterRestoreResponse";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\filters\PageCache";s:10:"sourceCode";s:48:"public function afterRestoreResponse($data)
