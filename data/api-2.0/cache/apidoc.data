";s:6:"params";a:2:{s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:845:"The value to be formatted. The following
types of value are supported:

- an integer representing a UNIX timestamp. A UNIX timestamp is always in UTC by its definition.
- a string that can be [parsed to create a DateTime object](https://www.php.net/manual/en/datetime.formats.php).
  The timestamp is assumed to be in [[defaultTimeZone]] unless a time zone is explicitly given.
- a PHP [DateTime](https://www.php.net/manual/en/class.datetime.php) object. You may set the time zone
  for the DateTime object to specify the source time zone.

The formatter will convert date values according to [[timeZone]] before formatting it.
If no timezone conversion should be performed, you need to set [[defaultTimeZone]] and [[timeZone]] to the same value.
Also no conversion will be performed on values that have no time information, e.g. `"2017-06-05"`.";s:4:"type";s:44:"int|string|\DateTime|\DateTimeInterface|null";s:5:"types";a:5:{i:0;s:3:"int";i:1;s:6:"string";i:2;s:9:"\DateTime";i:3;s:18:"\DateTimeInterface";i:4;s:4:"null";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";}s:7:"$format";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$format";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:514:"The format used to convert the value into a date string.
If null, [[dateFormat]] will be used.

This can be "short", "medium", "long", or "full", which represents a preset format of different lengths.
It can also be a custom format as specified in the [ICU manual](https://unicode-org.github.io/icu/userguide/format_parse/datetime/).

Alternatively this can be a string prefixed with `php:` representing a format that can be recognized by the
PHP [date()](https://www.php.net/manual/en/function.date.php)-function.";s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";}}s:10:"exceptions";a:2:{s:34:"\yii\base\InvalidArgumentException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:56:"if the input value can not be evaluated as a date value.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:30:"if the date format is invalid.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:21:"The formatted result.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:2299;s:4:"name";s:6:"asDate";s:8:"fullName";s:26:"yii\i18n\Formatter::asDate";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";s:9:"startLine";i:652;s:7:"endLine";i:659;s:16:"shortDescription";s:28:"Formats the value as a date.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:5;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:20:"\yii\i18n\dateFormat";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:10:"dateFormat";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:6:"asTime";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b: