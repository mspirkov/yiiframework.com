of a profiling block.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:8:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:14:"yii\log\Logger";s:10:"sourceCode";s:460:"public function init()
{
    parent::init();
    register_shutdown_function(function () {
        // make regular flush before other shutdown functions, which allows session data collection and so on
        $this->flush();
        // make sure log entries written by shutdown functions are also flushed
        // ensure "flush()" is called last when there are multiple shutdown functions
        register_shutdown_function([$this, 'flush'], true);
    });
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:65202;s:4:"name";s:4:"init";s:8:"fullName";s:20:"yii\log\Logger::init";s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/Logger.php";s:9:"startLine";i:131;s:7:"endLine";i:141;s:16:"shortDescription";s:73:"Initializes the logger by registering [[flush()]] as a shutdown function.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:3:"log";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:14:"yii\log\Logger";s:10:"sourceCode";s:1162:"public function log($message, $level, $category = 'application')
{
    $time = microtime(true);
    $traces = [];
    if ($this->traceLevel > 0) {
        $count = 0;
        $ts = debug_backtrace(DEBUG_BACKTRACE_IGNORE_ARGS);
        array_pop($ts); // remove the last trace since it would be the entry script, not very useful
        foreach ($ts as $trace) {
            if (isset($trace['file'], $trace['line']) && strpos($trace['file'], YII2_PATH) !== 0) {
                unset($trace['object'], $trace['args']);
                $traces[] = $trace;
                if (++$count >= $this->traceLevel) {
                    break;
                }
            }
        }
    }
    $data = [$message, $level, $category, $time, $traces, memory_get_usage()];
    if ($this->profilingAware && in_array($level, [self::LEVEL_PROFILE_BEGIN, self::LEVEL_PROFILE_END])) {
        $this->messages[($level == self::LEVEL_PROFILE_BEGIN ? 'begin-' : 'end-') . md5(json_encode($message))] = $data;
    } else {
        $this->messages[] = $data;
    }
    if ($this->flushInterval > 0 && count($this->messages) >= $this->flushInterval) {
        $this->flush();
    }
}
