- X-PINGOTHER -> X-Pingother
- X_PINGOTHER -> X-Pingother";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"headerizeToPhp";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:16:"yii\filters\Cors";s:10:"sourceCode";s:126:"protected function headerizeToPhp($string)
