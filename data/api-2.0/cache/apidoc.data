";s:6:"params";a:1:{s:9:"$viewName";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$viewName";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:9:"View name";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/ViewAction.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:23:"Result of the rendering";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:98092;s:4:"name";s:6:"render";s:8:"fullName";s:26:"yii\web\ViewAction::render";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/ViewAction.php";s:9:"startLine";i:109;s:7:"endLine";i:112;s:16:"shortDescription";s:15:"Renders a view.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:15:"resolveViewName";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:18:"yii\web\ViewAction";s:10:"sourceCode";s:685:"protected function resolveViewName()
{
    $viewName = Yii::$app->request->get($this->viewParam, $this->defaultView);
    if (!is_string($viewName) || !preg_match('~^\w(?:(?!\/\.{0,2}\/)[\w\/\-\.])*$~', $viewName)) {
        if (YII_DEBUG) {
            throw new NotFoundHttpException("The requested view \"$viewName\" must start with a word character, must not contain /../ or /./, can contain only word characters, forward slashes, dots and dashes.");
        }
        throw new NotFoundHttpException(Yii::t('yii', 'The requested view "{name}" was not found.', ['name' => $viewName]));
    }
    return empty($this->viewPrefix) ? $viewName : $this->viewPrefix . '/' . $viewName;
}
