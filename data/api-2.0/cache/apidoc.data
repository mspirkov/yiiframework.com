The `memory` and `memoryDiff` values are available since version 2.0.11.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:65202;s:4:"name";s:12:"getProfiling";s:8:"fullName";s:28:"yii\log\Logger::getProfiling";s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/Logger.php";s:9:"startLine";i:257;s:7:"endLine";i:300;s:16:"shortDescription";s:30:"Returns the profiling results.";s:11:"description";s:172:"By default, all profiling results will be returned. You may provide
`$categories` and `$excludeCategories` as parameters to retrieve the
results that you are interested in.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"getDbProfiling";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:14:"yii\log\Logger";s:10:"sourceCode";s:247:"public function getDbProfiling()
{
    $timings = $this->getProfiling($this->dbEventNames);
    $count = count($timings);
    $time = 0;
    foreach ($timings as $timing) {
        $time += $timing['duration'];
    }
    return [$count, $time];
}
