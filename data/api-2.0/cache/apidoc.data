ntroller::EXIT_CODE_NO_ROUTING_FILE";s:10:"sourceFile";N;s:9:"startLine";i:31;s:7:"endLine";i:31;s:16:"shortDescription";N;s:11:"description";N;s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:41:"EXIT_CODE_ADDRESS_TAKEN_BY_ANOTHER_SERVER";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:39:"yii\console\controllers\ServeController";s:5:"value";s:1:"4";s:13:"phpDocContext";N;s:4:"name";s:41:"EXIT_CODE_ADDRESS_TAKEN_BY_ANOTHER_SERVER";s:8:"fullName";s:82:"yii\console\controllers\ServeController::EXIT_CODE_ADDRESS_TAKEN_BY_ANOTHER_SERVER";s:10:"sourceFile";N;s:9:"startLine";i:32;s:7:"endLine";i:32;s:16:"shortDescription";N;s:11:"description";N;s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:42:"EXIT_CODE_ADDRESS_TAKEN_BY_ANOTHER_PROCESS";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:39:"yii\console\controllers\ServeController";s:5:"value";s:1:"5";s:13:"phpDocContext";N;s:4:"name";s:42:"EXIT_CODE_ADDRESS_TAKEN_BY_ANOTHER_PROCESS";s:8:"fullName";s:83:"yii\console\controllers\ServeController::EXIT_CODE_ADDRESS_TAKEN_BY_ANOTHER_PROCESS";s:10:"sourceFile";N;s:9:"startLine";i:33;s:7:"endLine";i:33;s:16:"shortDescription";N;s:11:"description";N;s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:7:"authors";a:1:{s:17:"Alexander Makarov";s:17:"sam@rmcreative.ru";}s:7:"methods";a:5:{s:11:"actionIndex";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:39:"yii\console\controllers\ServeController";s:10:"sourceCode";s:1376:"public function actionIndex($address = 'localhost')
{
    $documentRoot = Yii::getAlias($this->docroot);
    $router = $this->router !== null ? Yii::getAlias($this->router) : null;
    if (strpos($address, ':') === false) {
        $address = $address . ':' . $this->port;
    }
    if (!is_dir($documentRoot)) {
        $this->stdout("Document root \"$documentRoot\" does not exist.\n", Console::FG_RED);
        return self::EXIT_CODE_NO_DOCUMENT_ROOT;
    }
    if ($this->isAddressTaken($address)) {
        $this->stdout("http://$address is taken by another process.\n", Console::FG_RED);
        return self::EXIT_CODE_ADDRESS_TAKEN_BY_ANOTHER_PROCESS;
    }
    if ($this->router !== null && !file_exists($router)) {
        $this->stdout("Routing file \"$router\" does not exist.\n", Console::FG_RED);
        return self::EXIT_CODE_NO_ROUTING_FILE;
    }
    $this->stdout("Server started on http://{$address}/\n");
    $this->stdout("Document root is \"{$documentRoot}\"\n");
    if ($this->router) {
        $this->stdout("Routing file is \"$router\"\n");
    }
    $this->stdout("Quit the server with CTRL-C or COMMAND-C.\n");
    $command = '"' . PHP_BINARY . '"' . " -S {$address} -t \"{$documentRoot}\"";
    if ($this->router !== null && $router !== '') {
        $command .= " \"{$router}\"";
    }
    $this->runCommand($command);
    return ExitCode::OK;
}
