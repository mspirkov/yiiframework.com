9:"if the input value is not numeric or the formatting failed.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:68:"when INTL is not installed or does not contain required information.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:21:"The formatted result.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:2299;s:4:"name";s:13:"asShortWeight";s:8:"fullName";s:33:"yii\i18n\Formatter::asShortWeight";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";s:9:"startLine";i:1605;s:7:"endLine";i:1608;s:16:"shortDescription";s:73:"Formats the value as a weight in human readable form for example `12 kg`.";s:11:"description";s:238:"This is the short form of [[asWeight]].

Check properties [[baseUnits]] if you need to change unit of value as the multiplier
of the smallest unit and [[systemOfUnits]] to switch between [[UNIT_SYSTEM_METRIC]] or [[UNIT_SYSTEM_IMPERIAL]].";s:5:"since";s:6:"2.0.13";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:8;O:45:"phpDocumentor\Reflection\DocBlock\Tags\Author":4:{s:7:"␀*␀name";s:6:"author";s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Author␀authorName";s:8:"John Was";s:58:"␀phpDocumentor\Reflection\DocBlock\Tags\Author␀authorEmail";s:19:"janek.jan@gmail.com";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:12:"formatNumber";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:18:"yii\i18n\Formatter";s:10:"sourceCode";s:1877:"protected function formatNumber($value, $decimals, $maxPosition, $formatBase, $options, $textOptions)
{
    $value = $this->normalizeNumericValue($value);
    $position = 0;
    if (is_array($formatBase)) {
        $maxPosition = count($formatBase) - 1;
    }
    do {
        if (is_array($formatBase)) {
            if (!isset($formatBase[$position + 1])) {
                break;
            }
            if (abs($value) < $formatBase[$position + 1]) {
                break;
            }
        } else {
            if (abs($value) < $formatBase) {
                break;
            }
            $value /= $formatBase;
        }
        $position++;
    } while ($position < $maxPosition + 1);
    if (is_array($formatBase) && $position !== 0) {
        $value /= $formatBase[$position];
    }
    // no decimals for smallest unit
    if ($position === 0) {
        $decimals = 0;
    } elseif ($decimals !== null) {
        $value = round($value, $decimals);
    }
    // disable grouping for edge cases like 1023 to get 1023 B instead of 1,023 B
    $oldThousandSeparator = $this->thousandSeparator;
    $this->thousandSeparator = '';
    if ($this->_intlLoaded && !isset($options[NumberFormatter::GROUPING_USED])) {
        $options[NumberFormatter::GROUPING_USED] = 0;
    }
    // format the size value
    $params = [
        // this is the unformatted number used for the plural rule
        // abs() to make sure the plural rules work correctly on negative numbers, intl does not cover this
        // https://english.stackexchange.com/questions/9735/is-1-followed-by-a-singular-or-plural-noun
        'n' => abs($value),
        // this is the formatted number used for display
        'nFormatted' => $this->asDecimal($value, $decimals, $options, $textOptions),
    ];
    $this->thousandSeparator = $oldThousandSeparator;
    return [$params, $position];
}
";s:6:"params";a:6:{s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:31:"Value in bytes to be formatted.";s:4:"type";s:16:"string|int|float";s:5:"types";a:3:{i:0;s:6:"string";i:1;s:3:"int";i:2;s:5:"float";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";}s:9:"$decimals";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$decimals";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:44:"The number of digits after the decimal point";s:4:"type";s:8:"int|null";s:5:"types";a:2:{i:0;s:3:"int";i:1;s:4:"null";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";}s:12:"$maxPosition";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:12:"$maxPosition";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:74:"Maximum internal position of size unit, ignored if $formatBase is an array";s:4:"type";s:3:"int";s:5:"types";a:1:{i:0;s:3:"int";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";}s:11:"$formatBase";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:11:"$formatBase";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:80:"The base at which each next unit is calculated, either 1000 or 1024, or an array";s:4:"type";s:9:"array|int";s:5:"types";a:2:{i:0;s:5:"array";i:1;s:3:"int";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";}s:8:"$options";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$options";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:111:"Optional configuration for the number formatter. This parameter will be merged with [[numberFormatterOptions]].";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";}s:12:"$textOptions";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:12:"$textOptions";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:115:"Optional configuration for the number formatter. This parameter will be merged with [[numberFormatterTextOptions]].";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";}}s:10:"exceptions";a:1:{s:34:"\yii\base\InvalidArgumentException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:59:"if the input value is not numeric or the formatting failed.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:83:"[parameters for Yii::t containing formatted number, internal position of size unit]";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:2299;s:4:"name";s:12:"formatNumber";s:8:"fullName";s:32:"yii\i18n\Formatter::formatNumber";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";s:9:"startLine";i:1704;s:7:"endLine";i:1758;s:16:"shortDescription";s:72:"Given the value in bytes formats number part of the human readable form.";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.32";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:21:"normalizeNumericValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:18:"yii\i18n\Formatter";s:10:"sourceCode";s:328:"protected function normalizeNumericValue($value)
{
    if (empty($value)) {
        return 0;
    }
    if (is_string($value) && is_numeric($value)) {
        $value = (float) $value;
    }
    if (!is_numeric($value)) {
        throw new InvalidArgumentException("'$value' is not a numeric value.");
    }
    return $value;
}
";s:6:"params";a:1:{s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:15:"The input value";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";}}s:10:"exceptions";a:1:{s:34:"\yii\base\InvalidArgumentException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:34:"if the input value is not numeric.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:27:"The normalized number value";s:10:"returnType";s:9:"float|int";s:11:"returnTypes";a:2:{i:0;s:5:"float";i:1;s:3:"int";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:2299;s:4:"name";s:21:"normalizeNumericValue";s:8:"fullName";s:41:"yii\i18n\Formatter::normalizeNumericValue";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/Formatter.php";s:9:"startLine";i:1772;s:7:"endLine";i:1785;s:16:"shortDescription";s:33:"Normalizes a numeric input value.";s:11:"description";s:335:"- everything [empty](https://www.php.net/manual/en/function.empty.php) will result in `0`
- a [numeric](https://www.php.net/manual/en/function.is-numeric.php) string will be casted to float
- everything else will be returned if it is [numeric](https://www.php.net/manual/en/function.is-numeric.php),
  otherwise an exception is thrown.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:21:"createNumberFormatter";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:18:"yii\i18n\Formatter";s:10:"sourceCode";s:1931:"protected function createNumberFormatter($style, $decimals = null, $options = [], $textOptions = [])
{
    $formatter = new NumberFormatter($this->locale, $style);
    // set text attributes
    foreach ($this->numberFormatterTextOptions as $attribute => $value) {
        $this->setFormatterTextAttribute($formatter, $attribute, $value, 'numberFormatterTextOptions', 'numberFormatterOptions');
    }
    foreach ($textOptions as $attribute => $value) {
        $this->setFormatterTextAttribute($formatter, $attribute, $value, '$textOptions', '$options');
    }
    // set attributes
    foreach ($this->numberFormatterOptions as $attribute => $value) {
        $this->setFormatterIntAttribute($formatter, $attribute, $value, 'numberFormatterOptions', 'numberFormatterTextOptions');
    }
    foreach ($options as $attribute => $value) {
        $this->setFormatterIntAttribute($formatter, $attribute, $value, '$options', '$textOptions');
    }
    if ($decimals !== null) {
        $formatter->setAttribute(NumberFormatter::MAX_FRACTION_DIGITS, $decimals);
        $formatter->setAttribute(NumberFormatter::MIN_FRACTION_DIGITS, $decimals);
    }
    // set symbols
    if ($this->decimalSeparator !== null) {
        $formatter->setSymbol(NumberFormatter::DECIMAL_SEPARATOR_SYMBOL, $this->decimalSeparator);
    }
    if ($this->currencyDecimalSeparator !== null) {
        $formatter->setSymbol(NumberFormatter::MONETARY_SEPARATOR_SYMBOL, $this->currencyDecimalSeparator);
    }
    if ($this->thousandSeparator !== null) {
        $formatter->setSymbol(NumberFormatter::GROUPING_SEPARATOR_SYMBOL, $this->thousandSeparator);
        $formatter->setSymbol(NumberFormatter::MONETARY_GROUPING_SEPARATOR_SYMBOL, $this->thousandSeparator);
    }
    foreach ($this->numberFormatterSymbols as $symbol => $value) {
        $this->setFormatterSymbol($formatter, $symbol, $value, 'numberFormatterSymbols');
    }
    return $formatter;
}
