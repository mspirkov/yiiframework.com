";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:43:"Whether the flush operation was successful.";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:121881;s:4:"name";s:11:"flushValues";s:8:"fullName";s:32:"yii\caching\DbCache::flushValues";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/DbCache.php";s:9:"startLine";i:292;s:7:"endLine";i:299;s:16:"shortDescription";s:30:"Deletes all values from cache.";s:11:"description";s:70:"This is the implementation of the method declared in the parent class.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:20:"isVarbinaryDataField";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\caching\DbCache";s:10:"sourceCode";s:338:"protected function isVarbinaryDataField()
{
    if ($this->isVarbinaryDataField === null) {
        $this->isVarbinaryDataField = in_array($this->db->getDriverName(), ['sqlsrv', 'dblib']) &&
            $this->db->getTableSchema($this->cacheTable)->columns['data']->dbType === 'varbinary';
    }
    return $this->isVarbinaryDataField;
}
