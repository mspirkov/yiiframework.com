{
    if (isset($this->queryOperatorMap[$operator])) {
        $operator = $this->queryOperatorMap[$operator];
    }
    return [
        $operator,
        $this->buildCondition($condition),
    ];
}
";s:6:"params";a:2:{s:9:"$operator";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$operator";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:17:"Operator keyword.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/ActiveDataFilter.php";}s:10:"$condition";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$condition";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:14:"Raw condition.";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/ActiveDataFilter.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:17:"Actual condition.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:8624;s:4:"name";s:19:"buildBlockCondition";s:8:"fullName";s:46:"yii\data\ActiveDataFilter::buildBlockCondition";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/ActiveDataFilter.php";s:9:"startLine";i:141;s:7:"endLine";i:150;s:16:"shortDescription";s:61:"Builds block condition, which consists of a single condition.";s:11:"description";s:34:"It covers such operators as `not`.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:23:"buildAttributeCondition";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:25:"yii\data\ActiveDataFilter";s:10:"sourceCode";s:1068:"protected function buildAttributeCondition($attribute, $condition)
{
    if (is_array($condition)) {
        $parts = [];
        foreach ($condition as $operator => $value) {
            if (isset($this->operatorTypes[$operator])) {
                if (isset($this->conditionBuilders[$operator])) {
                    $method = $this->conditionBuilders[$operator];
                    if (is_string($method)) {
                        $callback = [$this, $method];
                    } else {
                        $callback = $method;
                    }
                    $parts[] = $callback($operator, $value, $attribute);
                } else {
                    $parts[] = $this->buildOperatorCondition($operator, $value, $attribute);
                }
            }
        }
        if (!empty($parts)) {
            if (count($parts) > 1) {
                return array_merge(['AND'], $parts);
            }
            return array_shift($parts);
        }
    }
    return [$attribute => $this->filterAttributeValue($attribute, $condition)];
}
