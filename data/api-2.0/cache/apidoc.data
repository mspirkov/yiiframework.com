";s:6:"params";a:1:{s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:553:"Cookie parameters, valid keys include: `lifetime`, `path`, `domain`, `secure` and `httponly`.
Starting with Yii 2.0.21 `sameSite` is also supported. It requires PHP version 7.3.0 or higher.
For security, an exception will be thrown if `sameSite` is set while using an unsupported version of PHP.
To use this feature across different PHP versions check the version first. E.g.
```
[
    'sameSite' => PHP_VERSION_ID >= 70300 ? yii\web\Cookie::SAME_SITE_LAX : null,
]
```
See https://owasp.org/www-community/SameSite for more information about `sameSite`.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Session.php";}}s:10:"exceptions";a:1:{s:34:"\yii\base\InvalidArgumentException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:33:"if the parameters are incomplete.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:106378;s:4:"name";s:15:"setCookieParams";s:8:"fullName";s:32:"yii\web\Session::setCookieParams";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Session.php";s:9:"startLine";i:408;s:7:"endLine";i:411;s:16:"shortDescription";s:35:"Sets the session cookie parameters.";s:11:"description";s:108:"The cookie parameters passed to this method will be merged with the result
of `session_get_cookie_params()`.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:2;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:68:"https://www.php.net/manual/en/function.session-set-cookie-params.php";}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:13:"getUseCookies";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\web\Session";s:10:"sourceCode";s:240:"public function getUseCookies()
{
    if (ini_get('session.use_cookies') === '0') {
        return false;
    } elseif (PHP_VERSION_ID >= 80400 || ini_get('session.use_only_cookies') === '1') {
        return true;
    }
    return null;
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:73:"The value indicating whether cookies should be used to store session IDs.";s:10:"returnType";s:9:"bool|null";s:11:"returnTypes";a:2:{i:0;s:4:"bool";i:1;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:106378;s:4:"name";s:13:"getUseCookies";s:8:"fullName";s:30:"yii\web\Session::getUseCookies";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Session.php";s:9:"startLine";i:441;s:7:"endLine";i:450;s:16:"shortDescription";s:81:"Returns the value indicating whether cookies should be used to store session IDs.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:1;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:24:"\yii\web\setUseCookies()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:13:"setUseCookies";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:13:"setUseCookies";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\web\Session";s:10:"sourceCode";s:607:"public function setUseCookies($value)
{
    $this->freeze();
    if ($value === false) {
        ini_set('session.use_cookies', '0');
        if (PHP_VERSION_ID < 80400) {
            ini_set('session.use_only_cookies', '0');
        }
    } elseif ($value === true) {
        ini_set('session.use_cookies', '1');
        if (PHP_VERSION_ID < 80400) {
            ini_set('session.use_only_cookies', '1');
        }
    } else {
        ini_set('session.use_cookies', '1');
        if (PHP_VERSION_ID < 80400) {
            ini_set('session.use_only_cookies', '0');
        }
    }
    $this->unfreeze();
}
";s:6:"params";a:1:{s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:73:"The value indicating whether cookies should be used to store session IDs.";s:4:"type";s:9:"bool|null";s:5:"types";a:2:{i:0;s:4:"bool";i:1;s:4:"null";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Session.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:106378;s:4:"name";s:13:"setUseCookies";s:8:"fullName";s:30:"yii\web\Session::setUseCookies";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Session.php";s:9:"startLine";i:463;s:7:"endLine";i:483;s:16:"shortDescription";s:78:"Sets the value indicating whether cookies should be used to store session IDs.";s:11:"description";s:274:"Three states are possible:

- true: cookies and only cookies will be used to store session IDs.
- false: cookies will not be used to store session IDs.
- null: if possible, cookies will be used to store session IDs; if not, other mechanisms will be used (e.g. GET parameter)";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"getGCProbability";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\web\Session";s:10:"sourceCode";s:289:"public function getGCProbability()
{
    /** @phpstan-var numeric-string|false */
    $gcProbability = ini_get('session.gc_probability');
    /** @phpstan-var numeric-string|false */
    $gcDivisor = ini_get('session.gc_divisor');
    return (float) ($gcProbability / $gcDivisor * 100);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:113:"The probability (percentage) that the GC (garbage collection) process is started on every session initialization.";s:10:"returnType";s:5:"float";s:11:"returnTypes";a:1:{i:0;s:5:"float";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:106378;s:4:"name";s:16:"getGCProbability";s:8:"fullName";s:33:"yii\web\Session::getGCProbability";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Session.php";s:9:"startLine";i:488;s:7:"endLine";i:497;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"setGCProbability";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\web\Session";s:10:"sourceCode";s:429:"public function setGCProbability($value)
{
    $this->freeze();
    if ($value >= 0 && $value <= 100) {
        // percent * 21474837 / 2147483647 ≈ percent * 0.01
        ini_set('session.gc_probability', floor($value * 21474836.47));
        ini_set('session.gc_divisor', 2147483647);
    } else {
        throw new InvalidArgumentException('GCProbability must be a value between 0 and 100.');
    }
    $this->unfreeze();
}
