;O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:31:"yii\filters\auth\QueryParamAuth";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:27:"yii\filters\auth\AuthMethod";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:1:{s:12:"authenticate";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:31:"yii\filters\auth\QueryParamAuth";s:10:"sourceCode";s:405:"public function authenticate($user, $request, $response)
{
    $accessToken = $request->get($this->tokenParam);
    if (is_string($accessToken)) {
        $identity = $user->loginByAccessToken($accessToken, get_class($this));
        if ($identity !== null) {
            return $identity;
        }
    }
    if ($accessToken !== null) {
        $this->handleFailure($response);
    }
    return null;
}
