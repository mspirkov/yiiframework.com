";s:6:"params";a:1:{s:6:"$level";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$level";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:316:"The transaction isolation level to use for this transaction.
This can be one of [[Transaction::READ_UNCOMMITTED]], [[Transaction::READ_COMMITTED]], [[Transaction::REPEATABLE_READ]]
and [[Transaction::SERIALIZABLE]] but also a string containing DBMS specific syntax to be used
after `SET TRANSACTION ISOLATION LEVEL`.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:88:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:190770;s:4:"name";s:28:"setTransactionIsolationLevel";s:8:"fullName";s:43:"yii\db\Schema::setTransactionIsolationLevel";s:10:"sourceFile";s:88:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Schema.php";s:9:"startLine";i:424;s:7:"endLine";i:427;s:16:"shortDescription";s:52:"Sets the isolation level of the current transaction.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:1;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:79:"https://en.wikipedia.org/wiki/Isolation_%28database_systems%29#Isolation_levels";}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:6:"insert";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:13:"yii\db\Schema";s:10:"sourceCode";s:599:"public function insert($table, $columns)
{
    $command = $this->db->createCommand()->insert($table, $columns);
    if (!$command->execute()) {
        return false;
    }
    $tableSchema = $this->getTableSchema($table);
    $result = [];
    foreach ($tableSchema->primaryKey as $name) {
        if ($tableSchema->columns[$name]->autoIncrement) {
            $result[$name] = $this->getLastInsertID($tableSchema->sequenceName);
            break;
        }
        $result[$name] = isset($columns[$name]) ? $columns[$name] : $tableSchema->columns[$name]->defaultValue;
    }
    return $result;
}
