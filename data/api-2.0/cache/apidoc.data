if the query results in nothing.";s:10:"returnType";s:31:"array|\yii\db\ActiveRecord|null";s:11:"returnTypes";a:3:{i:0;s:5:"array";i:1;s:20:"\yii\db\ActiveRecord";i:2;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:183465;s:4:"name";s:3:"one";s:8:"fullName";s:23:"yii\db\ActiveQuery::one";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQuery.php";s:9:"startLine";i:332;s:7:"endLine";i:341;s:16:"shortDescription";s:50:"Executes query and returns a single row of result.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:2;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:12:"psalm-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:6:"T|null";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:3;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:14:"phpstan-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:6:"T|null";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:13:"createCommand";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\db\ActiveQuery";s:10:"sourceCode";s:477:"public function createCommand($db = null)
{
    /** @var ActiveRecord $modelClass */
    $modelClass = $this->modelClass;
    if ($db === null) {
        $db = $modelClass::getDb();
    }
    if ($this->sql === null) {
        list($sql, $params) = $db->getQueryBuilder()->build($this);
    } else {
        $sql = $this->sql;
        $params = $this->params;
    }
    $command = $db->createCommand($sql, $params);
    $this->setCommandCache($command);
    return $command;
}
