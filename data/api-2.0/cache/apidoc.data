catedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:4;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:23:"\yii\widgets\beforeItem";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:10:"beforeItem";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:15:"renderAfterItem";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:20:"yii\widgets\ListView";s:10:"sourceCode";s:209:"protected function renderAfterItem($model, $key, $index)
{
    if ($this->afterItem instanceof Closure) {
        return call_user_func($this->afterItem, $model, $key, $index, $this);
    }
    return null;
}
