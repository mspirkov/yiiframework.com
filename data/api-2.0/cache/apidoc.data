{
    parent::init();
    if (strncmp($this->db->driverName, 'oci', 3) !== 0 && strncmp($this->db->driverName, 'odbc', 4) !== 0) {
        throw new InvalidConfigException('In order to use OracleMutex connection must be configured to use Oracle database.');
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:35:"if [[db]] is not Oracle connection.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:128279;s:4:"name";s:4:"init";s:8:"fullName";s:27:"yii\mutex\OracleMutex::init";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mutex/OracleMutex.php";s:9:"startLine";i:67;s:7:"endLine";i:73;s:16:"shortDescription";s:59:"Initializes Oracle specific mutex component implementation.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"acquireLock";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:21:"yii\mutex\OracleMutex";s:10:"sourceCode";s:846:"protected function acquireLock($name, $timeout = 0)
{
    $lockStatus = null;
    // clean vars before using
    $releaseOnCommit = $this->releaseOnCommit ? 'TRUE' : 'FALSE';
    $timeout = abs((int) $timeout);
    // inside pl/sql scopes pdo binding not working correctly :(
    $this->db->useMaster(function ($db) use ($name, $timeout, $releaseOnCommit, &$lockStatus) {
        /** @var \yii\db\Connection $db */
        $db->createCommand(
            'DECLARE
handle VARCHAR2(128);
N
DBMS_LOCK.ALLOCATE_UNIQUE(:name, handle);
:lockStatus := DBMS_LOCK.REQUEST(handle, DBMS_LOCK.' . $this->lockMode . ', ' . $timeout . ', ' . $releaseOnCommit . ');
',
            [':name' => $name]
        )
        ->bindParam(':lockStatus', $lockStatus, PDO::PARAM_INT, 1)
        ->execute();
    });
    return $lockStatus === 0 || $lockStatus === '0';
}
