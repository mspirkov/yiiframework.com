This is needed by other DB-related fixtures (e.g. [[ActiveFixture]]) so that they can populate
data into the database without triggering integrity check errors.

Besides, DbFixture also attempts to load an [[initScript|initialization script]] if it exists.

You should normally use InitDbFixture to prepare a skeleton test database.
Other DB fixtures will then add specific tables and data to this database.

For more details and usage information on InitDbFixture, see the [guide article on fixtures](guide:test-fixtures).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:22:"yii\test\ActiveFixture";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:26:"yii\test\BaseActiveFixture";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:6:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:22:"yii\test\ActiveFixture";s:10:"sourceCode";s:367:"public function init()
{
    parent::init();
    if ($this->tableName === null) {
        if ($this->modelClass === null) {
            throw new InvalidConfigException('Either "modelClass" or "tableName" must be set.');
        }
        /** @var ActiveRecord $modelClass */
        $modelClass = $this->modelClass;
        $this->db = $modelClass::getDb();
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:8:"yii\test";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:3:{s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:12:"ActiveRecord";s:19:"yii\db\ActiveRecord";s:11:"TableSchema";s:18:"yii\db\TableSchema";}}s:4:"name";s:4:"init";s:8:"fullName";s:28:"yii\test\ActiveFixture::init";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/test/ActiveFixture.php";s:9:"startLine";i:59;s:7:"endLine";i:70;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:4:"load";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:22:"yii\test\ActiveFixture";s:10:"sourceCode";s:404:"public function load()
{
    $this->data = [];
    $table = $this->getTableSchema();
    foreach ($this->getData() as $alias => $row) {
        $primaryKeys = $this->db->schema->insert($table->fullName, $row);
        $this->data[$alias] = array_merge($row, $primaryKeys);
    }
    if ($table->sequenceName !== null) {
        $this->db->createCommand()->executeResetSequence($table->fullName);
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:753;s:4:"name";s:4:"load";s:8:"fullName";s:28:"yii\test\ActiveFixture::load";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/test/ActiveFixture.php";s:9:"startLine";i:80;s:7:"endLine";i:91;s:16:"shortDescription";s:18:"Loads the fixture.";s:11:"description";s:222:"It populate the table with the data returned by [[getData()]].

If you override this method, you should consider calling the parent implementation
so that the data returned by [[getData()]] can be populated into the table.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:7:"getData";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:22:"yii\test\ActiveFixture";s:10:"sourceCode";s:457:"protected function getData()
{
    if ($this->dataFile === null) {
        if ($this->dataDirectory !== null) {
            $dataFile = $this->getTableSchema()->fullName . '.php';
        } else {
            $class = new \ReflectionClass($this);
            $dataFile = dirname($class->getFileName()) . '/data/' . $this->getTableSchema()->fullName . '.php';
        }
        return $this->loadData($dataFile, false);
    }
    return parent::getData();
}
