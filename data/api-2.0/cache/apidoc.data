";s:6:"params";a:1:{s:8:"$columns";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$columns";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:674:"The columns (and the directions) to be ordered by.
Columns can be specified in either a string (e.g. `"id ASC, name DESC"`) or an array
(e.g. `['id' => SORT_ASC, 'name' => SORT_DESC]`).

The method will automatically quote the column names unless a column contains some parenthesis
(which means the column contains a DB expression).

Note that if your order-by is an expression containing commas, you should always use an array
to represent the order-by information. Otherwise, the method will not be able to correctly determine
the order-by columns.

Since version 2.0.7, an [[ExpressionInterface]] object can be passed to specify the ORDER BY part explicitly in plain SQL.";s:4:"type";s:45:"string|array|\yii\db\ExpressionInterface|null";s:5:"types";a:4:{i:0;s:6:"string";i:1;s:5:"array";i:2;s:27:"\yii\db\ExpressionInterface";i:3;s:4:"null";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/QueryTrait.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:23:"The query object itself";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:215869;s:4:"name";s:7:"orderBy";s:8:"fullName";s:26:"yii\db\QueryTrait::orderBy";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/QueryTrait.php";s:9:"startLine";i:323;s:7:"endLine";i:327;s:16:"shortDescription";s:36:"Sets the ORDER BY part of the query.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:2;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:20:"\yii\db\addOrderBy()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:10:"addOrderBy";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:10:"addOrderBy";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\db\QueryTrait";s:10:"sourceCode";s:262:"public function addOrderBy($columns)
{
    $columns = $this->normalizeOrderBy($columns);
    if ($this->orderBy === null) {
        $this->orderBy = $columns;
    } else {
        $this->orderBy = array_merge($this->orderBy, $columns);
    }
    return $this;
}
";s:6:"params";a:1:{s:8:"$columns";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$columns";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:672:"The columns (and the directions) to be ordered by.
Columns can be specified in either a string (e.g. "id ASC, name DESC") or an array
(e.g. `['id' => SORT_ASC, 'name' => SORT_DESC]`).

The method will automatically quote the column names unless a column contains some parenthesis
(which means the column contains a DB expression).

Note that if your order-by is an expression containing commas, you should always use an array
to represent the order-by information. Otherwise, the method will not be able to correctly determine
the order-by columns.

Since version 2.0.7, an [[ExpressionInterface]] object can be passed to specify the ORDER BY part explicitly in plain SQL.";s:4:"type";s:40:"string|array|\yii\db\ExpressionInterface";s:5:"types";a:3:{i:0;s:6:"string";i:1;s:5:"array";i:2;s:27:"\yii\db\ExpressionInterface";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/QueryTrait.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:23:"The query object itself";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:215869;s:4:"name";s:10:"addOrderBy";s:8:"fullName";s:29:"yii\db\QueryTrait::addOrderBy";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/QueryTrait.php";s:9:"startLine";i:346;s:7:"endLine";i:356;s:16:"shortDescription";s:46:"Adds additional ORDER BY columns to the query.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:2;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:17:"\yii\db\orderBy()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:7:"orderBy";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:16:"normalizeOrderBy";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:17:"yii\db\QueryTrait";s:10:"sourceCode";s:639:"protected function normalizeOrderBy($columns)
{
    if (empty($columns)) {
        return [];
    } elseif ($columns instanceof ExpressionInterface) {
        return [$columns];
    } elseif (is_array($columns)) {
        return $columns;
    }
    $columns = preg_split('/\s*,\s*/', trim($columns), -1, PREG_SPLIT_NO_EMPTY);
    $result = [];
    foreach ($columns as $column) {
        if (preg_match('/^(.*?)\s+(asc|desc)$/i', $column, $matches)) {
            $result[$matches[1]] = strcasecmp($matches[2], 'desc') ? SORT_ASC : SORT_DESC;
        } else {
            $result[$column] = SORT_ASC;
        }
    }
    return $result;
}
