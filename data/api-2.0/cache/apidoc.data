s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:18:{s:11:"__construct";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\db\DataReader";s:10:"sourceCode";s:202:"public function __construct(Command $command, $config = [])
