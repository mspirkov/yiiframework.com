{
    switch (substr($string, -1)) {
        case 'M':
        case 'm':
            return (int) $string * 1048576;
        case 'K':
        case 'k':
            return (int) $string * 1024;
        case 'G':
        case 'g':
            return (int) $string * 1073741824;
        default:
            return (int) $string;
    }
}
";s:6:"params";a:1:{s:7:"$string";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$string";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:59:"Php.ini style size. Examples: `512M`, `1024K`, `1G`, `256`.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseStringHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:55:"The number of bytes equivalent to the specified string.";s:10:"returnType";s:3:"int";s:11:"returnTypes";a:1:{i:0;s:3:"int";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:61427;s:4:"name";s:21:"convertIniSizeToBytes";s:8:"fullName";s:51:"yii\helpers\BaseStringHelper::convertIniSizeToBytes";s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseStringHelper.php";s:9:"startLine";i:62;s:7:"endLine";i:77;s:16:"shortDescription";s:37:"Converts php.ini style size to bytes.";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.54";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"basename";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:28:"yii\helpers\BaseStringHelper";s:10:"sourceCode";s:407:"public static function basename($path, $suffix = '')
{
    $path = (string)$path;
    $len = mb_strlen($suffix);
    if ($len > 0 && mb_substr($path, -$len) === $suffix) {
        $path = mb_substr($path, 0, -$len);
    }
    $path = rtrim(str_replace('\\', '/', $path), '/');
    $pos = mb_strrpos($path, '/');
    if ($pos !== false) {
        return mb_substr($path, $pos + 1);
    }
    return $path;
}
";s:6:"params";a:2:{s:5:"$path";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$path";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:14:"A path string.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseStringHelper.php";}s:7:"$suffix";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$suffix";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"''";s:19:"isPassedByReference";b:0;s:11:"description";s:63:"If the name component ends in suffix this will also be cut off.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseStringHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:46:"The trailing name component of the given path.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:61427;s:4:"name";s:8:"basename";s:8:"fullName";s:38:"yii\helpers\BaseStringHelper::basename";s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseStringHelper.php";s:9:"startLine";i:92;s:7:"endLine";i:108;s:16:"shortDescription";s:46:"Returns the trailing name component of a path.";s:11:"description";s:384:"This method is similar to the php function `basename()` except that it will
treat both \ and / as directory separators, independent of the operating system.
This method was mainly created to work on php namespaces. When working with real
file paths, php's `basename()` should work fine for you.
Note: this method is not aware of the actual filesystem, or path components such as "..".";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:3;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:51:"https://www.php.net/manual/en/function.basename.php";}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:7:"dirname";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:28:"yii\helpers\BaseStringHelper";s:10:"sourceCode";s:313:"public static function dirname($path)
{
    $normalizedPath = rtrim(
        str_replace('\\', '/', (string)$path),
        '/'
    );
    $separatorPosition = mb_strrpos($normalizedPath, '/');
    if ($separatorPosition !== false) {
        return mb_substr($path, 0, $separatorPosition);
    }
    return '';
}
";s:6:"params";a:1:{s:5:"$path";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$path";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:14:"A path string.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseStringHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:28:"The parent directory's path.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:61427;s:4:"name";s:7:"dirname";s:8:"fullName";s:37:"yii\helpers\BaseStringHelper::dirname";s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseStringHelper.php";s:9:"startLine";i:119;s:7:"endLine";i:132;s:16:"shortDescription";s:32:"Returns parent directory's path.";s:11:"description";s:138:"This method is similar to `dirname()` except that it will treat
both \ and / as directory separators, independent of the operating system.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:2;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:51:"https://www.php.net/manual/en/function.basename.php";}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:8:"truncate";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:28:"yii\helpers\BaseStringHelper";s:10:"sourceCode";s:487:"public static function truncate($string, $length, $suffix = '...', $encoding = null, $asHtml = false)
{
    $string = (string)$string;
    if ($encoding === null) {
        $encoding = Yii::$app ? Yii::$app->charset : 'UTF-8';
    }
    if ($asHtml) {
        return static::truncateHtml($string, $length, $suffix, $encoding);
    }
    if (mb_strlen($string, $encoding) > $length) {
        return rtrim(mb_substr($string, 0, $length, $encoding)) . $suffix;
    }
    return $string;
}
