";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:10:"yii\db\oci";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:7:{s:24:"InvalidArgumentException";s:33:"yii\base\InvalidArgumentException";s:10:"Connection";s:17:"yii\db\Connection";s:9:"Exception";s:16:"yii\db\Exception";s:10:"Expression";s:17:"yii\db\Expression";s:5:"Query";s:12:"yii\db\Query";s:12:"StringHelper";s:24:"yii\helpers\StringHelper";s:19:"ExpressionInterface";s:26:"yii\db\ExpressionInterface";}}s:4:"name";s:25:"defaultExpressionBuilders";s:8:"fullName";s:50:"yii\db\oci\QueryBuilder::defaultExpressionBuilders";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/oci/QueryBuilder.php";s:9:"startLine";i:57;s:7:"endLine";i:63;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:20:"buildOrderByAndLimit";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\db\oci\QueryBuilder";s:10:"sourceCode";s:622:"public function buildOrderByAndLimit($sql, $orderBy, $limit, $offset)
{
    $orderBy = $this->buildOrderBy($orderBy);
    if ($orderBy !== '') {
        $sql .= $this->separator . $orderBy;
    }
    $filters = [];
    if ($this->hasOffset($offset)) {
        $filters[] = 'rowNumId > ' . $offset;
    }
    if ($this->hasLimit($limit)) {
        $filters[] = 'rownum <= ' . $limit;
    }
    if (empty($filters)) {
        return $sql;
    }
    $filter = implode(' AND ', $filters);
    return <<<EOD
 USER_SQL AS ($sql),
PAGINATION AS (SELECT USER_SQL.*, rownum as rowNumId FROM USER_SQL)
CT *
 PAGINATION
E $filter

}
