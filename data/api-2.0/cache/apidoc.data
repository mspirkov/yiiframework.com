about attribute expression.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";}s:6:"$items";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$items";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:137:"The data item used to generate the radio buttons.
The array keys are the radio values, and the array values are the corresponding labels.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";}s:8:"$options";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$options";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:1309:"Options (name => config) for the radio button list container tag.
The following options are specially handled:

- tag: string|false, the tag name of the container element. False to render radio button without container.
  See also [[tag()]].
- unselect: string, the value that should be submitted when none of the radio buttons is selected.
  You may set this option to be null to prevent default value submission.
  If this option is not set, an empty string will be submitted.
- encode: boolean, whether to HTML-encode the checkbox labels. Defaults to true.
  This option is ignored if `item` option is set.
- separator: string, the HTML code that separates items.
- itemOptions: array, the options for generating the radio button tag using [[radio()]].
- item: callable, a callback that can be used to customize the generation of the HTML code
  corresponding to a single item in $items. The signature of this callback must be:

  ```
  function ($index, $label, $name, $checked, $value)
  ```

  where $index is the zero-based index of the radio button in the whole list; $label
  is the label for the radio button; and $name, $value and $checked represent the name,
  value and the checked status of the radio button input.

See [[renderTagAttributes()]] for details on how attributes are being rendered.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:31:"The generated radio button list";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:56244;s:4:"name";s:15:"activeRadioList";s:8:"fullName";s:37:"yii\helpers\BaseHtml::activeRadioList";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";s:9:"startLine";i:1841;s:7:"endLine";i:1844;s:16:"shortDescription";s:34:"Generates a list of radio buttons.";s:11:"description";s:172:"A radio button list is like a checkbox list, except that it only allows single selection.
The selection of the radio buttons is taken from the value of the model attribute.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:15:"activeListInput";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:20:"yii\helpers\BaseHtml";s:10:"sourceCode";s:564:"protected static function activeListInput($type, $model, $attribute, $items, $options = [])
{
    $name = ArrayHelper::remove($options, 'name', static::getInputName($model, $attribute));
    $selection = ArrayHelper::remove($options, 'value', static::getAttributeValue($model, $attribute));
    if (!array_key_exists('unselect', $options)) {
        $options['unselect'] = '';
    }
    if (!array_key_exists('id', $options)) {
        $options['id'] = static::getInputId($model, $attribute);
    }
    return static::$type($name, $selection, $items, $options);
}
