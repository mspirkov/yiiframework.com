";s:11:"yii\helpers";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:0:{}}s:4:"name";s:21:"yii\helpers\Inflector";s:8:"fullName";s:21:"yii\helpers\Inflector";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/Inflector.php";s:9:"startLine";i:16;s:7:"endLine";i:18;s:16:"shortDescription";s:96:"Inflector pluralizes and singularizes English nouns. It also contains some other useful methods.";s:11:"description";s:0:"";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:20:"yii\helpers\Markdown";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:24:"yii\helpers\BaseMarkdown";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:14:"Carsten Brandt";s:12:"mail@cebe.cc";}s:7:"methods";a:0:{}s:10:"properties";a:0:{}s:9:"namespace";s:11:"yii\helpers";s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\helpers";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:0:{}}s:4:"name";s:20:"yii\helpers\Markdown";s:8:"fullName";s:20:"yii\helpers\Markdown";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/Markdown.php";s:9:"startLine";i:31;s:7:"endLine";i:33;s:16:"shortDescription";s:61:"Markdown provides an ability to transform markdown into HTML.";s:11:"description";s:666:"Basic usage is the following:

```
$myHtml = Markdown::process($myText); // use original markdown flavor
$myHtml = Markdown::process($myText, 'gfm'); // use github flavored markdown
$myHtml = Markdown::process($myText, 'extra'); // use markdown extra
```

You can configure multiple flavors using the [[$flavors]] property.

For more details please refer to the [Markdown library documentation](https://github.com/cebe/markdown#readme).

