```
'columns' => [
    // ...
    [
        'class' => 'yii\grid\SerialColumn',
        // you may configure additional properties here
    ],
]
```

For more details and usage information on SerialColumn, see the [guide article on data widgets](guide:output-data-widgets).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"yii\grid\GridView";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:24:"yii\widgets\BaseListView";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:3:{s:17:"FILTER_POS_HEADER";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:17:"yii\grid\GridView";s:5:"value";s:8:"'header'";s:13:"phpDocContext";N;s:4:"name";s:17:"FILTER_POS_HEADER";s:8:"fullName";s:36:"yii\grid\GridView::FILTER_POS_HEADER";s:10:"sourceFile";N;s:9:"startLine";i:51;s:7:"endLine";i:51;s:16:"shortDescription";N;s:11:"description";N;s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"FILTER_POS_FOOTER";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:17:"yii\grid\GridView";s:5:"value";s:8:"'footer'";s:13:"phpDocContext";N;s:4:"name";s:17:"FILTER_POS_FOOTER";s:8:"fullName";s:36:"yii\grid\GridView::FILTER_POS_FOOTER";s:10:"sourceFile";N;s:9:"startLine";i:52;s:7:"endLine";i:52;s:16:"shortDescription";N;s:11:"description";N;s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:15:"FILTER_POS_BODY";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:17:"yii\grid\GridView";s:5:"value";s:6:"'body'";s:13:"phpDocContext";N;s:4:"name";s:15:"FILTER_POS_BODY";s:8:"fullName";s:34:"yii\grid\GridView::FILTER_POS_BODY";s:10:"sourceFile";N;s:9:"startLine";i:53;s:7:"endLine";i:53;s:16:"shortDescription";N;s:11:"description";N;s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:16:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\grid\GridView";s:10:"sourceCode";s:591:"public function init()
{
    parent::init();
    if ($this->formatter === null) {
        $this->formatter = Yii::$app->getFormatter();
    } elseif (is_array($this->formatter)) {
        $this->formatter = Yii::createObject($this->formatter);
    }
    if (!$this->formatter instanceof Formatter) {
        throw new InvalidConfigException('The "formatter" property must be either a Format object or a configuration array.');
    }
    if (!isset($this->filterRowOptions['id'])) {
        $this->filterRowOptions['id'] = $this->options['id'] . '-filters';
    }
    $this->initColumns();
}
