placeholders, this will be the 1-indexed position of the parameter.";s:4:"type";s:10:"string|int";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:3:"int";}s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Command.php";}s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:34:"The value to bind to the parameter";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Command.php";}s:9:"$dataType";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$dataType";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:93:"SQL data type of the parameter. If null, the type is determined by the PHP type of the value.";s:4:"type";s:8:"int|null";s:5:"types";a:2:{i:0;s:3:"int";i:1;s:4:"null";}s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Command.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:34:"The current command being executed";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:184737;s:4:"name";s:9:"bindValue";s:8:"fullName";s:25:"yii\db\Command::bindValue";s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Command.php";s:9:"startLine";i:343;s:7:"endLine";i:352;s:16:"shortDescription";s:29:"Binds a value to a parameter.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:4;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:65:"https://www.php.net/manual/en/function.PDOStatement-bindValue.php";}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:10:"bindValues";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:14:"yii\db\Command";s:10:"sourceCode";s:1007:"public function bindValues($values)
{
    if (empty($values)) {
        return $this;
    }
    $schema = $this->db->getSchema();
    foreach ($values as $name => $value) {
        if (is_array($value)) { // TODO: Drop in Yii 2.1
            $this->pendingParams[$name] = $value;
            $this->params[$name] = $value[0];
        } elseif ($value instanceof PdoValue) {
            $this->pendingParams[$name] = [$value->getValue(), $value->getType()];
            $this->params[$name] = $value->getValue();
        } else {
            if (version_compare(PHP_VERSION, '8.1.0') >= 0) {
                if ($value instanceof \BackedEnum) {
                    $value = $value->value;
                } elseif ($value instanceof \UnitEnum) {
                    $value = $value->name;
                }
            }
            $type = $schema->getPdoType($value);
            $this->pendingParams[$name] = [$value, $type];
            $this->params[$name] = $value;
        }
    }
    return $this;
}
