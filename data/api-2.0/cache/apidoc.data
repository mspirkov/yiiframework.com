column type (if any) into the physical one. Anything that is not recognized as abstract type will be kept
in the generated SQL. For example, 'string' will be turned into 'varchar(255)', while 'string not null'
will become 'varchar(255) not null'. You can also use PostgreSQL-specific syntax such as `SET NOT NULL`.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/QueryBuilder.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:58:"The SQL statement for changing the definition of a column.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:195066;s:4:"name";s:11:"alterColumn";s:8:"fullName";s:38:"yii\db\pgsql\QueryBuilder::alterColumn";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/QueryBuilder.php";s:9:"startLine";i:255;s:7:"endLine";i:303;s:16:"shortDescription";s:63:"Builds a SQL statement for changing the definition of a column.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"insert";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\db\pgsql\QueryBuilder";s:10:"sourceCode";s:147:"public function insert($table, $columns, &$params)
