";s:6:"params";a:1:{s:10:"$tableName";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$tableName";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mysql/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:189213;s:4:"name";s:16:"loadTableUniques";s:8:"fullName";s:37:"yii\db\mysql\Schema::loadTableUniques";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mysql/Schema.php";s:9:"startLine";i:201;s:7:"endLine";i:204;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:15:"loadTableChecks";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\db\mysql\Schema";s:10:"sourceCode";s:1242:"protected function loadTableChecks($tableName)
{
    $version = $this->db->getServerVersion();
    // check version MySQL >= 8.0.16
    if (\stripos($version, 'MariaDb') === false && \version_compare($version, '8.0.16', '<')) {
        throw new NotSupportedException('MySQL < 8.0.16 does not support check constraints.');
    }
    $checks = [];
    $sql = <<<SQL
    SELECT cc.CONSTRAINT_NAME as constraint_name, cc.CHECK_CLAUSE as check_clause
    FROM INFORMATION_SCHEMA.TABLE_CONSTRAINTS tc
    JOIN INFORMATION_SCHEMA.CHECK_CONSTRAINTS cc
    ON tc.CONSTRAINT_NAME = cc.CONSTRAINT_NAME
    WHERE tc.TABLE_NAME = :tableName AND tc.CONSTRAINT_TYPE = 'CHECK';
    SQL;
    $resolvedName = $this->resolveTableName($tableName);
    $tableRows = $this->db->createCommand($sql, [':tableName' => $resolvedName->name])->queryAll();
    if ($tableRows === []) {
        return $checks;
    }
    $tableRows = $this->normalizePdoRowKeyCase($tableRows, true);
    foreach ($tableRows as $tableRow) {
        $check = new CheckConstraint(
            [
                'name' => $tableRow['constraint_name'],
                'expression' => $tableRow['check_clause'],
            ]
        );
        $checks[] = $check;
    }
    return $checks;
}
