exception with status code 422.";s:11:"description";s:256:"Use this exception to inform that the server understands the content type of
the request entity and the syntax of that request entity is correct but the server
was unable to process the contained instructions. For example, to return form
validation errors.";s:5:"since";s:5:"2.0.7";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Link":3:{s:7:"␀*␀name";s:4:"link";s:49:"␀phpDocumentor\Reflection\DocBlock\Tags\Link␀link";s:51:"http://www.webdav.org/specs/rfc2518.html#STATUS_422";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:18:"yii\web\JsonParser";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";N;s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:1:{i:0;s:30:"yii\web\RequestParserInterface";}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:11:"Dan Schmidt";s:24:"danschmidt5189@gmail.com";}s:7:"methods";a:1:{s:5:"parse";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\web\JsonParser";s:10:"sourceCode";s:570:"public function parse($rawBody, $contentType)
{
    // converts JSONP to JSON
    if (strpos($contentType, 'application/javascript') !== false) {
        $rawBody = preg_filter('/(^[^{]+|[^}]+$)/', '', $rawBody);
    }
    try {
        $parameters = Json::decode($rawBody, $this->asArray);
        return $parameters === null ? [] : $parameters;
    } catch (InvalidArgumentException $e) {
        if ($this->throwException) {
            throw new BadRequestHttpException('Invalid JSON data in request body: ' . $e->getMessage());
        }
        return [];
    }
}
