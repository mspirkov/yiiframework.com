and the last occurrence of the end string after that.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:10:"properties";a:0:{}s:9:"namespace";s:11:"yii\helpers";s:13:"phpDocContext";r:61427;s:4:"name";s:28:"yii\helpers\BaseStringHelper";s:8:"fullName";s:28:"yii\helpers\BaseStringHelper";s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseStringHelper.php";s:9:"startLine";i:21;s:7:"endLine";i:590;s:16:"shortDescription";s:71:"BaseStringHelper provides concrete implementation for [[StringHelper]].";s:11:"description";s:58:"Do not use BaseStringHelper. Use [[StringHelper]] instead.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:26:"yii\helpers\BaseFileHelper";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";N;s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:5:{s:13:"PATTERN_NODIR";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:26:"yii\helpers\BaseFileHelper";s:5:"value";s:1:"1";s:13:"phpDocContext";N;s:4:"name";s:13:"PATTERN_NODIR";s:8:"fullName";s:41:"yii\helpers\BaseFileHelper::PATTERN_NODIR";s:10:"sourceFile";N;s:9:"startLine";i:27;s:7:"endLine";i:27;s:16:"shortDescription";N;s:11:"description";N;s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"PATTERN_ENDSWITH";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:26:"yii\helpers\BaseFileHelper";s:5:"value";s:1:"4";s:13:"phpDocContext";N;s:4:"name";s:16:"PATTERN_ENDSWITH";s:8:"fullName";s:44:"yii\helpers\BaseFileHelper::PATTERN_ENDSWITH";s:10:"sourceFile";N;s:9:"startLine";i:28;s:7:"endLine";i:28;s:16:"shortDescription";N;s:11:"description";N;s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"PATTERN_MUSTBEDIR";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:26:"yii\helpers\BaseFileHelper";s:5:"value";s:1:"8";s:13:"phpDocContext";N;s:4:"name";s:17:"PATTERN_MUSTBEDIR";s:8:"fullName";s:45:"yii\helpers\BaseFileHelper::PATTERN_MUSTBEDIR";s:10:"sourceFile";N;s:9:"startLine";i:29;s:7:"endLine";i:29;s:16:"shortDescription";N;s:11:"description";N;s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"PATTERN_NEGATIVE";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:26:"yii\helpers\BaseFileHelper";s:5:"value";s:2:"16";s:13:"phpDocContext";N;s:4:"name";s:16:"PATTERN_NEGATIVE";s:8:"fullName";s:44:"yii\helpers\BaseFileHelper::PATTERN_NEGATIVE";s:10:"sourceFile";N;s:9:"startLine";i:30;s:7:"endLine";i:30;s:16:"shortDescription";N;s:11:"description";N;s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:24:"PATTERN_CASE_INSENSITIVE";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:26:"yii\helpers\BaseFileHelper";s:5:"value";s:2:"32";s:13:"phpDocContext";N;s:4:"name";s:24:"PATTERN_CASE_INSENSITIVE";s:8:"fullName";s:52:"yii\helpers\BaseFileHelper::PATTERN_CASE_INSENSITIVE";s:10:"sourceFile";N;s:9:"startLine";i:31;s:7:"endLine";i:31;s:16:"shortDescription";N;s:11:"description";N;s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:7:"authors";a:2:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";s:12:"Alex Makarov";s:17:"sam@rmcreative.ru";}s:7:"methods";a:18:{s:13:"normalizePath";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:26:"yii\helpers\BaseFileHelper";s:10:"sourceCode";s:1009:"public static function normalizePath($path, $ds = DIRECTORY_SEPARATOR)
{
    $path = rtrim(strtr($path, '/\\', $ds . $ds), $ds);
    if (strpos($ds . $path, "{$ds}.") === false && strpos($path, "{$ds}{$ds}") === false) {
        return $path;
    }
    // fix #17235 stream wrappers
    foreach (stream_get_wrappers() as $protocol) {
        if (strpos($path, "{$protocol}://") === 0) {
            return $path;
        }
    }
    // the path may contain ".", ".." or double slashes, need to clean them up
    if (strpos($path, "{$ds}{$ds}") === 0 && $ds == '\\') {
        $parts = [$ds];
    } else {
        $parts = [];
    }
    foreach (explode($ds, $path) as $part) {
        if ($part === '..' && !empty($parts) && end($parts) !== '..') {
            array_pop($parts);
        } elseif ($part === '.' || $part === '' && !empty($parts)) {
            continue;
        } else {
            $parts[] = $part;
        }
    }
    $path = implode($ds, $parts);
    return $path === '' ? '.' : $path;
}
";s:6:"params";a:2:{s:5:"$path";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$path";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:40:"The file/directory path to be normalized";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseFileHelper.php";}s:3:"$ds";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:3:"$ds";s:10:"isOptional";b:1;s:12:"defaultValue";s:19:"DIRECTORY_SEPARATOR";s:19:"isPassedByReference";b:0;s:11:"description";s:95:"The directory separator to be used in the normalized result. Defaults to `DIRECTORY_SEPARATOR`.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseFileHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:34:"The normalized file/directory path";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\helpers";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:5:{s:3:"Yii";s:3:"Yii";s:14:"ErrorException";s:23:"yii\base\ErrorException";s:9:"Exception";s:18:"yii\base\Exception";s:24:"InvalidArgumentException";s:33:"yii\base\InvalidArgumentException";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";}}s:4:"name";s:13:"normalizePath";s:8:"fullName";s:41:"yii\helpers\BaseFileHelper::normalizePath";s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseFileHelper.php";s:9:"startLine";i:66;s:7:"endLine";i:95;s:16:"shortDescription";s:33:"Normalizes a file/directory path.";s:11:"description";s:489:"The normalization does the following work:

- Convert all directory separators into `DIRECTORY_SEPARATOR` (e.g. "\a/b\c" becomes "/a/b/c")
- Remove trailing directory separators (e.g. "/a/b/c/" becomes "/a/b/c")
- Turn multiple consecutive slashes into a single one (e.g. "/a///b/c" becomes "/a/b/c")
- Remove ".." and "." based on their meanings (e.g. "/a/./b/../c" becomes "/a/c")

Note: For registered stream wrappers, the consecutive slashes rule
and ".."/"." translations are skipped.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"localize";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:26:"yii\helpers\BaseFileHelper";s:10:"sourceCode";s:779:"public static function localize($file, $language = null, $sourceLanguage = null)
{
    if ($language === null) {
        $language = Yii::$app->language;
    }
    if ($sourceLanguage === null) {
        $sourceLanguage = Yii::$app->sourceLanguage;
    }
    if ($language === $sourceLanguage) {
        return $file;
    }
    $desiredFile = dirname($file) . DIRECTORY_SEPARATOR . $language . DIRECTORY_SEPARATOR . basename($file);
    if (is_file($desiredFile)) {
        return $desiredFile;
    }
    $language = substr($language, 0, 2);
    if ($language === $sourceLanguage) {
        return $file;
    }
    $desiredFile = dirname($file) . DIRECTORY_SEPARATOR . $language . DIRECTORY_SEPARATOR . basename($file);
    return is_file($desiredFile) ? $desiredFile : $file;
}
