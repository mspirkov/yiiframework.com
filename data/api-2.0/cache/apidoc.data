existing [[context]] will be used.";s:4:"type";s:11:"object|null";s:5:"types";a:2:{i:0;s:6:"object";i:1;s:4:"null";}s:10:"sourceFile";s:88:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/View.php";}}s:10:"exceptions";a:1:{s:31:"\yii\base\ViewNotFoundException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:31:"if the view file does not exist";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:20:"The rendering result";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:86327;s:4:"name";s:10:"renderFile";s:8:"fullName";s:25:"yii\base\View::renderFile";s:10:"sourceFile";s:88:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/View.php";s:9:"startLine";i:224;s:7:"endLine";i:267;s:16:"shortDescription";s:20:"Renders a view file.";s:11:"description";s:411:"If [[theme]] is enabled (not null), it will try to render the themed version of the view file as long
as it is available.

The method will call [[FileHelper::localize()]] to localize the view file.

If [[renderers|renderer]] is enabled (not null), the method will use it to render the view file.
Otherwise, it will simply include the view file as a normal PHP file, capture its output and
return it as a string.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"getViewFile";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:13:"yii\base\View";s:10:"sourceCode";s:116:"public function getViewFile()
{
    return empty($this->_viewFiles) ? false : end($this->_viewFiles)['resolved'];
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:80:"The view file currently being rendered. False if no view file is being rendered.";s:10:"returnType";s:11:"string|bool";s:11:"returnTypes";a:2:{i:0;s:6:"string";i:1;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:86327;s:4:"name";s:11:"getViewFile";s:8:"fullName";s:26:"yii\base\View::getViewFile";s:10:"sourceFile";s:88:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/View.php";s:9:"startLine";i:272;s:7:"endLine";i:275;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:20:"getRequestedViewFile";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:13:"yii\base\View";s:10:"sourceCode";s:129:"protected function getRequestedViewFile()
{
