{
    if (!$this->screenWidth) {
        $size = Console::getScreenSize();
        $this->screenWidth = isset($size[0])
            ? $size[0]
            : self::DEFAULT_CONSOLE_SCREEN_WIDTH + self::CONSOLE_SCROLLBAR_OFFSET;
    }
    return $this->screenWidth;
}
