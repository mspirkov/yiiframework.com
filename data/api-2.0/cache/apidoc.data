]";s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:41:"yii\console\controllers\MigrateController";s:13:"phpDocContext";r:42610;s:4:"name";s:23:"$generatorTemplateFiles";s:8:"fullName";s:66:"yii\console\controllers\MigrateController::$generatorTemplateFiles";s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MigrateController.php";s:9:"startLine";i:108;s:7:"endLine";i:114;s:16:"shortDescription";s:68:"A set of template paths for generating migration code automatically.";s:11:"description";s:367:"A set of template paths for generating migration code automatically.

The key is the template type, the value is a path or the alias. Supported types are:
- `create_table`: table creating template
- `drop_table`: table dropping template
- `add_column`: adding new column template
- `drop_column`: dropping column template
- `create_junction`: create junction template";s:5:"since";s:5:"2.0.7";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:37:"phpDocumentor\Reflection\Types\Array_":3:{s:12:"␀*␀valueType";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:10:"␀*␀keyType";N;s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:367:"a set of template paths for generating migration code automatically.

