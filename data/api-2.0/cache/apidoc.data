Loaded modules will be returned as objects, while unloaded modules as configuration arrays.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Module.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:35:"The modules (indexed by their IDs).";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:77136;s:4:"name";s:10:"getModules";s:8:"fullName";s:27:"yii\base\Module::getModules";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Module.php";s:9:"startLine";i:484;s:7:"endLine";i:498;s:16:"shortDescription";s:39:"Returns the sub-modules in this module.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:10:"setModules";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\base\Module";s:10:"sourceCode";s:216:"public function setModules($modules)
