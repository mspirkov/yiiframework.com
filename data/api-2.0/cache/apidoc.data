a complex data structure consisting of factors representing the key.";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/FileCache.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:83:"True if a value exists in cache, false if the value is not in the cache or expired.";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:124459;s:4:"name";s:6:"exists";s:8:"fullName";s:29:"yii\caching\FileCache::exists";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/FileCache.php";s:9:"startLine";i:96;s:7:"endLine";i:101;s:16:"shortDescription";s:51:"Checks whether a specified key exists in the cache.";s:11:"description";s:264:"This can be faster than getting the value from the cache if the data is big.
Note that this method does not check whether the dependency associated
with the cached data, if there is any, has changed. So a call to [[get]]
may return false while exists returns true.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"getValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:21:"yii\caching\FileCache";s:10:"sourceCode";s:406:"protected function getValue($key)
{
    $cacheFile = $this->getCacheFile($key);
    if (@filemtime($cacheFile) > time()) {
        $fp = @fopen($cacheFile, 'r');
        if ($fp !== false) {
            @flock($fp, LOCK_SH);
            $cacheValue = @stream_get_contents($fp);
            @flock($fp, LOCK_UN);
            @fclose($fp);
            return $cacheValue;
        }
    }
    return false;
}
";s:6:"params";a:1:{s:4:"$key";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:4:"$key";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:41:"A unique key identifying the cached value";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/FileCache.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:77:"The value stored in cache, false if the value is not in the cache or expired.";s:10:"returnType";s:12:"string|false";s:11:"returnTypes";a:2:{i:0;s:6:"string";i:1;s:5:"false";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:124459;s:4:"name";s:8:"getValue";s:8:"fullName";s:31:"yii\caching\FileCache::getValue";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/FileCache.php";s:9:"startLine";i:109;s:7:"endLine";i:125;s:16:"shortDescription";s:50:"Retrieves a value from cache with a specified key.";s:11:"description";s:70:"This is the implementation of the method declared in the parent class.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"setValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:21:"yii\caching\FileCache";s:10:"sourceCode";s:1169:"protected function setValue($key, $value, $duration)
{
    $this->gc();
    $cacheFile = $this->getCacheFile($key);
    if ($this->directoryLevel > 0) {
        @FileHelper::createDirectory(dirname($cacheFile), $this->dirMode, true);
    }
    // If ownership differs the touch call will fail, so we try to
    // rebuild the file from scratch by deleting it first
    // https://github.com/yiisoft/yii2/pull/16120
    if (is_file($cacheFile) && function_exists('posix_geteuid') && fileowner($cacheFile) !== posix_geteuid()) {
        @unlink($cacheFile);
    }
    if (@file_put_contents($cacheFile, $value, LOCK_EX) !== false) {
        if ($this->fileMode !== null) {
            @chmod($cacheFile, $this->fileMode);
        }
        if ($duration <= 0) {
            $duration = 31536000; // 1 year
        }
        if (@touch($cacheFile, $duration + time())) {
            clearstatcache();
            return true;
        }
        return false;
    }
    $message = "Unable to write cache file '{$cacheFile}'";
    if ($error = error_get_last()) {
        $message .= ": {$error['message']}";
    }
    Yii::warning($message, __METHOD__);
    return false;
}
