xpression";s:20:"yii\web\JsExpression";s:4:"View";s:12:"yii\web\View";}}s:4:"name";s:11:"PLUGIN_NAME";s:8:"fullName";s:36:"yii\widgets\MaskedInput::PLUGIN_NAME";s:10:"sourceFile";N;s:9:"startLine";i:51;s:7:"endLine";i:51;s:16:"shortDescription";s:53:"The name of the jQuery plugin to use for this widget.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:7:"authors";a:1:{s:18:"Kartik Visweswaran";s:18:"kartikv2@gmail.com";}s:7:"methods";a:5:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\widgets\MaskedInput";s:10:"sourceCode";s:319:"public function init()
{
    parent::init();
    if (empty($this->mask) && empty($this->clientOptions['regex']) && empty($this->clientOptions['alias'])) {
        throw new InvalidConfigException("Either the 'mask' property, 'clientOptions[\"regex\"]' or the 'clientOptions[\"alias\"]' property must be set.");
    }
}
