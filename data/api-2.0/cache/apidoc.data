{
    parent::init();
    $this->basePath = Yii::getAlias($this->basePath);
    $this->basePath = realpath($this->basePath);
    $this->baseUrl = rtrim(Yii::getAlias($this->baseUrl), '/');
}
";s:6:"params";a:0:{}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:31:"if [[basePath]] does not exist.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:7:"yii\web";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:6:{s:3:"Yii";s:3:"Yii";s:9:"Component";s:18:"yii\base\Component";s:24:"InvalidArgumentException";s:33:"yii\base\InvalidArgumentException";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:10:"FileHelper";s:22:"yii\helpers\FileHelper";s:3:"Url";s:15:"yii\helpers\Url";}}s:4:"name";s:4:"init";s:8:"fullName";s:26:"yii\web\AssetManager::init";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetManager.php";s:9:"startLine";i:229;s:7:"endLine";i:236;s:16:"shortDescription";s:26:"Initializes the component.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:23:"checkBasePathPermission";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\web\AssetManager";s:10:"sourceCode";s:520:"public function checkBasePathPermission()
{
    // if the check is been done already, skip further checks
    if ($this->_isBasePathPermissionChecked) {
        return;
    }
    if (!is_dir($this->basePath)) {
        throw new InvalidConfigException("The directory does not exist: {$this->basePath}");
    }
    if (!is_writable($this->basePath)) {
        throw new InvalidConfigException("The directory is not writable by the Web process: {$this->basePath}");
    }
    $this->_isBasePathPermissionChecked = true;
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:102062;s:4:"name";s:23:"checkBasePathPermission";s:8:"fullName";s:45:"yii\web\AssetManager::checkBasePathPermission";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetManager.php";s:9:"startLine";i:248;s:7:"endLine";i:264;s:16:"shortDescription";s:51:"Check whether the basePath exists and is writeable.";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.40";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"getBundle";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\web\AssetManager";s:10:"sourceCode";s:693:"public function getBundle($name, $publish = true)
{
    if ($this->bundles === false) {
        return $this->loadDummyBundle($name);
    } elseif (!isset($this->bundles[$name])) {
        return $this->bundles[$name] = $this->loadBundle($name, [], $publish);
    } elseif ($this->bundles[$name] instanceof AssetBundle) {
        return $this->bundles[$name];
    } elseif (is_array($this->bundles[$name])) {
        return $this->bundles[$name] = $this->loadBundle($name, $this->bundles[$name], $publish);
    } elseif ($this->bundles[$name] === false) {
        return $this->loadDummyBundle($name);
    }
    throw new InvalidConfigException("Invalid asset bundle configuration: $name");
}
";s:6:"params";a:2:{s:5:"$name";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$name";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:66:"The class name of the asset bundle (without the leading backslash)";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetManager.php";}s:8:"$publish";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$publish";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"true";s:19:"isPassedByReference";b:0;s:11:"description";s:176:"Whether to publish the asset files in the asset bundle before it is returned.
If you set this false, you must manually call `AssetBundle::publish()` to publish the asset files.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetManager.php";}}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:47:"if $name does not refer to a valid asset bundle";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:25:"The asset bundle instance";s:10:"returnType";s:20:"\yii\web\AssetBundle";s:11:"returnTypes";a:1:{i:0;s:20:"\yii\web\AssetBundle";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:102062;s:4:"name";s:9:"getBundle";s:8:"fullName";s:31:"yii\web\AssetManager::getBundle";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/AssetManager.php";s:9:"startLine";i:278;s:7:"endLine";i:293;s:16:"shortDescription";s:31:"Returns the named asset bundle.";s:11:"description";s:160:"This method will first look for the bundle in [[bundles]]. If not found,
it will treat `$name` as the class of the asset bundle and create a new instance of it.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:10:"loadBundle";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:20:"yii\web\AssetManager";s:10:"sourceCode";s:305:"protected function loadBundle($name, $config = [], $publish = true)
{
    if (!isset($config['class'])) {
        $config['class'] = $name;
    }
    /** @var AssetBundle $bundle */
    $bundle = Yii::createObject($config);
    if ($publish) {
        $bundle->publish($this);
    }
    return $bundle;
}
