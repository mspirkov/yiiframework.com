pace";s:8:"yii\i18n";s:13:"phpDocContext";r:1974;s:4:"name";s:25:"yii\i18n\MessageFormatter";s:8:"fullName";s:25:"yii\i18n\MessageFormatter";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/MessageFormatter.php";s:9:"startLine";i:46;s:7:"endLine";i:441;s:16:"shortDescription";s:137:"MessageFormatter allows formatting messages via [ICU message format](https://unicode-org.github.io/icu/userguide/format_parse/messages/).";s:11:"description";s:1289:"This class enhances the message formatter class provided by the PHP intl extension.

The following enhancements are provided:

- It accepts named arguments and mixed numeric and named arguments.
- Issues no error when an insufficient number of arguments have been provided. Instead, the placeholders will not be
  substituted.
- Fixes PHP 5.5 weird placeholder replacement in case no arguments are provided at all (https://bugs.php.net/bug.php?id=65920).
- Offers limited support for message formatting in case PHP intl extension is not installed.
  However it is highly recommended that you install [PHP intl extension](https://www.php.net/manual/en/book.intl.php) if you want
  to use MessageFormatter features.

  The fallback implementation only supports the following message formats:
  - plural formatting for english ('one' and 'other' selectors)
  - select format
  - simple parameters
  - integer number parameters

  The fallback implementation does NOT support the ['apostrophe-friendly' syntax](https://www.php.net/manual/en/messageformatter.formatmessage.php).
  Also messages that are working with the fallback implementation are not necessarily compatible with the
  PHP intl MessageFormatter so do not rely on the fallback if you are able to install intl extension somehow.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:0;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:9:"errorCode";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:2227;}i:1;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:12:"errorMessage";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:2253;}}s:5:"todos";a:0:{}}s:18:"yii\i18n\Formatter";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:18:"yii\base\Component";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:6:{s:18:"UNIT_SYSTEM_METRIC";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:18:"yii\i18n\Formatter";s:5:"value";s:8:"'metric'";s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:8:"yii\i18n";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:16:{s:7:"Closure";s:7:"Closure";s:12:"DateInterval";s:12:"DateInterval";s:8:"DateTime";s:8:"DateTime";s:17:"DateTimeInterface";s:17:"DateTimeInterface";s:12:"DateTimeZone";s:12:"DateTimeZone";s:17:"IntlDateFormatter";s:17:"IntlDateFormatter";s:15:"NumberFormatter";s:15:"NumberFormatter";s:3:"Yii";s:3:"Yii";s:9:"Component";s:18:"yii\base\Component";s:24:"InvalidArgumentException";s:33:"yii\base\InvalidArgumentException";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:11:"ArrayHelper";s:23:"yii\helpers\ArrayHelper";s:15:"FormatConverter";s:27:"yii\helpers\FormatConverter";s:4:"Html";s:16:"yii\helpers\Html";s:12:"HtmlPurifier";s:24:"yii\helpers\HtmlPurifier";s:3