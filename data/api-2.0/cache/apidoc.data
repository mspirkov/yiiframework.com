{
    $sql = 'PRAGMA table_info(' . $this->quoteSimpleTableName($table->name) . ')';
    $columns = $this->db->createCommand($sql)->queryAll();
    if (empty($columns)) {
        return false;
    }
    foreach ($columns as $info) {
        $column = $this->loadColumnSchema($info);
        $table->columns[$column->name] = $column;
        if ($column->isPrimaryKey) {
            $table->primaryKey[] = $column->name;
        }
    }
    if (count($table->primaryKey) === 1 && !strncasecmp($table->columns[$table->primaryKey[0]]->dbType, 'int', 3)) {
        $table->sequenceName = '';
        $table->columns[$table->primaryKey[0]]->autoIncrement = true;
    }
    return true;
}
";s:6:"params";a:1:{s:6:"$table";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$table";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:18:"The table metadata";s:4:"type";s:19:"\yii\db\TableSchema";s:5:"types";a:1:{i:0;s:19:"\yii\db\TableSchema";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/sqlite/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:40:"Whether the table exists in the database";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:201941;s:4:"name";s:11:"findColumns";s:8:"fullName";s:33:"yii\db\sqlite\Schema::findColumns";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/sqlite/Schema.php";s:9:"startLine";i:231;s:7:"endLine";i:252;s:16:"shortDescription";s:35:"Collects the table column metadata.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:15:"findConstraints";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:20:"yii\db\sqlite\Schema";s:10:"sourceCode";s:512:"protected function findConstraints($table)
{
    $sql = 'PRAGMA foreign_key_list(' . $this->quoteSimpleTableName($table->name) . ')';
    $keys = $this->db->createCommand($sql)->queryAll();
    foreach ($keys as $key) {
        $id = (int) $key['id'];
        if (!isset($table->foreignKeys[$id])) {
            $table->foreignKeys[$id] = [$key['table'], $key['from'] => $key['to']];
        } else {
            // composite FK
            $table->foreignKeys[$id][$key['from']] = $key['to'];
        }
    }
}
