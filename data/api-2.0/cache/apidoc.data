For detailed information see [unicode normalization forms](https://unicode.org/reports/tr15/#Normalization_Forms_Table)";s:5:"since";s:5:"2.0.7";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:0;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:59:"https://unicode.org/reports/tr15/#Normalization_Forms_Table";}s:14:"␀*␀description";N;}i:1;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:28:"\yii\helpers\transliterate()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:13:"transliterate";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}}s:7:"authors";a:2:{s:15:"Antonio Ramirez";s:21:"amigo.cobos@gmail.com";s:17:"Alexander Makarov";s:17:"sam@rmcreative.ru";}s:7:"methods";a:17:{s:9:"pluralize";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\helpers\BaseInflector";s:10:"sourceCode";s:388:"public static function pluralize($word)
{
    if (empty($word)) {
        return (string) $word;
    }
    if (isset(static::$specials[$word])) {
        return static::$specials[$word];
    }
    foreach (static::$plurals as $rule => $replacement) {
        if (preg_match($rule, $word)) {
            return preg_replace($rule, $replacement, $word);
        }
    }
    return $word;
}
