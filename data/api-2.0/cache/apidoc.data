";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:13:"yii\behaviors";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:8:{s:8:"Behavior";s:17:"yii\base\Behavior";s:24:"InvalidArgumentException";s:33:"yii\base\InvalidArgumentException";s:5:"Model";s:14:"yii\base\Model";s:16:"BaseActiveRecord";s:23:"yii\db\BaseActiveRecord";s:12:"StringHelper";s:24:"yii\helpers\StringHelper";s:16:"BooleanValidator";s:31:"yii\validators\BooleanValidator";s:15:"NumberValidator";s:30:"yii\validators\NumberValidator";s:15:"StringValidator";s:30:"yii\validators\StringValidator";}}s:4:"name";s:31:"clearAutoDetectedAttributeTypes";s:8:"fullName";s:72:"yii\behaviors\AttributeTypecastBehavior::clearAutoDetectedAttributeTypes";s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/behaviors/AttributeTypecastBehavior.php";s:9:"startLine";i:200;s:7:"endLine";i:203;s:16:"shortDescription";s:104:"Clears internal static cache of auto detected [[attributeTypes]] values
over all affected owner classes.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"attach";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:39:"yii\behaviors\AttributeTypecastBehavior";s:10:"sourceCode";s:413:"public function attach($owner)
{
    parent::attach($owner);
    if ($this->attributeTypes === null) {
        $ownerClass = get_class($this->owner);
        if (!isset(self::$_autoDetectedAttributeTypes[$ownerClass])) {
            self::$_autoDetectedAttributeTypes[$ownerClass] = $this->detectAttributeTypes();
        }
        $this->attributeTypes = self::$_autoDetectedAttributeTypes[$ownerClass];
    }
}
";s:6:"params";a:1:{s:6:"$owner";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$owner";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/behaviors/AttributeTypecastBehavior.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:32799;s:4:"name";s:6:"attach";s:8:"fullName";s:47:"yii\behaviors\AttributeTypecastBehavior::attach";s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/behaviors/AttributeTypecastBehavior.php";s:9:"startLine";i:208;s:7:"endLine";i:219;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:18:"typecastAttributes";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:39:"yii\behaviors\AttributeTypecastBehavior";s:10:"sourceCode";s:769:"public function typecastAttributes($attributeNames = null)
{
    $attributeTypes = [];
    if ($attributeNames === null) {
        $attributeTypes = $this->attributeTypes;
    } else {
        foreach ($attributeNames as $attribute) {
            if (!isset($this->attributeTypes[$attribute])) {
                throw new InvalidArgumentException("There is no type mapping for '{$attribute}'.");
            }
            $attributeTypes[$attribute] = $this->attributeTypes[$attribute];
        }
    }
    foreach ($attributeTypes as $attribute => $type) {
        $value = $this->owner->{$attribute};
        if ($this->skipOnNull && $value === null) {
            continue;
        }
        $this->owner->{$attribute} = $this->typecastValue($value, $type);
    }
}
";s:6:"params";a:1:{s:15:"$attributeNames";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:15:"$attributeNames";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:158:"List of attribute names that should be type-casted.
If this parameter is empty, it means any attribute listed in the [[attributeTypes]]
should be type-casted.";s:4:"type";s:10:"array|null";s:5:"types";a:2:{i:0;s:5:"array";i:1;s:4:"null";}s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/behaviors/AttributeTypecastBehavior.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:32799;s:4:"name";s:18:"typecastAttributes";s:8:"fullName";s:59:"yii\behaviors\AttributeTypecastBehavior::typecastAttributes";s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/behaviors/AttributeTypecastBehavior.php";s:9:"startLine";i:227;s:7:"endLine";i:249;s:16:"shortDescription";s:58:"Typecast owner attributes according to [[attributeTypes]].";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"typecastValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:39:"yii\behaviors\AttributeTypecastBehavior";s:10:"sourceCode";s:1005:"protected function typecastValue($value, $type)
{
    if (is_scalar($type)) {
        if (is_object($value) && method_exists($value, '__toString')) {
            $value = $value->__toString();
        }
        switch ($type) {
            case self::TYPE_INTEGER:
                return (int) $value;
            case self::TYPE_FLOAT:
                return (float) $value;
            case self::TYPE_BOOLEAN:
                return (bool) $value;
            case self::TYPE_STRING:
                if (is_float($value)) {
                    return StringHelper::floatToString($value);
                }
                return (string) $value;
        }
        if (PHP_VERSION_ID >= 80100 && is_subclass_of($type, \BackedEnum::class)) {
            if ($value instanceof $type) {
                return $value;
            }
            return $type::from($value);
        }
        throw new InvalidArgumentException("Unsupported type '{$type}'");
    }
    return call_user_func($type, $value);
}
";s:6:"params";a:2:{s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:24:"Value to be type-casted.";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/behaviors/AttributeTypecastBehavior.php";}s:5:"$type";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$type";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:31:"Type name or typecast callable.";s:4:"type";s:15:"string|callable";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:8:"callable";}s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/behaviors/AttributeTypecastBehavior.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:16:"Typecast result.";s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:32799;s:4:"name";s:13:"typecastValue";s:8:"fullName";s:54:"yii\behaviors\AttributeTypecastBehavior::typecastValue";s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/behaviors/AttributeTypecastBehavior.php";s:9:"startLine";i:257;s:7:"endLine";i:289;s:16:"shortDescription";s:44:"Casts the given value to the specified type.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:20:"detectAttributeTypes";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:39:"yii\behaviors\AttributeTypecastBehavior";s:10:"sourceCode";s:662:"protected function detectAttributeTypes()
{
    $attributeTypes = [];
    foreach ($this->owner->getValidators() as $validator) {
        $type = null;
        if ($validator instanceof BooleanValidator) {
            $type = self::TYPE_BOOLEAN;
        } elseif ($validator instanceof NumberValidator) {
            $type = $validator->integerOnly ? self::TYPE_INTEGER : self::TYPE_FLOAT;
        } elseif ($validator instanceof StringValidator) {
            $type = self::TYPE_STRING;
        }
        if ($type !== null) {
            $attributeTypes += array_fill_keys($validator->getAttributeNames(), $type);
        }
    }
    return $attributeTypes;
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:19:"Attribute type map.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:32799;s:4:"name";s:20:"detectAttributeTypes";s:8:"fullName";s:61:"yii\behaviors\AttributeTypecastBehavior::detectAttributeTypes";s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/behaviors/AttributeTypecastBehavior.php";s:9:"startLine";i:295;s:7:"endLine";i:314;s:16:"shortDescription";s:78:"Composes default value for [[attributeTypes]] from the owner validation rules.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"events";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:39:"yii\behaviors\AttributeTypecastBehavior";s:10:"sourceCode";s:651:"public function events()
{
    $events = [];
    if ($this->typecastAfterValidate) {
        $events[Model::EVENT_AFTER_VALIDATE] = 'afterValidate';
    }
    if ($this->typecastBeforeSave) {
        $events[BaseActiveRecord::EVENT_BEFORE_INSERT] = 'beforeSave';
        $events[BaseActiveRecord::EVENT_BEFORE_UPDATE] = 'beforeSave';
    }
    if ($this->typecastAfterSave) {
        $events[BaseActiveRecord::EVENT_AFTER_INSERT] = 'afterSave';
        $events[BaseActiveRecord::EVENT_AFTER_UPDATE] = 'afterSave';
    }
    if ($this->typecastAfterFind) {
        $events[BaseActiveRecord::EVENT_AFTER_FIND] = 'afterFind';
    }
    return $events;
}
