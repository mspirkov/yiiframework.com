s:7:"matchIP";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:22:"yii\filters\AccessRule";s:10:"sourceCode";s:569:"protected function matchIP($ip)
{
    if (empty($this->ips)) {
        return true;
    }
    foreach ($this->ips as $rule) {
        if (
            $rule === '*'
            || $rule === $ip
            || (
                $ip !== null
                && ($pos = strpos($rule, '*')) !== false
                && strncmp($ip, $rule, $pos) === 0
            )
            || (
                strpos($rule, '/') !== false
                && IpHelper::inRange($ip, $rule) === true
            )
        ) {
            return true;
        }
    }
    return false;
}
