    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:20342;s:4:"name";s:16:"registerLinkTags";s:8:"fullName";s:39:"yii\widgets\LinkPager::registerLinkTags";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/LinkPager.php";s:9:"startLine";i:165;s:7:"endLine";i:171;s:16:"shortDescription";s:86:"Registers relational link tags in the html header for prev, next, first and last page.";s:11:"description";s:69:"These links are generated using [[\yii\data\Pagination::getLinks()]].";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:56:"https://www.w3.org/TR/html401/struct/links.html#h-12.1.2";}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:17:"renderPageButtons";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:21:"yii\widgets\LinkPager";s:10:"sourceCode";s:1795:"protected function renderPageButtons()
{
    $pageCount = $this->pagination->getPageCount();
    if ($pageCount < 2 && $this->hideOnSinglePage) {
        return '';
    }
    $buttons = [];
    $currentPage = $this->pagination->getPage();
    // first page
    $firstPageLabel = $this->firstPageLabel === true ? '1' : $this->firstPageLabel;
    if ($firstPageLabel !== false) {
        $buttons[] = $this->renderPageButton($firstPageLabel, 0, $this->firstPageCssClass, $currentPage <= 0, false);
    }
    // prev page
    if ($this->prevPageLabel !== false) {
        if (($page = $currentPage - 1) < 0) {
            $page = 0;
        }
        $buttons[] = $this->renderPageButton($this->prevPageLabel, $page, $this->prevPageCssClass, $currentPage <= 0, false);
    }
    // internal pages
    list($beginPage, $endPage) = $this->getPageRange();
    for ($i = $beginPage; $i <= $endPage; ++$i) {
        $buttons[] = $this->renderPageButton($i + 1, $i, null, $this->disableCurrentPageButton && $i == $currentPage, $i == $currentPage);
    }
    // next page
    if ($this->nextPageLabel !== false) {
        if (($page = $currentPage + 1) >= $pageCount - 1) {
            $page = $pageCount - 1;
        }
        $buttons[] = $this->renderPageButton($this->nextPageLabel, $page, $this->nextPageCssClass, $currentPage >= $pageCount - 1, false);
    }
    // last page
    $lastPageLabel = $this->lastPageLabel === true ? $pageCount : $this->lastPageLabel;
    if ($lastPageLabel !== false) {
        $buttons[] = $this->renderPageButton($lastPageLabel, $pageCount - 1, $this->lastPageCssClass, $currentPage >= $pageCount - 1, false);
    }
    $options = $this->options;
    $tag = ArrayHelper::remove($options, 'tag', 'ul');
    return Html::tag($tag, implode("\n", $buttons), $options);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:20:"The rendering result";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:20342;s:4:"name";s:17:"renderPageButtons";s:8:"fullName";s:40:"yii\widgets\LinkPager::renderPageButtons";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/LinkPager.php";s:9:"startLine";i:177;s:7:"endLine";i:224;s:16:"shortDescription";s:25:"Renders the page buttons.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"renderPageButton";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:21:"yii\widgets\LinkPager";s:10:"sourceCode";s:882:"protected function renderPageButton($label, $page, $class, $disabled, $active)
{
    $options = $this->linkContainerOptions;
    $linkWrapTag = ArrayHelper::remove($options, 'tag', 'li');
    Html::addCssClass($options, empty($class) ? $this->pageCssClass : $class);
    if ($active) {
        Html::addCssClass($options, $this->activePageCssClass);
    }
    if ($disabled) {
        Html::addCssClass($options, $this->disabledPageCssClass);
        $disabledItemOptions = $this->disabledListItemSubTagOptions;
        $tag = ArrayHelper::remove($disabledItemOptions, 'tag', 'span');
        return Html::tag($linkWrapTag, Html::tag($tag, $label, $disabledItemOptions), $options);
    }
    $linkOptions = $this->linkOptions;
    $linkOptions['data-page'] = $page;
    return Html::tag($linkWrapTag, Html::a($label, $this->pagination->createUrl($page), $linkOptions), $options);
}
