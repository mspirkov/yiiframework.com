";s:6:"params";a:0:{}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:34:"if [[db]] is not PgSQL connection.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:9:"yii\mutex";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:1:{s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";}}s:4:"name";s:4:"init";s:8:"fullName";s:26:"yii\mutex\PgsqlMutex::init";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/mutex/PgsqlMutex.php";s:9:"startLine";i:45;s:7:"endLine";i:51;s:16:"shortDescription";s:58:"Initializes PgSQL specific mutex component implementation.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"acquireLock";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:20:"yii\mutex\PgsqlMutex";s:10:"sourceCode";s:515:"protected function acquireLock($name, $timeout = 0)
{
    list($key1, $key2) = $this->getKeysFromName($name);
    return $this->retryAcquire($timeout, function () use ($key1, $key2) {
        return $this->db->useMaster(function ($db) use ($key1, $key2) {
            /** @var \yii\db\Connection $db */
            return (bool) $db->createCommand(
                'SELECT pg_try_advisory_lock(:key1, :key2)',
                [':key1' => $key1, ':key2' => $key2]
            )->queryScalar();
        });
    });
}
