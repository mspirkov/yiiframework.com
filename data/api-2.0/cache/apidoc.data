If not set, all forms with `data-pjax` attribute within the enclosed content of Pjax will trigger pjax requests.
If set to false, no code will be registered to handle forms.
Note that if the response to the pjax request is a full page, a normal request will be sent again.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:12:"$submitEvent";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:12:"defaultValue";s:8:"'submit'";s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:16:"yii\widgets\Pjax";s:13:"phpDocContext";r:19081;s:4:"name";s:12:"$submitEvent";s:8:"fullName";s:30:"yii\widgets\Pjax::$submitEvent";s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Pjax.php";s:9:"startLine";i:75;s:7:"endLine";i:75;s:16:"shortDescription";s:48:"The jQuery event that will trigger form handler.";s:11:"description";s:70:"The jQuery event that will trigger form handler. Defaults to "submit".";s:5:"since";s:5:"2.0.9";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:70:"The jQuery event that will trigger form handler. Defaults to "submit".";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:16:"$enablePushState";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:12:"defaultValue";s:4:"true";s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:16:"yii\widgets\Pjax";s:13:"phpDocContext";r:19081;s:4:"name";s:16:"$enablePushState";s:8:"fullName";s:34:"yii\widgets\Pjax::$enablePushState";s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/wi