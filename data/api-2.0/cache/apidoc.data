";s:6:"params";a:1:{s:10:"$exception";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$exception";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:29:"The exception to be rendered.";s:4:"type";s:10:"\Throwable";s:5:"types";a:1:{i:0;s:10:"\Throwable";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/ErrorHandler.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:80701;s:4:"name";s:15:"renderException";s:8:"fullName";s:38:"yii\base\ErrorHandler::renderException";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/ErrorHandler.php";s:9:"startLine";i:349;s:7:"endLine";i:349;s:16:"shortDescription";s:22:"Renders the exception.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:12:"logException";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\base\ErrorHandler";s:10:"sourceCode";s:358:"public function logException($exception)
{
    $category = get_class($exception);
    if ($exception instanceof HttpException) {
        $category = 'yii\\web\\HttpException:' . $exception->statusCode;
    } elseif ($exception instanceof \ErrorException) {
        $category .= ':' . $exception->getSeverity();
    }
    Yii::error($exception, $category);
}
";s:6:"params";a:1:{s:10:"$exception";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$exception";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:26:"The exception to be logged";s:4:"type";s:10:"\Throwable";s:5:"types";a:1:{i:0;s:10:"\Throwable";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/ErrorHandler.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:80701;s:4:"name";s:12:"logException";s:8:"fullName";s:35:"yii\base\ErrorHandler::logException";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/ErrorHandler.php";s:9:"startLine";i:356;s:7:"endLine";i:365;s:16:"shortDescription";s:25:"Logs the given exception.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:1:{s:5:"2.0.3";s:26:"this method is now public.";}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"clearOutput";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\base\ErrorHandler";s:10:"sourceCode";s:257:"public function clearOutput()
{
    // the following manual level counting is to deal with zlib.output_compression set to On
    for ($level = ob_get_level(); $level > 0; --$level) {
        if (!@ob_end_clean()) {
            ob_clean();
        }
    }
}
