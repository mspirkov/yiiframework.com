If not set, [[formName()]] is used.";s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Model.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:52:"Whether `load()` found the expected form in `$data`.";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:83412;s:4:"name";s:4:"load";s:8:"fullName";s:20:"yii\base\Model::load";s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Model.php";s:9:"startLine";i:930;s:7:"endLine";i:944;s:16:"shortDescription";s:36:"Populates the model with input data.";s:11:"description";s:661:"This method provides a convenient shortcut for:

```
if (isset($_POST['FormName'])) {
    $model->attributes = $_POST['FormName'];
    if ($model->save()) {
        // handle success
    }
}
```

which, with `load()` can be written as:

```
if ($model->load($_POST) && $model->save()) {
    // handle success
}
```

`load()` gets the `'FormName'` from the model's [[formName()]] method (which you may override), unless the
`$formName` parameter is given. If the form name is empty, `load()` populates the model with the whole of `$data`,
instead of `$data['FormName']`.

Note, that the data being populated is subject to the safety check by [[setAttributes()]].";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:12:"loadMultiple";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:14:"yii\base\Model";s:10:"sourceCode";s:687:"public static function loadMultiple($models, $data, $formName = null)
{
    if ($formName === null) {
        /** @var self|false $first */
        $first = reset($models);
        if ($first === false) {
            return false;
        }
        $formName = $first->formName();
    }
    $success = false;
    foreach ($models as $i => $model) {
        /** @var self $model */
        if ($formName == '') {
            if (!empty($data[$i]) && $model->load($data[$i], '')) {
                $success = true;
            }
        } elseif (!empty($data[$formName][$i]) && $model->load($data[$formName][$i], '')) {
            $success = true;
        }
    }
    return $success;
}
