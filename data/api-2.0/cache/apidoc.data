{
    $this->open();
    if (($transaction = $this->getTransaction()) === null) {
        $transaction = $this->_transaction = new Transaction(['db' => $this]);
    }
    $transaction->begin($isolationLevel);
    return $transaction;
}
";s:6:"params";a:1:{s:15:"$isolationLevel";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:15:"$isolationLevel";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:90:"The isolation level to use for this transaction.
See [[Transaction::begin()]] for details.";s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Connection.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:25:"The transaction initiated";s:10:"returnType";s:19:"\yii\db\Transaction";s:11:"returnTypes";a:1:{i:0;s:19:"\yii\db\Transaction";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:180271;s:4:"name";s:16:"beginTransaction";s:8:"fullName";s:35:"yii\db\Connection::beginTransaction";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Connection.php";s:9:"startLine";i:796;s:7:"endLine";i:806;s:16:"shortDescription";s:21:"Starts a transaction.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"transaction";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\db\Connection";s:10:"sourceCode";s:603:"public function transaction(callable $callback, $isolationLevel = null)
{
    $transaction = $this->beginTransaction($isolationLevel);
    $level = $transaction->level;
    try {
        $result = call_user_func($callback, $this);
        if ($transaction->isActive && $transaction->level === $level) {
            $transaction->commit();
        }
    } catch (\Exception $e) {
        $this->rollbackTransactionOnLevel($transaction, $level);
        throw $e;
    } catch (\Throwable $e) {
        $this->rollbackTransactionOnLevel($transaction, $level);
        throw $e;
    }
    return $result;
}
";s:6:"params";a:2:{s:9:"$callback";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$callback";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:85:"A valid PHP callback that performs the job. Accepts connection instance as parameter.";s:4:"type";s:8:"callable";s:5:"types";a:1:{i:0;s:8:"callable";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Connection.php";}s:15:"$isolationLevel";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:15:"$isolationLevel";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:90:"The isolation level to use for this transaction.
See [[Transaction::begin()]] for details.";s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Connection.php";}}s:10:"exceptions";a:1:{s:10:"\Throwable";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:89:"if there is any exception during query. In this case the transaction will be rolled back.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:27:"Result of callback function";s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:180271;s:4:"name";s:11:"transaction";s:8:"fullName";s:30:"yii\db\Connection::transaction";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Connection.php";s:9:"startLine";i:817;s:7:"endLine";i:836;s:16:"shortDescription";s:44:"Executes callback provided in a transaction.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"getSchema";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\db\Connection";s:10:"sourceCode";s:598:"public function getSchema()
{
    if ($this->_schema !== null) {
        return $this->_schema;
    }
    $driver = $this->getDriverName();
    if (isset($this->schemaMap[$driver])) {
        $config = !is_array($this->schemaMap[$driver]) ? ['class' => $this->schemaMap[$driver]] : $this->schemaMap[$driver];
        $config['db'] = $this;
        $this->_schema = Yii::createObject($config);
        $this->restoreQueryBuilderConfiguration();
        return $this->_schema;
    }
    throw new NotSupportedException("Connection does not support reading schema information for '$driver' DBMS.");
}
