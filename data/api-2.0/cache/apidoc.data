        'date' => 'n/j/y',
        'time' => 'H:i',
        'datetime' => 'n/j/y H:i',
    ],
    'medium' => [
        'date' => 'M j, Y',
        'time' => 'g:i:s A',
        'datetime' => 'M j, Y g:i:s A',
    ],
    'long' => [
        'date' => 'F j, Y',
        'time' => 'g:i:sA',
        'datetime' => 'F j, Y g:i:sA',
    ],
    'full' => [
        'date' => 'l, F j, Y',
        'time' => 'g:i:sA T',
        'datetime' => 'l, F j, Y g:i:sA T',
    ],
]";s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:31:"yii\helpers\BaseFormatConverter";s:13:"phpDocContext";r:60740;s:4:"name";s:24:"$phpFallbackDatePatterns";s:8:"fullName";s:57:"yii\helpers\BaseFormatConverter::$phpFallbackDatePatterns";s:10:"sourceFile";s:106:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseFormatConverter.php";s:9:"startLine";i:28;s:7:"endLine";i:49;s:16:"shortDescription";s:99:"The php fallback definition to use for the ICU short patterns `short`, `medium`, `long` and `full`.";s:11:"description";s:168:"The php fallback definition to use for the ICU short patterns `short`, `medium`, `long` and `full`.
