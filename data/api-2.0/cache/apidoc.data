client-side validation.";s:10:"returnType";s:11:"string|null";s:11:"returnTypes";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:137431;s:4:"name";s:23:"clientValidateAttribute";s:8:"fullName";s:49:"yii\validators\Validator::clientValidateAttribute";s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/Validator.php";s:9:"startLine";i:400;s:7:"endLine";i:403;s:16:"shortDescription";s:68:"Returns the JavaScript needed for performing client-side validation.";s:11:"description";s:1204:"Calls [[getClientOptions()]] to generate options array for client-side validation.

You may override this method to return the JavaScript validation code if
the validator can support client-side validation.

The following JavaScript variables are predefined and can be used in the validation code:

- `attribute`: an object describing the the attribute being validated.
- `value`: the value being validated.
- `messages`: an array used to hold the validation error messages for the attribute.
- `deferred`: an array used to hold deferred objects for asynchronous validation
- `$form`: a jQuery object containing the form element

The `attribute` object contains the following properties:
- `id`: a unique ID identifying the attribute (e.g. "loginform-username") in the form
- `name`: attribute name or expression (e.g. "[0]content" for tabular input)
- `container`: the jQuery selector of the container of the input field
- `input`: the jQuery selector of the input field under the context of the form
- `error`: the jQuery selector of the error tag under the context of the container
- `status`: status of the input field, 0: empty, not entered before, 1: validated, 2: pending validation, 3: validating";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:4;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:34:"\yii\validators\getClientOptions()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:16:"getClientOptions";}}s:14:"␀*␀description";N;}i:5;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:47:"\yii\widgets\ActiveForm::enableClientValidation";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:22:"enableClientValidation";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:16:"getClientOptions";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:24:"yii\validators\Validator";s:10:"sourceCode";s:72:"public function getClientOptions($model, $attribute)
