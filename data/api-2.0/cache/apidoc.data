arrays via third argument, fourth argument etc.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:55:"The merged array (the original arrays are not changed.)";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:54807;s:4:"name";s:5:"merge";s:8:"fullName";s:34:"yii\helpers\BaseArrayHelper::merge";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";s:9:"startLine";i:130;s:7:"endLine";i:155;s:16:"shortDescription";s:47:"Merges two or more arrays into one recursively.";s:11:"description";s:507:"If each array has an element with the same string key value, the latter
will overwrite the former (different from array_merge_recursive).
Recursive merging will be conducted if both arrays have an element of array
type and are having the same key.
For integer-keyed elements, the elements from the latter array will
be appended to the former array.
You can use [[UnsetArrayValue]] object to unset value from previous array or
[[ReplaceArrayValue]] to force replace former value instead of recursive merging.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:6:{i:3;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:13:"phpstan-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:26:"array<array-key, mixed> $a";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:4;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:11:"psalm-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:26:"array<array-key, mixed> $a";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:5;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:13:"phpstan-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:29:"array<array-key, mixed> ...$b";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:6;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:11:"psalm-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:29:"array<array-key, mixed> ...$b";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:7;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:14:"phpstan-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:23:"array<array-key, mixed>";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:8;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:12:"psalm-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:23:"array<array-key, mixed>";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:8:"getValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\helpers\BaseArrayHelper";s:10:"sourceCode";s:1231:"public static function getValue($array, $key, $default = null)
{
    if ($key instanceof \Closure) {
        return $key($array, $default);
    }
    if (is_array($key)) {
        $lastKey = array_pop($key);
        foreach ($key as $keyPart) {
            $array = static::getValue($array, $keyPart);
        }
        $key = $lastKey;
    }
    if (is_object($array) && property_exists($array, $key)) {
        return $array->$key;
    }
    if (static::keyExists($key, $array)) {
        return $array[$key];
    }
    if ($key && ($pos = strrpos($key, '.')) !== false) {
        $array = static::getValue($array, substr($key, 0, $pos), $default);
        $key = substr($key, $pos + 1);
    }
    if (static::keyExists($key, $array)) {
        return $array[$key];
    }
    if (is_object($array)) {
        // this is expected to fail if the property does not exist, or __get() is not implemented
        // it is not reliably possible to check whether a property is accessible beforehand
        try {
            return $array->$key;
        } catch (\Exception $e) {
            if ($array instanceof ArrayAccess) {
                return $default;
            }
            throw $e;
        }
    }
    return $default;
}
";s:6:"params";a:3:{s:6:"$array";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$array";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:37:"Array or object to extract value from";s:4:"type";s:12:"array|object";s:5:"types";a:2:{i:0;s:5:"array";i:1;s:6:"object";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:4:"$key";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:4:"$key";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:279:"Key name of the array element, an array of keys or property name of the object,
or an anonymous function returning the value. The anonymous function signature should be:
`function($array, $defaultValue)`.
The possibility to pass an array of keys is available since version 2.0.4.";s:4:"type";s:21:"string|\Closure|array";s:5:"types";a:3:{i:0;s:6:"string";i:1;s:8:"\Closure";i:2;s:5:"array";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:8:"$default";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$default";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:119:"The default value to be returned if the specified array key does not exist. Not used when
getting value from an object.";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:58:"The value of the element if found, default value otherwise";s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:54807;s:4:"name";s:8:"getValue";s:8:"fullName";s:37:"yii\helpers\BaseArrayHelper::getValue";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";s:9:"startLine";i:196;s:7:"endLine";i:240;s:16:"shortDescription";s:95:"Retrieves the value of an array element or object property with the given key or property name.";s:11:"description";s:1362:"If the key does not exist in the array, the default value will be returned instead.
Not used when getting value from an object.

The key may be specified in a dot format to retrieve the value of a sub-array or the property
of an embedded object. In particular, if the key is `x.y.z`, then the returned value would
be `$array['x']['y']['z']` or `$array->x->y->z` (if `$array` is an object). If `$array['x']`
or `$array->x` is neither an array nor an object, the default value will be returned.
Note that if the array already has an element `x.y.z`, then its value will be returned
instead of going through the sub-arrays. So it is better to be done specifying an array of key names
like `['x', 'y', 'z']`.

Below are some usage examples,

```
// working with array
$username = \yii\helpers\ArrayHelper::getValue($_POST, 'username');
// working with object
$username = \yii\helpers\ArrayHelper::getValue($user, 'username');
// working with anonymous function
$fullName = \yii\helpers\ArrayHelper::getValue($user, function ($user, $defaultValue) {
    return $user->firstName . ' ' . $user->lastName;
});
// using dot format to retrieve the property of embedded object
$street = \yii\helpers\ArrayHelper::getValue($users, 'address.street');
// using an array of keys to retrieve the value
$value = \yii\helpers\ArrayHelper::getValue($versions, ['1.0', 'date']);
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"setValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\helpers\BaseArrayHelper";s:10:"sourceCode";s:506:"public static function setValue(&$array, $path, $value)
{
    if ($path === null) {
        $array = $value;
        return;
    }
    $keys = is_array($path) ? $path : explode('.', $path);
    while (count($keys) > 1) {
        $key = array_shift($keys);
        if (!isset($array[$key])) {
            $array[$key] = [];
        }
        if (!is_array($array[$key])) {
            $array[$key] = [$array[$key]];
        }
        $array = &$array[$key];
    }
    $array[array_shift($keys)] = $value;
}
";s:6:"params";a:3:{s:6:"$array";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$array";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:1;s:11:"description";s:31:"The array to write the value to";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:5:"$path";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$path";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:254:"The path of where do you want to write a value to `$array`
the path can be described by a string when each key should be separated by a dot
you can also describe the path as an array of keys
if the path is null then `$array` will be assigned the `$value`";s:4:"type";s:17:"string|array|null";s:5:"types";a:3:{i:0;s:6:"string";i:1;s:5:"array";i:2;s:4:"null";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:23:"The value to be written";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:54807;s:4:"name";s:8:"setValue";s:8:"fullName";s:37:"yii\helpers\BaseArrayHelper::setValue";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";s:9:"startLine";i:295;s:7:"endLine";i:316;s:16:"shortDescription";s:67:"Writes a value into an associative array at the key path specified.";s:11:"description";s:728:"If there is no such key path yet, it will be created recursively.
If the key exists, it will be overwritten.

```
 $array = [
     'key' => [
         'in' => [
             'val1',
             'key' => 'val'
         ]
     ]
 ];
```

The result of `ArrayHelper::setValue($array, 'key.in.0', ['arr' => 'val']);` will be the following:

```
 [
     'key' => [
         'in' => [
             ['arr' => 'val'],
             'key' => 'val'
         ]
     ]
 ]

```

The result of
`ArrayHelper::setValue($array, 'key.in', ['arr' => 'val']);` or
`ArrayHelper::setValue($array, ['key', 'in'], ['arr' => 'val']);`
will be the following:

```
 [
     'key' => [
         'in' => [
             'arr' => 'val'
         ]
     ]
 ]
```";s:5:"since";s:6:"2.0.13";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"remove";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\helpers\BaseArrayHelper";s:10:"sourceCode";s:383:"public static function remove(&$array, $key, $default = null)
{
    // ToDo: This check can be removed when the minimum PHP version is >= 8.1 (Yii2.2)
    if (is_float($key)) {
        $key = (int)$key;
    }
    if (is_array($array) && array_key_exists($key, $array)) {
        $value = $array[$key];
        unset($array[$key]);
        return $value;
    }
    return $default;
}
";s:6:"params";a:3:{s:6:"$array";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$array";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:1;s:11:"description";s:31:"The array to extract value from";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:4:"$key";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:4:"$key";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:29:"Key name of the array element";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:8:"$default";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$default";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:68:"The default value to be returned if the specified key does not exist";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:58:"The value of the element if found, default value otherwise";s:10:"returnType";s:10:"mixed|null";s:11:"returnTypes";a:2:{i:0;s:5:"mixed";i:1;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:54807;s:4:"name";s:6:"remove";s:8:"fullName";s:35:"yii\helpers\BaseArrayHelper::remove";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";s:9:"startLine";i:337;s:7:"endLine";i:352;s:16:"shortDescription";s:136:"Removes an item from an array and returns the value. If the key does not exist in the array, the default value
will be returned instead.";s:11:"description";s:207:"Usage examples,

```
// $array = ['type' => 'A', 'options' => [1, 2]];
// working with array
$type = \yii\helpers\ArrayHelper::remove($array, 'type');
// $array content
// $array = ['options' => [1, 2]];
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"removeValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\helpers\BaseArrayHelper";s:10:"sourceCode";s:305:"public static function removeValue(&$array, $value)
{
    $result = [];
    if (is_array($array)) {
        foreach ($array as $key => $val) {
            if ($val === $value) {
                $result[$key] = $val;
                unset($array[$key]);
            }
        }
    }
    return $result;
}
";s:6:"params";a:2:{s:6:"$array";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$array";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:1;s:11:"description";s:38:"The array where to look the value from";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:34:"The value to remove from the array";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:42:"The items that were removed from the array";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:54807;s:4:"name";s:11:"removeValue";s:8:"fullName";s:40:"yii\helpers\BaseArrayHelper::removeValue";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";s:9:"startLine";i:372;s:7:"endLine";i:385;s:16:"shortDescription";s:80:"Removes items with matching values from the array and returns the removed items.";s:11:"description";s:306:"Example,

```
$array = ['Bob' => 'Dylan', 'Michael' => 'Jackson', 'Mick' => 'Jagger', 'Janet' => 'Jackson'];
$removed = \yii\helpers\ArrayHelper::removeValue($array, 'Jackson');
// result:
// $array = ['Bob' => 'Dylan', 'Mick' => 'Jagger'];
// $removed = ['Michael' => 'Jackson', 'Janet' => 'Jackson'];
```";s:5:"since";s:6:"2.0.11";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:5:"index";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\helpers\BaseArrayHelper";s:10:"sourceCode";s:913:"public static function index($array, $key, $groups = [])
{
    $result = [];
    $groups = (array) $groups;
    foreach ($array as $element) {
        $lastArray = &$result;
        foreach ($groups as $group) {
            $value = static::getValue($element, $group);
            if (!array_key_exists($value, $lastArray)) {
                $lastArray[$value] = [];
            }
            $lastArray = &$lastArray[$value];
        }
        if ($key === null) {
            if (!empty($groups)) {
                $lastArray[] = $element;
            }
        } else {
            $value = static::getValue($element, $key);
            if ($value !== null) {
                if (is_float($value)) {
                    $value = StringHelper::floatToString($value);
                }
                $lastArray[$value] = $element;
            }
        }
        unset($lastArray);
    }
    return $result;
}
";s:6:"params";a:3:{s:6:"$array";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$array";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:45:"The array that needs to be indexed or grouped";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:4:"$key";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:4:"$key";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:82:"The column name or anonymous function which result will be used to index the array";s:4:"type";s:20:"string|\Closure|null";s:5:"types";a:3:{i:0;s:6:"string";i:1;s:8:"\Closure";i:2;s:4:"null";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:7:"$groups";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$groups";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:367:"The array of keys, that will be used to group the input array
by one or more keys. If the $key attribute or its value for the particular element is null and $groups is not
defined, the array element will be discarded. Otherwise, if $groups is specified, array element will be added
to the result array without any key. This parameter is available since version 2.0.8.";s:4:"type";s:31:"string|string[]|\Closure[]|null";s:5:"types";a:4:{i:0;s:6:"string";i:1;s:8:"string[]";i:2;s:10:"\Closure[]";i:3;s:4:"null";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:32:"The indexed and/or grouped array";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:54807;s:4:"name";s:5:"index";s:8:"fullName";s:34:"yii\helpers\BaseArrayHelper::index";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";s:9:"startLine";i:486;s:7:"endLine";i:519;s:16:"shortDescription";s:61:"Indexes and/or groups the array according to a specified key.";s:11:"description";s:2546:"The input should be either multidimensional array or an array of objects.

The $key can be either a key name of the sub-array, a property name of object, or an anonymous
function that must return the value that will be used as a key.

$groups is an array of keys, that will be used to group the input array into one or more sub-arrays based
on keys specified.

If the `$key` is specified as `null` or a value of an element corresponding to the key is `null` in addition
to `$groups` not specified then the element is discarded.

For example:

```
$array = [
    ['id' => '123', 'data' => 'abc', 'device' => 'laptop'],
    ['id' => '345', 'data' => 'def', 'device' => 'tablet'],
    ['id' => '345', 'data' => 'hgi', 'device' => 'smartphone'],
];
$result = ArrayHelper::index($array, 'id');
```

The result will be an associative array, where the key is the value of `id` attribute

```
[
    '123' => ['id' => '123', 'data' => 'abc', 'device' => 'laptop'],
    '345' => ['id' => '345', 'data' => 'hgi', 'device' => 'smartphone']
    // The second element of an original array is overwritten by the last element because of the same id
]
```

An anonymous function can be used in the grouping array as well.

```
$result = ArrayHelper::index($array, function ($element) {
    return $element['id'];
});
```

Passing `id` as a third argument will group `$array` by `id`:

```
$result = ArrayHelper::index($array, null, 'id');
```

The result will be a multidimensional array grouped by `id`:

```
[
    '123' => [
        ['id' => '123', 'data' => 'abc', 'device' => 'laptop']
    ],
    '345' => [ // all elements with this index are present in the result array
        ['id' => '345', 'data' => 'def', 'device' => 'tablet'],
        ['id' => '345', 'data' => 'hgi', 'device' => 'smartphone'],
    ]
]
```

The anonymous function can be used in the array of grouping keys as well:

```
$result = ArrayHelper::index($array, 'data', [function ($element) {
    return $element['id'];
}, 'device']);
```

The result will be a multidimensional array grouped by `id` on the first level, by the `device` on the second one
and indexed by the `data` on the third level:

```
[
    '123' => [
        'laptop' => [
            'abc' => ['id' => '123', 'data' => 'abc', 'device' => 'laptop']
        ]
    ],
    '345' => [
        'tablet' => [
            'def' => ['id' => '345', 'data' => 'def', 'device' => 'tablet']
        ],
        'smartphone' => [
            'hgi' => ['id' => '345', 'data' => 'hgi', 'device' => 'smartphone']
        ]
    ]
]
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"getColumn";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\helpers\BaseArrayHelper";s:10:"sourceCode";s:372:"public static function getColumn($array, $name, $keepKeys = true)
{
    $result = [];
    if ($keepKeys) {
        foreach ($array as $k => $element) {
            $result[$k] = static::getValue($element, $name);
        }
    } else {
        foreach ($array as $element) {
            $result[] = static::getValue($element, $name);
        }
    }
    return $result;
}
";s:6:"params";a:3:{s:6:"$array";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$array";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:5:"$name";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$name";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:25:"int|string|array|\Closure";s:5:"types";a:4:{i:0;s:3:"int";i:1;s:6:"string";i:2;s:5:"array";i:3;s:8:"\Closure";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:9:"$keepKeys";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$keepKeys";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"true";s:19:"isPassedByReference";b:0;s:11:"description";s:99:"Whether to maintain the array keys. If false, the resulting array
will be re-indexed with integers.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:25:"The list of column values";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:54807;s:4:"name";s:9:"getColumn";s:8:"fullName";s:38:"yii\helpers\BaseArrayHelper::getColumn";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";s:9:"startLine";i:547;s:7:"endLine";i:561;s:16:"shortDescription";s:53:"Returns the values of a specified column in an array.";s:11:"description";s:383:"The input array should be multidimensional or an array of objects.

For example,

```
$array = [
    ['id' => '123', 'data' => 'abc'],
    ['id' => '345', 'data' => 'def'],
];
$result = ArrayHelper::getColumn($array, 'id');
// the result is: ['123', '345']

// using anonymous function
$result = ArrayHelper::getColumn($array, function ($element) {
    return $element['id'];
});
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:3:"map";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\helpers\BaseArrayHelper";s:10:"sourceCode";s:593:"public static function map($array, $from, $to, $group = null)
{
    if (is_string($from) && is_string($to) && $group === null && strpos($from, '.') === false && strpos($to, '.') === false) {
        return array_column($array, $to, $from);
    }
    $result = [];
    foreach ($array as $element) {
        $key = static::getValue($element, $from);
        $value = static::getValue($element, $to);
        if ($group !== null) {
            $result[static::getValue($element, $group)][$key] = $value;
        } else {
            $result[$key] = $value;
        }
    }
    return $result;
}
";s:6:"params";a:4:{s:6:"$array";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$array";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:5:"$from";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$from";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:15:"string|\Closure";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:8:"\Closure";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:3:"$to";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:3:"$to";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:15:"string|\Closure";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:8:"\Closure";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:6:"$group";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$group";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:20:"string|\Closure|null";s:5:"types";a:3:{i:0;s:6:"string";i:1;s:8:"\Closure";i:2;s:4:"null";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:0:"";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:54807;s:4:"name";s:3:"map";s:8:"fullName";s:32:"yii\helpers\BaseArrayHelper::map";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";s:9:"startLine";i:604;s:7:"endLine";i:621;s:16:"shortDescription";s:84:"Builds a map (key-value pairs) from a multidimensional array or an array of objects.";s:11:"description";s:741:"The `$from` and `$to` parameters specify the key names or property names to set up the map.
Optionally, one can further group the map according to a grouping field `$group`.

For example,

```
$array = [
    ['id' => '123', 'name' => 'aaa', 'class' => 'x'],
    ['id' => '124', 'name' => 'bbb', 'class' => 'x'],
    ['id' => '345', 'name' => 'ccc', 'class' => 'y'],
];

$result = ArrayHelper::map($array, 'id', 'name');
// the result is:
// [
//     '123' => 'aaa',
//     '124' => 'bbb',
//     '345' => 'ccc',
// ]

$result = ArrayHelper::map($array, 'id', 'name', 'class');
// the result is:
// [
//     'x' => [
//         '123' => 'aaa',
//         '124' => 'bbb',
//     ],
//     'y' => [
//         '345' => 'ccc',
//     ],
// ]
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"keyExists";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\helpers\BaseArrayHelper";s:10:"sourceCode";s:864:"public static function keyExists($key, $array, $caseSensitive = true)
{
    // ToDo: This check can be removed when the minimum PHP version is >= 8.1 (Yii2.2)
    if (is_float($key)) {
        $key = (int)$key;
    }
    if ($caseSensitive) {
        if (is_array($array) && array_key_exists($key, $array)) {
            return true;
        }
        // Cannot use `array_has_key` on Objects for PHP 7.4+, therefore we need to check using [[ArrayAccess::offsetExists()]]
        return $array instanceof ArrayAccess && $array->offsetExists($key);
    }
    if ($array instanceof ArrayAccess) {
        throw new InvalidArgumentException('Second parameter($array) cannot be ArrayAccess in case insensitive mode');
    }
    foreach (array_keys($array) as $k) {
        if (strcasecmp($key, $k) === 0) {
            return true;
        }
    }
    return false;
}
";s:6:"params";a:3:{s:4:"$key";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:4:"$key";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:16:"The key to check";s:4:"type";s:10:"string|int";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:3:"int";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:6:"$array";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$array";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:28:"The array with keys to check";s:4:"type";s:18:"array|\ArrayAccess";s:5:"types";a:2:{i:0;s:5:"array";i:1;s:12:"\ArrayAccess";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:14:"$caseSensitive";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:14:"$caseSensitive";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"true";s:19:"isPassedByReference";b:0;s:11:"description";s:51:"Whether the key comparison should be case-sensitive";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:44:"Whether the array contains the specified key";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:54807;s:4:"name";s:9:"keyExists";s:8:"fullName";s:38:"yii\helpers\BaseArrayHelper::keyExists";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";s:9:"startLine";i:635;s:7:"endLine";i:661;s:16:"shortDescription";s:53:"Checks if the given array contains the specified key.";s:11:"description";s:101:"This method enhances the `array_key_exists()` function by supporting case-insensitive
key comparison.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:4;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:13:"phpstan-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:60:"array<array-key, mixed>|ArrayAccess<array-key, mixed> $array";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:5;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:11:"psalm-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:60:"array<array-key, mixed>|ArrayAccess<array-key, mixed> $array";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:9:"multisort";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\helpers\BaseArrayHelper";s:10:"sourceCode";s:1271:"public static function multisort(&$array, $key, $direction = SORT_ASC, $sortFlag = SORT_REGULAR)
{
    $keys = is_array($key) ? $key : [$key];
    if (empty($keys) || empty($array)) {
        return;
    }
    $n = count($keys);
    if (is_scalar($direction)) {
        $direction = array_fill(0, $n, $direction);
    } elseif (count($direction) !== $n) {
        throw new InvalidArgumentException('The length of $direction parameter must be the same as that of $keys.');
    }
    if (is_scalar($sortFlag)) {
        $sortFlag = array_fill(0, $n, $sortFlag);
    } elseif (count($sortFlag) !== $n) {
        throw new InvalidArgumentException('The length of $sortFlag parameter must be the same as that of $keys.');
    }
    $args = [];
    foreach ($keys as $i => $k) {
        $flag = $sortFlag[$i];
        $args[] = static::getColumn($array, $k);
        $args[] = $direction[$i];
        $args[] = $flag;
    }
    // This fix is used for cases when main sorting specified by columns has equal values
    // Without it it will lead to Fatal Error: Nesting level too deep - recursive dependency?
    $args[] = range(1, count($array));
    $args[] = SORT_ASC;
    $args[] = SORT_NUMERIC;
    $args[] = &$array;
    call_user_func_array('array_multisort', $args);
}
