";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\caching";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:3:{s:3:"Yii";s:3:"Yii";s:9:"Component";s:18:"yii\base\Component";s:12:"StringHelper";s:24:"yii\helpers\StringHelper";}}s:4:"name";s:4:"init";s:8:"fullName";s:23:"yii\caching\Cache::init";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/Cache.php";s:9:"startLine";i:91;s:7:"endLine";i:95;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:8:"buildKey";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\caching\Cache";s:10:"sourceCode";s:415:"public function buildKey($key)
{
    if (is_string($key)) {
        $key = ctype_alnum($key) && StringHelper::byteLength($key) <= 32 ? $key : md5($key);
    } else {
        if ($this->_igbinaryAvailable) {
            $serializedKey = igbinary_serialize($key);
        } else {
            $serializedKey = serialize($key);
        }
        $key = md5($serializedKey);
    }
    return $this->keyPrefix . $key;
}
