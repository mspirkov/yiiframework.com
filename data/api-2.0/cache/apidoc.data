{
    parent::init();
    if ($this->message === null) {
        $this->message = Yii::t('yii', '{attribute} must be either "{true}" or "{false}".');
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:14:"yii\validators";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:2:{s:3:"Yii";s:3:"Yii";s:4:"Json";s:16:"yii\helpers\Json";}}s:4:"name";s:4:"init";s:8:"fullName";s:37:"yii\validators\BooleanValidator::init";s:10:"sourceFile";s:106:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/BooleanValidator.php";s:9:"startLine";i:43;s:7:"endLine";i:49;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:13:"validateValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:31:"yii\validators\BooleanValidator";s:10:"sourceCode";s:490:"protected function validateValue($value)
{
    if ($this->strict) {
        $valid = $value === $this->trueValue || $value === $this->falseValue;
    } else {
        $valid = $value == $this->trueValue || $value == $this->falseValue;
    }
    if (!$valid) {
        return [$this->message, [
            'true' => $this->trueValue === true ? 'true' : $this->trueValue,
            'false' => $this->falseValue === false ? 'false' : $this->falseValue,
        ]];
    }
    return null;
}
