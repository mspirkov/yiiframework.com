{
    if ($this->targetClass === null) {
        throw new InvalidConfigException('The "targetClass" property must be set.');
    }
    if (!is_string($this->targetAttribute)) {
        throw new InvalidConfigException('The "targetAttribute" property must be configured as a string.');
    }
    if (is_array($value) && !$this->allowArray) {
        return [$this->message, []];
    }
    $query = $this->createQuery($this->targetClass, [$this->targetAttribute => $value]);
    return $this->valueExists($this->targetClass, $query, $value) ? null : [$this->message, []];
}
";s:6:"params";a:1:{s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:104:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/ExistValidator.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:142098;s:4:"name";s:13:"validateValue";s:8:"fullName";s:44:"yii\validators\ExistValidator::validateValue";s:10:"sourceFile";s:104:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/ExistValidator.php";s:9:"startLine";i:242;s:7:"endLine";i:258;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:11:"createQuery";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:29:"yii\validators\ExistValidator";s:10:"sourceCode";s:375:"protected function createQuery($targetClass, $condition)
{
    /** @var \yii\db\ActiveRecordInterface $targetClass */
    $query = $targetClass::find()->andWhere($condition);
    if ($this->filter instanceof \Closure) {
        call_user_func($this->filter, $query);
    } elseif ($this->filter !== null) {
        $query->andWhere($this->filter);
    }
    return $query;
}
