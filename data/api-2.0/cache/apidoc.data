{
    foreach ($links as $rel => $link) {
        if (is_array($link)) {
            $links[$rel] = self::serialize($link);
        } elseif ($link instanceof self) {
            $links[$rel] = array_filter((array)$link);
        } else {
            $links[$rel] = ['href' => $link];
        }
    }
    return $links;
}
