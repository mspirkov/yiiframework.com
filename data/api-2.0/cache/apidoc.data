{
    if ($child->name === $parent->name) {
        return true;
    }
    if (!isset($this->children[$child->name], $this->items[$parent->name])) {
        return false;
    }
    foreach ($this->children[$child->name] as $grandchild) {
        /** @var Item $grandchild */
        if ($this->detectLoop($parent, $grandchild)) {
            return true;
        }
    }
    return false;
}
