";s:6:"params";a:1:{s:7:"$action";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$action";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:10:"The action";s:4:"type";s:16:"\yii\base\Action";s:5:"types";a:1:{i:0;s:16:"\yii\base\Action";}s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/AccessRule.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:38:"Whether the rule applies to the action";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:44920;s:4:"name";s:11:"matchAction";s:8:"fullName";s:35:"yii\filters\AccessRule::matchAction";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/AccessRule.php";s:9:"startLine";i:201;s:7:"endLine";i:204;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:2;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:13:"phpstan-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:34:"Action<Controller<Module>> $action";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:3;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:11:"psalm-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:34:"Action<Controller<Module>> $action";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:15:"matchController";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:22:"yii\filters\AccessRule";s:10:"sourceCode";s:318:"protected function matchController($controller)
{
    if (empty($this->controllers)) {
        return true;
    }
    $id = $controller->getUniqueId();
    foreach ($this->controllers as $pattern) {
        if (StringHelper::matchWildcard($pattern, $id)) {
            return true;
        }
    }
    return false;
}
";s:6:"params";a:1:{s:11:"$controller";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:11:"$controller";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:14:"The controller";s:4:"type";s:20:"\yii\base\Controller";s:5:"types";a:1:{i:0;s:20:"\yii\base\Controller";}s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/AccessRule.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:42:"Whether the rule applies to the controller";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:44920;s:4:"name";s:15:"matchController";s:8:"fullName";s:39:"yii\filters\AccessRule::matchController";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/AccessRule.php";s:9:"startLine";i:213;s:7:"endLine";i:227;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:2;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:13:"phpstan-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:30:"Controller<Module> $controller";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:3;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:11:"psalm-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:30:"Controller<Module> $controller";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:9:"matchRole";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:22:"yii\filters\AccessRule";s:10:"sourceCode";s:1022:"protected function matchRole($user)
{
    $items = empty($this->roles) ? [] : $this->roles;
    if (!empty($this->permissions)) {
        $items = array_merge($items, $this->permissions);
    }
    if (empty($items)) {
        return true;
    }
    if ($user === false) {
        throw new InvalidConfigException('The user application component must be available to specify roles in AccessRule.');
    }
    foreach ($items as $item) {
        if ($item === '?') {
            if ($user->getIsGuest()) {
                return true;
            }
        } elseif ($item === '@') {
            if (!$user->getIsGuest()) {
                return true;
            }
        } else {
            if (!isset($roleParams)) {
                $roleParams = !is_array($this->roleParams) && is_callable($this->roleParams) ? call_user_func($this->roleParams, $this) : $this->roleParams;
            }
            if ($user->can($item, $roleParams)) {
                return true;
            }
        }
    }
    return false;
}
