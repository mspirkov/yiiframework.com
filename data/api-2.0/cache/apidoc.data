6:"public";s:9:"definedBy";s:25:"yii\widgets\FragmentCache";s:10:"sourceCode";s:354:"public function init()
{
    parent::init();
    $this->cache = $this->enabled ? Instance::ensure($this->cache, 'yii\caching\CacheInterface') : null;
    if ($this->cache instanceof CacheInterface && $this->getCachedContent() === false) {
        $this->getView()->pushDynamicContent($this);
        ob_start();
        ob_implicit_flush(false);
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\widgets";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:7:{s:3:"Yii";s:3:"Yii";s:28:"DynamicContentAwareInterface";s:37:"yii\base\DynamicContentAwareInterface";s:24:"DynamicContentAwareTrait";s:33:"yii\base\DynamicContentAwareTrait";s:6:"Widget";s:15:"yii\base\Widget";s:14:"CacheInterface";s:26:"yii\caching\CacheInterface";s:10:"Dependency";s:22:"yii\caching\Dependency";s:8:"Instance";s:15:"yii\di\Instance";}}s:4:"name";s:4:"init";s:8:"fullName";s:31:"yii\widgets\FragmentCache::init";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/FragmentCache.php";s:9:"startLine";i:82;s:7:"endLine";i:93;s:16:"shortDescription";s:37:"Initializes the FragmentCache object.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:3:"run";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\widgets\FragmentCache";s:10:"sourceCode";s:698:"public function run()
{
    if (($content = $this->getCachedContent()) !== false) {
        echo $content;
    } elseif ($this->cache instanceof CacheInterface) {
        $this->getView()->popDynamicContent();
        $content = ob_get_clean();
        if ($content === false || $content === '') {
            return;
        }
        if (is_array($this->dependency)) {
            $this->dependency = Yii::createObject($this->dependency);
        }
        $data = [$content, $this->getDynamicPlaceholders()];
        $this->cache->set($this->calculateKey(), $data, $this->duration, $this->dependency);
        echo $this->updateDynamicContent($content, $this->getDynamicPlaceholders());
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:17600;s:4:"name";s:3:"run";s:8:"fullName";s:30:"yii\widgets\FragmentCache::run";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/FragmentCache.php";s:9:"startLine";i:101;s:7:"endLine";i:119;s:16:"shortDescription";s:38:"Marks the end of content to be cached.";s:11:"description";s:168:"Content displayed before this method call and after [[init()]]
will be captured and saved in cache.
This method does nothing if valid content is already found in cache.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"getCachedContent";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\widgets\FragmentCache";s:10:"sourceCode";s:663:"public function getCachedContent()
{
    if ($this->_content !== null) {
        return $this->_content;
    }
    $this->_content = false;
    if (!($this->cache instanceof CacheInterface)) {
        return $this->_content;
    }
    $key = $this->calculateKey();
    $data = $this->cache->get($key);
    if (!is_array($data) || count($data) !== 2) {
        return $this->_content;
    }
    list($this->_content, $placeholders) = $data;
    if (!is_array($placeholders) || count($placeholders) === 0) {
        return $this->_content;
    }
    $this->_content = $this->updateDynamicContent($this->_content, $placeholders, true);
    return $this->_content;
}
