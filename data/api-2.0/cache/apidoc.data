\Instance::$id";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/Instance.php";s:9:"startLine";i:61;s:7:"endLine";i:61;s:16:"shortDescription";s:58:"The component ID, class name, interface name or alias name";s:11:"description";s:58:"The component ID, class name, interface name or alias name";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:58:"the component ID, class name, interface name or alias name";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:9:"$optional";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:12:"defaultValue";N;s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:15:"yii\di\Instance";s:13:"phpDocContext";r:89466;s:4:"name";s:9:"$optional";s:8:"fullName";s:26:"yii\di\Instance::$optional";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/Instance.php";s:9:"startLine";i:65;s:7:"endLine";i:65;s:16:"shortDescription";s:59:"If null should be returned instead of throwing an exception";s:11:"description";s:59:"If null should be returned instead of throwing an exception";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Boolean":0:{}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:59:"if null should be returned instead of throwing an exception";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:6:"yii\di";s:13:"phpDocContext";r:89466;s:4:"name";s:15:"yii\di\Instance";s:8:"fullName";s:15:"yii\di\Instance";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/Instance.php";s:9:"startLine";i:56;s:7:"endLine";i:219;s:16:"shortDescription";s:112:"Instance represents a reference to a named object in a dependency injection (DI) container or a service locator.";s:11:"description";s:999:"You may use [[get()]] to obtain the actual object referenced by [[id]].

Instance is mainly used in two places:

- When configuring a dependency injection container, you use Instance to reference a class name, interface name
  or alias name. The reference can later be resolved into the actual object by the container.
- In classes which use service locator to obtain dependent objects.

The following example shows how to configure a DI container with Instance:

```
$container = new \yii\di\Container;
$container->set('cache', [
    'class' => 'yii\caching\DbCache',
    'db' => Instance::of('db')
]);
$container->set('db', [
    'class' => 'yii\db\Connection',
    'dsn' => 'sqlite:path/to/file.db',
]);
```

And the following example shows how a class retrieves a component from a service locator:

```
class DbCache extends Cache
{
    public $db = 'db';

    public function init()
    {
        parent::init();
        $this->db = Instance::ensure($this->db, 'yii\db\Connection');
    }
}
```";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:20:"yii\web\CacheSession";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:15:"yii\web\Session";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:3:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\web\CacheSession";s:10:"sourceCode";s:128:"public function init()
{
    parent::init();
    $this->cache = Instance::ensure($this->cache, 'yii\caching\CacheInterface');
}
