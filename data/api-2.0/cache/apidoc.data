";s:6:"params";a:2:{s:5:"$type";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$type";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/oci/Schema.php";}s:7:"$length";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$length";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/oci/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:198535;s:4:"name";s:25:"createColumnSchemaBuilder";s:8:"fullName";s:44:"yii\db\oci\Schema::createColumnSchemaBuilder";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/oci/Schema.php";s:9:"startLine";i:275;s:7:"endLine";i:278;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:17:"resolveTableNames";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:17:"yii\db\oci\Schema";s:10:"sourceCode";s:439:"protected function resolveTableNames($table, $name)
{
    $parts = explode('.', str_replace('"', '', $name));
    if (isset($parts[1])) {
        $table->schemaName = $parts[0];
        $table->name = $parts[1];
    } else {
        $table->schemaName = $this->defaultSchema;
        $table->name = $name;
    }
    $table->fullName = $table->schemaName !== $this->defaultSchema ? $table->schemaName . '.' . $table->name : $table->name;
}
";s:6:"params";a:2:{s:6:"$table";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$table";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:25:"The table metadata object";s:4:"type";s:19:"\yii\db\TableSchema";s:5:"types";a:1:{i:0;s:19:"\yii\db\TableSchema";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/oci/Schema.php";}s:5:"$name";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$name";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:14:"The table name";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/oci/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:198535;s:4:"name";s:17:"resolveTableNames";s:8:"fullName";s:36:"yii\db\oci\Schema::resolveTableNames";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/oci/Schema.php";s:9:"startLine";i:286;s:7:"endLine";i:298;s:16:"shortDescription";s:49:"Resolves the table name and schema name (if any).";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"findColumns";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:17:"yii\db\oci\Schema";s:10:"sourceCode";s:1247:"protected function findColumns($table)
{
    $sql = <<<'SQL'
CT
A.COLUMN_NAME,
A.DATA_TYPE,
A.DATA_PRECISION,
A.DATA_SCALE,
(
  CASE A.CHAR_USED WHEN 'C' THEN A.CHAR_LENGTH
    ELSE A.DATA_LENGTH
  END
) AS DATA_LENGTH,
A.NULLABLE,
A.DATA_DEFAULT,
COM.COMMENTS AS COLUMN_COMMENT
 ALL_TAB_COLUMNS A
INNER JOIN ALL_OBJECTS B ON B.OWNER = A.OWNER AND LTRIM(B.OBJECT_NAME) = LTRIM(A.TABLE_NAME)
LEFT JOIN ALL_COL_COMMENTS COM ON (A.OWNER = COM.OWNER AND A.TABLE_NAME = COM.TABLE_NAME AND A.COLUMN_NAME = COM.COLUMN_NAME)
E
A.OWNER = :schemaName
AND B.OBJECT_TYPE IN ('TABLE', 'VIEW', 'MATERIALIZED VIEW')
AND B.OBJECT_NAME = :tableName
R BY A.COLUMN_ID

    try {
        $columns = $this->db->createCommand($sql, [
            ':tableName' => $table->name,
            ':schemaName' => $table->schemaName,
        ])->queryAll();
    } catch (\Exception $e) {
        return false;
    }
    if (empty($columns)) {
        return false;
    }
    foreach ($columns as $column) {
        if ($this->db->slavePdo->getAttribute(\PDO::ATTR_CASE) === \PDO::CASE_LOWER) {
            $column = array_change_key_case($column, CASE_UPPER);
        }
        $c = $this->createColumn($column);
        $table->columns[$c->name] = $c;
    }
    return true;
}
";s:6:"params";a:1:{s:6:"$table";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$table";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:16:"The table schema";s:4:"type";s:19:"\yii\db\TableSchema";s:5:"types";a:1:{i:0;s:19:"\yii\db\TableSchema";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/oci/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:24:"Whether the table exists";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:198535;s:4:"name";s:11:"findColumns";s:8:"fullName";s:30:"yii\db\oci\Schema::findColumns";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/oci/Schema.php";s:9:"startLine";i:305;s:7:"endLine";i:353;s:16:"shortDescription";s:35:"Collects the table column metadata.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:15:"getLastInsertID";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\db\oci\Schema";s:10:"sourceCode";s:501:"public function getLastInsertID($sequenceName = '')
{
    if ($this->db->isActive) {
        // get the last insert id from the master connection
        $sequenceName = $this->quoteSimpleTableName($sequenceName);
        return $this->db->useMaster(function (Connection $db) use ($sequenceName) {
            return $db->createCommand("SELECT {$sequenceName}.CURRVAL FROM DUAL")->queryScalar();
        });
    } else {
        throw new InvalidCallException('DB Connection is not active.');
    }
}
";s:6:"params";a:1:{s:13:"$sequenceName";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:13:"$sequenceName";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"''";s:19:"isPassedByReference";b:0;s:11:"description";s:51:"Name of the sequence object (required by some DBMS)";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/oci/Schema.php";}}s:10:"exceptions";a:1:{s:30:"\yii\base\InvalidCallException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:34:"if the DB connection is not active";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:89:"The row ID of the last row inserted, or the last value retrieved from the sequence object";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:198535;s:4:"name";s:15:"getLastInsertID";s:8:"fullName";s:34:"yii\db\oci\Schema::getLastInsertID";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/oci/Schema.php";s:9:"startLine";i:387;s:7:"endLine";i:398;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:9:"Overrides";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:24:"method in class 'Schema'";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:1;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:59:"https://www.php.net/manual/en/function.PDO-lastInsertId.php";}s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:91:"-> Oracle does not support this

Returns the ID of the last inserted row or sequence value.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:12:"createColumn";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:17:"yii\db\oci\Schema";s:10:"sourceCode";s:1580:"protected function createColumn($column)
{
    $c = $this->createColumnSchema();
    $c->name = $column['COLUMN_NAME'];
    $c->allowNull = $column['NULLABLE'] === 'Y';
    $c->comment = $column['COLUMN_COMMENT'] === null ? '' : $column['COLUMN_COMMENT'];
    $c->isPrimaryKey = false;
    $this->extractColumnType($c, $column['DATA_TYPE'], $column['DATA_PRECISION'], $column['DATA_SCALE'], $column['DATA_LENGTH']);
    $this->extractColumnSize($c, $column['DATA_TYPE'], $column['DATA_PRECISION'], $column['DATA_SCALE'], $column['DATA_LENGTH']);
    $c->phpType = $this->getColumnPhpType($c);
    if (!$c->isPrimaryKey) {
        if (stripos((string) $column['DATA_DEFAULT'], 'timestamp') !== false) {
            $c->defaultValue = null;
        } else {
            $defaultValue = (string) $column['DATA_DEFAULT'];
            if ($c->type === 'timestamp' && $defaultValue === 'CURRENT_TIMESTAMP') {
                $c->defaultValue = new Expression('CURRENT_TIMESTAMP');
            } else {
                if ($defaultValue !== null) {
                    if (
                        strlen($defaultValue) > 2
                        && strncmp($defaultValue, "'", 1) === 0
                        && substr($defaultValue, -1) === "'"
                    ) {
                        $defaultValue = substr($defaultValue, 1, -1);
                    } else {
                        $defaultValue = trim($defaultValue);
                    }
                }
                $c->defaultValue = $c->phpTypecast($defaultValue);
            }
        }
    }
    return $c;
}
";s:6:"params";a:1:{s:7:"$column";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$column";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/oci/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:0:"";s:10:"returnType";s:20:"\yii\db\ColumnSchema";s:11:"returnTypes";a:1:{i:0;s:20:"\yii\db\ColumnSchema";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:198535;s:4:"name";s:12:"createColumn";s:8:"fullName";s:31:"yii\db\oci\Schema::createColumn";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/oci/Schema.php";s:9:"startLine";i:409;s:7:"endLine";i:446;s:16:"shortDescription";s:30:"Creates ColumnSchema instance.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:2;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:14:"phpstan-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:1:"T";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:3;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:12:"psalm-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:1:"T";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:15:"findConstraints";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:17:"yii\db\oci\Schema";s:10:"sourceCode";s:2121:"protected function findConstraints($table)
{
    $sql = <<<'SQL'
CT
/*+ PUSH_PRED(C) PUSH_PRED(D) PUSH_PRED(E) */
D.CONSTRAINT_NAME,
D.CONSTRAINT_TYPE,
C.COLUMN_NAME,
C.POSITION,
D.R_CONSTRAINT_NAME,
E.TABLE_NAME AS TABLE_REF,
F.COLUMN_NAME AS COLUMN_REF,
C.TABLE_NAME
 ALL_CONS_COLUMNS C
INNER JOIN ALL_CONSTRAINTS D ON D.OWNER = C.OWNER AND D.CONSTRAINT_NAME = C.CONSTRAINT_NAME
LEFT JOIN ALL_CONSTRAINTS E ON E.OWNER = D.R_OWNER AND E.CONSTRAINT_NAME = D.R_CONSTRAINT_NAME
LEFT JOIN ALL_CONS_COLUMNS F ON F.OWNER = E.OWNER AND F.CONSTRAINT_NAME = E.CONSTRAINT_NAME AND F.POSITION = C.POSITION
E
C.OWNER = :schemaName
AND C.TABLE_NAME = :tableName
R BY D.CONSTRAINT_NAME, C.POSITION

    $command = $this->db->createCommand($sql, [
        ':tableName' => $table->name,
        ':schemaName' => $table->schemaName,
    ]);
    $constraints = [];
    foreach ($command->queryAll() as $row) {
        if ($this->db->slavePdo->getAttribute(\PDO::ATTR_CASE) === \PDO::CASE_LOWER) {
            $row = array_change_key_case($row, CASE_UPPER);
        }
        if ($row['CONSTRAINT_TYPE'] === 'P') {
            $table->columns[$row['COLUMN_NAME']]->isPrimaryKey = true;
            $table->primaryKey[] = $row['COLUMN_NAME'];
            if (empty($table->sequenceName)) {
                $table->sequenceName = $this->getTableSequenceName($table->name);
            }
        }
        if ($row['CONSTRAINT_TYPE'] !== 'R') {
            // this condition is not checked in SQL WHERE because of an Oracle Bug:
            // see https://github.com/yiisoft/yii2/pull/8844
            continue;
        }
        $name = $row['CONSTRAINT_NAME'];
        if (!isset($constraints[$name])) {
            $constraints[$name] = [
                'tableName' => $row['TABLE_REF'],
                'columns' => [],
            ];
        }
        $constraints[$name]['columns'][$row['COLUMN_NAME']] = $row['COLUMN_REF'];
    }
    foreach ($constraints as $constraint) {
        $name = current(array_keys($constraint));
        $table->foreignKeys[$name] = array_merge([$constraint['tableName']], $constraint['columns']);
    }
}
";s:6:"params";a:1:{s:6:"$table";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$table";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:19:"\yii\db\TableSchema";s:5:"types";a:1:{i:0;s:19:"\yii\db\TableSchema";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/oci/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:198535;s:4:"name";s:15:"findConstraints";s:8:"fullName";s:34:"yii\db\oci\Schema::findConstraints";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/oci/Schema.php";s:9:"startLine";i:452;s:7:"endLine";i:513;s:16:"shortDescription";s:64:"Finds constraints and fills them into TableSchema object passed.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"findUniqueIndexes";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\db\oci\Schema";s:10:"sourceCode";s:661:"public function findUniqueIndexes($table)
{
    $query = <<<'SQL'
CT
DIC.INDEX_NAME,
DIC.COLUMN_NAME
 ALL_INDEXES DI
INNER JOIN ALL_IND_COLUMNS DIC ON DI.TABLE_NAME = DIC.TABLE_NAME AND DI.INDEX_NAME = DIC.INDEX_NAME
E
DI.UNIQUENESS = 'UNIQUE'
AND DIC.TABLE_OWNER = :schemaName
AND DIC.TABLE_NAME = :tableName
R BY DIC.TABLE_NAME, DIC.INDEX_NAME, DIC.COLUMN_POSITION

    $result = [];
    $command = $this->db->createCommand($query, [
        ':tableName' => $table->name,
        ':schemaName' => $table->schemaName,
    ]);
    foreach ($command->queryAll() as $row) {
        $result[$row['INDEX_NAME']][] = $row['COLUMN_NAME'];
    }
    return $result;
}
";s:6:"params";a:1:{s:6:"$table";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$table";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:18:"The table metadata";s:4:"type";s:19:"\yii\db\TableSchema";s:5:"types";a:1:{i:0;s:19:"\yii\db\TableSchema";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/oci/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:39:"All unique indexes for the given table.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:198535;s:4:"name";s:17:"findUniqueIndexes";s:8:"fullName";s:36:"yii\db\oci\Schema::findUniqueIndexes";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/oci/Schema.php";s:9:"startLine";i:530;s:7:"endLine";i:554;s:16:"shortDescription";s:47:"Returns all unique indexes for the given table.";s:11:"description";s:139:"Each array element is of the following structure:.

```
[
    'IndexName1' => ['col1' [, ...]],
    'IndexName2' => ['col2' [, ...]],
]
```";s:5:"since";s:5:"2.0.4";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"extractColumnType";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:17:"yii\db\oci\Schema";s:10:"sourceCode";s:844:"protected function extractColumnType($column, $dbType, $precision, $scale, $length)
{
    $column->dbType = $dbType;
    if (strpos($dbType, 'FLOAT') !== false || strpos($dbType, 'DOUBLE') !== false) {
        $column->type = 'double';
    } elseif (strpos($dbType, 'NUMBER') !== false) {
        if ($scale === null || $scale > 0) {
            $column->type = 'decimal';
        } else {
            $column->type = 'integer';
        }
    } elseif (strpos($dbType, 'INTEGER') !== false) {
        $column->type = 'integer';
    } elseif (strpos($dbType, 'BLOB') !== false) {
        $column->type = 'binary';
    } elseif (strpos($dbType, 'CLOB') !== false) {
        $column->type = 'text';
    } elseif (strpos($dbType, 'TIMESTAMP') !== false) {
        $column->type = 'timestamp';
    } else {
        $column->type = 'string';
    }
}
