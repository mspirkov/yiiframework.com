{
    if (!$this->useTablePrefix) {
        return $tableName;
    }
    return '{{%' . $tableName . '}}';
}
";s:6:"params";a:1:{s:10:"$tableName";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$tableName";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:27:"The table name to generate.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MigrateController.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:0:"";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:42610;s:4:"name";s:17:"generateTableName";s:8:"fullName";s:60:"yii\console\controllers\MigrateController::generateTableName";s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MigrateController.php";s:9:"startLine";i:519;s:7:"endLine";i:526;s:16:"shortDescription";s:84:"If `useTablePrefix` equals true, then the table name will contain the
prefix format.";s:11:"description";s:0:"";s:5:"since";s:5:"2.0.8";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"parseFields";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:41:"yii\console\controllers\MigrateController";s:10:"sourceCode";s:1157:"protected function parseFields()
{
    $fields = [];
    $foreignKeys = [];
    foreach ($this->fields as $index => $field) {
        $chunks = $this->splitFieldIntoChunks($field);
        $property = array_shift($chunks);
        foreach ($chunks as $i => &$chunk) {
            if (strncmp($chunk, 'foreignKey', 10) === 0) {
                preg_match('/foreignKey\((\w*)\s?(\w*)\)/', $chunk, $matches);
                $foreignKeys[$property] = [
                    'table' => isset($matches[1])
                        ? $matches[1]
                        : preg_replace('/_id$/', '', $property),
                    'column' => !empty($matches[2])
                        ? $matches[2]
                        : null,
                ];
                unset($chunks[$i]);
                continue;
            }
            if (!preg_match('/^(.+?)\(([^(]+)\)$/', $chunk)) {
                $chunk .= '()';
            }
        }
        $fields[] = [
            'property' => $property,
            'decorators' => implode('->', $chunks),
        ];
    }
    return [
        'fields' => $fields,
        'foreignKeys' => $foreignKeys,
    ];
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:111:"Parse result with following fields:

- fields: array, parsed fields
- foreignKeys: array, detected foreign keys";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:42610;s:4:"name";s:11:"parseFields";s:8:"fullName";s:54:"yii\console\controllers\MigrateController::parseFields";s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MigrateController.php";s:9:"startLine";i:537;s:7:"endLine";i:576;s:16:"shortDescription";s:40:"Parse the command line migration fields.";s:11:"description";s:0:"";s:5:"since";s:5:"2.0.7";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:20:"splitFieldIntoChunks";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:41:"yii\console\controllers\MigrateController";s:10:"sourceCode";s:755:"protected function splitFieldIntoChunks($field)
{
    $originalDefaultValue = null;
    $defaultValue = null;
    preg_match_all('/defaultValue\(["\'].*?:?.*?["\']\)/', $field, $matches, PREG_SET_ORDER, 0);
    if (isset($matches[0][0])) {
        $originalDefaultValue = $matches[0][0];
        $defaultValue = str_replace(':', '{{colon}}', $originalDefaultValue);
        $field = str_replace($originalDefaultValue, $defaultValue, $field);
    }
    $chunks = preg_split('/\s?:\s?/', $field);
    if (is_array($chunks) && $defaultValue !== null && $originalDefaultValue !== null) {
        foreach ($chunks as $key => $chunk) {
            $chunks[$key] = str_replace($defaultValue, $originalDefaultValue, $chunk);
        }
    }
    return $chunks;
}
