{
    $query = (new Query())
        ->from($this->itemTable)
        ->where(['type' => $type]);
    $items = [];
    foreach ($query->all($this->db) as $row) {
        /** @var Role|Permission */
        $item = $this->populateItem($row);
        $items[$row['name']] = $item;
    }
    return $items;
}
