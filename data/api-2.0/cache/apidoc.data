;b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\base\Module";s:10:"sourceCode";s:254:"public function setModule($id, $module)
{
    if ($module === null) {
        unset($this->_modules[$id]);
    } else {
        $this->_modules[$id] = $module;
        if ($module instanceof self) {
            $module->module = $this;
        }
    }
}
