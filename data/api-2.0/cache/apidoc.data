Note that items will be automatically HTML encoded if `$options['encode']` is not set or true.";s:4:"type";s:18:"array|\Traversable";s:5:"types";a:2:{i:0;s:5:"array";i:1;s:12:"\Traversable";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";}s:8:"$options";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$options";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:708:"Options (name => config) for the radio button list. The following options are supported:

- encode: boolean, whether to HTML-encode the items. Defaults to true.
  This option is ignored if the `item` option is specified.
- itemOptions: array, the HTML attributes for the `li` tags. This option is ignored if the `item` option is specified.
- item: callable, a callback that is used to generate each individual list item.
  The signature of this callback must be:

  ```
  function ($item, $index)
  ```

  where $index is the array key corresponding to `$item` in `$items`. The callback should return
  the whole list item tag.

See [[renderTagAttributes()]] for details on how attributes are being rendered.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:77:"The generated ordered list. An empty string is returned if `$items` is empty.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:56244;s:4:"name";s:2:"ol";s:8:"fullName";s:24:"yii\helpers\BaseHtml::ol";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";s:9:"startLine";i:1195;s:7:"endLine";i:1199;s:16:"shortDescription";s:26:"Generates an ordered list.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"activeLabel";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\helpers\BaseHtml";s:10:"sourceCode";s:376:"public static function activeLabel($model, $attribute, $options = [])
{
    $for = ArrayHelper::remove($options, 'for', static::getInputId($model, $attribute));
    $attribute = static::getAttributeName($attribute);
    $label = ArrayHelper::remove($options, 'label', static::encode($model->getAttributeLabel($attribute)));
    return static::label($label, $for, $options);
}
