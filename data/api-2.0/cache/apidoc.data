";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:20342;s:4:"name";s:3:"run";s:8:"fullName";s:26:"yii\widgets\LinkPager::run";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/LinkPager.php";s:9:"startLine";i:152;s:7:"endLine";i:158;s:16:"shortDescription";s:20:"Executes the widget.";s:11:"description";s:82:"This overrides the parent implementation by displaying the generated page buttons.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"registerLinkTags";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:21:"yii\widgets\LinkPager";s:10:"sourceCode";s:213:"protected function registerLinkTags()
{
