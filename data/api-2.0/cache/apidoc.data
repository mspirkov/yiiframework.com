s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:18:"\yii\db\Connection";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:10:"Connection";}}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:65:"the database connection that this transaction is associated with.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:6:"yii\db";s:13:"phpDocContext";r:170079;s:4:"name";s:18:"yii\db\Transaction";s:8:"fullName";s:18:"yii\db\Transaction";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Transaction.php";s:9:"startLine";i:52;s:7:"endLine";i:249;s:16:"shortDescription";s:40:"Transaction represents a DB transaction.";s:11:"description";s:852:"It is usually created by calling [[Connection::beginTransaction()]].

The following code is a typical example of using transactions (note that some
DBMS may not support transactions):

```
$transaction = $connection->beginTransaction();
try {
    $connection->createCommand($sql1)->execute();
    $connection->createCommand($sql2)->execute();
    //.... other SQL executions
    $transaction->commit();
} catch (\Exception $e) {
    $transaction->rollBack();
    throw $e;
} catch (\Throwable $e) {
    $transaction->rollBack();
    throw $e;
}
```

> Note: in the above code we have two catch-blocks for compatibility
> with PHP 5.x and PHP 7.x. `\Exception` implements the [`\Throwable` interface](https://www.php.net/manual/en/class.throwable.php)
> since PHP 7.0, so you can skip the part with `\Exception` if your app uses only PHP 7.0 and higher.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:3:{i:0;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:8:"isActive";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Boolean":0:{}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:170399;}i:1;O:52:"phpDocumentor\Reflection\DocBlock\Tags\PropertyWrite":4:{s:15:"␀*␀variableName";s:14:"isolationLevel";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:14:"property-write";s:14:"␀*␀description";r:170425;}i:2;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:5:"level";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Integer":0:{}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:170451;}}s:5:"todos";a:0:{}}s:21:"yii\db\AfterSaveEvent";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:14:"yii\base\Event";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:14:"Carsten Brandt";s:12:"mail@cebe.cc";}s:7:"methods";a:0:{}s:10:"properties";a:1:{s:18:"$changedAttributes";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:12:"defaultValue";N;s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:21:"yii\db\AfterSaveEvent";s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:6:"yii\db";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:1:{s:5:"Event";s:14:"yii\base\Event";}}s:4:"name";s:18:"$changedAttributes";s:8:"fullName";s:41:"yii\db\AfterSaveEvent::$changedAttributes";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/da