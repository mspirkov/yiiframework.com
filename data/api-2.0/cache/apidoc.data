- showAllErrors: boolean, if set to true every error message for each attribute will be shown otherwise
  only the first error message for each attribute will be shown. Defaults to `false`.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseConsole.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:27:"The generated error summary";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:52692;s:4:"name";s:12:"errorSummary";s:8:"fullName";s:37:"yii\helpers\BaseConsole::errorSummary";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseConsole.php";s:9:"startLine";i:1179;s:7:"endLine";i:1185;s:16:"shortDescription";s:45:"Generates a summary of the validation errors.";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.14";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:10:"properties";a:0:{}s:9:"namespace";s:11:"yii\helpers";s:13:"phpDocContext";r:52692;s:4:"name";s:23:"yii\helpers\BaseConsole";s:8:"fullName";s:23:"yii\helpers\BaseConsole";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseConsole.php";s:9:"startLine";i:22;s:7:"endLine";i:1208;s:16:"shortDescription";s:61:"BaseConsole provides concrete implementation for [[Console]].";s:11:"description";s:48:"Do not use BaseConsole. Use [[Console]] instead.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:27:"yii\helpers\BaseArrayHelper";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";N;s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:21:{s:7:"toArray";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\helpers\BaseArrayHelper";s:10:"sourceCode";s:1460:"public static function toArray($object, $properties = [], $recursive = true)
{
    if (is_array($object)) {
        if ($recursive) {
            foreach ($object as $key => $value) {
                if (is_array($value) || is_object($value)) {
                    $object[$key] = static::toArray($value, $properties, true);
                }
            }
        }
        return $object;
    } elseif ($object instanceof \DateTimeInterface) {
        return (array)$object;
    } elseif (is_object($object)) {
        if (!empty($properties)) {
            $className = get_class($object);
            if (!empty($properties[$className])) {
                $result = [];
                foreach ($properties[$className] as $key => $name) {
                    if (is_int($key)) {
                        $result[$name] = $object->$name;
                    } else {
                        $result[$key] = static::getValue($object, $name);
                    }
                }
                return $recursive ? static::toArray($result, $properties) : $result;
            }
        }
        if ($object instanceof Arrayable) {
            $result = $object->toArray([], [], $recursive);
        } else {
            $result = [];
            foreach ($object as $key => $value) {
                $result[$key] = $value;
            }
        }
        return $recursive ? static::toArray($result, $properties) : $result;
    }
    return [$object];
}
";s:6:"params";a:3:{s:7:"$object";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$object";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:40:"The object to be converted into an array";s:4:"type";s:19:"object|array|string";s:5:"types";a:3:{i:0;s:6:"object";i:1;s:5:"array";i:2;s:6:"string";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:11:"$properties";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:11:"$properties";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:703:"A mapping from object class names to the properties that need to put into the resulting arrays.
The properties specified for each class is an array of the following format:

```
[
    'app\models\Post' => [
        'id',
        'title',
        // the key name in array result => property name
        'createTime' => 'created_at',
        // the key name in array result => anonymous function
        'length' => function ($post) {
            return strlen($post->content);
        },
    ],
]
```

The result of `ArrayHelper::toArray($post, $properties)` could be like the following:

```
[
    'id' => 123,
    'title' => 'test',
    'createTime' => '2013-01-01 12:00AM',
    'length' => 301,
]
```";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}s:10:"$recursive";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$recursive";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"true";s:19:"isPassedByReference";b:0;s:11:"description";s:73:"Whether to recursively converts properties which are objects into arrays.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:38:"The array representation of the object";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\helpers";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:5:{s:3:"Yii";s:3:"Yii";s:11:"ArrayAccess";s:11:"ArrayAccess";s:11:"Traversable";s:11:"Traversable";s:9:"Arrayable";s:18:"yii\base\Arrayable";s:24:"InvalidArgumentException";s:33:"yii\base\InvalidArgumentException";}}s:4:"name";s:7:"toArray";s:8:"fullName";s:36:"yii\helpers\BaseArrayHelper::toArray";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseArrayHelper.php";s:9:"startLine";i:61;s:7:"endLine";i:104;s:16:"shortDescription";s:56:"Converts an object or an array of objects into an array.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:5:"merge";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\helpers\BaseArrayHelper";s:10:"sourceCode";s:791:"public static function merge($a, ...$b)
{
    $args = func_get_args();
    $res = array_shift($args);
    while (!empty($args)) {
        foreach (array_shift($args) as $k => $v) {
            if ($v instanceof UnsetArrayValue) {
                unset($res[$k]);
            } elseif ($v instanceof ReplaceArrayValue) {
                $res[$k] = $v->value;
            } elseif (is_int($k)) {
                if (array_key_exists($k, $res)) {
                    $res[] = $v;
                } else {
                    $res[$k] = $v;
                }
            } elseif (is_array($v) && isset($res[$k]) && is_array($res[$k])) {
                $res[$k] = static::merge($res[$k], $v);
            } else {
                $res[$k] = $v;
            }
        }
    }
    return $res;
}
