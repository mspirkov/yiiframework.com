{
    $tableName = $this->db->schema->getRawTableName($this->migrationTable);
    $this->stdout("Creating migration history table \"$tableName\"...", Console::FG_YELLOW);
    $this->db->createCommand()->createTable($this->migrationTable, [
        'version' => 'varchar(' . static::MAX_NAME_LENGTH . ') NOT NULL PRIMARY KEY',
        'apply_time' => 'integer',
    ])->execute();
    $this->db->createCommand()->insert($this->migrationTable, [
        'version' => self::BASE_MIGRATION,
        'apply_time' => time(),
    ])->execute();
    $this->stdout("Done.\n", Console::FG_GREEN);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:42610;s:4:"name";s:27:"createMigrationHistoryTable";s:8:"fullName";s:70:"yii\console\controllers\MigrateController::createMigrationHistoryTable";s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MigrateController.php";s:9:"startLine";i:274;s:7:"endLine";i:287;s:16:"shortDescription";s:36:"Creates the migration history table.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:19:"addMigrationHistory";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:41:"yii\console\controllers\MigrateController";s:10:"sourceCode";s:224:"protected function addMigrationHistory($version)
