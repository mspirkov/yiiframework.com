sAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:24:"yii\web\CookieCollection";s:10:"sourceCode";s:508:"public function has($name)
{
    if (!isset($this->_cookies[$name]) || $this->_cookies[$name]->value === '') {
        return false;
    }
    $expire = $this->_cookies[$name]->expire;
    if ($expire === null || $expire === 0) {
        return true;
    }
    $currentTime = time();
    if (is_numeric($expire)) {
        return (int) $expire >= $currentTime;
    }
    if (is_string($expire)) {
        return strtotime($expire) >= $currentTime;
    }
    return $expire->getTimestamp() >= $currentTime;
}
