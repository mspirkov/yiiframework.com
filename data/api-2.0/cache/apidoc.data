";s:6:"params";a:1:{s:6:"$class";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$class";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:24:"The migration class name";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MigrateController.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:22:"The migration instance";s:10:"returnType";s:17:"\yii\db\Migration";s:11:"returnTypes";a:1:{i:0;s:17:"\yii\db\Migration";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:42610;s:4:"name";s:15:"createMigration";s:8:"fullName";s:58:"yii\console\controllers\MigrateController::createMigration";s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MigrateController.php";s:9:"startLine";i:203;s:7:"endLine";i:212;s:16:"shortDescription";s:33:"Creates a new migration instance.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:19:"getMigrationHistory";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:41:"yii\console\controllers\MigrateController";s:10:"sourceCode";s:1698:"protected function getMigrationHistory($limit)
{
    if ($this->db->schema->getTableSchema($this->migrationTable, true) === null) {
        $this->createMigrationHistoryTable();
    }
    $query = (new Query())
        ->select(['version', 'apply_time'])
        ->from($this->migrationTable)
        ->orderBy(['apply_time' => SORT_DESC, 'version' => SORT_DESC]);
    if (empty($this->migrationNamespaces)) {
        $query->limit($limit);
        $rows = $query->all($this->db);
        $history = ArrayHelper::map($rows, 'version', 'apply_time');
        unset($history[self::BASE_MIGRATION]);
        return $history;
    }
    $rows = $query->all($this->db);
    $history = [];
    foreach ($rows as $key => $row) {
        if ($row['version'] === self::BASE_MIGRATION) {
            continue;
        }
        if (preg_match('/m?(\d{6}_?\d{6})(\D.*)?$/is', $row['version'], $matches)) {
            $time = str_replace('_', '', $matches[1]);
            $row['canonicalVersion'] = $time;
        } else {
            $row['canonicalVersion'] = $row['version'];
        }
        $row['apply_time'] = (int) $row['apply_time'];
        $history[] = $row;
    }
    usort($history, function ($a, $b) {
        if ($a['apply_time'] === $b['apply_time']) {
            if (($compareResult = strcasecmp($b['canonicalVersion'], $a['canonicalVersion'])) !== 0) {
                return $compareResult;
            }
            return strcasecmp($b['version'], $a['version']);
        }
        return ($a['apply_time'] > $b['apply_time']) ? -1 : +1;
    });
    $history = array_slice($history, 0, $limit);
    $history = ArrayHelper::map($history, 'version', 'apply_time');
    return $history;
}
