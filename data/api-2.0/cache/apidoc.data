";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:188028;s:4:"name";s:25:"defaultExpressionBuilders";s:8:"fullName";s:52:"yii\db\mysql\QueryBuilder::defaultExpressionBuilders";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mysql/QueryBuilder.php";s:9:"startLine";i:64;s:7:"endLine";i:69;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:12:"renameColumn";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\db\mysql\QueryBuilder";s:10:"sourceCode";s:1068:"public function renameColumn($table, $oldName, $newName)
{
    $quotedTable = $this->db->quoteTableName($table);
    $row = $this->db->createCommand('SHOW CREATE TABLE ' . $quotedTable)->queryOne();
    if ($row === false) {
        throw new Exception("Unable to find column '$oldName' in table '$table'.");
    }
    if (isset($row['Create Table'])) {
        $sql = $row['Create Table'];
    } else {
        $row = array_values($row);
        $sql = $row[1];
    }
    if (preg_match_all('/^\s*[`"](.*?)[`"]\s+(.*?),?$/m', $sql, $matches)) {
        foreach ($matches[1] as $i => $c) {
            if ($c === $oldName) {
                return "ALTER TABLE $quotedTable CHANGE "
                    . $this->db->quoteColumnName($oldName) . ' '
                    . $this->db->quoteColumnName($newName) . ' '
                    . $matches[2][$i];
            }
        }
    }
    // try to give back a SQL anyway
    return "ALTER TABLE $quotedTable CHANGE "
        . $this->db->quoteColumnName($oldName) . ' '
        . $this->db->quoteColumnName($newName);
}
