";s:6:"params";a:1:{s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:529:"How many messages should be logged before they are sent to targets.
This method will set the value of [[Logger::flushInterval]].
Defaults to 1000, meaning the [[Logger::flush()]] method will be invoked once every 1000 messages logged.
Set this property to be 0 if you don't want to flush messages until the application terminates.
This property mainly affects how much memory will be taken by the logged messages.
A smaller value means less memory, but will increase the execution time due to the overhead of [[Logger::flush()]].";s:4:"type";s:3:"int";s:5:"types";a:1:{i:0;s:3:"int";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/Dispatcher.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:67464;s:4:"name";s:16:"setFlushInterval";s:8:"fullName";s:36:"yii\log\Dispatcher::setFlushInterval";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/Dispatcher.php";s:9:"startLine";i:175;s:7:"endLine";i:178;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"dispatch";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\log\Dispatcher";s:10:"sourceCode";s:675:"public function dispatch($messages, $final)
{
    $targetErrors = [];
    foreach ($this->targets as $target) {
        if (!$target->enabled) {
            continue;
        }
        try {
            $target->collect($messages, $final);
        } catch (\Throwable $t) {
            $target->enabled = false;
            $targetErrors[] = $this->generateTargetFailErrorMessage($target, $t, __METHOD__);
        } catch (\Exception $e) {
            $target->enabled = false;
            $targetErrors[] = $this->generateTargetFailErrorMessage($target, $e, __METHOD__);
        }
    }
    if (!empty($targetErrors)) {
        $this->dispatch($targetErrors, true);
    }
}
