You may change the name of the table used to store the data by setting [[logTable]].";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:19:"yii\log\EmailTarget";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:14:"yii\log\Target";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:3:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\log\EmailTarget";s:10:"sourceCode";s:272:"public function init()
{
    parent::init();
    if (empty($this->message['to'])) {
        throw new InvalidConfigException('The "to" option must be set for EmailTarget::message.');
    }
    $this->mailer = Instance::ensure($this->mailer, 'yii\mail\MailerInterface');
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:7:"yii\log";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:4:{s:3:"Yii";s:3:"Yii";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:8:"Instance";s:15:"yii\di\Instance";s:15:"MailerInterface";s:24:"yii\mail\MailerInterface";}}s:4:"name";s:4:"init";s:8:"fullName";s:25:"yii\log\EmailTarget::init";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/EmailTarget.php";s:9:"startLine";i:64;s:7:"endLine";i:71;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:6:"export";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\log\EmailTarget";s:10:"sourceCode";s:553:"public function export()
{
    // moved initialization of subject here because of the following issue
    // https://github.com/yiisoft/yii2/issues/1446
    if (empty($this->message['subject'])) {
        $this->message['subject'] = 'Application Log';
    }
    $messages = array_map([$this, 'formatMessage'], $this->messages);
    $body = wordwrap(implode("\n", $messages), 70);
    $message = $this->composeMessage($body);
    if (!$message->send($this->mailer)) {
        throw new LogRuntimeException('Unable to export log through email!');
    }
}
