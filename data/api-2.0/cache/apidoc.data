{
    $properties['id'] = $id;
    $properties['view'] = $this;
    /** @var FragmentCache $cache */
    $cache = FragmentCache::begin($properties);
    if ($cache->getCachedContent() !== false) {
        $this->endCache();
        return false;
    }
    return true;
}
