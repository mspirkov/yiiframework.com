and continue for $length characters.";s:4:"type";s:3:"int";s:5:"types";a:1:{i:0;s:3:"int";}s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseStringHelper.php";}s:5:"$mask";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$mask";s:10:"isOptional";b:1;s:12:"defaultValue";s:3:"'*'";s:19:"isPassedByReference";b:0;s:11:"description";s:53:"The character to use for masking. The default is '*'.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseStringHelper.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:18:"The masked string.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:61427;s:4:"name";s:4:"mask";s:8:"fullName";s:34:"yii\helpers\BaseStringHelper::mask";s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseStringHelper.php";s:9:"startLine";i:547;s:7:"endLine";i:561;s:16:"shortDescription";s:54:"Masks a portion of a string with a repeated character.";s:11:"description";s:30:"This method is multibyte-safe.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"findBetween";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:28:"yii\helpers\BaseStringHelper";s:10:"sourceCode";s:371:"public static function findBetween($string, $start, $end)
{
    $startPos = mb_strpos($string, $start);
    if ($startPos === false) {
        return null;
    }
    $startPos += mb_strlen($start);
    $endPos = mb_strrpos($string, $end, $startPos);
    if ($endPos === false) {
        return null;
    }
    return mb_substr($string, $startPos, $endPos - $startPos);
}
