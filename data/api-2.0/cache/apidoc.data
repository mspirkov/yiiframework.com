This method returns the value of [[Logger::flushInterval]].";s:10:"returnType";s:3:"int";s:11:"returnTypes";a:1:{i:0;s:3:"int";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:67464;s:4:"name";s:16:"getFlushInterval";s:8:"fullName";s:36:"yii\log\Dispatcher::getFlushInterval";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/Dispatcher.php";s:9:"startLine";i:162;s:7:"endLine";i:165;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"setFlushInterval";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\log\Dispatcher";s:10:"sourceCode";s:93:"public function setFlushInterval($value)
