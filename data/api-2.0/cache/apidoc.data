";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:40:"The user-friendly name of this exception";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:7:"yii\log";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:0:{}}s:4:"name";s:7:"getName";s:8:"fullName";s:36:"yii\log\LogRuntimeException::getName";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/LogRuntimeException.php";s:9:"startLine";i:21;s:7:"endLine";i:24;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:10:"properties";a:0:{}s:9:"namespace";s:7:"yii\log";s:13:"phpDocContext";r:65982;s:4:"name";s:27:"yii\log\LogRuntimeException";s:8:"fullName";s:27:"yii\log\LogRuntimeException";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/LogRuntimeException.php";s:9:"startLine";i:16;s:7:"endLine";i:25;s:16:"shortDescription";s:81:"LogRuntimeException represents an exception caused by problems with log delivery.";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.14";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:18:"yii\log\FileTarget";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:14:"yii\log\Target";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:3:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\log\FileTarget";s:10:"sourceCode";s:373:"public function init()
{
    parent::init();
    if ($this->logFile === null) {
        $this->logFile = Yii::$app->getRuntimePath() . '/logs/app.log';
    } else {
        $this->logFile = Yii::getAlias($this->logFile);
    }
    if ($this->maxLogFiles < 1) {
        $this->maxLogFiles = 1;
    }
    if ($this->maxFileSize < 1) {
        $this->maxFileSize = 1;
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:7:"yii\log";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:3:{s:3:"Yii";s:3:"Yii";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:10:"FileHelper";s:22:"yii\helpers\FileHelper";}}s:4:"name";s:4:"init";s:8:"fullName";s:24:"yii\log\FileTarget::init";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/FileTarget.php";s:9:"startLine";i:85;s:7:"endLine";i:99;s:16:"shortDescription";s:22:"Initializes the route.";s:11:"description";s:71:"This method is invoked after the route is created by the route manager.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"export";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\log\FileTarget";s:10:"sourceCode";s:1677:"public function export()
{
    $text = implode("\n", array_map([$this, 'formatMessage'], $this->messages)) . "\n";
    if (trim($text) === '') {
        return; // No messages to export, so we exit the function early
    }
    if (strpos($this->logFile, '://') === false || strncmp($this->logFile, 'file://', 7) === 0) {
        $logPath = dirname($this->logFile);
        FileHelper::createDirectory($logPath, $this->dirMode, true);
    }
    if (($fp = @fopen($this->logFile, 'a')) === false) {
        throw new InvalidConfigException("Unable to append to log file: {$this->logFile}");
    }
    @flock($fp, LOCK_EX);
    if ($this->enableRotation) {
        // clear stat cache to ensure getting the real current file size and not a cached one
        // this may result in rotating twice when cached file size is used on subsequent calls
        clearstatcache();
    }
    if ($this->enableRotation && @filesize($this->logFile) > $this->maxFileSize * 1024) {
        $this->rotateFiles();
    }
    $writeResult = @fwrite($fp, $text);
    if ($writeResult === false) {
        $message = "Unable to export log through file ($this->logFile)!";
        if ($error = error_get_last()) {
            $message .= ": {$error['message']}";
        }
        throw new LogRuntimeException($message);
    }
    $textSize = strlen($text);
    if ($writeResult < $textSize) {
        throw new LogRuntimeException("Unable to export whole log through file ({$this->logFile})! Wrote $writeResult out of $textSize bytes.");
    }
    @fflush($fp);
    @flock($fp, LOCK_UN);
    @fclose($fp);
    if ($this->fileMode !== null) {
        @chmod($this->logFile, $this->fileMode);
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:2:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:42:"if unable to open the log file for writing";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}s:28:"\yii\log\LogRuntimeException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:39:"if unable to write complete log to file";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:66040;s:4:"name";s:6:"export";s:8:"fullName";s:26:"yii\log\FileTarget::export";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/FileTarget.php";s:9:"startLine";i:107;s:7:"endLine";i:151;s:16:"shortDescription";s:30:"Writes log messages to a file.";s:11:"description";s:105:"Starting from version 2.0.14, this method throws LogRuntimeException in case the log can not be exported.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"rotateFiles";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:18:"yii\log\FileTarget";s:10:"sourceCode";s:693:"protected function rotateFiles()
{
    $file = $this->logFile;
    for ($i = $this->maxLogFiles; $i >= 0; --$i) {
        // $i == 0 is the original log file
        $rotateFile = $file . ($i === 0 ? '' : '.' . $i);
        if (is_file($rotateFile)) {
            // suppress errors because it's possible multiple processes enter into this section
            if ($i === $this->maxLogFiles) {
                @unlink($rotateFile);
                continue;
            }
            $newFile = $this->logFile . '.' . ($i + 1);
            $this->rotateByCopy($rotateFile, $newFile);
            if ($i === 0) {
                $this->clearLogFile($rotateFile);
            }
        }
    }
}
