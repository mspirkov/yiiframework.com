yTemplate";s:7:"TResult";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:10:"properties";a:0:{}s:9:"namespace";s:11:"yii\caching";s:13:"phpDocContext";r:208159;s:4:"name";s:26:"yii\caching\CacheInterface";s:8:"fullName";s:26:"yii\caching\CacheInterface";s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/CacheInterface.php";s:9:"startLine";i:45;s:7:"endLine";i:201;s:16:"shortDescription";s:47:"CacheInterface is the base interface for cache.";s:11:"description";s:912:"A data item can be stored in the cache by calling [[set()]] and be retrieved back
later (in the same or different request) by [[get()]]. In both operations,
a key identifying the data item is required. An expiration time and/or a [[Dependency|dependency]]
can also be specified when calling [[set()]]. If the data item expires or the dependency
changes at the time of calling [[get()]], the cache will return no data.

A typical usage pattern of cache is like the following:

```
$key = 'demo';
$data = $cache->get($key);
if ($data === false) {
    // ...generate $data here...
    $cache->set($key, $data, $duration, $dependency);
}
```

Because CacheInterface extends the [[\ArrayAccess]] interface, it can be used like an array. For example,

```
$cache['foo'] = 'some data';
echo $cache['foo'];
```

For more details and usage information on Cache, see the [guide article on caching](guide:caching-overview).";s:5:"since";N;s:8:"sinceMap";a:1:{s:7:"2.0.13.";s:83:"Previous framework versions used abstract class [[yii\caching\Cache]] as interface.";}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:3;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Extends_":3:{s:7:"␀*␀type";O:41:"phpDocumentor\Reflection\Types\Collection":4:{s:48:"␀phpDocumentor\Reflection\Types\Collection␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:12:"\ArrayAccess";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:11:"ArrayAccess";}s:12:"␀*␀valueType";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:10:"␀*␀keyType";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}s:7:"␀*␀name";s:7:"extends";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:25:"yii\rbac\ManagerInterface";O:30:"yii\apidoc\models\InterfaceDoc":20:{s:16:"parentInterfaces";a:1:{i:0;s:29:"yii\rbac\CheckAccessInterface";}s:13:"implementedBy";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:32:{s:10:"createRole";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:1;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\rbac\ManagerInterface";s:10:"sourceCode";s:35:"public function createRole($name);
