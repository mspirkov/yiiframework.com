The keys are original messages, and the values are the translated messages.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:104:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/GettextMessageSource.php";}s:20:"$originalMessageFile";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:20:"$originalMessageFile";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:105:"The path to the file with messages. Used to log an error message
in case when no translations were found.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:104:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/GettextMessageSource.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:96:"The loaded messages. The keys are original messages, and the values are the translated messages.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:8272;s:4:"name";s:20:"loadFallbackMessages";s:8:"fullName";s:51:"yii\i18n\GettextMessageSource::loadFallbackMessages";s:10:"sourceFile";s:104:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/GettextMessageSource.php";s:9:"startLine";i:100;s:7:"endLine";i:123;s:16:"shortDescription";s:97:"The method is normally called by [[loadMessages]] to load the fallback messages for the language.";s:11:"description";s:107:"Method tries to load the $category messages for the $fallbackLanguage and adds them to the $messages array.";s:5:"since";s:5:"2.0.7";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:18:"getMessageFilePath";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:29:"yii\i18n\GettextMessageSource";s:10:"sourceCode";s:515:"protected function getMessageFilePath($language)
{
    $language = (string) $language;
    if ($language !== '' && !preg_match('/^[a-z0-9_-]+$/i', $language)) {
        throw new InvalidArgumentException(sprintf('Invalid language code: "%s".', $language));
    }
    $messageFile = Yii::getAlias($this->basePath) . '/' . $language . '/' . $this->catalog;
    if ($this->useMoFile) {
        $messageFile .= self::MO_FILE_EXT;
    } else {
        $messageFile .= self::PO_FILE_EXT;
    }
    return $messageFile;
}
";s:6:"params";a:1:{s:9:"$language";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$language";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:19:"The target language";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:104:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/GettextMessageSource.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:20:"Path to message file";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:8272;s:4:"name";s:18:"getMessageFilePath";s:8:"fullName";s:49:"yii\i18n\GettextMessageSource::getMessageFilePath";s:10:"sourceFile";s:104:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/i18n/GettextMessageSource.php";s:9:"startLine";i:131;s:7:"endLine";i:145;s:16:"shortDescription";s:66:"Returns message file path for the specified language and category.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:20:"loadMessagesFromFile";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:29:"yii\i18n\GettextMessageSource";s:10:"sourceCode";s:484:"protected function loadMessagesFromFile($messageFile, $category)
{
    if (is_file($messageFile)) {
        if ($this->useMoFile) {
            $gettextFile = new GettextMoFile(['useBigEndian' => $this->useBigEndian]);
        } else {
            $gettextFile = new GettextPoFile();
        }
        $messages = $gettextFile->load($messageFile, $category);
        if (!is_array($messages)) {
            $messages = [];
        }
        return $messages;
    }
    return null;
}
