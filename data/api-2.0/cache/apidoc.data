{
    $configInstance = \HTMLPurifier_Config::create($config instanceof \Closure ? null : $config);
    $configInstance->autoFinalize = false;
    $purifier = \HTMLPurifier::instance($configInstance);
    $purifier->config->set('Cache.SerializerPath', \Yii::$app->getRuntimePath());
    $purifier->config->set('Cache.SerializerPermissions', 0775);
    static::configure($configInstance);
    if ($config instanceof \Closure) {
        call_user_func($config, $configInstance);
    }
    return $purifier->purify($content);
}
";s:6:"params";a:2:{s:8:"$content";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$content";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:26:"The HTML content to purify";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtmlPurifier.php";}s:7:"$config";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$config";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:718:"The config to use for HtmlPurifier.
If not specified or `null` the default config will be used.
You can use an array or an anonymous function to provide configuration options:

- An array will be passed to the `HTMLPurifier_Config::create()` method.
- An anonymous function will be called after the config was created.
  The signature should be: `function($config)` where `$config` will be an
  instance of `HTMLPurifier_Config`.

  Here is a usage example of such a function:

  ```
  // Allow the HTML5 data attribute `data-type` on `img` elements.
  $content = HtmlPurifier::process($content, function ($config) {
    $config->getHTMLDefinition(true)
           ->addAttribute('img', 'data-type', 'Text');
  });
```";s:4:"type";s:19:"array|\Closure|null";s:5:"types";a:3:{i:0;s:5:"array";i:1;s:8:"\Closure";i:2;s:4:"null";}s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtmlPurifier.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:26:"The purified HTML content.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\helpers";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:0:{}}s:4:"name";s:7:"process";s:8:"fullName";s:37:"yii\helpers\BaseHtmlPurifier::process";s:10:"sourceFile";s:103:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtmlPurifier.php";s:9:"startLine";i:45;s:7:"endLine";i:59;s:16:"shortDescription";s:72:"Passes markup through HTMLPurifier making it safe to output to end user.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"configure";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:28:"yii\helpers\BaseHtmlPurifier";s:10:"sourceCode";s:49:"protected static function configure($config)
