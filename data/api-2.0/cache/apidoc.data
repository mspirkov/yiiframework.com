:"This class is required because of the way in which Yii determines whether a property is safe for massive assignment, that is,
when a user submits form data to be loaded into a model directly from the POST data, is it ok for a property to be copied.
In many cases, this is required but because sometimes properties are internal and you do not want the POST data to be able to
override these internal values (especially things like database row ids), Yii assumes all values are unsafe for massive assignment
unless a validation rule exists for the property, which in most cases it will. Sometimes, however, an item is safe for massive assignment but
does not have a validation rule associated with it - for instance, due to no validation being performed, in which case, you use this class
as a validation rule for that property. Although it has no functionality, it allows Yii to determine that the property is safe to copy.

> Note: [[when]] property is not supported by SafeValidator.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:26:"yii\validators\IpValidator";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:24:"yii\validators\Validator";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:1:{s:13:"NEGATION_CHAR";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:26:"yii\validators\IpValidator";s:5:"value";s:3:"'!'";s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:14:"yii\validators";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:6:{s:3:"Yii";s:3:"Yii";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:4:"Html";s:16:"yii\helpers\Html";s:8:"IpHelper";s:20:"yii\helpers\IpHelper";s:4:"Json";s:16:"yii\helpers\Json";s:12:"JsExpression";s:20:"yii\web\JsExpression";}}s:4:"name";s:13:"NEGATION_CHAR";s:8:"fullName";s:41:"yii\validators\IpValidator::NEGATION_CHAR";s:10:"sourceFile";N;s:9:"startLine";i:51;s:7:"endLine";i:51;s:16:"shortDescription";s:14:"Negation char.";s:11:"description";s:107:"Used to negate [[ranges]] or [[networks]] or to negate validating value when [[negation]] is set to `true`.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:3:{i:0;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:24:"\yii\validators\negation";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:8:"negation";}}s:14:"␀*␀description";N;}i:1;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:24:"\yii\validators\networks";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:8:"networks";}}s:14:"␀*␀description";N;}i:2;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:22:"\yii\validators\ranges";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:6:"ranges";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}}s:7:"authors";a:1:{s:15:"Dmitry Naumenko";s:22:"d.naumenko.a@gmail.com";}s:7:"methods";a:9:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:26:"yii\validators\IpValidator";s:10:"sourceCode";s:1127:"public function init()
{
    parent::init();
    if (!$this->ipv4 && !$this->ipv6) {
        throw new InvalidConfigException('Both IPv4 and IPv6 checks can not be disabled at the same time');
    }
    if ($this->message === null) {
        $this->message = Yii::t('yii', '{attribute} must be a valid IP address.');
    }
    if ($this->ipv6NotAllowed === null) {
        $this->ipv6NotAllowed = Yii::t('yii', '{attribute} must not be an IPv6 address.');
    }
    if ($this->ipv4NotAllowed === null) {
        $this->ipv4NotAllowed = Yii::t('yii', '{attribute} must not be an IPv4 address.');
    }
    if ($this->wrongCidr === null) {
        $this->wrongCidr = Yii::t('yii', '{attribute} contains wrong subnet mask.');
    }
    if ($this->noSubnet === null) {
        $this->noSubnet = Yii::t('yii', '{attribute} must be an IP address with specified subnet.');
    }
    if ($this->hasSubnet === null) {
        $this->hasSubnet = Yii::t('yii', '{attribute} must not be a subnet.');
    }
    if ($this->notInRange === null) {
        $this->notInRange = Yii::t('yii', '{attribute} is not in the allowed range.');
    }
}
