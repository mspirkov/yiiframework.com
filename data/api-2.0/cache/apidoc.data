-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/conditions/NotCondition.php";s:9:"startLine";i:19;s:7:"endLine";i:57;s:16:"shortDescription";s:44:"Condition that inverts passed [[condition]].";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.14";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:2;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:13:"phpcs:disable";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:61:"Squiz.NamingConventions.ValidVariableName.PrivateNoUnderscore";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:40:"yii\db\conditions\SimpleConditionBuilder";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";N;s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:1:{i:0;s:33:"yii\db\ExpressionBuilderInterface";}s:6:"traits";a:1:{i:0;s:29:"yii\db\ExpressionBuilderTrait";}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:15:"Dmytro Naumenko";s:22:"d.naumenko.a@gmail.com";}s:7:"methods";a:1:{s:5:"build";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:40:"yii\db\conditions\SimpleConditionBuilder";s:10:"sourceCode";s:795:"public function build(ExpressionInterface $expression, array &$params = [])
{
    $operator = $expression->getOperator();
    $column = $expression->getColumn();
    $value = $expression->getValue();
    if ($column instanceof ExpressionInterface) {
        $column = $this->queryBuilder->buildExpression($column, $params);
    } elseif (is_string($column) && strpos($column, '(') === false) {
        $column = $this->queryBuilder->db->quoteColumnName($column);
    }
    if ($value === null) {
        return "$column $operator NULL";
    }
    if ($value instanceof ExpressionInterface) {
        return "$column $operator {$this->queryBuilder->buildExpression($value, $params)}";
    }
    $phName = $this->queryBuilder->bindParam($value, $params);
    return "$column $operator $phName";
}
