}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:54:"A value indicating whether this log target is enabled.";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:66390;s:4:"name";s:10:"getEnabled";s:8:"fullName";s:26:"yii\log\Target::getEnabled";s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/log/Target.php";s:9:"startLine";i:391;s:7:"endLine";i:398;s:16:"shortDescription";s:40:"Check whether the log target is enabled.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:7:"getTime";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:14:"yii\log\Target";s:10:"sourceCode";s:186:"protected function getTime($timestamp)
