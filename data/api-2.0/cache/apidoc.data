{
    if (is_scalar($assetManager)) {
        throw new Exception('"' . get_class($this) . '::assetManager" should be either object or array - "' . gettype($assetManager) . '" given.');
    }
    $this->_assetManager = $assetManager;
}
";s:6:"params";a:1:{s:13:"$assetManager";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:13:"$assetManager";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:50:"Asset manager instance or its array configuration.";s:4:"type";s:27:"\yii\web\AssetManager|array";s:5:"types";a:2:{i:0;s:21:"\yii\web\AssetManager";i:1;s:5:"array";}s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/AssetController.php";}}s:10:"exceptions";a:1:{s:22:"\yii\console\Exception";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:25:"on invalid argument type.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:39009;s:4:"name";s:15:"setAssetManager";s:8:"fullName";s:56:"yii\console\controllers\AssetController::setAssetManager";s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/AssetController.php";s:9:"startLine";i:177;s:7:"endLine";i:183;s:16:"shortDescription";s:45:"Sets asset manager instance or configuration.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"actionCompress";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:39:"yii\console\controllers\AssetController";s:10:"sourceCode";s:756:"public function actionCompress($configFile, $bundleFile)
{
    $this->loadConfiguration($configFile);
    $bundles = $this->loadBundles($this->bundles);
    $targets = $this->loadTargets($this->targets, $bundles);
    foreach ($targets as $name => $target) {
        $this->stdout("Creating output bundle '{$name}':\n");
        if (!empty($target->js)) {
            $this->buildTarget($target, 'js', $bundles);
        }
        if (!empty($target->css)) {
            $this->buildTarget($target, 'css', $bundles);
        }
        $this->stdout("\n");
    }
    $targets = $this->adjustDependency($targets, $bundles);
    $this->saveTargets($targets, $bundleFile);
    if ($this->deleteSource) {
        $this->deletePublishedAssets($bundles);
    }
}
";s:6:"params";a:2:{s:11:"$configFile";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:11:"$configFile";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:24:"Configuration file name.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/AssetController.php";}s:11:"$bundleFile";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:11:"$bundleFile";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:45:"Output asset bundles configuration file name.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/AssetController.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:39009;s:4:"name";s:14:"actionCompress";s:8:"fullName";s:55:"yii\console\controllers\AssetController::actionCompress";s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/AssetController.php";s:9:"startLine";i:192;s:7:"endLine";i:214;s:16:"shortDescription";s:77:"Combines and compresses the asset files according to the given configuration.";s:11:"description";s:180:"During the process new asset bundle configuration file will be created.
You should replace your original asset bundle configuration with this file in order to use compressed files.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"loadConfiguration";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:39:"yii\console\controllers\AssetController";s:10:"sourceCode";s:500:"protected function loadConfiguration($configFile)
{
    $this->stdout("Loading configuration from '{$configFile}'...\n");
    $config = require $configFile;
    foreach ($config as $name => $value) {
        if (property_exists($this, $name) || $this->canSetProperty($name)) {
            $this->$name = $value;
        } else {
            throw new Exception("Unknown configuration option: $name");
        }
    }
    $this->getAssetManager(); // check if asset manager configuration is correct
}
";s:6:"params";a:1:{s:11:"$configFile";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:11:"$configFile";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:24:"Configuration file name.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/AssetController.php";}}s:10:"exceptions";a:1:{s:22:"\yii\console\Exception";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:11:"on failure.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:39009;s:4:"name";s:17:"loadConfiguration";s:8:"fullName";s:58:"yii\console\controllers\AssetController::loadConfiguration";s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/AssetController.php";s:9:"startLine";i:221;s:7:"endLine";i:234;s:16:"shortDescription";s:59:"Applies configuration from the given file to self instance.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"loadBundles";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:39:"yii\console\controllers\AssetController";s:10:"sourceCode";s:362:"protected function loadBundles($bundles)
{
    $this->stdout("Collecting source bundles information...\n");
    $am = $this->getAssetManager();
    $result = [];
    foreach ($bundles as $name) {
        $result[$name] = $am->getBundle($name);
    }
    foreach ($result as $bundle) {
        $this->loadDependency($bundle, $result);
    }
    return $result;
}
";s:6:"params";a:1:{s:8:"$bundles";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$bundles";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:26:"List of asset bundle names";s:4:"type";s:8:"string[]";s:5:"types";a:1:{i:0;s:8:"string[]";}s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/AssetController.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:29:"List of source asset bundles.";s:10:"returnType";s:22:"\yii\web\AssetBundle[]";s:11:"returnTypes";a:1:{i:0;s:22:"\yii\web\AssetBundle[]";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:39009;s:4:"name";s:11:"loadBundles";s:8:"fullName";s:52:"yii\console\controllers\AssetController::loadBundles";s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/AssetController.php";s:9:"startLine";i:241;s:7:"endLine";i:255;s:16:"shortDescription";s:42:"Creates full list of source asset bundles.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"loadDependency";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:39:"yii\console\controllers\AssetController";s:10:"sourceCode";s:592:"protected function loadDependency($bundle, &$result)
{
    $am = $this->getAssetManager();
    foreach ($bundle->depends as $name) {
        if (!isset($result[$name])) {
            $dependencyBundle = $am->getBundle($name);
            $result[$name] = false;
            $this->loadDependency($dependencyBundle, $result);
            $result[$name] = $dependencyBundle;
        } elseif ($result[$name] === false) {
            throw new Exception("A circular dependency is detected for bundle '{$name}': " . $this->composeCircularDependencyTrace($name, $result) . '.');
        }
    }
}
";s:6:"params";a:2:{s:7:"$bundle";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$bundle";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:15:"Bundle instance";s:4:"type";s:20:"\yii\web\AssetBundle";s:5:"types";a:1:{i:0;s:20:"\yii\web\AssetBundle";}s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/AssetController.php";}s:7:"$result";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$result";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:1;s:11:"description";s:28:"Already loaded bundles list.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/AssetController.php";}}s:10:"exceptions";a:1:{s:22:"\yii\console\Exception";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:11:"on failure.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:39009;s:4:"name";s:14:"loadDependency";s:8:"fullName";s:55:"yii\console\controllers\AssetController::loadDependency";s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/AssetController.php";s:9:"startLine";i:263;s:7:"endLine";i:276;s:16:"shortDescription";s:44:"Loads asset bundle dependencies recursively.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"loadTargets";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:39:"yii\console\controllers\AssetController";s:10:"sourceCode";s:2102:"protected function loadTargets($targets, $bundles)
{
    // build the dependency order of bundles
    $registered = [];
    foreach ($bundles as $name => $bundle) {
        $this->registerBundle($bundles, $name, $registered);
    }
    $bundleOrders = array_combine(array_keys($registered), range(0, count($bundles) - 1));
    // fill up the target which has empty 'depends'.
    $referenced = [];
    foreach ($targets as $name => $target) {
        if (empty($target['depends'])) {
            if (!isset($all)) {
                $all = $name;
            } else {
                throw new Exception("Only one target can have empty 'depends' option. Found two now: $all, $name");
            }
        } else {
            foreach ($target['depends'] as $bundle) {
                if (!isset($referenced[$bundle])) {
                    $referenced[$bundle] = $name;
                } else {
                    throw new Exception("Target '{$referenced[$bundle]}' and '$name' cannot contain the bundle '$bundle' at the same time.");
                }
            }
        }
    }
    if (isset($all)) {
        $targets[$all]['depends'] = array_diff(array_keys($registered), array_keys($referenced));
    }
    // adjust the 'depends' order for each target according to the dependency order of bundles
    // create an AssetBundle object for each target
    foreach ($targets as $name => $target) {
        if (!isset($target['basePath'])) {
            throw new Exception("Please specify 'basePath' for the '$name' target.");
        }
        if (!isset($target['baseUrl'])) {
            throw new Exception("Please specify 'baseUrl' for the '$name' target.");
        }
        usort($target['depends'], function ($a, $b) use ($bundleOrders) {
            if ($bundleOrders[$a] == $bundleOrders[$b]) {
                return 0;
            }
            return $bundleOrders[$a] > $bundleOrders[$b] ? 1 : -1;
        });
        if (!isset($target['class'])) {
            $target['class'] = $name;
        }
        $targets[$name] = Yii::createObject($target);
    }
    return $targets;
}
