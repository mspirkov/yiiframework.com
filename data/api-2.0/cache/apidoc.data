It also controls the HTTP [[statusCode|status code]].

Response is configured as an application component in [[\yii\web\Application]] by default.
You can access that instance via `Yii::$app->response`.

You can modify its configuration by adding an array to your application config under `components`
as it is shown in the following example:

```
'response' => [
    'format' => yii\web\Response::FORMAT_JSON,
    'charset' => 'UTF-8',
    // ...
]
```

For more details and usage information on Response, see the [guide article on responses](guide:runtime-responses).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:15:{i:0;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:7:"cookies";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:25:"\yii\web\CookieCollection";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:16:"CookieCollection";}}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:91608;}i:1;O:52:"phpDocumentor\Reflection\DocBlock\Tags\PropertyWrite":4:{s:15:"␀*␀variableName";s:15:"downloadHeaders";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:14:"property-write";s:14:"␀*␀description";r:91634;}i:2;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:7:"headers";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:25:"\yii\web\HeaderCollection";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:16:"HeaderCollection";}}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:91660;}i:3;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:13:"isClientError";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Boolean":0:{}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:91686;}i:4;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:7:"isEmpty";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Boolean":0:{}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:91712;}i:5;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:11:"isForbidden";