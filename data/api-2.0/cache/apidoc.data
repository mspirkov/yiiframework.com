";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:21287;s:4:"name";s:4:"init";s:8:"fullName";s:28:"yii\widgets\ActiveForm::init";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveForm.php";s:9:"startLine";i:202;s:7:"endLine";i:210;s:16:"shortDescription";s:23:"Initializes the widget.";s:11:"description";s:31:"This renders the form open tag.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:3:"run";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:22:"yii\widgets\ActiveForm";s:10:"sourceCode";s:426:"public function run()
{
    if (!empty($this->_fields)) {
        throw new InvalidCallException('Each beginField() should have a matching endField() call.');
    }
    $content = ob_get_clean();
    $html = Html::beginForm($this->action, $this->method, $this->options);
    $html .= $content;
    if ($this->enableClientScript) {
        $this->registerClientScript();
    }
    $html .= Html::endForm();
    return $html;
}
";s:6:"params";a:0:{}s:10:"exceptions";a:1:{s:30:"\yii\base\InvalidCallException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:58:"if `beginField()` and `endField()` calls are not matching.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:21287;s:4:"name";s:3:"run";s:8:"fullName";s:27:"yii\widgets\ActiveForm::run";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveForm.php";s:9:"startLine";i:217;s:7:"endLine";i:233;s:16:"shortDescription";s:16:"Runs the widget.";s:11:"description";s:86:"This registers the necessary JavaScript code and renders the form open and close tags.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:20:"registerClientScript";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:22:"yii\widgets\ActiveForm";s:10:"sourceCode";s:337:"public function registerClientScript()
{
    $id = $this->options['id'];
    $options = Json::htmlEncode($this->getClientOptions());
    $attributes = Json::htmlEncode($this->attributes);
    $view = $this->getView();
    ActiveFormAsset::register($view);
    $view->registerJs("jQuery('#$id').yiiActiveForm($attributes, $options);");
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:21287;s:4:"name";s:20:"registerClientScript";s:8:"fullName";s:44:"yii\widgets\ActiveForm::registerClientScript";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveForm.php";s:9:"startLine";i:239;s:7:"endLine";i:247;s:16:"shortDescription";s:45:"This registers the necessary JavaScript code.";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.12";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"getClientOptions";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:22:"yii\widgets\ActiveForm";s:10:"sourceCode";s:1425:"protected function getClientOptions()
{
    $options = [
        'encodeErrorSummary' => $this->encodeErrorSummary,
        'errorSummary' => '.' . implode('.', preg_split('/\s+/', $this->errorSummaryCssClass, -1, PREG_SPLIT_NO_EMPTY)),
        'validateOnSubmit' => $this->validateOnSubmit,
        'errorCssClass' => $this->errorCssClass,
        'successCssClass' => $this->successCssClass,
        'validatingCssClass' => $this->validatingCssClass,
        'ajaxParam' => $this->ajaxParam,
        'ajaxDataType' => $this->ajaxDataType,
        'scrollToError' => $this->scrollToError,
        'scrollToErrorOffset' => $this->scrollToErrorOffset,
        'validationStateOn' => $this->validationStateOn,
    ];
    if ($this->validationUrl !== null) {
        $options['validationUrl'] = Url::to($this->validationUrl);
    }
    // only get the options that are different from the default ones (set in yii.activeForm.js)
    return array_diff_assoc($options, [
        'encodeErrorSummary' => true,
        'errorSummary' => '.error-summary',
        'validateOnSubmit' => true,
        'errorCssClass' => 'has-error',
        'successCssClass' => 'has-success',
        'validatingCssClass' => 'validating',
        'ajaxParam' => 'ajax',
        'ajaxDataType' => 'json',
        'scrollToError' => true,
        'scrollToErrorOffset' => 0,
        'validationStateOn' => self::VALIDATION_STATE_ON_CONTAINER,
    ]);
}
