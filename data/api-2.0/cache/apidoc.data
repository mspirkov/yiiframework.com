If the target and the source language codes are the same, the original file will be returned.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:62694;s:4:"name";s:8:"localize";s:8:"fullName";s:36:"yii\helpers\BaseFileHelper::localize";s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseFileHelper.php";s:9:"startLine";i:117;s:7:"endLine";i:140;s:16:"shortDescription";s:50:"Returns the localized version of a specified file.";s:11:"description";s:597:"The searching is based on the specified language code. In particular,
a file with the same name will be looked for under the subdirectory
whose name is the same as the language code. For example, given the file "path/to/view.php"
and language code "zh-CN", the localized file will be looked for as
"path/to/zh-CN/view.php". If the file is not found, it will try a fallback with just a language code that is
"zh" i.e. "path/to/zh/view.php". If it is not found as well the original file will be returned.

If the target and the source language codes are the same, the original file will be returned.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"getMimeType";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:26:"yii\helpers\BaseFileHelper";s:10:"sourceCode";s:964:"public static function getMimeType($file, $magicFile = null, $checkExtension = true)
{
    if ($magicFile !== null) {
        $magicFile = Yii::getAlias($magicFile);
    }
    if (!extension_loaded('fileinfo')) {
        if ($checkExtension) {
            return static::getMimeTypeByExtension($file, $magicFile);
        }
        throw new InvalidConfigException('The fileinfo PHP extension is not installed.');
    }
    $info = finfo_open(FILEINFO_MIME_TYPE, $magicFile);
    if ($info) {
        $result = finfo_file($info, $file);
        // @link https://wiki.php.net/rfc/deprecations_php_8_5#deprecate_finfo_close
        // @link https://github.com/php/php-src/commit/ccb716dcadf60d989db48e4d2963e14d7dc63df3
        if (PHP_VERSION_ID < 80500) {
            finfo_close($info);
        }
        if ($result !== false) {
            return $result;
        }
    }
    return $checkExtension ? static::getMimeTypeByExtension($file, $magicFile) : null;
}
