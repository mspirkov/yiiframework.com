are considered to be under this base URL.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"$pathMap";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:10:"array|null";s:5:"types";a:2:{i:0;s:5:"array";i:1;s:4:"null";}s:12:"defaultValue";N;s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:14:"yii\base\Theme";s:13:"phpDocContext";r:78920;s:4:"name";s:8:"$pathMap";s:8:"fullName";s:24:"yii\base\Theme::$pathMap";s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Theme.php";s:9:"startLine";i:82;s:7:"endLine";i:82;s:16:"shortDescription";s:77:"The mapping between view directories and their corresponding themed versions.";s:11:"description";s:341:"The mapping between view directories and their corresponding themed versions.
