    $this->select = $this->normalizeSelect($columns);
    $this->selectOption = $option;
    return $this;
}
";s:6:"params";a:2:{s:8:"$columns";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$columns";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:985:"The columns to be selected.
Columns can be specified in either a string (e.g. "id, name") or an array (e.g. ['id', 'name']).
Columns can be prefixed with table names (e.g. "user.id") and/or contain column aliases (e.g. "user.id AS user_id").
The method will automatically quote the column names unless a column contains some parenthesis
(which means the column contains a DB expression). A DB expression may also be passed in form of
an [[ExpressionInterface]] object.

Note that if you are selecting an expression like `CONCAT(first_name, ' ', last_name)`, you should
use an array to specify the columns. Otherwise, the expression may be incorrectly split into several parts.

When the columns are specified as an array, you may also use array keys as the column aliases (if a column
does not need alias, do not use a string key).

Starting from version 2.0.1, you may also select sub-queries as columns by specifying each such column
as a `Query` instance representing the sub-query.";s:4:"type";s:40:"string|array|\yii\db\ExpressionInterface";s:5:"types";a:3:{i:0;s:6:"string";i:1;s:5:"array";i:2;s:27:"\yii\db\ExpressionInterface";}s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";}s:7:"$option";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$option";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:135:"Additional option that should be appended to the 'SELECT' keyword. For example,
in MySQL, the option 'SQL_CALC_FOUND_ROWS' can be used.";s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:23:"The query object itself";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:164108;s:4:"name";s:6:"select";s:8:"fullName";s:20:"yii\db\Query::select";s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";s:9:"startLine";i:640;s:7:"endLine";i:645;s:16:"shortDescription";s:34:"Sets the SELECT part of the query.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"addSelect";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:12:"yii\db\Query";s:10:"sourceCode";s:325:"public function addSelect($columns)
{
    if ($this->select === null) {
        return $this->select($columns);
    }
    if (!is_array($this->select)) {
        $this->select = $this->normalizeSelect($this->select);
    }
    $this->select = array_merge($this->select, $this->normalizeSelect($columns));
    return $this;
}
";s:6:"params";a:1:{s:8:"$columns";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$columns";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:103:"The columns to add to the select. See [[select()]] for more
details about the format of this parameter.";s:4:"type";s:40:"string|array|\yii\db\ExpressionInterface";s:5:"types";a:3:{i:0;s:6:"string";i:1;s:5:"array";i:2;s:27:"\yii\db\ExpressionInterface";}s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:23:"The query object itself";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:164108;s:4:"name";s:9:"addSelect";s:8:"fullName";s:23:"yii\db\Query::addSelect";s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";s:9:"startLine";i:662;s:7:"endLine";i:673;s:16:"shortDescription";s:49:"Add more columns to the SELECT part of the query.";s:11:"description";s:231:"Note, that if [[select]] has not been specified before, you should include `*` explicitly
if you want to select all remaining columns too:

```
$query->addSelect(["*", "CONCAT(first_name, ' ', last_name) AS full_name"])->one();
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:2;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:16:"\yii\db\select()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:6:"select";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:15:"normalizeSelect";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:12:"yii\db\Query";s:10:"sourceCode";s:1399:"protected function normalizeSelect($columns)
{
    if ($columns instanceof ExpressionInterface) {
        $columns = [$columns];
    } elseif (!is_array($columns)) {
        $columns = preg_split('/\s*,\s*/', trim((string)$columns), -1, PREG_SPLIT_NO_EMPTY);
    }
    $select = [];
    foreach ($columns as $columnAlias => $columnDefinition) {
        if (is_string($columnAlias)) {
            // Already in the normalized format, good for them
            $select[$columnAlias] = $columnDefinition;
            continue;
        }
        if (is_string($columnDefinition)) {
            if (
                preg_match('/^(.*?)(?i:\s+as\s+|\s+)([\w\-_\.]+)$/', $columnDefinition, $matches) &&
                !preg_match('/^\d+$/', $matches[2]) &&
                strpos($matches[2], '.') === false
            ) {
                // Using "columnName as alias" or "columnName alias" syntax
                $select[$matches[2]] = $matches[1];
                continue;
            }
            if (strpos($columnDefinition, '(') === false) {
                // Normal column name, just alias it to itself to ensure it's not selected twice
                $select[$columnDefinition] = $columnDefinition;
                continue;
            }
        }
        // Either a string calling a function, DB expression, or sub-query
        $select[] = $columnDefinition;
    }
    return $select;
}
";s:6:"params";a:1:{s:8:"$columns";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$columns";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:40:"string|array|\yii\db\ExpressionInterface";s:5:"types";a:3:{i:0;s:6:"string";i:1;s:5:"array";i:2;s:27:"\yii\db\ExpressionInterface";}s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:0:"";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:164108;s:4:"name";s:15:"normalizeSelect";s:8:"fullName";s:29:"yii\db\Query::normalizeSelect";s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";s:9:"startLine";i:682;s:7:"endLine";i:716;s:16:"shortDescription";s:72:"Normalizes the SELECT columns passed to [[select()]] or [[addSelect()]].";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.21";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"getUniqueColumns";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:12:"yii\db\Query";s:10:"sourceCode";s:923:"protected function getUniqueColumns($columns)
{
    $unaliasedColumns = $this->getUnaliasedColumnsFromSelect();
    $result = [];
    foreach ($columns as $columnAlias => $columnDefinition) {
        if (!$columnDefinition instanceof Query) {
            if (is_string($columnAlias)) {
                $existsInSelect = isset($this->select[$columnAlias]) && $this->select[$columnAlias] === $columnDefinition;
                if ($existsInSelect) {
                    continue;
                }
            } elseif (is_int($columnAlias)) {
                $existsInSelect = in_array($columnDefinition, $unaliasedColumns, true);
                $existsInResultSet = in_array($columnDefinition, $result, true);
                if ($existsInSelect || $existsInResultSet) {
                    continue;
                }
            }
        }
        $result[$columnAlias] = $columnDefinition;
    }
    return $result;
}
";s:6:"params";a:1:{s:8:"$columns";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$columns";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:39:"The columns to be merged to the select.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:164108;s:4:"name";s:16:"getUniqueColumns";s:8:"fullName";s:30:"yii\db\Query::getUniqueColumns";s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";s:9:"startLine";i:727;s:7:"endLine";i:751;s:16:"shortDescription";s:49:"Returns unique column names excluding duplicates.";s:11:"description";s:178:"Columns to be removed:
- if column definition already present in SELECT part with same alias
- if column definition without alias already present in SELECT part without alias too";s:5:"since";s:6:"2.0.14";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";s:9:"in 2.0.21";s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:29:"getUnaliasedColumnsFromSelect";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:12:"yii\db\Query";s:10:"sourceCode";s:294:"protected function getUnaliasedColumnsFromSelect()
{
    $result = [];
    if (is_array($this->select)) {
        foreach ($this->select as $name => $value) {
            if (is_int($name)) {
                $result[] = $value;
            }
        }
    }
    return array_unique($result);
}
