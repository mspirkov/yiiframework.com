c":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\db\pgsql\QueryBuilder";s:10:"sourceCode";s:130:"public function truncateTable($table)
{
    return 'TRUNCATE TABLE ' . $this->db->quoteTableName($table) . ' RESTART IDENTITY';
}
";s:6:"params";a:1:{s:6:"$table";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$table";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:74:"The table to be truncated. The name will be properly quoted by the method.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/QueryBuilder.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:44:"The SQL statement for truncating a DB table.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:195066;s:4:"name";s:13:"truncateTable";s:8:"fullName";s:40:"yii\db\pgsql\QueryBuilder::truncateTable";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/QueryBuilder.php";s:9:"startLine";i:240;s:7:"endLine";i:243;s:16:"shortDescription";s:49:"Builds a SQL statement for truncating a DB table.";s:11:"description";s:106:"Explicitly restarts identity for PGSQL to be consistent with other databases which all do this by default.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"alterColumn";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\db\pgsql\QueryBuilder";s:10:"sourceCode";s:2016:"public function alterColumn($table, $column, $type)
{
    $columnName = $this->db->quoteColumnName($column);
    $tableName = $this->db->quoteTableName($table);
    // https://github.com/yiisoft/yii2/issues/4492
    // https://www.postgresql.org/docs/9.1/sql-altertable.html
    if (preg_match('/^(DROP|SET|RESET)\s+/i', $type)) {
        return "ALTER TABLE {$tableName} ALTER COLUMN {$columnName} {$type}";
    }
    $type = 'TYPE ' . $this->getColumnType($type);
    $multiAlterStatement = [];
    $constraintPrefix = preg_replace('/[^a-z0-9_]/i', '', $table . '_' . $column);
    if (preg_match('/\s+DEFAULT\s+(["\']?\w*["\']?)/i', $type, $matches)) {
        $type = preg_replace('/\s+DEFAULT\s+(["\']?\w*["\']?)/i', '', $type);
        $multiAlterStatement[] = "ALTER COLUMN {$columnName} SET DEFAULT {$matches[1]}";
    } else {
        // safe to drop default even if there was none in the first place
        $multiAlterStatement[] = "ALTER COLUMN {$columnName} DROP DEFAULT";
    }
    $type = preg_replace('/\s+NOT\s+NULL/i', '', $type, -1, $count);
    if ($count) {
        $multiAlterStatement[] = "ALTER COLUMN {$columnName} SET NOT NULL";
    } else {
        // remove additional null if any
        $type = preg_replace('/\s+NULL/i', '', $type);
        // safe to drop not null even if there was none in the first place
        $multiAlterStatement[] = "ALTER COLUMN {$columnName} DROP NOT NULL";
    }
    if (preg_match('/\s+CHECK\s+\((.+)\)/i', $type, $matches)) {
        $type = preg_replace('/\s+CHECK\s+\((.+)\)/i', '', $type);
        $multiAlterStatement[] = "ADD CONSTRAINT {$constraintPrefix}_check CHECK ({$matches[1]})";
    }
    $type = preg_replace('/\s+UNIQUE/i', '', $type, -1, $count);
    if ($count) {
        $multiAlterStatement[] = "ADD UNIQUE ({$columnName})";
    }
    // add what's left at the beginning
    array_unshift($multiAlterStatement, "ALTER COLUMN {$columnName} {$type}");
    return 'ALTER TABLE ' . $tableName . ' ' . implode(', ', $multiAlterStatement);
}
