";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:17971;s:4:"name";s:3:"run";s:8:"fullName";s:28:"yii\widgets\MaskedInput::run";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/MaskedInput.php";s:9:"startLine";i:143;s:7:"endLine";i:147;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:17:"hashPluginOptions";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:23:"yii\widgets\MaskedInput";s:10:"sourceCode";s:374:"protected function hashPluginOptions($view)
{
    $encOptions = empty($this->clientOptions) ? '{}' : Json::htmlEncode($this->clientOptions);
    $this->_hashVar = self::PLUGIN_NAME . '_' . hash('crc32', $encOptions);
    $this->options['data-plugin-' . self::PLUGIN_NAME] = $this->_hashVar;
    $view->registerJs("var {$this->_hashVar} = {$encOptions};", View::POS_HEAD);
}
";s:6:"params";a:1:{s:5:"$view";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$view";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:17:"The view instance";s:4:"type";s:13:"\yii\web\View";s:5:"types";a:1:{i:0;s:13:"\yii\web\View";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/MaskedInput.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:17971;s:4:"name";s:17:"hashPluginOptions";s:8:"fullName";s:42:"yii\widgets\MaskedInput::hashPluginOptions";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/MaskedInput.php";s:9:"startLine";i:161;s:7:"endLine";i:167;s:16:"shortDescription";s:64:"Generates a hashed variable to store the plugin `clientOptions`.";s:11:"description";s:307:"Helps in reusing the variable for similar
options passed for other widgets on the same page. The following special data attribute will also be
added to the input field to allow accessing the client options via javascript:

- 'data-plugin-inputmask' will store the hashed variable storing the plugin options.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:1;O:45:"phpDocumentor\Reflection\DocBlock\Tags\Author":4:{s:7:"␀*␀name";s:6:"author";s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Author␀authorName";s:46:"[Thiago Talma](https://github.com/thiagotalma)";s:58:"␀phpDocumentor\Reflection\DocBlock\Tags\Author␀authorEmail";s:0:"";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:17:"initClientOptions";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:23:"yii\widgets\MaskedInput";s:10:"sourceCode";s:387:"protected function initClientOptions()
{
    $options = $this->clientOptions;
    foreach ($options as $key => $value) {
        if (
            !empty($value)
            && !$value instanceof JsExpression
            && in_array($key, $this->_jsCallbacks, true)
        ) {
            $options[$key] = new JsExpression($value);
        }
    }
    $this->clientOptions = $options;
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:17971;s:4:"name";s:17:"initClientOptions";s:8:"fullName";s:42:"yii\widgets\MaskedInput::initClientOptions";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/MaskedInput.php";s:9:"startLine";i:172;s:7:"endLine";i:185;s:16:"shortDescription";s:27:"Initializes client options.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:20:"registerClientScript";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\widgets\MaskedInput";s:10:"sourceCode";s:795:"public function registerClientScript()
{
    $js = '';
    $view = $this->getView();
    $this->initClientOptions();
    if (!empty($this->mask)) {
        $this->clientOptions['mask'] = $this->mask;
    }
    $this->hashPluginOptions($view);
    if (is_array($this->definitions) && !empty($this->definitions)) {
        $js .= ucfirst(self::PLUGIN_NAME) . '.extendDefinitions(' . Json::htmlEncode($this->definitions) . ');';
    }
    if (is_array($this->aliases) && !empty($this->aliases)) {
        $js .= ucfirst(self::PLUGIN_NAME) . '.extendAliases(' . Json::htmlEncode($this->aliases) . ');';
    }
    $id = $this->options['id'];
    $js .= 'jQuery("#' . $id . '").' . self::PLUGIN_NAME . '(' . $this->_hashVar . ');';
    MaskedInputAsset::register($view);
    $view->registerJs($js);
}
