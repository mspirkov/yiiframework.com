s:10:"visibility";s:6:"public";s:9:"definedBy";s:16:"yii\filters\Cors";s:10:"sourceCode";s:261:"public function addCorsHeaders($response, $headers)
{
    if (empty($headers) === false) {
        $responseHeaders = $response->getHeaders();
        foreach ($headers as $field => $value) {
            $responseHeaders->set($field, $value);
        }
    }
}
