{
    parent::init();
    if ($this->message === null) {
        $this->message = $this->requiredValue === null ? Yii::t('yii', '{attribute} cannot be blank.')
            : Yii::t('yii', '{attribute} must be "{requiredValue}".');
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:14:"yii\validators";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:2:{s:3:"Yii";s:3:"Yii";s:4:"Json";s:16:"yii\helpers\Json";}}s:4:"name";s:4:"init";s:8:"fullName";s:38:"yii\validators\RequiredValidator::init";s:10:"sourceFile";s:107:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/RequiredValidator.php";s:9:"startLine";i:59;s:7:"endLine";i:66;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:13:"validateValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:32:"yii\validators\RequiredValidator";s:10:"sourceCode";s:565:"protected function validateValue($value)
{
    if ($this->requiredValue === null) {
        if ($this->strict && $value !== null || !$this->strict && !$this->isEmpty(is_string($value) ? trim($value) : $value)) {
            return null;
        }
    } elseif (!$this->strict && $value == $this->requiredValue || $this->strict && $value === $this->requiredValue) {
        return null;
    }
    if ($this->requiredValue === null) {
        return [$this->message, []];
    }
    return [$this->message, [
        'requiredValue' => $this->requiredValue,
    ]];
}
