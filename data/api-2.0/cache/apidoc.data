where `$rule` is this rule, and `$action` is the current [[Action|action]] object.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:1;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:41:"\yii\filters\AccessControl::$denyCallback";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:12:"denyCallback";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}}s:9:"namespace";s:11:"yii\filters";s:13:"phpDocContext";r:44920;s:4:"name";s:22:"yii\filters\AccessRule";s:8:"fullName";s:22:"yii\filters\AccessRule";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/AccessRule.php";s:9:"startLine";i:28;s:7:"endLine";i:325;s:16:"shortDescription";s:84:"This class represents an access rule defined by the [[AccessControl]] action filter.";s:11:"description";s:0:"";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:21:"yii\filters\HttpCache";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:21:"yii\base\ActionFilter";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:2:{s:12:"Da:Sourcerer";s:25:"webmaster@dasourcerer.net";s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:4:{s:12:"beforeAction";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\filters\HttpCache";s:10:"sourceCode";s:1234:"public function beforeAction($action)
{
    if (!$this->enabled) {
        return true;
    }
    $verb = Yii::$app->getRequest()->getMethod();
    if ($verb !== 'GET' && $verb !== 'HEAD' || $this->lastModified === null && $this->etagSeed === null) {
        return true;
    }
    $lastModified = $etag = null;
    if ($this->lastModified !== null) {
        $lastModified = call_user_func($this->lastModified, $action, $this->params);
    }
    if ($this->etagSeed !== null) {
        $seed = call_user_func($this->etagSeed, $action, $this->params);
        if ($seed !== null) {
            $etag = $this->generateEtag($seed);
        }
    }
    $this->sendCacheControlHeader();
    $response = Yii::$app->getResponse();
    if ($etag !== null) {
        $response->getHeaders()->set('Etag', $etag);
    }
    $cacheValid = $this->validateCache($lastModified, $etag);
    // https://tools.ietf.org/html/rfc7232#section-4.1
    if ($lastModified !== null && (!$cacheValid || ($cacheValid && $etag === null))) {
        $response->getHeaders()->set('Last-Modified', gmdate('D, d M Y H:i:s', $lastModified) . ' GMT');
    }
    if ($cacheValid) {
        $response->setStatusCode(304);
        return false;
    }
    return true;
}
";s:6:"params";a:1:{s:7:"$action";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$action";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/HttpCache.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\filters";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:3:{s:3:"Yii";s:3:"Yii";s:12:"ActionFilter";s:21:"yii\base\ActionFilter";s:9:"Component";s:18:"yii\base\Component";}}s:4:"name";s:12:"beforeAction";s:8:"fullName";s:35:"yii\filters\HttpCache::beforeAction";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/HttpCache.php";s:9:"startLine";i:116;s:7:"endLine";i:156;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:13:"validateCache";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:21:"yii\filters\HttpCache";s:10:"sourceCode";s:572:"protected function validateCache($lastModified, $etag)
{
    if (Yii::$app->request->headers->has('If-None-Match')) {
        // HTTP_IF_NONE_MATCH takes precedence over HTTP_IF_MODIFIED_SINCE
        // https://datatracker.ietf.org/doc/html/rfc7232#section-3.3
        return $etag !== null && in_array($etag, Yii::$app->request->getETags(), true);
    } elseif (Yii::$app->request->headers->has('If-Modified-Since')) {
        return $lastModified !== null && @strtotime(Yii::$app->request->headers->get('If-Modified-Since')) >= $lastModified;
    }
    return false;
}
";s:6:"params";a:2:{s:13:"$lastModified";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:13:"$lastModified";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:121:"The calculated Last-Modified value in terms of a UNIX timestamp.
If null, the Last-Modified header will not be validated.";s:4:"type";s:8:"int|null";s:5:"types";a:2:{i:0;s:3:"int";i:1;s:4:"null";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/HttpCache.php";}s:5:"$etag";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$etag";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:74:"The calculated ETag value. If null, the ETag header will not be validated.";s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/HttpCache.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:38:"Whether the HTTP cache is still valid.";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:45760;s:4:"name";s:13:"validateCache";s:8:"fullName";s:36:"yii\filters\HttpCache::validateCache";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/HttpCache.php";s:9:"startLine";i:166;s:7:"endLine";i:177;s:16:"shortDescription";s:51:"Validates if the HTTP cache contains valid content.";s:11:"description";s:55:"If both Last-Modified and ETag are null, returns false.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:22:"sendCacheControlHeader";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:21:"yii\filters\HttpCache";s:10:"sourceCode";s:636:"protected function sendCacheControlHeader()
{
    if ($this->sessionCacheLimiter !== null) {
        if ($this->sessionCacheLimiter === '' && !headers_sent() && Yii::$app->getSession()->getIsActive()) {
            header_remove('Expires');
            header_remove('Cache-Control');
            header_remove('Last-Modified');
            header_remove('Pragma');
        }
        Yii::$app->getSession()->setCacheLimiter($this->sessionCacheLimiter);
    }
    $headers = Yii::$app->getResponse()->getHeaders();
    if ($this->cacheControlHeader !== null) {
        $headers->set('Cache-Control', $this->cacheControlHeader);
    }
}
