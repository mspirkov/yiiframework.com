> Note: if this option is enabled, value of `$_FILES` will be reset on each parse.";s:5:"since";s:6:"2.0.13";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Boolean":0:{}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:290:"whether to parse raw body even for 'POST' request and `$_FILES` already populated.
By default this option is disabled saving performance for 'POST' requests, which are already
processed by PHP automatically.
> Note: if this option is enabled, value of `$_FILES` will be reset on each parse.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:7:"yii\web";s:13:"phpDocContext";r:112742;s:4:"name";s:31:"yii\web\MultipartFormDataParser";s:8:"fullName";s:31:"yii\web\MultipartFormDataParser";s:10:"sourceFile";s:106:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/MultipartFormDataParser.php";s:9:"startLine";i:65;s:7:"endLine";i:372;s:16:"shortDescription";s:72:"MultipartFormDataParser parses content encoded as 'multipart/form-data'.";s:11:"description";s:1490:"This parser provides the fallback for the 'multipart/form-data' processing on non POST requests,
for example: the one with 'PUT' request method.

In order to enable this parser you should configure [[Request::parsers]] in the following way:

```
return [
    'components' => [
        'request' => [
            'parsers' => [
                'multipart/form-data' => 'yii\web\MultipartFormDataParser'
            ],
        ],
        // ...
    ],
    // ...
];
```

Method [[parse()]] of this parser automatically populates `$_FILES` with the files parsed from raw body.

> Note: since this is a request parser, it will initialize `$_FILES` values on [[Request::getBodyParams()]].
Until this method is invoked, `$_FILES` array will remain empty even if there are submitted files in the
request body. Make sure you have requested body params before any attempt to get uploaded file in case
you are using this parser.

Usage example:

```
use yii\web\UploadedFile;

$restRequestData = Yii::$app->request->getBodyParams();
$uploadedFile = UploadedFile::getInstancesByName('photo');

$model = new Item();
$model->populate($restRequestData);
copy($uploadedFile->tempName, '/path/to/file/storage/photo.jpg');
```

> Note: although this parser fully emulates regular structure of the `$_FILES`, related temporary
files, which are available via `tmp_name` key, will not be recognized by PHP as uploaded ones.
Thus functions like `is_uploaded_file()` and `move_uploaded_file()` will fail on them.";s:5:"since";s:6:"2.0.10";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:0;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:18:"uploadFileMaxCount";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Integer":0:{}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:112933;}i:1;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:17:"uploadFileMaxSize";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Integer":0:{}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:112959;}}s:5:"todos";a:0:{}}s:15:"yii\web\Request";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:16:"yii\base\Request";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:2:{s:11:"CSRF_HEADER";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:15:"yii\web\Request";s:5:"value";s:14:"'X-CSRF-Token'";s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:7:"yii\web";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:3:{s:3:"Yii";s:3:"Yii";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:11:"IpValidator";s:26:"yii\validators\IpValidator";}}s:4:"name";s:11:"CSRF_HEADER";s:8:"fullName";s:28:"yii\web\Request::CSRF_HEADER";s:10:"sourceFile";N;s:9:"startLine";i:96;s:7:"endLine";i:96;s:16:"shortDescription";s:55:"Default name of the HTTP header for sending CSRF token.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"CSRF_MASK_LENGTH";O:26:"yii\apidoc\models\ConstDoc":16:{s:9:"definedBy";s:15:"yii\web\Request";s:5:"value";s:1:"8";s:13:"phpDocContext";r:113036;s:4:"name";s:16:"CSRF_MASK_LENGTH";s:8:"fullName";s:33:"yii\web\Request::CSRF_MASK_LENGTH";s:10:"sourceFile";N;s:9:"startLine";i:101;s:7:"endLine";i:101;s:16:"shortDescription";s:34:"The length of the CSRF token mask.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";s:63:"since 2.0.12. The mask length is now equal to the token length.";s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:81:{s:7:"resolve";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:15:"yii\web\Request";s:10:"sourceCode";s:488:"public function resolve()
{
    $result = Yii::$app->getUrlManager()->parseRequest($this);
    if ($result !== false) {
        list($route, $params) = $result;
        if ($this->_queryParams === null) {
            $_GET = $params + $_GET; // preserve numeric keys
        } else {
            $this->_queryParams = $params + $this->_queryParams;
        }
        return [$route, $this->getQueryParams()];
    }
    throw new NotFoundHttpException(Yii::t('yii', 'Page not found.'));
}
";s:6:"params";a:0:{}s:10:"exceptions";a:1:{s:30:"\yii\web\NotFoundHttpException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:34:"if the request cannot be resolved.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:76:"The first element is the route, and the second is the associated parameters.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:113036;s:4:"name";s:7:"resolve";s:8:"fullName";s:24:"yii\web\Request::resolve";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";s:9:"startLine";i:316;s:7:"endLine";i:331;s:16:"shortDescription";s:72:"Resolves the current request into a route and the associated parameters.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"filterHeaders";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:15:"yii\web\Request";s:10:"sourceCode";s:361:"protected function filterHeaders(HeaderCollection $headerCollection)
{
    $trustedHeaders = $this->getTrustedHeaders();
    // remove all secure headers unless they are trusted
    foreach ($this->secureHeaders as $secureHeader) {
        if (!in_array($secureHeader, $trustedHeaders)) {
            $headerCollection->remove($secureHeader);
        }
    }
}
";s:6:"params";a:1:{s:17:"$headerCollection";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:17:"$headerCollection";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:25:"\yii\web\HeaderCollection";s:5:"types";a:1:{i:0;s:25:"\yii\web\HeaderCollection";}s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:113036;s:4:"name";s:13:"filterHeaders";s:8:"fullName";s:30:"yii\web\Request::filterHeaders";s:10:"sourceFile";s:90:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/Request.php";s:9:"startLine";i:338;s:7:"endLine";i:348;s:16:"shortDescription";s:50:"Filters headers according to the [[trustedHosts]].";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.13";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"getTrustedHeaders";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:15:"yii\web\Request";s:10:"sourceCode";s:704:"protected function getTrustedHeaders()
{
    // do not trust any of the [[secureHeaders]] by default
    $trustedHeaders = [];
    // check if the client is a trusted host
    if (!empty($this->trustedHosts)) {
        $validator = $this->getIpValidator();
        $ip = $this->getRemoteIP();
        foreach ($this->trustedHosts as $cidr => $headers) {
            if (!is_array($headers)) {
                $cidr = $headers;
                $headers = $this->secureHeaders;
            }
            $validator->setRanges($cidr);
            if ($validator->validate($ip)) {
                $trustedHeaders = $headers;
                break;
            }
        }
    }
    return $trustedHeaders;
}
