";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:28:"The version of Yii framework";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:3:"yii";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:6:{s:24:"InvalidArgumentException";s:33:"yii\base\InvalidArgumentException";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:21:"UnknownClassException";s:30:"yii\base\UnknownClassException";s:9:"Container";s:16:"yii\di\Container";s:6:"Logger";s:14:"yii\log\Logger";s:17:"IdentityInterface";s:25:"yii\web\IdentityInterface";}}s:4:"name";s:10:"getVersion";s:8:"fullName";s:23:"yii\BaseYii::getVersion";s:10:"sourceFile";s:86:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/BaseYii.php";s:9:"startLine";i:100;s:7:"endLine";i:103;s:16:"shortDescription";s:71:"Returns a string representing the current version of the Yii framework.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"getAlias";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:11:"yii\BaseYii";s:10:"sourceCode";s:815:"public static function getAlias($alias, $throwException = true)
{
    if (strncmp((string)$alias, '@', 1) !== 0) {
        // not an alias
        return $alias;
    }
    $pos = strpos($alias, '/');
    $root = $pos === false ? $alias : substr($alias, 0, $pos);
    if (isset(static::$aliases[$root])) {
        if (is_string(static::$aliases[$root])) {
            return $pos === false ? static::$aliases[$root] : static::$aliases[$root] . substr($alias, $pos);
        }
        foreach (static::$aliases[$root] as $name => $path) {
            if (strpos($alias . '/', $name . '/') === 0) {
                return $path . substr($alias, strlen($name));
            }
        }
    }
    if ($throwException) {
        throw new InvalidArgumentException("Invalid path alias: $alias");
    }
    return false;
}
";s:6:"params";a:2:{s:6:"$alias";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$alias";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:27:"The alias to be translated.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:86:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/BaseYii.php";}s:15:"$throwException";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:15:"$throwException";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"true";s:19:"isPassedByReference";b:0;s:11:"description";s:147:"Whether to throw an exception if the given alias is invalid.
If this is false and an invalid alias is given, false will be returned by this method.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:86:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/BaseYii.php";}}s:10:"exceptions";a:1:{s:34:"\yii\base\InvalidArgumentException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:54:"if the alias is invalid while $throwException is true.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:90:"The path corresponding to the alias, false if the root alias is not previously registered.";s:10:"returnType";s:12:"string|false";s:11:"returnTypes";a:2:{i:0;s:6:"string";i:1;s:5:"false";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:152664;s:4:"name";s:8:"getAlias";s:8:"fullName";s:21:"yii\BaseYii::getAlias";s:10:"sourceFile";s:86:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/BaseYii.php";s:9:"startLine";i:140;s:7:"endLine";i:167;s:16:"shortDescription";s:44:"Translates a path alias into an actual path.";s:11:"description";s:1175:"The translation is done according to the following procedure:

1. If the given alias does not start with '@', it is returned back without change;
2. Otherwise, look for the longest registered alias that matches the beginning part
   of the given alias. If it exists, replace the matching part of the given alias with
   the corresponding registered path.
3. Throw an exception or return false, depending on the `$throwException` parameter.

For example, by default '@yii' is registered as the alias to the Yii framework directory,
say '/path/to/yii'. The alias '@yii/web' would then be translated into '/path/to/yii/web'.

If you have registered two aliases '@foo' and '@foo/bar'. Then translating '@foo/bar/config'
would replace the part '@foo/bar' (instead of '@foo') with the corresponding registered path.
This is because the longest alias takes precedence.

However, if the alias to be translated is '@foo/barbar/config', then '@foo' will be replaced
instead of '@foo/bar', because '/' serves as the boundary character.

Note, this method does not check if the returned path exists or not.

See the [guide article on aliases](guide:concept-aliases) for more information.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:3:{i:4;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:15:"\yii\setAlias()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:8:"setAlias";}}s:14:"␀*␀description";N;}i:5;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:14:"phpstan-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:49:"($throwException is true ? string : string|false)";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:6;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:12:"psalm-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:49:"($throwException is true ? string : string|false)";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:12:"getRootAlias";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:11:"yii\BaseYii";s:10:"sourceCode";s:470:"public static function getRootAlias($alias)
{
    $pos = strpos($alias, '/');
    $root = $pos === false ? $alias : substr($alias, 0, $pos);
    if (isset(static::$aliases[$root])) {
        if (is_string(static::$aliases[$root])) {
            return $root;
        }
        foreach (static::$aliases[$root] as $name => $path) {
            if (strpos($alias . '/', $name . '/') === 0) {
                return $name;
            }
        }
    }
    return false;
}
";s:6:"params";a:1:{s:6:"$alias";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$alias";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:9:"The alias";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:86:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/BaseYii.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:50:"The root alias, or false if no root alias is found";s:10:"returnType";s:12:"string|false";s:11:"returnTypes";a:2:{i:0;s:6:"string";i:1;s:5:"false";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:152664;s:4:"name";s:12:"getRootAlias";s:8:"fullName";s:25:"yii\BaseYii::getRootAlias";s:10:"sourceFile";s:86:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/BaseYii.php";s:9:"startLine";i:176;s:7:"endLine";i:194;s:16:"shortDescription";s:45:"Returns the root alias part of a given alias.";s:11:"description";s:162:"A root alias is an alias that has been registered via [[setAlias()]] previously.
If a given alias matches multiple root aliases, the longest one will be returned.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"setAlias";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:11:"yii\BaseYii";s:10:"sourceCode";s:1256:"public static function setAlias($alias, $path)
{
    if (strncmp($alias, '@', 1)) {
        $alias = '@' . $alias;
    }
    $pos = strpos($alias, '/');
    $root = $pos === false ? $alias : substr($alias, 0, $pos);
    if ($path !== null) {
        $path = strncmp($path, '@', 1) ? rtrim($path, '\\/') : static::getAlias($path);
        if (!isset(static::$aliases[$root])) {
            if ($pos === false) {
                static::$aliases[$root] = $path;
            } else {
                static::$aliases[$root] = [$alias => $path];
            }
        } elseif (is_string(static::$aliases[$root])) {
            if ($pos === false) {
                static::$aliases[$root] = $path;
            } else {
                static::$aliases[$root] = [
                    $alias => $path,
                    $root => static::$aliases[$root],
                ];
            }
        } else {
            static::$aliases[$root][$alias] = $path;
            krsort(static::$aliases[$root]);
        }
    } elseif (isset(static::$aliases[$root])) {
        if (is_array(static::$aliases[$root])) {
            unset(static::$aliases[$root][$alias]);
        } elseif ($pos === false) {
            unset(static::$aliases[$root]);
        }
    }
}
";s:6:"params";a:2:{s:6:"$alias";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$alias";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:192:"The alias name (e.g. "@yii"). It must start with a '@' character.
It may contain the forward-slash '/' which serves as a boundary character when performing
alias translation by [[getAlias()]].";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:86:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/BaseYii.php";}s:5:"$path";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$path";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:386:"The path corresponding to the alias. If this is null, the alias will
be removed. Trailing '/' and '\' characters will be trimmed. This can be

- a directory or a file path (e.g. `/tmp`, `/tmp/main.txt`)
- a URL (e.g. `https://www.yiiframework.com`)
- a path alias (e.g. `@yii/base`). In this case, the path alias will be converted into the
  actual path first by calling [[getAlias()]].";s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:10:"sourceFile";s:86:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/BaseYii.php";}}s:10:"exceptions";a:1:{s:34:"\yii\base\InvalidArgumentException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:29:"if $path is an invalid alias.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:152664;s:4:"name";s:8:"setAlias";s:8:"fullName";s:21:"yii\BaseYii::setAlias";s:10:"sourceFile";s:86:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/BaseYii.php";s:9:"startLine";i:226;s:7:"endLine";i:261;s:16:"shortDescription";s:23:"Registers a path alias.";s:11:"description";s:551:"A path alias is a short name representing a long path (a file path, a URL, etc.)
For example, we use '@yii' as the alias of the path to the Yii framework directory.

A path alias must start with the character '@' so that it can be easily differentiated
from non-alias paths.

Note that this method does not check if the given path exists or not. All it does is
to associate the alias with the path.

Any trailing '/' and '\' characters in the given path will be trimmed.

See the [guide article on aliases](guide:concept-aliases) for more information.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:3;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:15:"\yii\getAlias()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:8:"getAlias";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:8:"autoload";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:11:"yii\BaseYii";s:10:"sourceCode";s:811:"public static function autoload($className)
{
    if (isset(static::$classMap[$className])) {
        $classFile = static::$classMap[$className];
        if (strncmp($classFile, '@', 1) === 0) {
            $classFile = static::getAlias($classFile);
        }
    } elseif (strpos($className, '\\') !== false) {
        $classFile = static::getAlias('@' . str_replace('\\', '/', $className) . '.php', false);
        if ($classFile === false || !is_file($classFile)) {
            return;
        }
    } else {
        return;
    }
    include $classFile;
    if (YII_DEBUG && !class_exists($className, false) && !interface_exists($className, false) && !trait_exists($className, false)) {
        throw new UnknownClassException("Unable to find '$className' in file: $classFile. Namespace missing?");
    }
}
";s:6:"params";a:1:{s:10:"$className";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$className";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:62:"The fully qualified class name without a leading backslash "\"";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:86:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/BaseYii.php";}}s:10:"exceptions";a:1:{s:31:"\yii\base\UnknownClassException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:45:"if the class does not exist in the class file";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:152664;s:4:"name";s:8:"autoload";s:8:"fullName";s:21:"yii\BaseYii::autoload";s:10:"sourceFile";s:86:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/BaseYii.php";s:9:"startLine";i:286;s:7:"endLine";i:307;s:16:"shortDescription";s:22:"Class autoload loader.";s:11:"description";s:944:"This method is invoked automatically when PHP sees an unknown class.
The method will attempt to include the class file according to the following procedure:

1. Search in [[classMap]];
2. If the class is namespaced (e.g. `yii\base\Component`), it will attempt
   to include the file associated with the corresponding path alias
   (e.g. `@yii/base/Component.php`);

This autoloader allows loading classes that follow the [PSR-4 standard](https://www.php-fig.org/psr/psr-4/)
and have its top-level namespace or sub-namespaces defined as path aliases.

Example: When aliases `@yii` and `@yii/bootstrap` are defined, classes in the `yii\bootstrap` namespace
will be loaded using the `@yii/bootstrap` alias which points to the directory where the bootstrap extension
files are installed and all classes from other `yii` namespaces will be loaded from the yii framework directory.

Also the [guide section on autoloading](guide:concept-autoloading).";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:12:"createObject";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:11:"yii\BaseYii";s:10:"sourceCode";s:865:"public static function createObject($type, array $params = [])
{
    if (is_string($type)) {
        return static::$container->get($type, $params);
    }
    if (is_callable($type, true)) {
        return static::$container->invoke($type, $params);
    }
    if (!is_array($type)) {
        throw new InvalidConfigException('Unsupported configuration type: ' . gettype($type));
    }
    if (isset($type['__class'])) {
        $class = $type['__class'];
        unset($type['__class'], $type['class']);
        return static::$container->get($class, $params, $type);
    }
    if (isset($type['class'])) {
        $class = $type['class'];
        unset($type['class']);
        return static::$container->get($class, $params, $type);
    }
    throw new InvalidConfigException('Object configuration must be an array containing a "class" or "__class" element.');
}
";s:6:"params";a:2:{s:5:"$type";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$type";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:538:"The object type. This can be specified in one of the following forms:

- a string: representing the class name of the object to be created
- a configuration array: the array must contain a `class` element which is treated as the object class,
  and the rest of the name-value pairs will be used to initialize the corresponding object properties
- a PHP callable: either an anonymous function or an array representing a class method (`[$class or $object, $method]`).
  The callable should return a new instance of the object being created.";s:4:"type";s:21:"string|array|callable";s:5:"types";a:3:{i:0;s:6:"string";i:1;s:5:"array";i:2;s:8:"callable";}s:10:"sourceFile";s:86:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/BaseYii.php";}s:7:"$params";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$params";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:26:"The constructor parameters";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:86:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/BaseYii.php";}}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:32:"if the configuration is invalid.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:18:"The created object";s:10:"returnType";s:6:"object";s:11:"returnTypes";a:1:{i:0;s:6:"object";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:152664;s:4:"name";s:12:"createObject";s:8:"fullName";s:25:"yii\BaseYii::createObject";s:10:"sourceFile";s:86:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/BaseYii.php";s:9:"startLine";i:357;s:7:"endLine";i:384;s:16:"shortDescription";s:51:"Creates a new object using the given configuration.";s:11:"description";s:839:"You may view this method as an enhanced version of the `new` operator.
The method supports creating an object based on a class name, a configuration array or
an anonymous function.

Below are some usage examples:

```
// create an object using a class name
$object = Yii::createObject('yii\db\Connection');

// create an object using a configuration array
$object = Yii::createObject([
    'class' => 'yii\db\Connection',
    'dsn' => 'mysql:host=127.0.0.1;dbname=demo',
    'username' => 'root',
    'password' => '',
    'charset' => 'utf8',
]);

// create an object with two constructor parameters
$object = \Yii::createObject('MyClass', [$param1, $param2]);
```

Using [[\yii\di\Container|dependency injection container]], this method can also identify
dependent objects, instantiate them and inject them into the newly created object.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:6:{i:4;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:17:"\yii\di\Container";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:9:"Container";}}s:14:"␀*␀description";N;}i:5;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Template":5:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀templateName";s:1:"T";s:54:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀bound";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:56:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀default";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:7:"␀*␀name";s:8:"template";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:6;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:13:"phpstan-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:98:"class-string<T>|array{class?: class-string<T>, __class?: class-string<T>, ...}|callable(): T $type";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:7;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:11:"psalm-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:98:"class-string<T>|array{class?: class-string<T>, __class?: class-string<T>, ...}|callable(): T $type";s:51:"␀phpDocum