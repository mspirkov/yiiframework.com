";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:43510;s:4:"name";s:13:"optionAliases";s:8:"fullName";s:56:"yii\console\controllers\FixtureController::optionAliases";s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/FixtureController.php";s:9:"startLine";i:85;s:7:"endLine";i:91;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";s:5:"2.0.8";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:1;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:10:"actionLoad";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:41:"yii\console\controllers\FixtureController";s:10:"sourceCode";s:1611:"public function actionLoad(array $fixturesInput = [])
{
    if ($fixturesInput === []) {
        $this->printHelpMessage();
        return ExitCode::OK;
    }
    $filtered = $this->filterFixtures($fixturesInput);
    $except = $filtered['except'];
    if (!$this->needToApplyAll($fixturesInput[0])) {
        $fixtures = $filtered['apply'];
        $foundFixtures = $this->findFixtures($fixtures);
        $notFoundFixtures = array_diff($fixtures, $foundFixtures);
        if ($notFoundFixtures !== []) {
            $this->notifyNotFound($notFoundFixtures);
        }
    } else {
        $foundFixtures = $this->findFixtures();
    }
    $fixturesToLoad = array_diff($foundFixtures, $except);
    if (!$foundFixtures) {
        throw new Exception(
            'No files were found for: "' . implode(', ', $fixturesInput) . "\".\n" .
            "Check that files exist under fixtures path: \n\"" . $this->getFixturePath() . '".'
        );
    }
    if ($fixturesToLoad === []) {
        $this->notifyNothingToLoad($foundFixtures, $except);
        return ExitCode::OK;
    }
    if (!$this->confirmLoad($fixturesToLoad, $except)) {
        return ExitCode::OK;
    }
    $fixtures = $this->getFixturesConfig(array_merge($this->globalFixtures, $fixturesToLoad));
    if (!$fixtures) {
        throw new Exception('No fixtures were found in namespace: "' . $this->namespace . '"' . '');
    }
    $fixturesObjects = $this->createFixtures($fixtures);
    $this->unloadFixtures($fixturesObjects);
    $this->loadFixtures($fixturesObjects);
    $this->notifyLoaded($fixturesObjects);
    return ExitCode::OK;
}
";s:6:"params";a:1:{s:14:"$fixturesInput";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:14:"$fixturesInput";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/FixtureController.php";}}s:10:"exceptions";a:1:{s:22:"\yii\console\Exception";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:40:"if the specified fixture does not exist.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:11:"Return code";s:10:"returnType";s:3:"int";s:11:"returnTypes";a:1:{i:0;s:3:"int";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:43510;s:4:"name";s:10:"actionLoad";s:8:"fullName";s:53:"yii\console\controllers\FixtureController::actionLoad";s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/FixtureController.php";s:9:"startLine";i:114;s:7:"endLine";i:168;s:16:"shortDescription";s:33:"Loads the specified fixture data.";s:11:"description";s:344:"For example,

```
# load the fixture data specified by User and UserProfile.
# any existing fixture data will be removed first
yii fixture/load "User, UserProfile"

# load all available fixtures found under 'tests\unit\fixtures'
yii fixture/load "*"

# load all fixtures except User and UserProfile
yii fixture/load "*, -User, -UserProfile"
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:12:"actionUnload";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:41:"yii\console\controllers\FixtureController";s:10:"sourceCode";s:1543:"public function actionUnload(array $fixturesInput = [])
{
    if ($fixturesInput === []) {
        $this->printHelpMessage();
        return ExitCode::OK;
    }
    $filtered = $this->filterFixtures($fixturesInput);
    $except = $filtered['except'];
    if (!$this->needToApplyAll($fixturesInput[0])) {
        $fixtures = $filtered['apply'];
        $foundFixtures = $this->findFixtures($fixtures);
        $notFoundFixtures = array_diff($fixtures, $foundFixtures);
        if ($notFoundFixtures !== []) {
            $this->notifyNotFound($notFoundFixtures);
        }
    } else {
        $foundFixtures = $this->findFixtures();
    }
    if ($foundFixtures === []) {
        throw new Exception(
            'No files were found for: "' . implode(', ', $fixturesInput) . "\".\n" .
            "Check that files exist under fixtures path: \n\"" . $this->getFixturePath() . '".'
        );
    }
    $fixturesToUnload = array_diff($foundFixtures, $except);
    if ($fixturesToUnload === []) {
        $this->notifyNothingToUnload($foundFixtures, $except);
        return ExitCode::OK;
    }
    if (!$this->confirmUnload($fixturesToUnload, $except)) {
        return ExitCode::OK;
    }
    $fixtures = $this->getFixturesConfig(array_merge($this->globalFixtures, $fixturesToUnload));
    if ($fixtures === []) {
        throw new Exception('No fixtures were found in namespace: ' . $this->namespace . '".');
    }
    $this->unloadFixtures($this->createFixtures($fixtures));
    $this->notifyUnloaded($fixtures);
    return ExitCode::OK;
}
