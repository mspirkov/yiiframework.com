;s:4:"name";s:21:"yii\grid\ActionColumn";s:8:"fullName";s:21:"yii\grid\ActionColumn";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/grid/ActionColumn.php";s:9:"startLine";i:34;s:7:"endLine";i:252;s:16:"shortDescription";s:114:"ActionColumn is a column for the [[GridView]] widget that displays buttons for viewing and manipulating the items.";s:11:"description";s:380:"To add an ActionColumn to the gridview, add it to the [[GridView::columns|columns]] configuration as follows:

```
