{
    return $value === '' || $value === [] || $value === null || is_string($value) && trim($value) === '';
}
";s:6:"params";a:1:{s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/QueryTrait.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:21:"If the value is empty";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:215869;s:4:"name";s:7:"isEmpty";s:8:"fullName";s:26:"yii\db\QueryTrait::isEmpty";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/QueryTrait.php";s:9:"startLine";i:301;s:7:"endLine";i:304;s:16:"shortDescription";s:61:"Returns a value indicating whether the give value is "empty".";s:11:"description";s:195:"The value is considered "empty", if one of the following conditions is satisfied:

- it is `null`,
- an empty string (`''`),
