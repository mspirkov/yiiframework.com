the next new row's primary key will have a value 1.";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/QueryBuilder.php";}}s:10:"exceptions";a:1:{s:34:"\yii\base\InvalidArgumentException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:78:"if the table does not exist or there is no sequence associated with the table.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:40:"The SQL statement for resetting sequence";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:195066;s:4:"name";s:13:"resetSequence";s:8:"fullName";s:40:"yii\db\pgsql\QueryBuilder::resetSequence";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/QueryBuilder.php";s:9:"startLine";i:180;s:7:"endLine";i:200;s:16:"shortDescription";s:82:"Creates a SQL statement for resetting the sequence value of a table's primary key.";s:11:"description";s:117:"The sequence will be reset such that the primary key of the next new row inserted
will have the specified value or 1.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"checkIntegrity";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\db\pgsql\QueryBuilder";s:10:"sourceCode";s:832:"public function checkIntegrity($check = true, $schema = '', $table = '')
{
    /**
     * @var Schema
     * @phpstan-var Schema<ColumnSchema>
     */
    $dbSchema = $this->db->getSchema();
    $enable = $check ? 'ENABLE' : 'DISABLE';
    $schema = $schema ?: $dbSchema->defaultSchema;
    $tableNames = $table ? [$table] : $dbSchema->getTableNames($schema);
    $viewNames = $dbSchema->getViewNames($schema);
    $tableNames = array_diff($tableNames, $viewNames);
    $command = '';
    foreach ($tableNames as $tableName) {
        $tableName = $this->db->quoteTableName("{$schema}.{$tableName}");
        $command .= "ALTER TABLE $tableName $enable TRIGGER ALL; ";
    }
    // enable to have ability to alter several tables
    $this->db->getMasterPdo()->setAttribute(\PDO::ATTR_EMULATE_PREPARES, true);
    return $command;
}
