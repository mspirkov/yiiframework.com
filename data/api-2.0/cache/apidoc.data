{
    if ($this->_oldMysql === null) {
        $version = $this->db->getSlavePdo(true)->getAttribute(\PDO::ATTR_SERVER_VERSION);
        $this->_oldMysql = version_compare($version, '5.1', '<=');
    }
    return $this->_oldMysql;
}
