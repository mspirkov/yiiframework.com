You should call [[endField()]] afterwards.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:4;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:23:"\yii\widgets\endField()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:8:"endField";}}s:14:"␀*␀description";N;}i:5;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:20:"\yii\widgets\field()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:5:"field";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:8:"endField";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:22:"yii\widgets\ActiveForm";s:10:"sourceCode";s:216:"public function endField()
{
    $field = array_pop($this->_fields);
    if ($field instanceof ActiveField) {
        return $field->end();
    }
    throw new InvalidCallException('Mismatching endField() call.');
}
";s:6:"params";a:0:{}s:10:"exceptions";a:1:{s:30:"\yii\base\InvalidCallException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:63:"if this method is called without a prior [[beginField()]] call.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:34:"The closing tag of the form field.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:21287;s:4:"name";s:8:"endField";s:8:"fullName";s:32:"yii\widgets\ActiveForm::endField";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/ActiveForm.php";s:9:"startLine";i:363;s:7:"endLine";i:371;s:16:"shortDescription";s:18:"Ends a form field.";s:11:"description";s:92:"This method will return the closing tag of an active form field started by [[beginField()]].";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:8:"validate";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:22:"yii\widgets\ActiveForm";s:10:"sourceCode";s:542:"public static function validate($model, $attributes = null)
{
    $result = [];
    if ($attributes instanceof Model) {
        // validating multiple models
        $models = func_get_args();
        $attributes = null;
    } else {
        $models = [$model];
    }
    /** @var Model $model */
    foreach ($models as $model) {
        $model->validate($attributes);
        foreach ($model->getErrors() as $attribute => $errors) {
            $result[Html::getInputId($model, $attribute)] = $errors;
        }
    }
    return $result;
}
