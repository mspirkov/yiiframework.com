{
    $value = $expression->getValue();
    if ($value instanceof Query) {
        list ($sql, $params) = $this->queryBuilder->build($value, $params);
        return "($sql)";
    }
    $placeholder = static::PARAM_PREFIX . count($params);
    $params[$placeholder] = Json::encode($value);
    return $placeholder;
}
