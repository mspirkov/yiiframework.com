`$fallbackToMaster` is false.";s:10:"returnType";s:23:"\yii\db\Connection|null";s:11:"returnTypes";a:2:{i:0;s:18:"\yii\db\Connection";i:1;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:180271;s:4:"name";s:8:"getSlave";s:8:"fullName";s:27:"yii\db\Connection::getSlave";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Connection.php";s:9:"startLine";i:1086;s:7:"endLine";i:1097;s:16:"shortDescription";s:46:"Returns the currently active slave connection.";s:11:"description";s:114:"If this method is called for the first time, it will try to open a slave connection when [[enableSlaves]] is true.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"getMaster";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\db\Connection";s:10:"sourceCode";s:303:"public function getMaster()
{
    if ($this->_master === false) {
        $this->_master = $this->shuffleMasters
            ? $this->openFromPool($this->masters, $this->masterConfig)
            : $this->openFromPoolSequentially($this->masters, $this->masterConfig);
    }
    return $this->_master;
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:91:"The currently active master connection. `null` is returned if there is no master available.";s:10:"returnType";s:23:"\yii\db\Connection|null";s:11:"returnTypes";a:2:{i:0;s:18:"\yii\db\Connection";i:1;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:180271;s:4:"name";s:9:"getMaster";s:8:"fullName";s:28:"yii\db\Connection::getMaster";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Connection.php";s:9:"startLine";i:1105;s:7:"endLine";i:1114;s:16:"shortDescription";s:47:"Returns the currently active master connection.";s:11:"description";s:85:"If this method is called for the first time, it will try to open a master connection.";s:5:"since";s:6:"2.0.11";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"useMaster";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\db\Connection";s:10:"sourceCode";s:600:"public function useMaster(callable $callback)
{
    if ($this->enableSlaves) {
        $this->enableSlaves = false;
        try {
            $result = call_user_func($callback, $this);
        } catch (\Exception $e) {
            $this->enableSlaves = true;
            throw $e;
        } catch (\Throwable $e) {
            $this->enableSlaves = true;
            throw $e;
        }
        // TODO: use "finally" keyword when miminum required PHP version is >= 5.5
        $this->enableSlaves = true;
    } else {
        $result = call_user_func($callback, $this);
    }
    return $result;
}
