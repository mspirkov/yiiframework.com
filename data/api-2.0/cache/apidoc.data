nce\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:18:"\yii\db\andWhere()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:8:"andWhere";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:16:"andFilterCompare";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:12:"yii\db\Query";s:10:"sourceCode";s:351:"public function andFilterCompare($name, $value, $defaultOperator = '=')
{
    if (preg_match('/^(<>|>=|>|<=|<|=)/', (string)$value, $matches)) {
        $operator = $matches[1];
        $value = substr($value, strlen($operator));
    } else {
        $operator = $defaultOperator;
    }
    return $this->andFilterWhere([$operator, $name, $value]);
}
";s:6:"params";a:3:{s:5:"$name";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$name";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:16:"The column name.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";}s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:67:"The column value optionally prepended with the comparison operator.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";}s:16:"$defaultOperator";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:16:"$defaultOperator";s:10:"isOptional";b:1;s:12:"defaultValue";s:3:"'='";s:19:"isPassedByReference";b:0;s:11:"description";s:103:"The operator to use, when no operator is given in `$value`.
Defaults to `=`, performing an exact match.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:23:"The query object itself";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:164108;s:4:"name";s:16:"andFilterCompare";s:8:"fullName";s:30:"yii\db\Query::andFilterCompare";s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";s:9:"startLine";i:922;s:7:"endLine";i:932;s:16:"shortDescription";s:96:"Adds a filtering condition for a specific column and allow the user to choose a filter operator.";s:11:"description";s:998:"It adds an additional WHERE condition for the given field and determines the comparison operator
based on the first few characters of the given value.
The condition is added in the same way as in [[andFilterWhere]] so [[isEmpty()|empty values]] are ignored.
The new condition and the existing one will be joined using the `AND` operator.

The comparison operator is intelligently determined based on the first few characters in the given value.
In particular, it recognizes the following operators if they appear as the leading characters in the given value:

- `<`: the column must be less than the given value.
- `>`: the column must be greater than the given value.
- `<=`: the column must be less than or equal to the given value.
- `>=`: the column must be greater than or equal to the given value.
- `<>`: the column must not be the same as the given value.
- `=`: the column must be equal to the given value.
- If none of the above operators is detected, the `$defaultOperator` will be used.";s:5:"since";s:5:"2.0.8";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:4:"join";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:12:"yii\db\Query";s:10:"sourceCode";s:144:"public function join($type, $table, $on = '', $params = [])
{
    $this->join[] = [$type, $table, $on];
    return $this->addParams($params);
}
";s:6:"params";a:4:{s:5:"$type";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$type";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:48:"The type of join, such as INNER JOIN, LEFT JOIN.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";}s:6:"$table";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$table";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:649:"The table or sub-query to be joined.

Use a string to represent the name of the table to be joined.
The table name can contain a schema prefix (e.g. 'public.user') and/or table alias (e.g. 'user u').
The method will automatically quote the table name unless it contains some parenthesis
(which means the table is given as a sub-query or DB expression).

You may also specify the table as an array with one element, using the array key as the table alias
(e.g. ['u' => 'user']).

To join a sub-query, use an array with one element, with the value set to a [[Query]] object
representing the sub-query, and the corresponding key representing the alias.";s:4:"type";s:12:"string|array";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:5:"array";}s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";}s:3:"$on";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:3:"$on";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"''";s:19:"isPassedByReference";b:0;s:11:"description";s:510:"The join condition that should appear in the ON part.
Please refer to [[where()]] on how to specify this parameter.

Note that the array format of [[where()]] is designed to match columns to values instead of columns to columns, so
the following would **not** work as expected: `['post.author_id' => 'user.id']`, it would
match the `post.author_id` column value against the string `'user.id'`.
It is recommended to use the string syntax here which is more suited for a join:

```
'post.author_id = user.id'
```";s:4:"type";s:12:"string|array";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:5:"array";}s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";}s:7:"$params";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$params";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:56:"The parameters (name => value) to be bound to the query.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:23:"The query object itself";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:164108;s:4:"name";s:4:"join";s:8:"fullName";s:18:"yii\db\Query::join";s:10:"sourceFile";s:87:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Query.php";s:9:"startLine";i:966;s:7:"endLine";i:970;s:16:"shortDescription";s:33:"Appends a JOIN part to the query.";s:11:"description";s:54:"The first parameter specifies what type of join it is.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:9:"innerJoin";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:12:"yii\db\Query";s:10:"sourceCode";s:149:"public function innerJoin($table, $on = '', $params = [])
{
    $this->join[] = ['INNER JOIN', $table, $on];
    return $this->addParams($params);
}
";s:6:"params";a:3:{s:6:"$table";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$table";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:649:"The table or sub-query to be joined.

Use a string to represent the name of the table to be joined.
The table name can contain a schema prefix (e.g. 'public.user') and/or table alias (e.g. 'user u').
The method will automatically quote the table name unless it contains some parenthesis
(which means the table is given as a sub-query or DB expression).

You may also specify the table as an array with one element, using the array key as the table alias
(e.g. ['u' => 'user']).

To join a sub-query, use an array with one element, with the value set to a [[Query]] object
