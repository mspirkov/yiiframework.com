This is the implementation of the method declared in the parent class.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:12:"getCacheFile";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:21:"yii\caching\FileCache";s:10:"sourceCode";s:714:"protected function getCacheFile($normalizedKey)
{
    $cacheKey = $normalizedKey;
    if ($this->keyPrefix !== '') {
        // Remove key prefix to avoid generating constant directory levels
        $lenKeyPrefix = strlen($this->keyPrefix);
        $cacheKey = substr_replace($normalizedKey, '', 0, $lenKeyPrefix);
    }
    $cachePath = $this->cachePath;
    if ($this->directoryLevel > 0) {
        for ($i = 0; $i < $this->directoryLevel; ++$i) {
            if (($subDirectory = substr($cacheKey, $i + $i, 2)) !== false) {
                $cachePath .= DIRECTORY_SEPARATOR . $subDirectory;
            }
        }
    }
    return $cachePath . DIRECTORY_SEPARATOR . $normalizedKey . $this->cacheFileSuffix;
}
";s:6:"params";a:1:{s:14:"$normalizedKey";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:14:"$normalizedKey";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:43:"Normalized cache key by [[buildKey]] method";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/FileCache.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:19:"The cache file path";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:124459;s:4:"name";s:12:"getCacheFile";s:8:"fullName";s:35:"yii\caching\FileCache::getCacheFile";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/caching/FileCache.php";s:9:"startLine";i:215;s:7:"endLine";i:236;s:16:"shortDescription";s:59:"Returns the cache file path given the normalized cache key.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"flushValues";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:21:"yii\caching\FileCache";s:10:"sourceCode";s:82:"protected function flushValues()
{
    $this->gc(true, false);
    return true;
}
