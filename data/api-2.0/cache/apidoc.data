If `null`, the DB connection returned by [[modelClass]] will be used.";s:4:"type";s:23:"\yii\db\Connection|null";s:5:"types";a:2:{i:0;s:18:"\yii\db\Connection";i:1;s:4:"null";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQuery.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:32:"The created DB command instance.";s:10:"returnType";s:15:"\yii\db\Command";s:11:"returnTypes";a:1:{i:0;s:15:"\yii\db\Command";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:183465;s:4:"name";s:13:"createCommand";s:8:"fullName";s:33:"yii\db\ActiveQuery::createCommand";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQuery.php";s:9:"startLine";i:349;s:7:"endLine";i:368;s:16:"shortDescription";s:60:"Creates a DB command that can be used to execute this query.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"queryScalar";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:18:"yii\db\ActiveQuery";s:10:"sourceCode";s:536:"protected function queryScalar($selectExpression, $db)
{
    /** @var ActiveRecord $modelClass */
    $modelClass = $this->modelClass;
    if ($db === null) {
        $db = $modelClass::getDb();
    }
    if ($this->sql === null) {
        return parent::queryScalar($selectExpression, $db);
    }
    $command = (new Query())->select([$selectExpression])
        ->from(['c' => "({$this->sql})"])
        ->params($this->params)
        ->createCommand($db);
    $this->setCommandCache($command);
    return $command->queryScalar();
}
";s:6:"params";a:2:{s:17:"$selectExpression";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:17:"$selectExpression";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQuery.php";}s:3:"$db";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:3:"$db";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQuery.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:183465;s:4:"name";s:11:"queryScalar";s:8:"fullName";s:31:"yii\db\ActiveQuery::queryScalar";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQuery.php";s:9:"startLine";i:373;s:7:"endLine";i:392;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:8:"joinWith";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\db\ActiveQuery";s:10:"sourceCode";s:1124:"public function joinWith($with, $eagerLoading = true, $joinType = 'LEFT JOIN')
{
    $relations = [];
    foreach ((array) $with as $name => $callback) {
        if (is_int($name)) {
            $name = $callback;
            $callback = null;
        }
        if (preg_match('/^(.*?)(?:\s+AS\s+|\s+)(\w+)$/i', $name, $matches)) {
            // relation is defined with an alias, adjust callback to apply alias
            list(, $relation, $alias) = $matches;
            $name = $relation;
            $callback = function ($query) use ($callback, $alias) {
                /**
                 * @var self $query
                 * @phpstan-var self<ActiveRecord|array<string, mixed>> $query
                 */
                $query->alias($alias);
                if ($callback !== null) {
                    call_user_func($callback, $query);
                }
            };
        }
        if ($callback === null) {
            $relations[] = $name;
        } else {
            $relations[$name] = $callback;
        }
    }
    $this->joinWith[] = [$relations, $eagerLoading, $joinType];
    return $this;
}
";s:6:"params";a:3:{s:5:"$with";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$with";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:1288:"The relations to be joined. This can either be a string, representing a relation name or
an array with the following semantics:

- Each array element represents a single relation.
- You may specify the relation name as the array key and provide an anonymous functions that
  can be used to modify the relation queries on-the-fly as the array value.
- If a relation query does not need modification, you may use the relation name as the array value.

The relation name may optionally contain an alias for the relation table (e.g. `books b`).

Sub-relations can also be specified, see [[with()]] for the syntax.

In the following you find some examples:

```
// find all orders that contain books, and eager loading "books"
Order::find()->joinWith('books', true, 'INNER JOIN')->all();
// find all orders, eager loading "books", and sort the orders and books by the book names.
Order::find()->joinWith([
    'books' => function (\yii\db\ActiveQuery $query) {
        $query->orderBy('item.name');
    }
])->all();
// find all orders that contain books of the category 'Science fiction', using the alias "b" for the books table
Order::find()->joinWith(['books b'], true, 'INNER JOIN')->where(['b.category' => 'Science fiction'])->all();
```

The alias syntax is available since version 2.0.7.";s:4:"type";s:12:"string|array";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:5:"array";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQuery.php";}s:13:"$eagerLoading";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:13:"$eagerLoading";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"true";s:19:"isPassedByReference";b:0;s:11:"description";s:395:"Whether to eager load the relations
specified in `$with`.  When this is a boolean, it applies to all
relations specified in `$with`. Use an array to explicitly list which
relations in `$with` need to be eagerly loaded.  Note, that this does
not mean, that the relations are populated from the query result. An
extra query will still be performed to bring in the related data.
Defaults to `true`.";s:4:"type";s:10:"bool|array";s:5:"types";a:2:{i:0;s:4:"bool";i:1;s:5:"array";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQuery.php";}s:9:"$joinType";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$joinType";s:10:"isOptional";b:1;s:12:"defaultValue";s:11:"'LEFT JOIN'";s:19:"isPassedByReference";b:0;s:11:"description";s:239:"The join type of the relations specified in `$with`.
When this is a string, it applies to all relations specified in `$with`. Use an array
in the format of `relationName => joinType` to specify different join types for different relations.";s:4:"type";s:12:"string|array";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:5:"array";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQuery.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:23:"The query object itself";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:183465;s:4:"name";s:8:"joinWith";s:8:"fullName";s:28:"yii\db\ActiveQuery::joinWith";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQuery.php";s:9:"startLine";i:450;s:7:"endLine";i:483;s:16:"shortDescription";s:35:"Joins with the specified relations.";s:11:"description";s:724:"This method allows you to reuse existing relation definitions to perform JOIN queries.
Based on the definition of the specified relation(s), the method will append one or multiple
JOIN statements to the current query.

If the `$eagerLoading` parameter is true, the method will also perform eager loading for the specified relations,
which is equivalent to calling [[with()]] using the specified relations.

Note that because a JOIN query will be performed, you are responsible to disambiguate column names.

This method differs from [[with()]] in that it will build up and execute a JOIN SQL statement
for the primary table. And when `$eagerLoading` is true, it will call [[with()]] in addition with the specified relations.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"innerJoinWith";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\db\ActiveQuery";s:10:"sourceCode";s:127:"public function innerJoinWith($with, $eagerLoading = true)
{
    return $this->joinWith($with, $eagerLoading, 'INNER JOIN');
}
";s:6:"params";a:2:{s:5:"$with";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$with";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:32:"The relations to be joined with.";s:4:"type";s:12:"string|array";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:5:"array";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQuery.php";}s:13:"$eagerLoading";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:13:"$eagerLoading";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"true";s:19:"isPassedByReference";b:0;s:11:"description";s:192:"Whether to eager load the relations.
Note, that this does not mean, that the relations are populated from the
query result. An extra query will still be performed to bring in the
related data.";s:4:"type";s:10:"bool|array";s:5:"types";a:2:{i:0;s:4:"bool";i:1;s:5:"array";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQuery.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:23:"The query object itself";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:183465;s:4:"name";s:13:"innerJoinWith";s:8:"fullName";s:33:"yii\db\ActiveQuery::innerJoinWith";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQuery.php";s:9:"startLine";i:551;s:7:"endLine";i:554;s:16:"shortDescription";s:41:"Inner joins with the specified relations.";s:11:"description";s:149:"This is a shortcut method to [[joinWith()]] with the join type set as "INNER JOIN".
Please refer to [[joinWith()]] for detailed usage of this method.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:3;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:18:"\yii\db\joinWith()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:8:"joinWith";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:20:"getTableNameAndAlias";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:18:"yii\db\ActiveQuery";s:10:"sourceCode";s:622:"protected function getTableNameAndAlias()
{
    if (empty($this->from)) {
        $tableName = $this->getPrimaryTableName();
    } else {
        $tableName = '';
        // if the first entry in "from" is an alias-tablename-pair return it directly
        foreach ($this->from as $alias => $tableName) {
            if (is_string($alias)) {
                return [$tableName, $alias];
            }
            break;
        }
    }
    if (preg_match('/^(.*?)\s+({{\w+}}|\w+)$/', $tableName, $matches)) {
        $alias = $matches[2];
    } else {
        $alias = $tableName;
    }
    return [$tableName, $alias];
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:35:"The table name and the table alias.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:183465;s:4:"name";s:20:"getTableNameAndAlias";s:8:"fullName";s:40:"yii\db\ActiveQuery::getTableNameAndAlias";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQuery.php";s:9:"startLine";i:627;s:7:"endLine";i:649;s:16:"shortDescription";s:62:"Returns the table name and the table alias for [[modelClass]].";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.16";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"onCondition";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\db\ActiveQuery";s:10:"sourceCode";s:135:"public function onCondition($condition, $params = [])
{
    $this->on = $condition;
    $this->addParams($params);
    return $this;
}
";s:6:"params";a:2:{s:10:"$condition";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$condition";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:86:"The ON condition. Please refer to [[Query::where()]] on how to specify this parameter.";s:4:"type";s:12:"string|array";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:5:"array";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQuery.php";}s:7:"$params";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$params";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:56:"The parameters (name => value) to be bound to the query.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQuery.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:23:"The query object itself";s:10:"returnType";s:5:"$this";s:11:"returnTypes";a:1:{i:0;s:5:"$this";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:183465;s:4:"name";s:11:"onCondition";s:8:"fullName";s:31:"yii\db\ActiveQuery::onCondition";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveQuery.php";s:9:"startLine";i:751;s:7:"endLine";i:756;s:16:"shortDescription";s:45:"Sets the ON condition for a relational query.";s:11:"description";s:673:"The condition will be used in the ON part when [[ActiveQuery::joinWith()]] is called.
Otherwise, the condition will be used in the WHERE part of a query.

Use this method to specify additional conditions when declaring a relation in the [[ActiveRecord]] class:

```
public function getActiveUsers()
{
    return $this->hasMany(User::class, ['id' => 'user_id'])
                ->onCondition(['active' => true]);
}
```

Note that this condition is applied in case of a join as well as when fetching the related records.
Thus only fields of the related table can be used in the condition. Trying to access fields of the primary
record will cause an error in a non-join-query.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"andOnCondition";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\db\ActiveQuery";s:10:"sourceCode";s:243:"public function andOnCondition($condition, $params = [])
{
    if ($this->on === null) {
        $this->on = $condition;
    } else {
        $this->on = ['and', $this->on, $condition];
    }
    $this->addParams($params);
    return $this;
