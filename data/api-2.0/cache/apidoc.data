}
";s:6:"params";a:1:{s:7:"$record";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$record";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:20:"Record to compare to";s:4:"type";s:20:"\yii\db\ActiveRecord";s:5:"types";a:1:{i:0;s:20:"\yii\db\ActiveRecord";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveRecord.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:80:"Whether the two active records refer to the same row in the same database table.";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:159117;s:4:"name";s:6:"equals";s:8:"fullName";s:27:"yii\db\ActiveRecord::equals";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveRecord.php";s:9:"startLine";i:821;s:7:"endLine";i:828;s:16:"shortDescription";s:90:"Returns a value indicating whether the given active record is the same as the current one.";s:11:"description";s:186:"The comparison is made by comparing the table names and the primary key values of the two active records.
If one of the records [[isNewRecord|is new]] they are also considered not equal.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:15:"isTransactional";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\db\ActiveRecord";s:10:"sourceCode";s:216:"public function isTransactional($operation)
{
    $scenario = $this->getScenario();
    $transactions = $this->transactions();
    return isset($transactions[$scenario]) && ($transactions[$scenario] & $operation);
}
";s:6:"params";a:1:{s:10:"$operation";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$operation";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:91:"The operation to check. Possible values are [[OP_INSERT]], [[OP_UPDATE]] and [[OP_DELETE]].";s:4:"type";s:3:"int";s:5:"types";a:1:{i:0;s:3:"int";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveRecord.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:77:"Whether the specified operation is transactional in the current [[scenario]].";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:159117;s:4:"name";s:15:"isTransactional";s:8:"fullName";s:36:"yii\db\ActiveRecord::isTransactional";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveRecord.php";s:9:"startLine";i:835;s:7:"endLine";i:841;s:16:"shortDescription";s:105:"Returns a value indicating whether the specified operation is transactional in the current [[$scenario]].";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:10:"properties";a:0:{}s:9:"namespace";s:6:"yii\db";s:13:"phpDocContext";r:159117;s:4:"name";s:19:"yii\db\ActiveRecord";s:8:"fullName";s:19:"yii\db\ActiveRecord";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveRecord.php";s:9:"startLine";i:77;s:7:"endLine";i:842;s:16:"shortDescription";s:92:"ActiveRecord is the base class for classes representing relational data in terms of objects.";s:11:"description";s:2220:"Active Record implements the [Active Record design pattern](https://en.wikipedia.org/wiki/Active_record_pattern).
The premise behind Active Record is that an individual [[ActiveRecord]] object is associated with a specific
row in a database table. The object's attributes are mapped to the columns of the corresponding table.
Referencing an Active Record attribute is equivalent to accessing the corresponding table column for that record.

As an example, say that the `Customer` ActiveRecord class is associated with the `customer` table.
This would mean that the class's `name` attribute is automatically mapped to the `name` column in `customer` table.
Thanks to Active Record, assuming the variable `$customer` is an object of type `Customer`, to get the value of
the `name` column for the table row, you can use the expression `$customer->name`.
In this example, Active Record is providing an object-oriented interface for accessing data stored in the database.
But Active Record provides much more functionality than this.

To declare an ActiveRecord class you need to extend [[\yii\db\ActiveRecord]] and
implement the `tableName` method:

```
<?php

class Customer extends \yii\db\ActiveRecord
{
    public static function tableName()
    {
        return 'customer';
    }
}
```

The `tableName` method only has to return the name of the database table associated with the class.

> Tip: You may also use the [Gii code generator](guide:start-gii) to generate ActiveRecord classes from your
> database tables.

Class instances are obtained in one of two ways:

* Using the `new` operator to create a new, empty object
* Using a method to fetch an existing record (or records) from the database

Below is an example showing some typical usage of ActiveRecord:

```
$user = new User();
$user->name = 'Qiang';
$user->save();  // a new row is inserted into user table

// the following will retrieve the user 'CeBe' from the database
$user = User::find()->where(['name' => 'CeBe'])->one();

// this will get related records from orders table when relation is defined
$orders = $user->orders;
```

For more details and usage information on ActiveRecord, see the [guide article on ActiveRecord](guide:db-active-record).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:42:"yii\db\mssql\conditions\InConditionBuilder";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:36:"yii\db\conditions\InConditionBuilder";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:15:"Dmytro Naumenko";s:22:"d.naumenko.a@gmail.com";}s:7:"methods";a:2:{s:24:"buildSubqueryInCondition";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:42:"yii\db\mssql\conditions\InConditionBuilder";s:10:"sourceCode";s:293:"protected function buildSubqueryInCondition($operator, $columns, $values, &$params)
{
    if (is_array($columns)) {
        throw new NotSupportedException(__METHOD__ . ' is not supported by MSSQL.');
    }
    return parent::buildSubqueryInCondition($operator, $columns, $values, $params);
}
