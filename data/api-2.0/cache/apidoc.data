on ActiveField, see the [guide article on forms](guide:input-forms).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:22:"yii\widgets\DetailView";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:15:"yii\base\Widget";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:4:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:22:"yii\widgets\DetailView";s:10:"sourceCode";s:683:"public function init()
{
    parent::init();
    if ($this->model === null) {
        throw new InvalidConfigException('Please specify the "model" property.');
    }
    if ($this->formatter === null) {
        $this->formatter = Yii::$app->getFormatter();
    } elseif (is_array($this->formatter)) {
        $this->formatter = Yii::createObject($this->formatter);
    }
    if (!$this->formatter instanceof Formatter) {
        throw new InvalidConfigException('The "formatter" property must be either a Format object or a configuration array.');
    }
    $this->normalizeAttributes();
    if (!isset($this->options['id'])) {
        $this->options['id'] = $this->getId();
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\widgets";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:9:{s:3:"Yii";s:3:"Yii";s:9:"Arrayable";s:18:"yii\base\Arrayable";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:5:"Model";s:14:"yii\base\Model";s:6:"Widget";s:15:"yii\base\Widget";s:11:"ArrayHelper";s:23:"yii\helpers\ArrayHelper";s:4:"Html";s:16:"yii\helpers\Html";s:9:"Inflector";s:21:"yii\helpers\Inflector";s:9:"Formatter";s:18:"yii\i18n\Formatter";}}s:4:"name";s:4:"init";s:8:"fullName";s:28:"yii\widgets\DetailView::init";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/DetailView.php";s:9:"startLine";i:128;s:7:"endLine";i:148;s:16:"shortDescription";s:28:"Initializes the detail view.";s:11:"description";s:53:"This method will initialize required property values.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:3:"run";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:22:"yii\widgets\DetailView";s:10:"sourceCode";s:315:"public function run()
{
    $rows = [];
    $i = 0;
    foreach ($this->attributes as $attribute) {
        $rows[] = $this->renderAttribute($attribute, $i++);
    }
    $options = $this->options;
    $tag = ArrayHelper::remove($options, 'tag', 'table');
    echo Html::tag($tag, implode("\n", $rows), $options);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:24548;s:4:"name";s:3:"run";s:8:"fullName";s:27:"yii\widgets\DetailView::run";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/DetailView.php";s:9:"startLine";i:154;s:7:"endLine";i:165;s:16:"shortDescription";s:24:"Renders the detail view.";s:11:"description";s:58:"This is the main entry of the whole detail view rendering.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:15:"renderAttribute";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:22:"yii\widgets\DetailView";s:10:"sourceCode";s:688:"protected function renderAttribute($attribute, $index)
{
    if (is_string($this->template)) {
        $captionOptions = Html::renderTagAttributes(ArrayHelper::getValue($attribute, 'captionOptions', []));
        $contentOptions = Html::renderTagAttributes(ArrayHelper::getValue($attribute, 'contentOptions', []));
        return strtr($this->template, [
            '{label}' => $attribute['label'],
            '{value}' => $this->formatter->format($attribute['value'], $attribute['format']),
            '{captionOptions}' => $captionOptions,
            '{contentOptions}' => $contentOptions,
        ]);
    }
    return call_user_func($this->template, $attribute, $index, $this);
}
";s:6:"params";a:2:{s:10:"$attribute";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$attribute";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:50:"The specification of the attribute to be rendered.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/DetailView.php";}s:6:"$index";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$index";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:65:"The zero-based index of the attribute in the [[attributes]] array";s:4:"type";s:3:"int";s:5:"types";a:1:{i:0;s:3:"int";}s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/DetailView.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:20:"The rendering result";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:24548;s:4:"name";s:15:"renderAttribute";s:8:"fullName";s:39:"yii\widgets\DetailView::renderAttribute";s:10:"sourceFile";s:97:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/DetailView.php";s:9:"startLine";i:173;s:7:"endLine";i:187;s:16:"shortDescription";s:27:"Renders a single attribute.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:19:"normalizeAttributes";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:22:"yii\widgets\DetailView";s:10:"sourceCode";s:2578:"protected function normalizeAttributes()
{
    if ($this->attributes === null) {
        if ($this->model instanceof Model) {
            $this->attributes = $this->model->attributes();
        } elseif (is_object($this->model)) {
            $this->attributes = $this->model instanceof Arrayable ? array_keys($this->model->toArray()) : array_keys(get_object_vars($this->model));
        } elseif (is_array($this->model)) {
            $this->attributes = array_keys($this->model);
        } else {
            throw new InvalidConfigException('The "model" property must be either an array or an object.');
        }
        sort($this->attributes);
    }
    foreach ($this->attributes as $i => $attribute) {
        if (is_string($attribute)) {
            if (!preg_match('/^([^:]+)(:(\w*))?(:(.*))?$/', $attribute, $matches)) {
                throw new InvalidConfigException('The attribute must be specified in the format of "attribute", "attribute:format" or "attribute:format:label"');
            }
            $attribute = [
                'attribute' => $matches[1],
                'format' => isset($matches[3]) ? $matches[3] : 'text',
                'label' => isset($matches[5]) ? $matches[5] : null,
            ];
        }
        if (!is_array($attribute)) {
            throw new InvalidConfigException('The attribute configuration must be an array.');
        }
        if (isset($attribute['visible']) && !$attribute['visible']) {
            unset($this->attributes[$i]);
            continue;
        }
        if (!isset($attribute['format'])) {
            $attribute['format'] = 'text';
        }
        if (isset($attribute['attribute'])) {
            $attributeName = $attribute['attribute'];
            if (!isset($attribute['label'])) {
                $attribute['label'] = $this->model instanceof Model ? $this->model->getAttributeLabel($attributeName) : Inflector::camel2words($attributeName, true);
            }
            if (!array_key_exists('value', $attribute)) {
                $attribute['value'] = ArrayHelper::getValue($this->model, $attributeName);
            }
        } elseif (!isset($attribute['label']) || !array_key_exists('value', $attribute)) {
            throw new InvalidConfigException('The attribute configuration requires the "attribute" element to determine the value and display label.');
        }
        if ($attribute['value'] instanceof \Closure) {
            $attribute['value'] = call_user_func($attribute['value'], $this->model, $this);
        }
        $this->attributes[$i] = $attribute;
    }
}
