}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:12:"yii\db\mssql";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:5:{s:24:"InvalidArgumentException";s:33:"yii\base\InvalidArgumentException";s:21:"NotSupportedException";s:30:"yii\base\NotSupportedException";s:10:"Expression";s:17:"yii\db\Expression";s:5:"Query";s:12:"yii\db\Query";s:11:"TableSchema";s:18:"yii\db\TableSchema";}}s:4:"name";s:25:"defaultExpressionBuilders";s:8:"fullName";s:52:"yii\db\mssql\QueryBuilder::defaultExpressionBuilders";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";s:9:"startLine";i:55;s:7:"endLine";i:61;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:20:"buildOrderByAndLimit";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\db\mssql\QueryBuilder";s:10:"sourceCode";s:516:"public function buildOrderByAndLimit($sql, $orderBy, $limit, $offset)
{
    if (!$this->hasOffset($offset) && !$this->hasLimit($limit)) {
        $orderBy = $this->buildOrderBy($orderBy);
        return $orderBy === '' ? $sql : $sql . $this->separator . $orderBy;
    }
    if (version_compare($this->db->getSchema()->getServerVersion(), '11', '<')) {
        return $this->oldBuildOrderByAndLimit($sql, $orderBy, $limit, $offset);
    }
    return $this->newBuildOrderByAndLimit($sql, $orderBy, $limit, $offset);
}
";s:6:"params";a:4:{s:4:"$sql";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:4:"$sql";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";}s:8:"$orderBy";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$orderBy";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";}s:6:"$limit";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$limit";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";}s:7:"$offset";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$offset";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:160667;s:4:"name";s:20:"buildOrderByAndLimit";s:8:"fullName";s:47:"yii\db\mssql\QueryBuilder::buildOrderByAndLimit";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";s:9:"startLine";i:66;s:7:"endLine";i:78;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:23:"newBuildOrderByAndLimit";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:25:"yii\db\mssql\QueryBuilder";s:10:"sourceCode";s:621:"protected function newBuildOrderByAndLimit($sql, $orderBy, $limit, $offset)
{
    $orderBy = $this->buildOrderBy($orderBy);
    if ($orderBy === '') {
        // ORDER BY clause is required when FETCH and OFFSET are in the SQL
        $orderBy = 'ORDER BY (SELECT NULL)';
    }
    $sql .= $this->separator . $orderBy;
    // https://technet.microsoft.com/en-us/library/gg699618.aspx
    $offset = $this->hasOffset($offset) ? $offset : '0';
    $sql .= $this->separator . "OFFSET $offset ROWS";
    if ($this->hasLimit($limit)) {
        $sql .= $this->separator . "FETCH NEXT $limit ROWS ONLY";
    }
    return $sql;
}
";s:6:"params";a:4:{s:4:"$sql";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:4:"$sql";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:48:"The existing SQL (without ORDER BY/LIMIT/OFFSET)";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";}s:8:"$orderBy";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$orderBy";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:103:"The order by columns. See [[\yii\db\Query::orderBy]] for more details on how to specify this parameter.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";}s:6:"$limit";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$limit";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:64:"The limit number. See [[\yii\db\Query::limit]] for more details.";s:4:"type";s:3:"int";s:5:"types";a:1:{i:0;s:3:"int";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";}s:7:"$offset";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$offset";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:66:"The offset number. See [[\yii\db\Query::offset]] for more details.";s:4:"type";s:3:"int";s:5:"types";a:1:{i:0;s:3:"int";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:53:"The SQL completed with ORDER BY/LIMIT/OFFSET (if any)";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:160667;s:4:"name";s:23:"newBuildOrderByAndLimit";s:8:"fullName";s:50:"yii\db\mssql\QueryBuilder::newBuildOrderByAndLimit";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mssql/QueryBuilder.php";s:9:"startLine";i:88;s:7:"endLine";i:105;s:16:"shortDescription";s:70:"Builds the ORDER BY/LIMIT/OFFSET clauses for SQL SERVER 2012 or newer.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:23:"oldBuildOrderByAndLimit";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:25:"yii\db\mssql\QueryBuilder";s:10:"sourceCode";s:768:"protected function oldBuildOrderByAndLimit($sql, $orderBy, $limit, $offset)
{
    $orderBy = $this->buildOrderBy($orderBy);
    if ($orderBy === '') {
        // ROW_NUMBER() requires an ORDER BY clause
        $orderBy = 'ORDER BY (SELECT NULL)';
    }
    $sql = preg_replace('/^([\s(])*SELECT(\s+DISTINCT)?(?!\s*TOP\s*\()/i', "\\1SELECT\\2 rowNum = ROW_NUMBER() over ($orderBy),", $sql);
    if ($this->hasLimit($limit)) {
        if ($limit instanceof Expression) {
            $limit = '(' . (string)$limit . ')';
        }
        $sql = "SELECT TOP $limit * FROM ($sql) sub";
    } else {
        $sql = "SELECT * FROM ($sql) sub";
    }
    if ($this->hasOffset($offset)) {
        $sql .= $this->separator . "WHERE rowNum > $offset";
    }
    return $sql;
}
