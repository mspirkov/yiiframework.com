";s:6:"params";a:1:{s:5:"$data";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$data";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:65:"An array of an additional data stored in a cache entry or `null`.";s:4:"type";s:10:"array|null";s:5:"types";a:2:{i:0;s:5:"array";i:1;s:4:"null";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/PageCache.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:46579;s:4:"name";s:20:"afterRestoreResponse";s:8:"fullName";s:43:"yii\filters\PageCache::afterRestoreResponse";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/PageCache.php";s:9:"startLine";i:217;s:7:"endLine";i:219;s:16:"shortDescription";s:104:"This method is invoked right after the response restoring is finished (but before the response is sent).";s:11:"description";s:87:"You may override this method to do last-minute preparation before the response is sent.";s:5:"since";s:6:"2.0.11";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:15:"restoreResponse";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:21:"yii\filters\PageCache";s:10:"sourceCode";s:716:"protected function restoreResponse($response, $data)
{
    foreach (['format', 'version', 'statusCode', 'statusText', 'content'] as $name) {
        $response->{$name} = $data[$name];
    }
    foreach (['headers', 'cookies'] as $name) {
        if (isset($data[$name]) && is_array($data[$name])) {
            $response->{$name}->fromArray(array_merge($data[$name], $response->{$name}->toArray()));
        }
    }
    if (!empty($data['dynamicPlaceholders']) && is_array($data['dynamicPlaceholders'])) {
        $response->content = $this->updateDynamicContent($response->content, $data['dynamicPlaceholders'], true);
    }
    $this->afterRestoreResponse(isset($data['cacheData']) ? $data['cacheData'] : null);
}
";s:6:"params";a:2:{s:9:"$response";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$response";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:28:"The response to be restored.";s:4:"type";s:17:"\yii\web\Response";s:5:"types";a:1:{i:0;s:17:"\yii\web\Response";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/PageCache.php";}s:5:"$data";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$data";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:27:"The response property data.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/PageCache.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:46579;s:4:"name";s:15:"restoreResponse";s:8:"fullName";s:38:"yii\filters\PageCache::restoreResponse";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/PageCache.php";s:9:"startLine";i:227;s:7:"endLine";i:241;s:16:"shortDescription";s:49:"Restores response properties from the given data.";s:11:"description";s:0:"";s:5:"since";s:5:"2.0.3";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"cacheResponse";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\filters\PageCache";s:10:"sourceCode";s:1264:"public function cacheResponse()
{
    $this->view->popDynamicContent();
    $beforeCacheResponseResult = $this->beforeCacheResponse();
    if ($beforeCacheResponseResult === false) {
        echo $this->updateDynamicContent(ob_get_clean(), $this->getDynamicPlaceholders());
        return;
    }
    $response = Yii::$app->getResponse();
    $response->off(Response::EVENT_AFTER_SEND, [$this, 'cacheResponse']);
    $data = [
        'cacheVersion' => static::PAGE_CACHE_VERSION,
        'cacheData' => is_array($beforeCacheResponseResult) ? $beforeCacheResponseResult : null,
        'content' => ob_get_clean(),
    ];
    if ($data['content'] === false || $data['content'] === '') {
        return;
    }
    $data['dynamicPlaceholders'] = $this->getDynamicPlaceholders();
    foreach (['format', 'version', 'statusCode', 'statusText'] as $name) {
        $data[$name] = $response->{$name};
    }
    $this->insertResponseHeaderCollectionIntoData($response, $data);
    $this->insertResponseCookieCollectionIntoData($response, $data);
    $this->cache->set($this->calculateCacheKey(), $data, $this->duration, $this->dependency);
    $data['content'] = $this->updateDynamicContent($data['content'], $this->getDynamicPlaceholders());
    echo $data['content'];
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:46579;s:4:"name";s:13:"cacheResponse";s:8:"fullName";s:36:"yii\filters\PageCache::cacheResponse";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/filters/PageCache.php";s:9:"startLine";i:247;s:7:"endLine";i:276;s:16:"shortDescription";s:27:"Caches response properties.";s:11:"description";s:0:"";s:5:"since";s:5:"2.0.3";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:17:"calculateCacheKey";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:21:"yii\filters\PageCache";s:10:"sourceCode";s:370:"protected function calculateCacheKey()
{
    $key = [__CLASS__];
    if ($this->varyByRoute) {
        $key[] = Yii::$app->requestedRoute;
    }
    if ($this->variations instanceof Closure) {
        $variations = call_user_func($this->variations, $this);
    } else {
        $variations = $this->variations;
    }
    return array_merge($key, (array) $variations);
}
