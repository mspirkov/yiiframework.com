Note that it is possible the number of rows deleted is 0, even though the deletion execution is successful.";s:10:"returnType";s:9:"int|false";s:11:"returnTypes";a:2:{i:0;s:3:"int";i:1;s:5:"false";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:159117;s:4:"name";s:14:"deleteInternal";s:8:"fullName";s:35:"yii\db\ActiveRecord::deleteInternal";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/ActiveRecord.php";s:9:"startLine";i:791;s:7:"endLine";i:812;s:16:"shortDescription";s:56:"Deletes an ActiveRecord without considering transaction.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:6:"equals";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\db\ActiveRecord";s:10:"sourceCode";s:230:"public function equals($record)
{
    if ($this->isNewRecord || $record->isNewRecord) {
