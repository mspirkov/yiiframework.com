is not registered before, null will be returned.";s:10:"returnType";s:11:"object|null";s:11:"returnTypes";a:2:{i:0;s:6:"object";i:1;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:87790;s:4:"name";s:3:"get";s:8:"fullName";s:26:"yii\di\ServiceLocator::get";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/ServiceLocator.php";s:9:"startLine";i:128;s:7:"endLine";i:146;s:16:"shortDescription";s:53:"Returns the component instance with the specified ID.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:4:{i:4;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:13:"\yii\di\has()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:3:"has";}}s:14:"␀*␀description";N;}i:5;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:13:"\yii\di\set()";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:3:"set";}}s:14:"␀*␀description";N;}i:6;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:14:"phpstan-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:48:"($throwException is true ? object : object|null)";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:7;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:12:"psalm-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:48:"($throwException is true ? object : object|null)";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:3:"set";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\di\ServiceLocator";s:10:"sourceCode";s:1040:"public function set($id, $definition)
{
    unset($this->_components[$id]);
    if ($definition === null) {
        unset($this->_definitions[$id]);
        return;
    }
    if (is_object($definition) || is_callable($definition, true)) {
        // an object, a class name, or a PHP callable
        $this->_definitions[$id] = $definition;
    } elseif (is_array($definition)) {
        // a configuration array
        if (isset($definition['__class'])) {
            $this->_definitions[$id] = $definition;
            $this->_definitions[$id]['class'] = $definition['__class'];
            unset($this->_definitions[$id]['__class']);
        } elseif (isset($definition['class'])) {
            $this->_definitions[$id] = $definition;
        } else {
            throw new InvalidConfigException("The configuration for the \"$id\" component must contain a \"class\" element.");
        }
    } else {
        throw new InvalidConfigException("Unexpected configuration type for the \"$id\" component: " . gettype($definition));
    }
}
";s:6:"params";a:2:{s:3:"$id";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:3:"$id";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:25:"Component ID (e.g. `db`).";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/ServiceLocator.php";}s:11:"$definition";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:11:"$definition";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:657:"The component definition to be registered with this locator.
It can be one of the following:

- a class name
- a configuration array: the array contains name-value pairs that will be used to
  initialize the property values of the newly created object when [[get()]] is called.
  The `class` element is required and stands for the the class of the object to be created.
- a PHP callable: either an anonymous function or an array representing a class method (e.g. `['Foo', 'bar']`).
  The callable will be called by [[get()]] to return an object associated with the specified component ID.
- an object: When [[get()]] is called, this object will be returned.";s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/ServiceLocator.php";}}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:51:"if the definition is an invalid configuration array";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:87790;s:4:"name";s:3:"set";s:8:"fullName";s:26:"yii\di\ServiceLocator::set";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/ServiceLocator.php";s:9:"startLine";i:191;s:7:"endLine";i:217;s:16:"shortDescription";s:51:"Registers a component definition with this locator.";s:11:"description";s:561:"For example,

```
// a class name
$locator->set('cache', 'yii\caching\FileCache');

// a configuration array
$locator->set('db', [
    'class' => 'yii\db\Connection',
    'dsn' => 'mysql:host=127.0.0.1;dbname=demo',
    'username' => 'root',
    'password' => '',
    'charset' => 'utf8',
]);

// an anonymous function
$locator->set('cache', function ($params) {
    return new \yii\caching\FileCache;
});

// an instance
$locator->set('cache', new \yii\caching\FileCache);
```

If a component definition with the same ID already exists, it will be overwritten.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:5:"clear";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\di\ServiceLocator";s:10:"sourceCode";s:93:"public function clear($id)
{
    unset($this->_definitions[$id], $this->_components[$id]);
}
";s:6:"params";a:1:{s:3:"$id";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:3:"$id";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:16:"The component ID";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/ServiceLocator.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:87790;s:4:"name";s:5:"clear";s:8:"fullName";s:28:"yii\di\ServiceLocator::clear";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/ServiceLocator.php";s:9:"startLine";i:223;s:7:"endLine";i:226;s:16:"shortDescription";s:39:"Removes the component from the locator.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"getComponents";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\di\ServiceLocator";s:10:"sourceCode";s:135:"public function getComponents($returnDefinitions = true)
{
    return $returnDefinitions ? $this->_definitions : $this->_components;
}
";s:6:"params";a:1:{s:18:"$returnDefinitions";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:18:"$returnDefinitions";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"true";s:19:"isPassedByReference";b:0;s:11:"description";s:82:"Whether to return component definitions instead of the loaded component instances.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/ServiceLocator.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:103:"The list of the component definitions or the loaded component instances (ID => definition or instance).";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:87790;s:4:"name";s:13:"getComponents";s:8:"fullName";s:36:"yii\di\ServiceLocator::getComponents";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/ServiceLocator.php";s:9:"startLine";i:233;s:7:"endLine";i:236;s:16:"shortDescription";s:80:"Returns the list of the component definitions or the loaded component instances.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"setComponents";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\di\ServiceLocator";s:10:"sourceCode";s:139:"public function setComponents($components)
{
    foreach ($components as $id => $component) {
        $this->set($id, $component);
    }
}
";s:6:"params";a:1:{s:11:"$components";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:11:"$components";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:34:"Component definitions or instances";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/ServiceLocator.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:87790;s:4:"name";s:13:"setComponents";s:8:"fullName";s:36:"yii\di\ServiceLocator::setComponents";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/ServiceLocator.php";s:9:"startLine";i:265;s:7:"endLine";i:270;s:16:"shortDescription";s:57:"Registers a set of component definitions in this locator.";s:11:"description";s:607:"This is the bulk version of [[set()]]. The parameter should be an array
whose keys are component IDs and values the corresponding component definitions.

For more details on how to specify component IDs and definitions, please refer to [[set()]].

If a component definition with the same ID already exists, it will be overwritten.

The following is an example for registering two component definitions:

```
[
    'db' => [
        'class' => 'yii\db\Connection',
        'dsn' => 'sqlite:path/to/file.db',
    ],
    'cache' => [
        'class' => 'yii\caching\DbCache',
        'db' => 'db',
    ],
]
```";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:10:"properties";a:1:{s:11:"$components";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:12:"defaultValue";N;s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:21:"yii\di\ServiceLocator";s:13:"phpDocContext";N;s:4:"name";s:11:"$components";s:8:"fullName";s:34:"yii\di\ServiceLocator::$components";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/ServiceLocator.php";s:9:"startLine";N;s:7:"endLine";N;s:16:"shortDescription";s:103:"The list of the component definitions or the loaded component instances (ID => definition or instance).";s:11:"description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:103:"The list of the component definitions or the loaded component instances (ID =>
definition or instance).";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:9:"namespace";s:6:"yii\di";s:13:"phpDocContext";r:87790;s:4:"name";s:21:"yii\di\ServiceLocator";s:8:"fullName";s:21:"yii\di\ServiceLocator";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/ServiceLocator.php";s:9:"startLine";i:53;s:7:"endLine";i:271;s:16:"shortDescription";s:101:"ServiceLocator implements a [service locator](https://en.wikipedia.org/wiki/Service_locator_pattern).";s:11:"description";s:1080:"To use ServiceLocator, you first need to register component IDs with the corresponding component
definitions with the locator by calling [[set()]] or [[setComponents()]].
You can then call [[get()]] to retrieve a component with the specified ID. The locator will automatically
instantiate and configure the component according to the definition.

For example,

```
$locator = new \yii\di\ServiceLocator;
$locator->setComponents([
    'db' => [
        'class' => 'yii\db\Connection',
        'dsn' => 'sqlite:path/to/file.db',
    ],
    'cache' => [
        'class' => 'yii\caching\DbCache',
        'db' => 'db',
    ],
]);

$db = $locator->get('db');  // or $locator->db
$cache = $locator->get('cache');  // or $locator->cache
```

Because [[\yii\base\Module]] extends from ServiceLocator, modules and the application are all service locators.
Modules add [tree traversal](guide:concept-service-locator#tree-traversal) for service resolution.

For more details and usage information on ServiceLocator, see the [guide article on service locators](guide:concept-service-locator).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:10:"components";s:7:"␀*␀type";O:37:"phpDocumentor\Reflection\Types\Array_":3:{s:12:"␀*␀valueType";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:10:"␀*␀keyType";N;s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:88162;}}s:5:"todos";a:0:{}}s:16:"yii\di\Container";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:18:"yii\base\Component";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:17:{s:3:"get";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:16:"yii\di\Container";s:10:"sourceCode";s:1383:"public function get($class, $params = [], $config = [])
{
    if ($class instanceof Instance) {
        $class = $class->id;
    }
    if (isset($this->_singletons[$class])) {
        // singleton
        return $this->_singletons[$class];
    } elseif (!isset($this->_definitions[$class])) {
        return $this->build($class, $params, $config);
    }
    $definition = $this->_definitions[$class];
    if (is_callable($definition, true)) {
        $params = $this->resolveDependencies($this->mergeParams($class, $params));
        $object = call_user_func($definition, $this, $params, $config);
    } elseif (is_array($definition)) {
        $concrete = $definition['class'];
        unset($definition['class']);
        $config = array_merge($definition, $config);
        $params = $this->mergeParams($class, $params);
        if ($concrete === $class) {
            $object = $this->build($class, $params, $config);
        } else {
            $object = $this->get($concrete, $params, $config);
        }
    } elseif (is_object($definition)) {
        return $this->_singletons[$class] = $definition;
    } else {
        throw new InvalidConfigException('Unexpected object definition type: ' . gettype($definition));
    }
    if (array_key_exists($class, $this->_singletons)) {
        // singleton
        $this->_singletons[$class] = $object;
    }
    return $object;
}
