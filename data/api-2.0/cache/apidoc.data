";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:20:"List of column names";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:179869;s:4:"name";s:14:"getColumnNames";s:8:"fullName";s:34:"yii\db\TableSchema::getColumnNames";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/TableSchema.php";s:9:"startLine";i:78;s:7:"endLine";i:81;s:16:"shortDescription";s:47:"Returns the names of all columns in this table.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"fixPrimaryKey";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\db\TableSchema";s:10:"sourceCode";s:459:"public function fixPrimaryKey($keys)
{
    $keys = (array) $keys;
    $this->primaryKey = $keys;
    foreach ($this->columns as $column) {
        $column->isPrimaryKey = false;
    }
    foreach ($keys as $key) {
        if (isset($this->columns[$key])) {
            $this->columns[$key]->isPrimaryKey = true;
        } else {
            throw new InvalidArgumentException("Primary key '$key' cannot be found in table '{$this->name}'.");
        }
    }
}
