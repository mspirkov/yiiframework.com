  (without encoding).

See [[renderTagAttributes()]] for details on how attributes are being rendered.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:22:"The generated hint tag";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:56244;s:4:"name";s:10:"activeHint";s:8:"fullName";s:32:"yii\helpers\BaseHtml::activeHint";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";s:9:"startLine";i:1249;s:7:"endLine";i:1259;s:16:"shortDescription";s:51:"Generates a hint tag for the given model attribute.";s:11:"description";s:172:"The hint text is the hint associated with the attribute, obtained via [[Model::getAttributeHint()]].
If no hint content can be obtained, method will return an empty string.";s:5:"since";s:5:"2.0.4";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:12:"errorSummary";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\helpers\BaseHtml";s:10:"sourceCode";s:1088:"public static function errorSummary($models, $options = [])
{
    $header = isset($options['header']) ? $options['header'] : '<p>' . Yii::t('yii', 'Please fix the following errors:') . '</p>';
    $footer = ArrayHelper::remove($options, 'footer', '');
    $encode = ArrayHelper::remove($options, 'encode', true);
    $showAllErrors = ArrayHelper::remove($options, 'showAllErrors', false);
    $emptyClass = ArrayHelper::remove($options, 'emptyClass', null);
    unset($options['header']);
    $lines = self::collectErrors($models, $encode, $showAllErrors);
    if (empty($lines)) {
        // still render the placeholder for client-side validation use
        $content = '<ul></ul>';
        if ($emptyClass !== null) {
            $options['class'] = $emptyClass;
        } else {
            $options['style'] = isset($options['style']) ? rtrim($options['style'], ';') . '; display:none' : 'display:none';
        }
    } else {
        $content = '<ul><li>' . implode("</li>\n<li>", $lines) . '</li></ul>';
    }
    return Html::tag('div', $header . $content . $footer, $options);
}
";s:6:"params";a:2:{s:7:"$models";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$models";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:57:"The model(s) whose validation errors are to be displayed.";s:4:"type";s:33:"\yii\base\Model|\yii\base\Model[]";s:5:"types";a:2:{i:0;s:15:"\yii\base\Model";i:1;s:17:"\yii\base\Model[]";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";}s:8:"$options";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$options";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:758:"The tag options in terms of name-value pairs. The following options are specially handled:

- header: string, the header HTML for the error summary. If not set, a default prompt string will be used.
- footer: string, the footer HTML for the error summary. Defaults to empty string.
- encode: boolean, if set to false then the error messages won't be encoded. Defaults to `true`.
- showAllErrors: boolean, if set to true every error message for each attribute will be shown otherwise
  only the first error message for each attribute will be shown. Defaults to `false`.
  Option is available since 2.0.10.
- emptyClass: string, the class name that is added to an empty summary.

The rest of the options will be rendered as the attributes of the container tag.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:27:"The generated error summary";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:56244;s:4:"name";s:12:"errorSummary";s:8:"fullName";s:34:"yii\helpers\BaseHtml::errorSummary";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";s:9:"startLine";i:1279;s:7:"endLine";i:1301;s:16:"shortDescription";s:45:"Generates a summary of the validation errors.";s:11:"description";s:110:"If there is no validation error, an empty error summary markup will still be generated, but it will be hidden.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:5:"error";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\helpers\BaseHtml";s:10:"sourceCode";s:555:"public static function error($model, $attribute, $options = [])
{
    $attribute = static::getAttributeName($attribute);
    $errorSource = ArrayHelper::remove($options, 'errorSource');
    if ($errorSource !== null) {
        $error = call_user_func($errorSource, $model, $attribute);
    } else {
        $error = $model->getFirstError($attribute);
    }
    $tag = ArrayHelper::remove($options, 'tag', 'div');
    $encode = ArrayHelper::remove($options, 'encode', true);
    return Html::tag($tag, $encode ? Html::encode($error) : $error, $options);
}
";s:6:"params";a:3:{s:6:"$model";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$model";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:16:"The model object";s:4:"type";s:15:"\yii\base\Model";s:5:"types";a:1:{i:0;s:15:"\yii\base\Model";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";}s:10:"$attribute";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$attribute";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:103:"The attribute name or expression. See [[getAttributeName()]] for the format
about attribute expression.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";}s:8:"$options";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$options";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:730:"The tag options in terms of name-value pairs. The values will be HTML-encoded
using [[encode()]]. If a value is null, the corresponding attribute will not be rendered.

The following options are specially handled:

- tag: this specifies the tag name. If not set, "div" will be used.
  See also [[tag()]].
- encode: boolean, if set to false then the error message won't be encoded.
- errorSource (since 2.0.14): \Closure|callable, callback that will be called to obtain an error message.
  The signature of the callback must be: `function ($model, $attribute)` and return a string.
  When not set, the `$model->getFirstError()` method will be called.

See [[renderTagAttributes()]] for details on how attributes are being rendered.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:23:"The generated label tag";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:56244;s:4:"name";s:5:"error";s:8:"fullName";s:27:"yii\helpers\BaseHtml::error";s:10:"sourceFile";s:95:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseHtml.php";s:9:"startLine";i:1358;s:7:"endLine";i:1370;s:16:"shortDescription";s:90:"Generates a tag that contains the first validation error of the specified model attribute.";s:11:"description";s:97:"Note that even if there is no validation error, this method will still return an empty error tag.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"activeInput";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:1;s:10:"visibility";s:6:"public";s:9:"definedBy";s:20:"yii\helpers\BaseHtml";s:10:"sourceCode";s:585:"public static function activeInput($type, $model, $attribute, $options = [])
{
    $name = isset($options['name']) ? $options['name'] : static::getInputName($model, $attribute);
    $value = isset($options['value']) ? $options['value'] : static::getAttributeValue($model, $attribute);
    if (!array_key_exists('id', $options)) {
        $options['id'] = static::getInputId($model, $attribute);
    }
    static::setActivePlaceholder($model, $attribute, $options);
    self::normalizeMaxLength($model, $attribute, $options);
    return static::input($type, $name, $value, $options);
}
