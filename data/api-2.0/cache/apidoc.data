This property is used to get columns' names.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:8:"yii\data";s:13:"phpDocContext";r:14099;s:4:"name";s:26:"yii\data\ArrayDataProvider";s:8:"fullName";s:26:"yii\data\ArrayDataProvider";s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/ArrayDataProvider.php";s:9:"startLine";i:53;s:7:"endLine";i:136;s:16:"shortDescription";s:67:"ArrayDataProvider implements a data provider based on a data array.";s:11:"description";s:1322:"The [[allModels]] property contains all data models that may be sorted and/or paginated.
ArrayDataProvider will provide the data after sorting and/or pagination.
You may configure the [[sort]] and [[pagination]] properties to
customize the sorting and pagination behaviors.

Elements in the [[allModels]] array may be either objects (e.g. model objects)
or associative arrays (e.g. query results of DAO).
Make sure to set the [[key]] property to the name of the field that uniquely
identifies a data record or false if you do not have such a field.

Compared to [[ActiveDataProvider]], ArrayDataProvider could be less efficient
because it needs to have [[allModels]] ready.

ArrayDataProvider may be used in the following way:

```
$query = new Query;
$provider = new ArrayDataProvider([
    'allModels' => $query->from('post')->all(),
    'sort' => [
        'attributes' => ['id', 'username', 'email'],
    ],
    'pagination' => [
        'pageSize' => 10,
    ],
]);
// get the posts in the current page
$posts = $provider->getModels();
```

Note: if you want to use the sorting feature, you must configure the [[sort]] property
so that the provider knows which columns can be sorted.

For more details and usage information on ArrayDataProvider, see the [guide article on data providers](guide:output-data-providers).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:27:"yii\data\ActiveDataProvider";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:25:"yii\data\BaseDataProvider";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:6:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\data\ActiveDataProvider";s:10:"sourceCode";s:132:"public function init()
{
    parent::init();
    if ($this->db !== null) {
        $this->db = Instance::ensure($this->db);
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:21:"if [[db]] is invalid.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:8:"yii\data";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:6:{s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:5:"Model";s:14:"yii\base\Model";s:20:"ActiveQueryInterface";s:27:"yii\db\ActiveQueryInterface";s:10:"Connection";s:17:"yii\db\Connection";s:14:"QueryInterface";s:21:"yii\db\QueryInterface";s:8:"Instance";s:15:"yii\di\Instance";}}s:4:"name";s:4:"init";s:8:"fullName";s:33:"yii\data\ActiveDataProvider::init";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/ActiveDataProvider.php";s:9:"startLine";i:87;s:7:"endLine";i:93;s:16:"shortDescription";s:40:"Initializes the DB connection component.";s:11:"description";s:107:"This method will initialize the [[db]] property (when set) to make sure it refers to a valid DB connection.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"prepareModels";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:27:"yii\data\ActiveDataProvider";s:10:"sourceCode";s:719:"protected function prepareModels()
{
    if (!$this->query instanceof QueryInterface) {
        throw new InvalidConfigException('The "query" property must be an instance of a class that implements the QueryInterface e.g. yii\db\Query or its subclasses.');
    }
    $query = clone $this->query;
    if (($pagination = $this->getPagination()) !== false) {
        $pagination->totalCount = $this->getTotalCount();
        if ($pagination->totalCount === 0) {
            return [];
        }
        $query->limit($pagination->getLimit())->offset($pagination->getOffset());
    }
    if (($sort = $this->getSort()) !== false) {
        $query->addOrderBy($sort->getOrders());
    }
    return $query->all($this->db);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:14407;s:4:"name";s:13:"prepareModels";s:8:"fullName";s:42:"yii\data\ActiveDataProvider::prepareModels";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/ActiveDataProvider.php";s:9:"startLine";i:98;s:7:"endLine";i:116;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:11:"prepareKeys";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:27:"yii\data\ActiveDataProvider";s:10:"sourceCode";s:1001:"protected function prepareKeys($models)
{
    $keys = [];
    if ($this->key !== null) {
        foreach ($models as $model) {
            if (is_string($this->key)) {
                $keys[] = $model[$this->key];
            } else {
                $keys[] = call_user_func($this->key, $model);
            }
        }
        return $keys;
    } elseif ($this->query instanceof ActiveQueryInterface) {
        /** @var \yii\db\ActiveRecordInterface $class */
        $class = $this->query->modelClass;
        $pks = $class::primaryKey();
        if (count($pks) === 1) {
            $pk = $pks[0];
            foreach ($models as $model) {
                $keys[] = $model[$pk];
            }
        } else {
            foreach ($models as $model) {
                $kk = [];
                foreach ($pks as $pk) {
                    $kk[$pk] = $model[$pk];
                }
                $keys[] = $kk;
            }
        }
        return $keys;
    }
    return array_keys($models);
}
";s:6:"params";a:1:{s:7:"$models";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$models";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/ActiveDataProvider.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:14407;s:4:"name";s:11:"prepareKeys";s:8:"fullName";s:40:"yii\data\ActiveDataProvider::prepareKeys";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/ActiveDataProvider.php";s:9:"startLine";i:121;s:7:"endLine";i:157;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:17:"prepareTotalCount";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:27:"yii\data\ActiveDataProvider";s:10:"sourceCode";s:386:"protected function prepareTotalCount()
{
    if (!$this->query instanceof QueryInterface) {
        throw new InvalidConfigException('The "query" property must be an instance of a class that implements the QueryInterface e.g. yii\db\Query or its subclasses.');
    }
    $query = clone $this->query;
    return (int) $query->limit(-1)->offset(-1)->orderBy([])->count('*', $this->db);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:14407;s:4:"name";s:17:"prepareTotalCount";s:8:"fullName";s:46:"yii\data\ActiveDataProvider::prepareTotalCount";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/ActiveDataProvider.php";s:9:"startLine";i:162;s:7:"endLine";i:169;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:7:"setSort";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:27:"yii\data\ActiveDataProvider";s:10:"sourceCode";s:696:"public function setSort($value)
{
    parent::setSort($value);
    if ($this->query instanceof ActiveQueryInterface && ($sort = $this->getSort()) !== false) {
        /** @var Model $modelClass */
        $modelClass = $this->query->modelClass;
        $model = $modelClass::instance();
        if (empty($sort->attributes)) {
            foreach ($model->attributes() as $attribute) {
                $sort->attributes[$attribute] = [
                    'asc' => [$attribute => SORT_ASC],
                    'desc' => [$attribute => SORT_DESC],
                ];
            }
        }
        if ($sort->modelClass === null) {
            $sort->modelClass = $modelClass;
        }
    }
}
