- [[TYPE_STRING|string]]: the values are being compared as strings. No conversion will be done before comparison.
- [[TYPE_NUMBER|number]]: the values are being compared as numbers. String values will be converted into numbers before comparison.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:317:"the type of the values being compared. The follow types are supported:

- [[TYPE_STRING|string]]: the values are being compared as strings. No conversion will be done before comparison.
- [[TYPE_NUMBER|number]]: the values are being compared as numbers. String values will be converted into numbers before comparison.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:9:"$operator";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:12:"defaultValue";s:4:"'=='";s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:31:"yii\validators\CompareValidator";s:13:"phpDocContext";r:131993;s:4:"name";s:9:"$operator";s:8:"fullName";s:42:"yii\validators\CompareValidator::$operator";s:10:"sourceFile";s:106:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/CompareValidator.php";s:9:"startLine";i:95;s:7:"endLine";i:95;s:16:"shortDescription";s:28:"The operator for comparison.";s:11:"description";s:837:"The operator for comparison. The following operators are supported:

- `==`: check if two values are equal. The comparison is done is non-strict mode.
- `===`: check if two values are equal. The comparison is done is strict mode.
- `!=`: check if two values are NOT equal. The comparison is done is non-strict mode.
- `!==`: check if two values are NOT equal. The comparison is done is strict mode.
- `>`: check if value being validated is greater than the value being compared with.
- `>=`: check if value being validated is greater than or equal to the value being compared with.
- `<`: check if value being validated is less than the value being compared with.
- `<=`: check if value being validated is less than or equal to the value being compared with.

When you want to compare numbers, make sure to also set [[type]] to `number`.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:837:"the operator for comparison. The following operators are supported:

- `==`: check if two values are equal. The comparison is done is non-strict mode.
- `===`: check if two values are equal. The comparison is done is strict mode.
- `!=`: check if two values are NOT equal. The comparison is done is non-strict mode.
- `!==`: check if two values are NOT equal. The comparison is done is strict mode.
- `>`: check if value being validated is greater than the value being compared with.
- `>=`: check if value being validated is greater than or equal to the value being compared with.
- `<`: check if value being validated is less than the value being compared with.
- `<=`: check if value being validated is less than or equal to the value being compared with.

When you want to compare numbers, make sure to also set [[type]] to `number`.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:8:"$message";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:12:"defaultValue";N;s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:31:"yii\validators\CompareValidator";s:13:"phpDocContext";r:131993;s:4:"name";s:8:"$message";s:8:"fullName";s:41:"yii\validators\CompareValidator::$message";s:10:"sourceFile";s:106:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/CompareValidator.php";s:9:"startLine";i:106;s:7:"endLine";i:106;s:16:"shortDescription";s:31:"The user-defined error message.";s:11:"description";s:471:"The user-defined error message. It may contain the following placeholders which
will be replaced accordingly by the validator:

- `{attribute}`: the label of the attribute being validated
- `{value}`: the value of the attribute being validated
- `{compareValue}`: the value or the attribute label to be compared with
- `{compareAttribute}`: the label of the attribute to be compared with
- `{compareValueOrAttribute}`: the value or the attribute label to be compared with";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:471:"the user-defined error message. It may contain the following placeholders which
will be replaced accordingly by the validator:

- `{attribute}`: the label of the attribute being validated
- `{value}`: the value of the attribute being validated
- `{compareValue}`: the value or the attribute label to be compared with
- `{compareAttribute}`: the label of the attribute to be compared with
- `{compareValueOrAttribute}`: the value or the attribute label to be compared with";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:14:"yii\validators";s:13:"phpDocContext";r:131993;s:4:"name";s:31:"yii\validators\CompareValidator";s:8:"fullName";s:31:"yii\validators\CompareValidator";s:10:"sourceFile";s:106:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/CompareValidator.php";s:9:"startLine";i:35;s:7:"endLine";i:295;s:16:"shortDescription";s:75:"CompareValidator compares the specified attribute value with another value.";s:11:"description";s:659:"The value being compared with can be another attribute value
(specified via [[compareAttribute]]) or a constant (specified via
[[compareValue]]). When both are specified, the latter takes
precedence. If neither is specified, the attribute will be compared
with another attribute whose name is by appending "_repeat" to the source
attribute name.

CompareValidator supports different comparison operators, specified
via the [[operator]] property.

The default comparison function is based on string values, which means the values
are compared byte by byte. When comparing numbers, make sure to set the [[$type]]
to [[TYPE_NUMBER]] to enable numeric comparison.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:30:"yii\validators\StringValidator";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:24:"yii\validators\Validator";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:5:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:30:"yii\validators\StringValidator";s:10:"sourceCode";s:1147:"public function init()
{
    parent::init();
    if (is_array($this->length)) {
        if (isset($this->length[0])) {
            $this->min = $this->length[0];
        }
        if (isset($this->length[1])) {
            $this->max = $this->length[1];
        }
        $this->length = null;
    }
    if ($this->encoding === null) {
        $this->encoding = Yii::$app ? Yii::$app->charset : 'UTF-8';
    }
    if ($this->message === null) {
        $this->message = Yii::t('yii', '{attribute} must be a string.');
    }
    if ($this->min !== null && $this->tooShort === null) {
        $this->tooShort = Yii::t('yii', '{attribute} should contain at least {min, number} {min, plural, one{character} other{characters}}.');
    }
    if ($this->max !== null && $this->tooLong === null) {
        $this->tooLong = Yii::t('yii', '{attribute} should contain at most {max, number} {max, plural, one{character} other{characters}}.');
    }
    if ($this->length !== null && $this->notEqual === null) {
        $this->notEqual = Yii::t('yii', '{attribute} should contain {length, number} {length, plural, one{character} other{characters}}.');
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:14:"yii\validators";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:2:{s:3:"Yii";s:3:"Yii";s:4:"Json";s:16:"yii\helpers\Json";}}s:4:"name";s:4:"init";s:8:"fullName";s:36:"yii\validators\StringValidator::init";s:10:"sourceFile";s:105:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/StringValidator.php";s:9:"startLine";i:79;s:7:"endLine";i:106;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:17:"validateAttribute";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:30:"yii\validators\StringValidator";s:10:"sourceCode";s:813:"public function validateAttribute($model, $attribute)
{
    $value = $model->$attribute;
    if (!$this->strict && is_scalar($value) && !is_string($value)) {
        $value = (string)$value;
    }
    if (!is_string($value)) {
        $this->addError($model, $attribute, $this->message);
        return;
    }
    $length = mb_strlen($value, $this->encoding);
    if ($this->min !== null && $length < $this->min) {
        $this->addError($model, $attribute, $this->tooShort, ['min' => $this->min]);
    }
    if ($this->max !== null && $length > $this->max) {
        $this->addError($model, $attribute, $this->tooLong, ['max' => $this->max]);
    }
    if ($this->length !== null && $length !== $this->length) {
        $this->addError($model, $attribute, $this->notEqual, ['length' => $this->length]);
    }
}
";s:6:"params";a:2:{s:6:"$model";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$model";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:105:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/StringValidator.php";}s:10:"$attribute";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$attribute";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:105:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/StringValidator.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:132555;s:4:"name";s:17:"validateAttribute";s:8:"fullName";s:49:"yii\validators\StringValidator::validateAttribute";s:10:"sourceFile";s:105:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/StringValidator.php";s:9:"startLine";i:111;s:7:"endLine";i:134;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:13:"validateValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:30:"yii\validators\StringValidator";s:10:"sourceCode";s:660:"protected function validateValue($value)
{
    if (!$this->strict && is_scalar($value) && !is_string($value)) {
        $value = (string)$value;
    }
    if (!is_string($value)) {
        return [$this->message, []];
    }
    $length = mb_strlen($value, $this->encoding);
    if ($this->min !== null && $length < $this->min) {
        return [$this->tooShort, ['min' => $this->min]];
    }
    if ($this->max !== null && $length > $this->max) {
        return [$this->tooLong, ['max' => $this->max]];
    }
    if ($this->length !== null && $length !== $this->length) {
        return [$this->notEqual, ['length' => $this->length]];
    }
    return null;
}
