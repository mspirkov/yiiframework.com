{
    $row = $this->db->createCommand('SHOW CREATE TABLE ' . $this->quoteTableName($table->fullName))->queryOne();
    if (isset($row['Create Table'])) {
        $sql = $row['Create Table'];
    } else {
        $row = array_values($row);
        $sql = $row[1];
    }
    return $sql;
}
";s:6:"params";a:1:{s:6:"$table";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$table";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:18:"The table metadata";s:4:"type";s:19:"\yii\db\TableSchema";s:5:"types";a:1:{i:0;s:19:"\yii\db\TableSchema";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mysql/Schema.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:38:"$sql the result of 'SHOW CREATE TABLE'";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:189213;s:4:"name";s:17:"getCreateTableSql";s:8:"fullName";s:38:"yii\db\mysql\Schema::getCreateTableSql";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/mysql/Schema.php";s:9:"startLine";i:414;s:7:"endLine";i:425;s:16:"shortDescription";s:33:"Gets the CREATE TABLE sql string.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:15:"findConstraints";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:19:"yii\db\mysql\Schema";s:10:"sourceCode";s:2603:"protected function findConstraints($table)
{
    $sql = <<<'SQL'
CT
`kcu`.`CONSTRAINT_NAME` AS `constraint_name`,
`kcu`.`COLUMN_NAME` AS `column_name`,
`kcu`.`REFERENCED_TABLE_NAME` AS `referenced_table_name`,
`kcu`.`REFERENCED_COLUMN_NAME` AS `referenced_column_name`
 `information_schema`.`REFERENTIAL_CONSTRAINTS` AS `rc`
 `information_schema`.`KEY_COLUMN_USAGE` AS `kcu` ON
(
    `kcu`.`CONSTRAINT_CATALOG` = `rc`.`CONSTRAINT_CATALOG` OR
    (`kcu`.`CONSTRAINT_CATALOG` IS NULL AND `rc`.`CONSTRAINT_CATALOG` IS NULL)
) AND
`kcu`.`CONSTRAINT_SCHEMA` = `rc`.`CONSTRAINT_SCHEMA` AND
`kcu`.`CONSTRAINT_NAME` = `rc`.`CONSTRAINT_NAME`
E `rc`.`CONSTRAINT_SCHEMA` = database() AND `kcu`.`TABLE_SCHEMA` = database()
`rc`.`TABLE_NAME` = :tableName AND `kcu`.`TABLE_NAME` = :tableName1

    try {
        $rows = $this->db->createCommand($sql, [':tableName' => $table->name, ':tableName1' => $table->name])->queryAll();
        $constraints = [];
        foreach ($rows as $row) {
            $constraints[$row['constraint_name']]['referenced_table_name'] = $row['referenced_table_name'];
            $constraints[$row['constraint_name']]['columns'][$row['column_name']] = $row['referenced_column_name'];
        }
        $table->foreignKeys = [];
        foreach ($constraints as $name => $constraint) {
            $table->foreignKeys[$name] = array_merge(
                [$constraint['referenced_table_name']],
                $constraint['columns']
            );
        }
    } catch (\Exception $e) {
        $previous = $e->getPrevious();
        if (!$previous instanceof \PDOException || strpos($previous->getMessage(), 'SQLSTATE[42S02') === false) {
            throw $e;
        }
        // table does not exist, try to determine the foreign keys using the table creation sql
        $sql = $this->getCreateTableSql($table);
        $regexp = '/FOREIGN KEY\s+\(([^\)]+)\)\s+REFERENCES\s+([^\(^\s]+)\s*\(([^\)]+)\)/mi';
        if (preg_match_all($regexp, $sql, $matches, PREG_SET_ORDER)) {
            foreach ($matches as $match) {
                $fks = array_map('trim', explode(',', str_replace(['`', '"'], '', $match[1])));
                $pks = array_map('trim', explode(',', str_replace(['`', '"'], '', $match[3])));
                $constraint = [str_replace(['`', '"'], '', $match[2])];
                foreach ($fks as $k => $name) {
                    $constraint[$name] = $pks[$k];
                }
                $table->foreignKeys[md5(serialize($constraint))] = $constraint;
            }
            $table->foreignKeys = array_values($table->foreignKeys);
        }
    }
}
