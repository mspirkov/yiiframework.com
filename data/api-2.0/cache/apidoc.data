specified.";s:11:"description";s:119:"For more details and usage information on ListView, see the [guide article on data widgets](guide:output-data-widgets).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"yii\widgets\Pjax";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:15:"yii\base\Widget";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:4:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:16:"yii\widgets\Pjax";s:10:"sourceCode";s:936:"public function init()
{
    parent::init();
    if (!isset($this->options['id'])) {
        $this->options['id'] = $this->getId();
    }
    if ($this->requiresPjax()) {
        ob_start();
        ob_implicit_flush(false);
        $view = $this->getView();
        $view->clear();
        $view->beginPage();
        $view->head();
        $view->beginBody();
        if ($view->title !== null) {
            echo Html::tag('title', Html::encode($view->title));
        }
    } else {
        $options = $this->options;
        $tag = ArrayHelper::remove($options, 'tag', 'div');
        echo Html::beginTag($tag, array_merge([
            'data-pjax-container' => '',
            'data-pjax-push-state' => $this->enablePushState,
            'data-pjax-replace-state' => $this->enableReplaceState,
            'data-pjax-timeout' => $this->timeout,
            'data-pjax-scrollto' => $this->scrollTo,
        ], $options));
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\widgets";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:6:{s:3:"Yii";s:3:"Yii";s:6:"Widget";s:15:"yii\base\Widget";s:11:"ArrayHelper";s:23:"yii\helpers\ArrayHelper";s:4:"Html";s:16:"yii\helpers\Html";s:4:"Json";s:16:"yii\helpers\Json";s:8:"Response";s:16:"yii\web\Response";}}s:4:"name";s:4:"init";s:8:"fullName";s:22:"yii\widgets\Pjax::init";s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Pjax.php";s:9:"startLine";i:114;s:7:"endLine";i:143;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:3:"run";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:16:"yii\widgets\Pjax";s:10:"sourceCode";s:658:"public function run()
{
    if (!$this->requiresPjax()) {
        echo Html::endTag(ArrayHelper::remove($this->options, 'tag', 'div'));
        $this->registerClientScript();
        return;
    }
    $view = $this->getView();
    $view->endBody();
    $view->endPage(true);
    $content = ob_get_clean();
    // only need the content enclosed within this widget
    $response = Yii::$app->getResponse();
    $response->clearOutputBuffers();
    $response->setStatusCode(200);
    $response->format = Response::FORMAT_HTML;
    $response->content = $content;
    $response->headers->setDefault('X-Pjax-Url', Yii::$app->request->url);
    Yii::$app->end();
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:19081;s:4:"name";s:3:"run";s:8:"fullName";s:21:"yii\widgets\Pjax::run";s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Pjax.php";s:9:"startLine";i:148;s:7:"endLine";i:173;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:12:"requiresPjax";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:16:"yii\widgets\Pjax";s:10:"sourceCode";s:213:"protected function requiresPjax()
{
    $headers = Yii::$app->getRequest()->getHeaders();
    return $headers->get('X-Pjax') && explode(' ', $headers->get('X-Pjax-Container'))[0] === '#' . $this->options['id'];
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:67:"Whether the current request requires pjax response from this widget";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:19081;s:4:"name";s:12:"requiresPjax";s:8:"fullName";s:30:"yii\widgets\Pjax::requiresPjax";s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Pjax.php";s:9:"startLine";i:178;s:7:"endLine";i:183;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:20:"registerClientScript";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:16:"yii\widgets\Pjax";s:10:"sourceCode";s:1232:"public function registerClientScript()
{
    $id = $this->options['id'];
    $this->clientOptions['push'] = $this->enablePushState;
    $this->clientOptions['replace'] = $this->enableReplaceState;
    $this->clientOptions['timeout'] = $this->timeout;
    $this->clientOptions['scrollTo'] = $this->scrollTo;
    if (!isset($this->clientOptions['container'])) {
        $this->clientOptions['container'] = "#$id";
    }
    $options = Json::htmlEncode($this->clientOptions);
    $js = '';
    if ($this->linkSelector !== false) {
        $linkSelector = Json::htmlEncode($this->linkSelector !== null ? $this->linkSelector : '#' . $id . ' a');
        $js .= "jQuery(document).pjax($linkSelector, $options);";
    }
    if ($this->formSelector !== false) {
        $formSelector = Json::htmlEncode($this->formSelector !== null ? $this->formSelector : '#' . $id . ' form[data-pjax]');
        $submitEvent = Json::htmlEncode($this->submitEvent);
        $js .= "\njQuery(document).off($submitEvent, $formSelector).on($submitEvent, $formSelector, function (event) {jQuery.pjax.submit(event, $options);});";
    }
    $view = $this->getView();
    PjaxAsset::register($view);
    if ($js !== '') {
        $view->registerJs($js);
    }
}
