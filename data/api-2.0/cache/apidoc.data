}
";s:6:"params";a:0:{}s:10:"exceptions";a:1:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:21:"if [[db]] is invalid.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:8:"yii\data";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:5:{s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:10:"Connection";s:17:"yii\db\Connection";s:10:"Expression";s:17:"yii\db\Expression";s:5:"Query";s:12:"yii\db\Query";s:8:"Instance";s:15:"yii\di\Instance";}}s:4:"name";s:4:"init";s:8:"fullName";s:30:"yii\data\SqlDataProvider::init";s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/SqlDataProvider.php";s:9:"startLine";i:95;s:7:"endLine";i:102;s:16:"shortDescription";s:40:"Initializes the DB connection component.";s:11:"description";s:96:"This method will initialize the [[db]] property to make sure it refers to a valid DB connection.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:13:"prepareModels";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:24:"yii\data\SqlDataProvider";s:10:"sourceCode";s:979:"protected function prepareModels()
{
    $sort = $this->getSort();
    $pagination = $this->getPagination();
    if ($pagination === false && $sort === false) {
        return $this->db->createCommand($this->sql, $this->params)->queryAll();
    }
    $sql = $this->sql;
    $orders = [];
    $limit = $offset = null;
    if ($sort !== false) {
        $orders = $sort->getOrders();
        $pattern = '/\s+order\s+by\s+([\w\s,\."`\[\]]+)$/i';
        if (preg_match($pattern, $sql, $matches)) {
            array_unshift($orders, new Expression($matches[1]));
            $sql = preg_replace($pattern, '', $sql);
        }
    }
    if ($pagination !== false) {
        $pagination->totalCount = $this->getTotalCount();
        $limit = $pagination->getLimit();
        $offset = $pagination->getOffset();
    }
    $sql = $this->db->getQueryBuilder()->buildOrderByAndLimit($sql, $orders, $limit, $offset);
    return $this->db->createCommand($sql, $this->params)->queryAll();
}
