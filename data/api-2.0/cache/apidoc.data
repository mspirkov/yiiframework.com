{
    foreach ($messages as $category => $msgs) {
        $file = str_replace('\\', '/', "$dirName/$category.php");
        $path = dirname($file);
        FileHelper::createDirectory($path);
        $msgs = array_values(array_unique($msgs));
        $coloredFileName = Console::ansiFormat($file, [Console::FG_CYAN]);
        $this->stdout("Saving messages to $coloredFileName...\n");
        $this->saveMessagesCategoryToPHP($msgs, $file, $overwrite, $removeUnused, $sort, $category, $markUnused);
    }
    if ($removeUnused) {
        $this->deleteUnusedPhpMessageFiles(array_keys($messages), $dirName);
    }
}
";s:6:"params";a:6:{s:9:"$messages";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$messages";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MessageController.php";}s:8:"$dirName";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:8:"$dirName";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:33:"Name of the directory to write to";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MessageController.php";}s:10:"$overwrite";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$overwrite";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:53:"If existing file should be overwritten without backup";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MessageController.php";}s:13:"$removeUnused";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:13:"$removeUnused";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:42:"If obsolete translations should be removed";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MessageController.php";}s:5:"$sort";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$sort";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:32:"If translations should be sorted";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MessageController.php";}s:11:"$markUnused";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:11:"$markUnused";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:41:"If obsolete translations should be marked";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MessageController.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:40168;s:4:"name";s:17:"saveMessagesToPHP";s:8:"fullName";s:60:"yii\console\controllers\MessageController::saveMessagesToPHP";s:10:"sourceFile";s:116:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/MessageController.php";s:9:"startLine";i:700;s:7:"endLine";i:715;s:16:"shortDescription";s:31:"Writes messages into PHP files.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:25:"saveMessagesCategoryToPHP";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:41:"yii\console\controllers\MessageController";s:10:"sourceCode";s:2479:"protected function saveMessagesCategoryToPHP($messages, $fileName, $overwrite, $removeUnused, $sort, $category, $markUnused)
{
    if (is_file($fileName)) {
        $rawExistingMessages = require $fileName;
        $existingMessages = $rawExistingMessages;
        sort($messages);
        ksort($existingMessages);
        if (array_keys($existingMessages) === $messages && (!$sort || array_keys($rawExistingMessages) === $messages)) {
            $this->stdout("Nothing new in \"$category\" category... Nothing to save.\n\n", Console::FG_GREEN);
            return ExitCode::OK;
        }
        unset($rawExistingMessages);
        $merged = [];
        $untranslated = [];
        foreach ($messages as $message) {
            if (array_key_exists($message, $existingMessages) && $existingMessages[$message] !== '') {
                $merged[$message] = $existingMessages[$message];
            } else {
                $untranslated[] = $message;
            }
        }
        ksort($merged);
        sort($untranslated);
        $todo = [];
        foreach ($untranslated as $message) {
            $todo[$message] = '';
        }
        ksort($existingMessages);
        foreach ($existingMessages as $message => $translation) {
            if (!$removeUnused && !isset($merged[$message]) && !isset($todo[$message])) {
                if (!$markUnused || (!empty($translation) && (strncmp($translation, '@@', 2) === 0 && substr_compare($translation, '@@', -2, 2) === 0))) {
                    $todo[$message] = $translation;
                } else {
                    $todo[$message] = '@@' . $translation . '@@';
                }
            }
        }
        $merged = array_merge($merged, $todo);
        if ($sort) {
            ksort($merged);
        }
        if (false === $overwrite) {
            $fileName .= '.merged';
        }
        $this->stdout("Translation merged.\n");
    } else {
        $merged = [];
        foreach ($messages as $message) {
            $merged[$message] = '';
        }
        ksort($merged);
    }
    $array = VarDumper::export($merged);
    $content = <<<EOD
p
is->config['phpFileHeader']}{$this->config['phpDocBlock']}
rn $array;

    if (file_put_contents($fileName, $content, LOCK_EX) === false) {
        $this->stdout("Translation was NOT saved.\n\n", Console::FG_RED);
        return ExitCode::UNSPECIFIED_ERROR;
    }
    $this->stdout("Translation saved.\n\n", Console::FG_GREEN);
    return ExitCode::OK;
}
