Default to empty string which results in no prefix to be displayed.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/helpers/BaseConsole.php";}s:6:"$width";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$width";s:10:"isOptional";b:1;s:12:"defaultValue";s:4:"null";s:19:"isPassedByReference";b:0;s:11:"description";s:452:"Optional width of the progressbar. This can be an integer representing
