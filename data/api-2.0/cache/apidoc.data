";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:109295;s:4:"name";s:4:"init";s:8:"fullName";s:30:"yii\web\CompositeUrlRule::init";s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/CompositeUrlRule.php";s:9:"startLine";i:45;s:7:"endLine";i:49;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:12:"parseRequest";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:24:"yii\web\CompositeUrlRule";s:10:"sourceCode";s:563:"public function parseRequest($manager, $request)
{
    foreach ($this->rules as $rule) {
        /** @var UrlRule $rule */
        $result = $rule->parseRequest($manager, $request);
        if (YII_DEBUG) {
            Yii::debug([
                'rule' => method_exists($rule, '__toString') ? $rule->__toString() : get_class($rule),
                'match' => $result !== false,
                'parent' => self::className(),
            ], __METHOD__);
        }
        if ($result !== false) {
            return $result;
        }
    }
    return false;
}
