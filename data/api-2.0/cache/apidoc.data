for a single domain. And each message category represents a message context
in Gettext. Translated messages are stored as either a MO or PO file,
depending on the [[useMoFile]] property value.

All translations are saved under the [[basePath]] directory.

Translations in one language are kept as MO or PO files under an individual
subdirectory whose name is the language ID. The file name is specified via
[[catalog]] property, which defaults to 'messages'.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:25:"yii\data\ActiveDataFilter";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:19:"yii\data\DataFilter";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:11:"Paul Klimov";s:21:"klimov.paul@gmail.com";}s:7:"methods";a:6:{s:13:"buildInternal";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:25:"yii\data\ActiveDataFilter";s:10:"sourceCode";s:172:"protected function buildInternal()
{
    $filter = $this->normalize(false);
    if (empty($filter)) {
        return [];
    }
    return $this->buildCondition($filter);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:8:"yii\data";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:0:{}}s:4:"name";s:13:"buildInternal";s:8:"fullName";s:40:"yii\data\ActiveDataFilter::buildInternal";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/ActiveDataFilter.php";s:9:"startLine";i:71;s:7:"endLine";i:79;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:14:"buildCondition";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:25:"yii\data\ActiveDataFilter";s:10:"sourceCode";s:707:"protected function buildCondition($condition)
{
    $parts = [];
    foreach ($condition as $key => $value) {
        if (isset($this->conditionBuilders[$key])) {
            $method = $this->conditionBuilders[$key];
            if (is_string($method)) {
                $callback = [$this, $method];
            } else {
                $callback = $method;
            }
        } else {
            $callback = [$this, 'buildAttributeCondition'];
        }
        $parts[] = $callback($key, $value);
    }
    if (!empty($parts)) {
        if (count($parts) > 1) {
            array_unshift($parts, 'AND');
        } else {
            $parts = array_shift($parts);
        }
    }
    return $parts;
}
";s:6:"params";a:1:{s:10:"$condition";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$condition";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:0:"";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/ActiveDataFilter.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:16:"Built condition.";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:8624;s:4:"name";s:14:"buildCondition";s:8:"fullName";s:41:"yii\data\ActiveDataFilter::buildCondition";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/ActiveDataFilter.php";s:9:"startLine";i:85;s:7:"endLine";i:111;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:25:"buildConjunctionCondition";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:25:"yii\data\ActiveDataFilter";s:10:"sourceCode";s:326:"protected function buildConjunctionCondition($operator, $condition)
{
    if (isset($this->queryOperatorMap[$operator])) {
        $operator = $this->queryOperatorMap[$operator];
    }
    $result = [$operator];
    foreach ($condition as $part) {
        $result[] = $this->buildCondition($part);
    }
    return $result;
}
