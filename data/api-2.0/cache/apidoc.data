This parameter will be ignored if not supported by the DBMS.";s:4:"type";s:8:"int|null";s:5:"types";a:2:{i:0;s:3:"int";i:1;s:4:"null";}s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/SchemaBuilderTrait.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:52:"The column instance which can be further customized.";s:10:"returnType";s:27:"\yii\db\ColumnSchemaBuilder";s:11:"returnTypes";a:1:{i:0;s:27:"\yii\db\ColumnSchemaBuilder";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:214424;s:4:"name";s:5:"money";s:8:"fullName";s:32:"yii\db\SchemaBuilderTrait::money";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/SchemaBuilderTrait.php";s:9:"startLine";i:275;s:7:"endLine";i:286;s:16:"shortDescription";s:23:"Creates a money column.";s:11:"description";s:0:"";s:5:"since";s:5:"2.0.6";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:4:"json";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\db\SchemaBuilderTrait";s:10:"sourceCode";s:456:"public function json()
{
    /*
     * TODO Remove in Yii 2.1
     *
     * Disabled due to bug in MySQL extension
     * @link https://bugs.php.net/bug.php?id=70384
     */
    if (version_compare(PHP_VERSION, '5.6', '<') && $this->getDb()->getDriverName() === 'mysql') {
        throw new \yii\base\Exception('JSON column type is not supported in PHP < 5.6');
    }
    return $this->getDb()->getSchema()->createColumnSchemaBuilder(Schema::TYPE_JSON);
}
