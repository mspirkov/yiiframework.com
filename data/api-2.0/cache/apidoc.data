llName";s:40:"yii\db\oci\conditions\InConditionBuilder";s:10:"sourceFile";s:115:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/oci/conditions/InConditionBuilder.php";s:9:"startLine";i:16;s:7:"endLine";i:72;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:42:"yii\db\oci\conditions\LikeConditionBuilder";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:38:"yii\db\conditions\LikeConditionBuilder";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:0:{}s:7:"methods";a:1:{s:5:"build";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:42:"yii\db\oci\conditions\LikeConditionBuilder";s:10:"sourceCode";s:456:"public function build(ExpressionInterface $expression, array &$params = [])
{
    if (!isset($this->escapingReplacements['\\'])) {
        /*
         * Different pdo_oci8 versions may or may not implement PDO::quote(), so
         * yii\db\Schema::quoteValue() may or may not quote \.
         */
        $this->escapingReplacements['\\'] = substr($this->queryBuilder->db->quoteValue('\\'), 1, -1);
    }
    return parent::build($expression, $params);
}
