/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/grid/GridView.php";s:9:"startLine";i:266;s:7:"endLine";i:266;s:16:"shortDescription";s:87:"The layout that determines how different sections of the grid view should be organized.";s:11:"description";s:447:"The layout that determines how different sections of the grid view should be organized.
The following tokens will be replaced with the corresponding section contents:

- `{summary}`: the summary section. See [[renderSummary()]].
- `{errors}`: the filter model error summary. See [[renderErrors()]].
- `{items}`: the list items. See [[renderItems()]].
- `{sorter}`: the sorter. See [[renderSorter()]].
- `{pager}`: the pager. See [[renderPager()]].";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:447:"the layout that determines how different sections of the grid view should be organized.
The following tokens will be replaced with the corresponding section contents:

- `{summary}`: the summary section. See [[renderSummary()]].
- `{errors}`: the filter model error summary. See [[renderErrors()]].
- `{items}`: the list items. See [[renderItems()]].
- `{sorter}`: the sorter. See [[renderSorter()]].
- `{pager}`: the pager. See [[renderPager()]].";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:8:"yii\grid";s:13:"phpDocContext";r:27606;s:4:"name";s:17:"yii\grid\GridView";s:8:"fullName";s:17:"yii\grid\GridView";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/grid/GridView.php";s:9:"startLine";i:49;s:7:"endLine";i:599;s:16:"shortDescription";s:54:"The GridView widget is used to display data in a grid.";s:11:"description";s:652:"It provides features like [[sorter|sorting]], [[pager|paging]] and also [[filterModel|filtering]] the data.

A basic usage looks like the following:

```
<?= GridView::widget([
    'dataProvider' => $dataProvider,
    'columns' => [
        'id',
        'name',
        'created_at:datetime',
        // ...
    ],
]) ?>
```

The columns of the grid table are configured in terms of [[Column]] classes,
which are configured via [[columns]].

The look and feel of a grid view can be customized using the large amount of properties.

For more details and usage information on GridView, see the [guide article on data widgets](guide:output-data-widgets).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:21:"yii\grid\ActionColumn";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:15:"yii\grid\Column";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:5:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\grid\ActionColumn";s:10:"sourceCode";s:80:"public function init()
{
    parent::init();
    $this->initDefaultButtons();
}
