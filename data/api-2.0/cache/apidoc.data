";s:6:"params";a:1:{s:9:"$pathInfo";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:9:"$pathInfo";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:14:"Raw path info.";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/UrlNormalizer.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:21:"Normalized path info.";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:118604;s:4:"name";s:15:"collapseSlashes";s:8:"fullName";s:38:"yii\web\UrlNormalizer::collapseSlashes";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/UrlNormalizer.php";s:9:"startLine";i:128;s:7:"endLine";i:131;s:16:"shortDescription";s:97:"Collapse consecutive slashes in $pathInfo, for example converts `site///index` into `site/index`.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:22:"normalizeTrailingSlash";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:21:"yii\web\UrlNormalizer";s:10:"sourceCode";s:313:"protected function normalizeTrailingSlash($pathInfo, $suffix)
{
    if (substr($suffix, -1) === '/' && substr($pathInfo, -1) !== '/') {
        $pathInfo .= '/';
    } elseif (substr($suffix, -1) !== '/' && substr($pathInfo, -1) === '/') {
        $pathInfo = rtrim($pathInfo, '/');
    }
    return $pathInfo;
}
