it will be replaced with the [[expression]] property value without any
DB escaping or quoting. For example,

```
$expression = new Expression('NOW()');
$now = (new \yii\db\Query)->select($expression)->scalar();  // SELECT NOW();
echo $now; // prints the current date
```

Expression objects are mainly created for passing raw SQL expressions to methods of
[[Query]], [[ActiveQuery]], and related classes.

An expression can also be bound with parameters specified via [[params]].";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:24:"yii\db\pgsql\ArrayParser";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";N;s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:2:{s:13:"Sergei Tigrov";s:11:"rrr-r@ya.ru";s:15:"Dmytro Naumenko";s:22:"d.naumenko.a@gmail.com";}s:7:"methods";a:1:{s:5:"parse";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:24:"yii\db\pgsql\ArrayParser";s:10:"sourceCode";s:178:"public function parse($value)
{
    if ($value === null) {
        return null;
    }
    if ($value === '{}') {
        return [];
    }
    return $this->parseArray($value);
}
";s:6:"params";a:1:{s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:22:"String to be converted";s:4:"type";s:6:"string";s:5:"types";a:1:{i:0;s:6:"string";}s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/ArrayParser.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:0:"";s:10:"returnType";s:10:"array|null";s:11:"returnTypes";a:2:{i:0;s:5:"array";i:1;s:4:"null";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:12:"yii\db\pgsql";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:0:{}}s:4:"name";s:5:"parse";s:8:"fullName";s:31:"yii\db\pgsql\ArrayParser::parse";s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/ArrayParser.php";s:9:"startLine";i:32;s:7:"endLine";i:43;s:16:"shortDescription";s:36:"Convert array from PostgreSQL to PHP";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:10:"properties";a:0:{}s:9:"namespace";s:12:"yii\db\pgsql";s:13:"phpDocContext";r:194745;s:4:"name";s:24:"yii\db\pgsql\ArrayParser";s:8:"fullName";s:24:"yii\db\pgsql\ArrayParser";s:10:"sourceFile";s:99:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/pgsql/ArrayParser.php";s:9:"startLine";i:18;s:7:"endLine";i:110;s:16:"shortDescription";s:63:"The class converts PostgreSQL array representation to PHP array";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.14";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:3;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:13:"phpcs:disable";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:61:"Squiz.NamingConventions.ValidVariableName.PrivateNoUnderscore";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:35:"yii\db\pgsql\ArrayExpressionBuilder";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";N;s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:1:{i:0;s:33:"yii\db\ExpressionBuilderInterface";}s:6:"traits";a:1:{i:0;s:29:"yii\db\ExpressionBuilderTrait";}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:15:"Dmytro Naumenko";s:22:"d.naumenko.a@gmail.com";}s:7:"methods";a:5:{s:5:"build";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:35:"yii\db\pgsql\ArrayExpressionBuilder";s:10:"sourceCode";s:512:"public function build(ExpressionInterface $expression, array &$params = [])
{
    $value = $expression->getValue();
    if ($value === null) {
        return 'NULL';
    }
    if ($value instanceof Query) {
        list ($sql, $params) = $this->queryBuilder->build($value, $params);
        return $this->buildSubqueryArray($sql, $expression);
    }
    $placeholders = $this->buildPlaceholders($expression, $params);
    return 'ARRAY[' . implode(', ', $placeholders) . ']' . $this->getTypehint($expression);
}
