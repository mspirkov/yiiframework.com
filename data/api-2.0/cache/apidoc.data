[pjax project page](https://github.com/yiisoft/jquery-pjax) for available options.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:13:"$autoIdPrefix";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:1;s:4:"type";N;s:5:"types";N;s:12:"defaultValue";s:3:"'p'";s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:16:"yii\widgets\Pjax";s:13:"phpDocContext";r:19081;s:4:"name";s:13:"$autoIdPrefix";s:8:"fullName";s:31:"yii\widgets\Pjax::$autoIdPrefix";s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Pjax.php";s:9:"startLine";i:108;s:7:"endLine";i:108;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}}s:9:"namespace";s:11:"yii\widgets";s:13:"phpDocContext";r:19081;s:4:"name";s:16:"yii\widgets\Pjax";s:8:"fullName";s:16:"yii\widgets\Pjax";s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Pjax.php";s:9:"startLine";i:45;s:7:"endLine";i:216;s:16:"shortDescription";s:94:"Pjax is a widget integrating the [pjax](https://github.com/yiisoft/jquery-pjax) jQuery plugin.";s:11:"description";s:1098:"Pjax only deals with the content enclosed between its [[begin()]] and [[end()]] calls, called the *body content* of the widget.
By default, any link click or form submission (for those forms with `data-pjax` attribute) within the body content
will trigger an AJAX request. In responding to the AJAX request, Pjax will send the updated body content (based
on the AJAX request) to the client which will replace the old content with the new one. The browser's URL will then
be updated using pushState. The whole process requires no reloading of the layout or resources (js, css).

You may configure [[linkSelector]] to specify which links should trigger pjax, and configure [[formSelector]]
to specify which form submission may trigger pjax.

You may disable pjax for a specific link inside the container by adding `data-pjax="0"` attribute to this link.

The following example shows how to use Pjax with the [[\yii\grid\GridView]] widget so that the grid pagination,
sorting and filtering can be done via pjax:

```
use yii\widgets\Pjax;

Pjax::begin();
echo GridView::widget([...]);
Pjax::end();
```";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:21:"yii\widgets\Spaceless";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:15:"yii\base\Widget";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:7:"resurtm";s:17:"resurtm@gmail.com";}s:7:"methods";a:2:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\widgets\Spaceless";s:10:"sourceCode";s:93:"public function init()
{
    parent::init();
    ob_start();
    ob_implicit_flush(false);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\widgets";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:1:{s:6:"Widget";s:15:"yii\base\Widget";}}s:4:"name";s:4:"init";s:8:"fullName";s:27:"yii\widgets\Spaceless::init";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Spaceless.php";s:9:"startLine";i:55;s:7:"endLine";i:60;s:16:"shortDescription";s:86:"Starts capturing an output to be cleaned from whitespace characters between HTML tags.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:3:"run";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\widgets\Spaceless";s:10:"sourceCode";s:88:"public function run()
{
    echo trim(preg_replace('/>\s+</', '><', ob_get_clean()));
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:19581;s:4:"name";s:3:"run";s:8:"fullName";s:26:"yii\widgets\Spaceless::run";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Spaceless.php";s:9:"startLine";i:66;s:7:"endLine";i:69;s:16:"shortDescription";s:84:"Marks the end of content to be cleaned from whitespace characters between HTML tags.";s:11:"description";s:52:"Stops capturing an output and echoes cleaned result.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:10:"properties";a:0:{}s:9:"namespace";s:11:"yii\widgets";s:13:"phpDocContext";r:19581;s:4:"name";s:21:"yii\widgets\Spaceless";s:8:"fullName";s:21:"yii\widgets\Spaceless";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Spaceless.php";s:9:"startLine";i:50;s:7:"endLine";i:70;s:16:"shortDescription";s:140:"Spaceless widget removes whitespace characters between HTML tags. Whitespaces within HTML tags
or in a plain text are always left untouched.";s:11:"description";s:933:"Usage example:

```
<body>
    <?php Spaceless::begin(); ?>
        <div class="nav-bar">
            <!-- tags -->
        </div>
        <div class="content">
            <!-- tags -->
        </div>
    <?php Spaceless::end(); ?>
</body>
```

This example will generate the following HTML:

```
<body>
    <div class="nav-bar"><!-- tags --></div><div class="content"><!-- tags --></div></body>
```

This method is not designed for content compression (you should use `gzip` output compression to
achieve it). Main intention is to strip out extra whitespace characters between HTML tags in order
to avoid browser rendering quirks in some circumstances (e.g. newlines between inline-block elements).

Note, never use this method with `pre` or `textarea` tags. It's not that trivial to deal with such tags
as it may seem at first sight. For this case you should consider using
[HTML Tidy Project](https://www.html-tidy.org/) instead.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:26:"https://www.html-tidy.org/";}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:23:"yii\widgets\Breadcrumbs";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:15:"yii\base\Widget";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:2:{s:3:"run";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:23:"yii\widgets\Breadcrumbs";s:10:"sourceCode";s:727:"public function run()
{
    if (empty($this->links)) {
        return;
    }
    $links = [];
    if ($this->homeLink === null) {
        $links[] = $this->renderItem([
            'label' => Yii::t('yii', 'Home'),
            'url' => Yii::$app->homeUrl,
        ], $this->itemTemplate);
    } elseif ($this->homeLink !== false) {
        $links[] = $this->renderItem($this->homeLink, $this->itemTemplate);
    }
    foreach ($this->links as $link) {
        if (!is_array($link)) {
            $link = ['label' => $link];
        }
        $links[] = $this->renderItem($link, isset($link['url']) ? $this->itemTemplate : $this->activeItemTemplate);
    }
    echo Html::tag($this->tag, implode('', $links), $this->options);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\widgets";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:5:{s:3:"Yii";s:3:"Yii";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:6:"Widget";s:15:"yii\base\Widget";s:11:"ArrayHelper";s:23:"yii\helpers\ArrayHelper";s:4:"Html";s:16:"yii\helpers\Html";}}s:4:"name";s:3:"run";s:8:"fullName";s:28:"yii\widgets\Breadcrumbs::run";s:10:"sourceFile";s:98:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Breadcrumbs.php";s:9:"startLine";i:130;s:7:"endLine";i:151;s:16:"shortDescription";s:19:"Renders the widget.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:10:"renderItem";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:23:"yii\widgets\Breadcrumbs";s:10:"sourceCode";s:725:"protected function renderItem($link, $template)
{
    $encodeLabel = ArrayHelper::remove($link, 'encode', $this->encodeLabels);
    if (array_key_exists('label', $link)) {
        $label = $encodeLabel ? Html::encode($link['label']) : $link['label'];
    } else {
        throw new InvalidConfigException('The "label" element is required for each link.');
    }
    if (isset($link['template'])) {
        $template = $link['template'];
    }
    if (isset($link['url'])) {
        $options = $link;
        unset($options['template'], $options['label'], $options['url']);
        $link = Html::a($label, $link['url'], $options);
    } else {
        $link = $label;
    }
    return strtr($template, ['{link}' => $link]);
}
