in a SELECT statement. These methods can be chained together.

By calling [[createCommand()]], we can get a [[Command]] instance which can be further
used to perform/execute the DB query against a database.

For example,

```
$query = new Query;
// compose the query
$query->select('id, name')
    ->from('user')
    ->limit(10);
// build and execute the query
$rows = $query->all();
// alternatively, you can create DB command and execute it
$command = $query->createCommand();
// $command->sql returns the actual SQL
$rows = $command->queryAll();
```

Query internally uses the [[QueryBuilder]] class to generate the SQL statement.

A more detailed usage guide on how to work with Query can be found in the [guide article on Query Builder](guide:db-query-builder).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:51:"phpDocumentor\Reflection\DocBlock\Tags\PropertyRead":4:{s:15:"␀*␀variableName";s:16:"tablesUsedInFrom";s:7:"␀*␀type";O:37:"phpDocumentor\Reflection\Types\Array_":3:{s:12:"␀*␀valueType";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:10:"␀*␀keyType";N;s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}s:7:"␀*␀name";s:13:"property-read";s:14:"␀*␀description";r:166510;}}s:5:"todos";a:0:{}}s:27:"yii\db\ForeignKeyConstraint";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:17:"yii\db\Constraint";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:14:"Sergey Makinen";s:17:"sergey@makinen.ru";}s:7:"methods";a:0:{}s:10:"properties";a:5:{s:18:"$foreignSchemaName";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:11:"string|null";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:4:"null";}s:12:"defaultValue";N;s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:27:"yii\db\ForeignKeyConstraint";s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:6:"yii\db";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:0:{}}s:4:"name";s:18:"$foreignSchemaName";s:8:"fullName";s:47:"yii\db\ForeignKeyConstraint::$foreignSchemaName";s:10:"sourceFile";s:102:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/fra