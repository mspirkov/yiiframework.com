";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:14099;s:4:"name";s:17:"prepareTotalCount";s:8:"fullName";s:45:"yii\data\ArrayDataProvider::prepareTotalCount";s:10:"sourceFile";s:101:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/ArrayDataProvider.php";s:9:"startLine";i:116;s:7:"endLine";i:119;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:10:"sortModels";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:26:"yii\data\ArrayDataProvider";s:10:"sourceCode";s:240:"protected function sortModels($models, $sort)
{
    $orders = $sort->getOrders();
    if (!empty($orders)) {
        ArrayHelper::multisort($models, array_keys($orders), array_values($orders), $sort->sortFlags);
    }
    return $models;
