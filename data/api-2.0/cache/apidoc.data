"description";s:0:"";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:21:"yii\db\sqlite\Command";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:14:"yii\db\Command";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:14:"Sergey Makinen";s:17:"sergey@makinen.ru";}s:7:"methods";a:2:{s:7:"execute";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:21:"yii\db\sqlite\Command";s:10:"sourceCode";s:516:"public function execute()
{
    $sql = $this->getSql();
    $params = $this->params;
    $statements = $this->splitStatements($sql, $params);
    if ($statements === false) {
        return parent::execute();
    }
    $result = null;
    foreach ($statements as $statement) {
        list($statementSql, $statementParams) = $statement;
        $this->setSql($statementSql)->bindValues($statementParams);
        $result = parent::execute();
    }
    $this->setSql($sql)->bindValues($params);
    return $result;
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:13:"yii\db\sqlite";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:2:{s:8:"SqlToken";s:15:"yii\db\SqlToken";s:12:"StringHelper";s:24:"yii\helpers\StringHelper";}}s:4:"name";s:7:"execute";s:8:"fullName";s:30:"yii\db\sqlite\Command::execute";s:10:"sourceFile";s:96:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/sqlite/Command.php";s:9:"startLine";i:26;s:7:"endLine";i:43;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:13:"queryInternal";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:21:"yii\db\sqlite\Command";s:10:"sourceCode";s:752:"protected function queryInternal($method, $fetchMode = null)
{
    $sql = $this->getSql();
    $params = $this->params;
    $statements = $this->splitStatements($sql, $params);
    if ($statements === false) {
        return parent::queryInternal($method, $fetchMode);
    }
    list($lastStatementSql, $lastStatementParams) = array_pop($statements);
    foreach ($statements as $statement) {
        list($statementSql, $statementParams) = $statement;
        $this->setSql($statementSql)->bindValues($statementParams);
        parent::execute();
    }
    $this->setSql($lastStatementSql)->bindValues($lastStatementParams);
    $result = parent::queryInternal($method, $fetchMode);
    $this->setSql($sql)->bindValues($params);
    return $result;
}
