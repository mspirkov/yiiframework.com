";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:60:"pending parameters to be bound to the current PDO statement.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:6:"yii\db";s:13:"phpDocContext";r:184737;s:4:"name";s:14:"yii\db\Command";s:8:"fullName";s:14:"yii\db\Command";s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Command.php";s:9:"startLine";i:57;s:7:"endLine";i:1346;s:16:"shortDescription";s:69:"Command represents a SQL statement to be executed against a database.";s:11:"description";s:1300:"A command object is usually created by calling [[Connection::createCommand()]].
The SQL statement it represents can be set via the [[sql]] property.

To execute a non-query SQL (such as INSERT, DELETE, UPDATE), call [[execute()]].
To execute a SQL statement that returns a result data set (such as SELECT),
use [[queryAll()]], [[queryOne()]], [[queryColumn()]], [[queryScalar()]], or [[query()]].

For example,

```
$users = $connection->createCommand('SELECT * FROM user')->queryAll();
```

Command supports SQL statement preparation and parameter binding.
Call [[bindValue()]] to bind a value to a SQL parameter;
Call [[bindParam()]] to bind a PHP variable to a SQL parameter.
When binding a parameter, the SQL statement is automatically prepared.
You may also call [[prepare()]] explicitly to prepare a SQL statement.

Command also supports building SQL statements by providing methods such as [[insert()]],
[[update()]], etc. For example, the following code will create and execute an INSERT SQL statement:

```
$connection->createCommand()->insert('user', [
    'name' => 'Sam',
    'age' => 30,
])->execute();
```

To build SELECT SQL statements, please use [[Query]] instead.

For more details and usage information on Command, see the [guide article on Database Access Objects](guide:db-dao).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:0;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:6:"rawSql";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:187679;}i:1;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:3:"sql";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\String_":0:{}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:187705;}}s:5:"todos";a:0:{}}s:25:"yii\db\mysql\QueryBuilder";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:19:"yii\db\QueryBuilder";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:19:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:25:"yii\db\mysql\QueryBuilder";s:10:"sourceCode";s:126:"public function init()
{
