;i:48;s:16:"shortDescription";s:66:"Constant for specifying the comparison [[type]] by numeric values.";s:11:"description";s:0:"";s:5:"since";s:6:"2.0.11";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:1;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:20:"\yii\validators\type";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:4:"type";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:6:{s:4:"init";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:31:"yii\validators\CompareValidator";s:10:"sourceCode";s:1257:"public function init()
{
    parent::init();
    if ($this->message === null) {
        switch ($this->operator) {
            case '==':
            case '===':
                $this->message = Yii::t('yii', '{attribute} must be equal to "{compareValueOrAttribute}".');
                break;
            case '!=':
            case '!==':
                $this->message = Yii::t('yii', '{attribute} must not be equal to "{compareValueOrAttribute}".');
                break;
            case '>':
                $this->message = Yii::t('yii', '{attribute} must be greater than "{compareValueOrAttribute}".');
                break;
            case '>=':
                $this->message = Yii::t('yii', '{attribute} must be greater than or equal to "{compareValueOrAttribute}".');
                break;
            case '<':
                $this->message = Yii::t('yii', '{attribute} must be less than "{compareValueOrAttribute}".');
                break;
            case '<=':
                $this->message = Yii::t('yii', '{attribute} must be less than or equal to "{compareValueOrAttribute}".');
                break;
            default:
                throw new InvalidConfigException("Unknown operator: {$this->operator}");
        }
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:131993;s:4:"name";s:4:"init";s:8:"fullName";s:37:"yii\validators\CompareValidator::init";s:10:"sourceFile";s:106:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/CompareValidator.php";s:9:"startLine";i:112;s:7:"endLine";i:141;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:17:"validateAttribute";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:31:"yii\validators\CompareValidator";s:10:"sourceCode";s:1439:"public function validateAttribute($model, $attribute)
{
    $value = $model->$attribute;
    if (is_array($value)) {
        $this->addError($model, $attribute, Yii::t('yii', '{attribute} is invalid.'));
        return;
    }
    if ($this->compareValue !== null) {
        if ($this->compareValue instanceof \Closure) {
            $this->compareValue = call_user_func($this->compareValue, $model, $attribute);
        }
        $compareLabel = $compareValue = $compareValueOrAttribute = $this->compareValue;
    } else {
        $compareAttribute = $this->compareAttribute === null ? $attribute . '_repeat' : $this->compareAttribute;
        $compareValue = $model->$compareAttribute;
        $compareLabel = $compareValueOrAttribute = $model->getAttributeLabel($compareAttribute);
        if (!$this->skipOnError && $model->hasErrors($compareAttribute)) {
            $this->addError(
                $model,
                $attribute,
                Yii::t('yii', '{compareAttribute} is invalid.'),
                ['compareAttribute' => $compareLabel]
            );
            return;
        }
    }
    if (!$this->compareValues($this->operator, $this->type, $value, $compareValue)) {
        $this->addError($model, $attribute, $this->message, [
            'compareAttribute' => $compareLabel,
            'compareValue' => $compareValue,
            'compareValueOrAttribute' => $compareValueOrAttribute,
        ]);
    }
}
";s:6:"params";a:2:{s:6:"$model";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$model";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:106:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/CompareValidator.php";}s:10:"$attribute";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:10:"$attribute";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:106:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/CompareValidator.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:131993;s:4:"name";s:17:"validateAttribute";s:8:"fullName";s:50:"yii\validators\CompareValidator::validateAttribute";s:10:"sourceFile";s:106:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/CompareValidator.php";s:9:"startLine";i:146;s:7:"endLine";i:183;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:13:"validateValue";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:31:"yii\validators\CompareValidator";s:10:"sourceCode";s:633:"protected function validateValue($value)
{
    if ($this->compareValue === null) {
        throw new InvalidConfigException('CompareValidator::compareValue must be set.');
    }
    if ($this->compareValue instanceof \Closure) {
        $this->compareValue = call_user_func($this->compareValue);
    }
    if (!$this->compareValues($this->operator, $this->type, $value, $this->compareValue)) {
        return [$this->message, [
            'compareAttribute' => $this->compareValue,
            'compareValue' => $this->compareValue,
            'compareValueOrAttribute' => $this->compareValue,
        ]];
    }
    return null;
}
";s:6:"params";a:1:{s:6:"$value";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$value";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";N;s:4:"type";s:5:"mixed";s:5:"types";a:1:{i:0;s:5:"mixed";}s:10:"sourceFile";s:106:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/CompareValidator.php";}}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";N;s:11:"returnTypes";N;s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:131993;s:4:"name";s:13:"validateValue";s:8:"fullName";s:46:"yii\validators\CompareValidator::validateValue";s:10:"sourceFile";s:106:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/validators/CompareValidator.php";s:9:"startLine";i:188;s:7:"endLine";i:205;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:13:"compareValues";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:31:"yii\validators\CompareValidator";s:10:"sourceCode";s:876:"protected function compareValues($operator, $type, $value, $compareValue)
{
    if ($type === self::TYPE_NUMBER) {
        $value = (float) $value;
        $compareValue = (float) $compareValue;
    } else {
        $value = (string) $value;
        $compareValue = (string) $compareValue;
    }
    switch ($operator) {
        case '==':
            return $value == $compareValue;
        case '===':
            return $value === $compareValue;
        case '!=':
            return $value != $compareValue;
        case '!==':
            return $value !== $compareValue;
        case '>':
            return $value > $compareValue;
        case '>=':
            return $value >= $compareValue;
        case '<':
            return $value < $compareValue;
        case '<=':
            return $value <= $compareValue;
        default:
            return false;
    }
}
