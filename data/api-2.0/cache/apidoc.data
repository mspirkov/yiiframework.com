For more details and usage information on BaseListView, see the [guide article on data widgets](guide:output-data-widgets).";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"yii\widgets\Menu";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:15:"yii\base\Widget";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:5:{s:3:"run";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:16:"yii\widgets\Menu";s:10:"sourceCode";s:520:"public function run()
{
    if ($this->route === null && Yii::$app->controller !== null) {
        $this->route = Yii::$app->controller->getRoute();
    }
    if ($this->params === null) {
        $this->params = Yii::$app->request->getQueryParams();
    }
    $items = $this->normalizeItems($this->items, $hasActiveChild);
    if (!empty($items)) {
        $options = $this->options;
        $tag = ArrayHelper::remove($options, 'tag', 'ul');
        echo Html::tag($tag, $this->renderItems($items), $options);
    }
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";N;s:10:"returnType";s:5:"mixed";s:11:"returnTypes";a:1:{i:0;s:5:"mixed";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:11:"yii\widgets";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:6:{s:7:"Closure";s:7:"Closure";s:3:"Yii";s:3:"Yii";s:6:"Widget";s:15:"yii\base\Widget";s:11:"ArrayHelper";s:23:"yii\helpers\ArrayHelper";s:4:"Html";s:16:"yii\helpers\Html";s:3:"Url";s:15:"yii\helpers\Url";}}s:4:"name";s:3:"run";s:8:"fullName";s:21:"yii\widgets\Menu::run";s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Menu.php";s:9:"startLine";i:172;s:7:"endLine";i:187;s:16:"shortDescription";s:17:"Renders the menu.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:11:"renderItems";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:16:"yii\widgets\Menu";s:10:"sourceCode";s:1089:"protected function renderItems($items)
{
    $n = count($items);
    $lines = [];
    foreach ($items as $i => $item) {
        $options = array_merge($this->itemOptions, ArrayHelper::getValue($item, 'options', []));
        $tag = ArrayHelper::remove($options, 'tag', 'li');
        $class = [];
        if ($item['active']) {
            $class[] = $this->activeCssClass;
        }
        if ($i === 0 && $this->firstItemCssClass !== null) {
            $class[] = $this->firstItemCssClass;
        }
        if ($i === $n - 1 && $this->lastItemCssClass !== null) {
            $class[] = $this->lastItemCssClass;
        }
        Html::addCssClass($options, $class);
        $menu = $this->renderItem($item);
        if (!empty($item['items'])) {
            $submenuTemplate = ArrayHelper::getValue($item, 'submenuTemplate', $this->submenuTemplate);
            $menu .= strtr($submenuTemplate, [
                '{items}' => $this->renderItems($item['items']),
            ]);
        }
        $lines[] = Html::tag($tag, $menu, $options);
    }
    return implode("\n", $lines);
}
";s:6:"params";a:1:{s:6:"$items";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$items";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:41:"The menu items to be rendered recursively";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Menu.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:20:"The rendering result";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:16703;s:4:"name";s:11:"renderItems";s:8:"fullName";s:29:"yii\widgets\Menu::renderItems";s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Menu.php";s:9:"startLine";i:194;s:7:"endLine";i:224;s:16:"shortDescription";s:63:"Recursively renders the menu items (without the container tag).";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:10:"renderItem";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:16:"yii\widgets\Menu";s:10:"sourceCode";s:463:"protected function renderItem($item)
{
    if (isset($item['url'])) {
        $template = ArrayHelper::getValue($item, 'template', $this->linkTemplate);
        return strtr($template, [
            '{url}' => Html::encode(Url::to($item['url'])),
            '{label}' => $item['label'],
        ]);
    }
    $template = ArrayHelper::getValue($item, 'template', $this->labelTemplate);
    return strtr($template, [
        '{label}' => $item['label'],
    ]);
}
";s:6:"params";a:1:{s:5:"$item";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$item";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:94:"The menu item to be rendered. Please refer to [[items]] to see what data might be in the item.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Menu.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:20:"The rendering result";s:10:"returnType";s:6:"string";s:11:"returnTypes";a:1:{i:0;s:6:"string";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:16703;s:4:"name";s:10:"renderItem";s:8:"fullName";s:28:"yii\widgets\Menu::renderItem";s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Menu.php";s:9:"startLine";i:232;s:7:"endLine";i:248;s:16:"shortDescription";s:35:"Renders the content of a menu item.";s:11:"description";s:64:"Note that the container and the sub-menus are not rendered here.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"normalizeItems";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:16:"yii\widgets\Menu";s:10:"sourceCode";s:1613:"protected function normalizeItems($items, &$active)
{
    foreach ($items as $i => $item) {
        if (isset($item['visible']) && !$item['visible']) {
            unset($items[$i]);
            continue;
        }
        if (!isset($item['label'])) {
            $item['label'] = '';
        }
        $encodeLabel = isset($item['encode']) ? $item['encode'] : $this->encodeLabels;
        $items[$i]['label'] = $encodeLabel ? Html::encode($item['label']) : $item['label'];
        $hasActiveChild = false;
        if (isset($item['items'])) {
            $items[$i]['items'] = $this->normalizeItems($item['items'], $hasActiveChild);
            if (empty($items[$i]['items']) && $this->hideEmptyItems) {
                unset($items[$i]['items']);
                if (!isset($item['url'])) {
                    unset($items[$i]);
                    continue;
                }
            }
        }
        if (!isset($item['active'])) {
            if ($this->activateParents && $hasActiveChild || $this->activateItems && $this->isItemActive($item)) {
                $active = $items[$i]['active'] = true;
            } else {
                $items[$i]['active'] = false;
            }
        } elseif ($item['active'] instanceof Closure) {
            if (call_user_func($item['active'], $item, $hasActiveChild, $this->isItemActive($item), $this)) {
                $active = $items[$i]['active'] = true;
            } else {
                $items[$i]['active'] = false;
            }
        } elseif ($item['active']) {
            $active = true;
        }
    }
    return array_values($items);
}
";s:6:"params";a:2:{s:6:"$items";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:6:"$items";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:27:"The items to be normalized.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Menu.php";}s:7:"$active";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$active";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:1;s:11:"description";s:43:"Whether there is an active child menu item.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Menu.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:25:"The normalized menu items";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:16703;s:4:"name";s:14:"normalizeItems";s:8:"fullName";s:32:"yii\widgets\Menu::normalizeItems";s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Menu.php";s:9:"startLine";i:256;s:7:"endLine";i:297;s:16:"shortDescription";s:87:"Normalizes the [[items]] property to remove invisible items and activate certain items.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:12:"isItemActive";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:16:"yii\widgets\Menu";s:10:"sourceCode";s:843:"protected function isItemActive($item)
{
    if (isset($item['url']) && is_array($item['url']) && isset($item['url'][0])) {
        $route = Yii::getAlias($item['url'][0]);
        if (strncmp($route, '/', 1) !== 0 && Yii::$app->controller) {
            $route = Yii::$app->controller->module->getUniqueId() . '/' . $route;
        }
        if (ltrim($route, '/') !== $this->route) {
            return false;
        }
        unset($item['url']['#']);
        if (count($item['url']) > 1) {
            $params = $item['url'];
            unset($params[0]);
            foreach ($params as $name => $value) {
                if ($value !== null && (!isset($this->params[$name]) || $this->params[$name] != $value)) {
                    return false;
                }
            }
        }
        return true;
    }
    return false;
}
";s:6:"params";a:1:{s:5:"$item";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:5:"$item";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:27:"The menu item to be checked";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Menu.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:31:"Whether the menu item is active";s:10:"returnType";s:4:"bool";s:11:"returnTypes";a:1:{i:0;s:4:"bool";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:16703;s:4:"name";s:12:"isItemActive";s:8:"fullName";s:30:"yii\widgets\Menu::isItemActive";s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Menu.php";s:9:"startLine";i:309;s:7:"endLine";i:334;s:16:"shortDescription";s:37:"Checks whether a menu item is active.";s:11:"description";s:418:"This is done by checking if [[route]] and [[params]] match that specified in the `url` option of the menu item.
When the `url` option of a menu item is specified in terms of an array, its first element is treated
as the route for the item and the rest of the elements are the associated parameters.
Only when its route and parameters match [[route]] and [[params]], respectively, will a menu item
be considered active.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:10:"properties";a:15:{s:6:"$items";O:29:"yii\apidoc\models\PropertyDoc":22:{s:10:"visibility";s:6:"public";s:8:"isStatic";b:0;s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:12:"defaultValue";s:2:"[]";s:6:"getter";N;s:6:"setter";N;s:9:"definedBy";s:16:"yii\widgets\Menu";s:13:"phpDocContext";r:16703;s:4:"name";s:6:"$items";s:8:"fullName";s:24:"yii\widgets\Menu::$items";s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/widgets/Menu.php";s:9:"startLine";i:79;s:7:"endLine";i:79;s:16:"shortDescription";s:19:"List of menu items.";s:11:"description";s:2034:"List of menu items. Each menu item should be an array of the following structure:

- label: string, optional, specifies the menu item label. When [[encodeLabels]] is true, the label
  will be HTML-encoded. If the label is not specified, an empty string will be used.
- encode: boolean, optional, whether this item`s label should be HTML-encoded. This param will override
  global [[encodeLabels]] param.
- url: string or array, optional, specifies the URL of the menu item. It will be processed by [[Url::to]].
  When this is set, the actual menu item content will be generated using [[linkTemplate]];
  otherwise, [[labelTemplate]] will be used.
- visible: boolean, optional, whether this menu item is visible. Defaults to true.
- items: array, optional, specifies the sub-menu items. Its format is the same as the parent items.
- active: boolean or Closure, optional, whether this menu item is in active state (currently selected).
  When using a closure, its signature should be `function ($item, $hasActiveChild, $isItemActive, $widget)`.
  Closure must return `true` if item should be marked as `active`, otherwise - `false`.
  If a menu item is active, its CSS class will be appended with [[activeCssClass]].
  If this option is not set, the menu item will be set active automatically when the current request
  is triggered by `url`. For more details, please refer to [[isItemActive()]].
- template: string, optional, the template used to render the content of this menu item.
  The token `{url}` will be replaced by the URL associated with this menu item,
  and the token `{label}` will be replaced by the label of the menu item.
  If this option is not set, [[linkTemplate]] or [[labelTemplate]] will be used instead.
- submenuTemplate: string, optional, the template used to render the list of sub-menus.
  The token `{items}` will be replaced with the rendered sub-menu items.
  If this option is not set, [[submenuTemplate]] will be used instead.
- options: array, optional, the HTML attributes for the menu container tag.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:43:"phpDocumentor\Reflection\DocBlock\Tags\Var_":4:{s:15:"␀*␀variableName";s:0:"";s:7:"␀*␀type";O:37:"phpDocumentor\Reflection\Types\Array_":3:{s:12:"␀*␀valueType";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:10:"␀*␀keyType";N;s:17:"␀*␀defaultKeyType";O:39:"phpDocumentor\Reflection\Types\Compound":2:{s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀types";a:2:{i:0;O:38:"phpDocumentor\Reflection\Types\String_":0:{}i:1;O:38:"phpDocumentor\Reflection\Types\Integer":0:{}}s:52:"␀phpDocumentor\Reflection\Types\AggregatedType␀token";s:1:"|";}}s:7:"␀*␀name";s:3:"var";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:2034:"list of menu items. Each menu item should be an array of the following structure:

