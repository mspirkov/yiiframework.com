registered via [[set()]] or [[setSingleton()]].";s:4:"type";s:23:"string|\yii\di\Instance";s:5:"types";a:2:{i:0;s:6:"string";i:1;s:16:"\yii\di\Instance";}s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/Container.php";}s:7:"$params";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$params";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:465:"A list of constructor parameter values. Use one of two definitions:
- Parameters as name-value pairs, for example: `['posts' => PostRepository::class]`.
- Parameters in the order they appear in the constructor declaration. If you want to skip some parameters,
  you should index the remaining ones with the integers that represent their positions in the constructor
  parameter list.
  Dependencies indexed by name and by position in the same array are not allowed.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/Container.php";}s:7:"$config";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:7:"$config";s:10:"isOptional";b:1;s:12:"defaultValue";s:2:"[]";s:19:"isPassedByReference";b:0;s:11:"description";s:81:"A list of name-value pairs that will be used to initialize the object properties.";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/Container.php";}}s:10:"exceptions";a:2:{s:32:"\yii\base\InvalidConfigException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:72:"if the class cannot be recognized or correspond to an invalid definition";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}s:32:"\yii\di\NotInstantiableException";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:62:"If resolved to an abstract class or an interface (since 2.0.9)";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}s:6:"return";s:35:"An instance of the requested class.";s:10:"returnType";s:6:"object";s:11:"returnTypes";a:1:{i:0;s:6:"object";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";O:38:"phpDocumentor\Reflection\Types\Context":2:{s:49:"␀phpDocumentor\Reflection\Types\Context␀namespace";s:6:"yii\di";s:56:"␀phpDocumentor\Reflection\Types\Context␀namespaceAliases";a:8:{s:15:"ReflectionClass";s:15:"ReflectionClass";s:19:"ReflectionException";s:19:"ReflectionException";s:19:"ReflectionNamedType";s:19:"ReflectionNamedType";s:19:"ReflectionParameter";s:19:"ReflectionParameter";s:3:"Yii";s:3:"Yii";s:9:"Component";s:18:"yii\base\Component";s:22:"InvalidConfigException";s:31:"yii\base\InvalidConfigException";s:11:"ArrayHelper";s:23:"yii\helpers\ArrayHelper";}}s:4:"name";s:3:"get";s:8:"fullName";s:21:"yii\di\Container::get";s:10:"sourceFile";s:91:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/di/Container.php";s:9:"startLine";i:171;s:7:"endLine";i:212;s:16:"shortDescription";s:43:"Returns an instance of the requested class.";s:11:"description";s:658:"You may provide constructor parameters (`$params`) and object configurations (`$config`)
that will be used during the creation of the instance.

If the class implements [[\yii\base\Configurable]], the `$config` parameter will be passed as the last
parameter to the class constructor; Otherwise, the configuration will be applied *after* the object is
instantiated.

Note that if the class is declared to be singleton by calling [[setSingleton()]],
the same instance of the class will be returned each time this method is called.
In this case, the constructor parameters and object configurations will be used
only if the class is instantiated the first time.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:5:{i:6;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Template":5:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀templateName";s:1:"T";s:54:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀bound";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";N;}s:56:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀default";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:7:"␀*␀name";s:8:"template";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:7;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:11:"psalm-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:38:"string|class-string<T>|Instance $class";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:8;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:13:"phpstan-param";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:38:"string|class-string<T>|Instance $class";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:9;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:12:"psalm-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:40:"($class is class-string<T> ? T : object)";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:10;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:14:"phpstan-return";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:40:"($class is class-string<T> ? T : object)";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}s:3:"set";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:16:"yii\di\Container";s:10:"sourceCode";s:248:"public function set($class, $definition = [], array $params = [])
