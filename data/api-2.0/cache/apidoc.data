{
    if ($this->_page === null || $recalculate) {
        $page = (int) $this->getQueryParam($this->pageParam, 1) - 1;
        $this->setPage($page, true);
    }
    return $this->_page;
}
";s:6:"params";a:1:{s:12:"$recalculate";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:12:"$recalculate";s:10:"isOptional";b:1;s:12:"defaultValue";s:5:"false";s:19:"isPassedByReference";b:0;s:11:"description";s:78:"Whether to recalculate the current page based on the page size and item count.";s:4:"type";s:4:"bool";s:5:"types";a:1:{i:0;s:4:"bool";}s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/Pagination.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:35:"The zero-based current page number.";s:10:"returnType";s:3:"int";s:11:"returnTypes";a:1:{i:0;s:3:"int";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:9077;s:4:"name";s:7:"getPage";s:8:"fullName";s:28:"yii\data\Pagination::getPage";s:10:"sourceFile";s:94:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/data/Pagination.php";s:9:"startLine";i:170;s:7:"endLine";i:178;s:16:"shortDescription";s:43:"Returns the zero-based current page number.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:7:"setPage";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:19:"yii\data\Pagination";s:10:"sourceCode";s:461:"public function setPage($value, $validatePage = false)
{
    if ($value === null) {
        $this->_page = null;
    } else {
        $value = (int) $value;
        if ($validatePage && $this->validatePage) {
            $pageCount = $this->getPageCount();
            if ($value >= $pageCount) {
                $value = $pageCount - 1;
            }
        }
        if ($value < 0) {
            $value = 0;
        }
        $this->_page = $value;
    }
}
