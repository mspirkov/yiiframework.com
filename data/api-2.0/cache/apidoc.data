ce";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:10:"properties";a:0:{}s:9:"namespace";s:7:"yii\web";s:13:"phpDocContext";r:98025;s:4:"name";s:25:"yii\web\GoneHttpException";s:8:"fullName";s:25:"yii\web\GoneHttpException";s:10:"sourceFile";s:100:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/web/GoneHttpException.php";s:9:"startLine";i:22;s:7:"endLine";i:34;s:16:"shortDescription";s:74:"GoneHttpException represents a "Gone" HTTP exception with status code 410.";s:11:"description";s:255:"Throw a GoneHttpException when a user requests a resource that no longer exists
at the requested url. For example, after a record is deleted, future requests
for that record should return a 410 GoneHttpException instead of a 404
[[NotFoundHttpException]].";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:52:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Url":1:{s:57:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Url␀uri";s:49:"https://tools.ietf.org/html/rfc7231#section-6.5.9";}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:18:"yii\web\ViewAction";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:15:"yii\base\Action";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:2:{s:17:"Alexander Makarov";s:17:"sam@rmcreative.ru";s:9:"Qiang Xue";s:19:"qiang.xue@gmail.com";}s:7:"methods";a:3:{s:3:"run";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\web\ViewAction";s:10:"sourceCode";s:913:"public function run()
{
    $viewName = $this->resolveViewName();
    $this->controller->actionParams[$this->viewParam] = Yii::$app->request->get($this->viewParam);
    $controllerLayout = null;
    if ($this->layout !== null) {
        $controllerLayout = $this->controller->layout;
        $this->controller->layout = $this->layout;
    }
    try {
        $output = $this->render($viewName);
        if ($controllerLayout) {
            $this->controller->layout = $controllerLayout;
        }
    } catch (ViewNotFoundException $e) {
        if ($controllerLayout) {
            $this->controller->layout = $controllerLayout;
        }
        if (YII_DEBUG) {
            throw new NotFoundHttpException($e->getMessage());
        }
        throw new NotFoundHttpException(
            Yii::t('yii', 'The requested view "{name}" was not found.', ['name' => $viewName])
        );
    }
    return $output;
}
