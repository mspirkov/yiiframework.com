{
    foreach ($this->columns as $column) {
        /** @var Column $column */
        if (!empty($column->options)) {
            $cols = [];
            foreach ($this->columns as $col) {
                $cols[] = Html::tag('col', '', $col->options);
            }
            return Html::tag('colgroup', implode("\n", $cols));
        }
    }
    return false;
}
