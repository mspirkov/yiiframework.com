Connections will be tried in sequential order. The first successful connection will return.

If [[serverStatusCache]] is configured, this method will cache information about
unreachable servers and does not try to connect to these for the time configured in [[serverRetryInterval]].
This helps to keep the application stable when some servers are unavailable. Avoiding
connection attempts to unavailable servers saves time when the connection attempts fail due to timeout.

If none of the servers are available the status cache is ignored and connection attempts are made to all
servers (Since version 2.0.35). This is to avoid downtime when all servers are unavailable for a short time.
After a successful connection attempt the server is marked as available again.";s:5:"since";s:6:"2.0.11";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:2:{i:5;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:20:"\yii\db\openFromPool";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:12:"openFromPool";}}s:14:"␀*␀description";N;}i:6;O:42:"phpDocumentor\Reflection\DocBlock\Tags\See":3:{s:7:"␀*␀name";s:3:"see";s:9:"␀*␀refers";O:54:"phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen":1:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Reference\Fqsen␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:25:"\yii\db\serverStatusCache";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:17:"serverStatusCache";}}s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:7:"__sleep";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\db\Connection";s:10:"sourceCode";s:366:"public function __sleep()
{
    $fields = (array) $this;
    unset($fields['pdo']);
    unset($fields["\000" . __CLASS__ . "\000" . '_master']);
    unset($fields["\000" . __CLASS__ . "\000" . '_slave']);
    unset($fields["\000" . __CLASS__ . "\000" . '_transaction']);
    unset($fields["\000" . __CLASS__ . "\000" . '_schema']);
    return array_keys($fields);
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:0:"";s:10:"returnType";s:5:"array";s:11:"returnTypes";a:1:{i:0;s:5:"array";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:180271;s:4:"name";s:7:"__sleep";s:8:"fullName";s:26:"yii\db\Connection::__sleep";s:10:"sourceFile";s:92:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/Connection.php";s:9:"startLine";i:1266;s:7:"endLine";i:1277;s:16:"shortDescription";s:40:"Close the connection before serializing.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:7:"__clone";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:17:"yii\db\Connection";s:10:"sourceCode";s:357:"public function __clone()
{
    parent::__clone();
    $this->_master = false;
    $this->_slave = false;
    $this->_schema = null;
    $this->_transaction = null;
    if (strncmp($this->dsn, 'sqlite::memory:', 15) !== 0) {
        // reset PDO connection, unless its sqlite in-memory, which can only have one connection
        $this->pdo = null;
    }
