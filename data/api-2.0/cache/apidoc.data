The method [[validate()]] will perform this check.";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"safeAttributes";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:14:"yii\base\Model";s:10:"sourceCode";s:502:"public function safeAttributes()
{
    $scenario = $this->getScenario();
    $scenarios = $this->scenarios();
    if (!isset($scenarios[$scenario])) {
        return [];
    }
    $attributes = [];
    foreach ($scenarios[$scenario] as $attribute) {
        if (
            $attribute !== ''
            && strncmp($attribute, '!', 1) !== 0
            && !in_array('!' . $attribute, $scenarios[$scenario])
        ) {
            $attributes[] = $attribute;
        }
    }
    return $attributes;
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:20:"Safe attribute names";s:10:"returnType";s:8:"string[]";s:11:"returnTypes";a:1:{i:0;s:8:"string[]";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:83412;s:4:"name";s:14:"safeAttributes";s:8:"fullName";s:30:"yii\base\Model::safeAttributes";s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Model.php";s:9:"startLine";i:855;s:7:"endLine";i:874;s:16:"shortDescription";s:91:"Returns the attribute names that are safe to be massively assigned in the current scenario.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:16:"activeAttributes";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:14:"yii\base\Model";s:10:"sourceCode";s:435:"public function activeAttributes()
{
    $scenario = $this->getScenario();
    $scenarios = $this->scenarios();
    if (!isset($scenarios[$scenario])) {
        return [];
    }
    $attributes = array_keys(array_flip($scenarios[$scenario]));
    foreach ($attributes as $i => $attribute) {
        if (strncmp($attribute, '!', 1) === 0) {
            $attributes[$i] = substr($attribute, 1);
        }
    }
    return $attributes;
}
";s:6:"params";a:0:{}s:10:"exceptions";a:0:{}s:6:"return";s:20:"Safe attribute names";s:10:"returnType";s:8:"string[]";s:11:"returnTypes";a:1:{i:0;s:8:"string[]";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:83412;s:4:"name";s:16:"activeAttributes";s:8:"fullName";s:32:"yii\base\Model::activeAttributes";s:10:"sourceFile";s:89:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/base/Model.php";s:9:"startLine";i:880;s:7:"endLine";i:895;s:16:"shortDescription";s:83:"Returns the attribute names that are subject to validation in the current scenario.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:4:"load";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:14:"yii\base\Model";s:10:"sourceCode";s:343:"public function load($data, $formName = null)
{
    $scope = $formName === null ? $this->formName() : $formName;
    if ($scope === '' && !empty($data)) {
        $this->setAttributes($data);
        return true;
    } elseif (isset($data[$scope])) {
        $this->setAttributes($data[$scope]);
        return true;
    }
    return false;
}
