we need to choose replacement value based on [[\yii\db\Schema::quoteValue()]].";s:11:"description";s:13:"{@inheritdoc}";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}}s:9:"namespace";s:24:"yii\db\cubrid\conditions";s:13:"phpDocContext";r:157416;s:4:"name";s:45:"yii\db\cubrid\conditions\LikeConditionBuilder";s:8:"fullName";s:45:"yii\db\cubrid\conditions\LikeConditionBuilder";s:10:"sourceFile";s:120:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/db/cubrid/conditions/LikeConditionBuilder.php";s:9:"startLine";i:13;s:7:"endLine";i:29;s:16:"shortDescription";s:0:"";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:1:{i:0;O:46:"phpDocumentor\Reflection\DocBlock\Tags\Generic":2:{s:7:"␀*␀name";s:10:"inheritdoc";s:14:"␀*␀description";N;}}s:5:"todos";a:0:{}}s:26:"yii\db\cubrid\QueryBuilder";O:26:"yii\apidoc\models\ClassDoc":26:{s:11:"parentClass";s:19:"yii\db\QueryBuilder";s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:10:"interfaces";a:0:{}s:6:"traits";a:0:{}s:10:"subclasses";a:0:{}s:6:"events";a:0:{}s:9:"constants";a:0:{}s:7:"authors";a:1:{s:14:"Carsten Brandt";s:12:"mail@cebe.cc";}s:7:"methods";a:12:{s:25:"defaultExpressionBuilders";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:9:"protected";s:9:"definedBy";s:26:"yii\db\cubrid\QueryBuilder";s:10:"sourceCode";s:215:"protected function defaultExpressionBuilders()
