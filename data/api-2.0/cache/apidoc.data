This option affects only those bundles, which have [[\yii\web\AssetBundle::sourcePath]] is set.";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}}s:5:"todos";a:0:{}}}s:9:"namespace";s:23:"yii\console\controllers";s:13:"phpDocContext";r:39009;s:4:"name";s:39:"yii\console\controllers\AssetController";s:8:"fullName";s:39:"yii\console\controllers\AssetController";s:10:"sourceFile";s:114:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/console/controllers/AssetController.php";s:9:"startLine";i:52;s:7:"endLine";i:845;s:16:"shortDescription";s:65:"Allows you to combine and compress your JavaScript and CSS files.";s:11:"description";s:752:"Usage:

1. Create a configuration file using the `template` action:

   yii asset/template /path/to/myapp/config.php

2. Edit the created config file, adjusting it for your web application needs.
3. Run the 'compress' action, using created config:

   yii asset /path/to/myapp/config.php /path/to/myapp/config/assets_compressed.php

4. Adjust your web application config to use compressed assets.

Note: in the console environment some [path aliases](guide:concept-aliases) like `@webroot` and `@web` may not exist,
so corresponding paths inside the configuration should be specified directly.

Note: by default this command relies on an external tools to perform actual files compression,
check [[jsCompressor]] and [[cssCompressor]] for more details.";s:5:"since";s:3:"2.0";s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:3:{i:0;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Property":4:{s:15:"␀*␀variableName";s:12:"assetManager";s:7:"␀*␀type";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:21:"\yii\web\AssetManager";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:12:"AssetManager";}}s:7:"␀*␀name";s:8:"property";s:14:"␀*␀description";r:39847;}i:4;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Template":5:{s:61:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀templateName";s:1:"T";s:54:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀bound";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:24:"\yii\console\Application";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:11:"Application";}}s:56:"␀phpDocumentor\Reflection\DocBlock\Tags\Template␀default";O:37:"phpDocumentor\Reflection\Types\Mixed_":0:{}s:7:"␀*␀name";s:8:"template";s:14:"␀*␀description";O:45:"phpDocumentor\Reflection\DocBlock\Description":2:{s:59:"␀phpDocumentor\Reflection\DocBlock\Description␀bodyTemplate";s:0:"";s:51:"␀phpDocumentor\Reflection\DocBlock\Description␀tags";a:0:{}}}i:5;O:47:"phpDocumentor\Reflection\DocBlock\Tags\Extends_":3:{s:7:"␀*␀type";O:41:"phpDocumentor\Reflection\Types\Collection":4:{s:48:"␀phpDocumentor\Reflection\Types\Collection␀fqsen";O:30:"phpDocumentor\Reflection\Fqsen":2:{s:37:"␀phpDocumentor\Reflection\Fqsen␀fqsen";s:23:"\yii\console\Controller";s:36:"␀phpDocumentor\Reflection\Fqsen␀name";s:10:"Controller";}s:12:"␀*␀valueType";O:38:"phpDocumentor\Reflection\Types\Object_":1:{s:45:"␀phpDocumentor\Reflection\Types\Object_␀fqsen";O:30:"phpDocumentor\Reflection\