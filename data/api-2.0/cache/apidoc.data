{
    $class = $row['type'] == Item::TYPE_PERMISSION ? Permission::className() : Role::className();
    if (!isset($row['data']) || ($data = @unserialize(is_resource($row['data']) ? stream_get_contents($row['data']) : $row['data'])) === false) {
        $data = null;
    }
    return new $class([
        'name' => $row['name'],
        'type' => $row['type'],
        'description' => $row['description'],
        'ruleName' => $row['rule_name'] ?: null,
        'data' => $data,
        'createdAt' => $row['created_at'],
        'updatedAt' => $row['updated_at'],
    ]);
}
";s:6:"params";a:1:{s:4:"$row";O:26:"yii\apidoc\models\ParamDoc":8:{s:4:"name";s:4:"$row";s:10:"isOptional";b:0;s:12:"defaultValue";N;s:19:"isPassedByReference";b:0;s:11:"description";s:33:"The data from the auth item table";s:4:"type";s:5:"array";s:5:"types";a:1:{i:0;s:5:"array";}s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/rbac/DbManager.php";}}s:10:"exceptions";a:0:{}s:6:"return";s:60:"The populated auth item instance (either Role or Permission)";s:10:"returnType";s:14:"\yii\rbac\Item";s:11:"returnTypes";a:1:{i:0;s:14:"\yii\rbac\Item";}s:19:"isReturnByReference";b:0;s:13:"phpDocContext";r:146884;s:4:"name";s:12:"populateItem";s:8:"fullName";s:32:"yii\rbac\DbManager::populateItem";s:10:"sourceFile";s:93:"/home/mspirkov/open-source/yiisoft/yiiframework.com/data/yii-2.0/framework/rbac/DbManager.php";s:9:"startLine";i:452;s:7:"endLine";i:469;s:16:"shortDescription";s:59:"Populates an auth item with the data fetched from database.";s:11:"description";s:0:"";s:5:"since";N;s:8:"sinceMap";a:0:{}s:15:"deprecatedSince";N;s:16:"deprecatedReason";N;s:4:"tags";a:0:{}s:5:"todos";a:0:{}}s:14:"getRolesByUser";O:27:"yii\apidoc\models\MethodDoc":26:{s:10:"isAbstract";b:0;s:7:"isFinal";b:0;s:8:"isStatic";b:0;s:10:"visibility";s:6:"public";s:9:"definedBy";s:18:"yii\rbac\DbManager";s:10:"sourceCode";s:879:"public function getRolesByUser($userId)
{
    if ($this->isEmptyUserId($userId)) {
        return [];
    }
    if ($this->cache !== null) {
        $data = $this->cache->get($this->getUserRolesCacheKey($userId));
        if ($data !== false) {
            return $data;
        }
    }
    $query = (new Query())->select('b.*')
        ->from(['a' => $this->assignmentTable, 'b' => $this->itemTable])
        ->where('{{a}}.[[item_name]]={{b}}.[[name]]')
        ->andWhere(['a.user_id' => (string) $userId])
        ->andWhere(['b.type' => Item::TYPE_ROLE]);
    $roles = $this->getDefaultRoleInstances();
    foreach ($query->all($this->db) as $row) {
        /** @var Role */
        $role = $this->populateItem($row);
        $roles[$row['name']] = $role;
    }
    if ($this->cache !== null) {
        $this->cacheUserRolesData($userId, $roles);
    }
    return $roles;
}
