{
    $modelClass = $this->primaryModel ? get_class($this->primaryModel) : $this->modelClass;
    $relation = new self($modelClass, [
        'from' => [$tableName],
        'link' => $link,
        'multiple' => true,
        'asArray' => true,
    ]);
    $this->via = $relation;
    if ($callable !== null) {
        call_user_func($callable, $relation);
    }
    return $this;
}
